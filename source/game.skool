;
; Output:F NZ; the actor is in disguise and the disguise is out of the world
c$E022 DEFB $48,$10,$1C,$E0 ; Action record header: flags $48; bit 6: pre-check
                            ; at #R$E01C; byte 1 $10
 $E026 LD A,$01             ; Load A with $01 - WEAR: A = 1, the actor becomes
                            ; thing 1 (#R$E03A)
; This entry point is used by the routine at #R$DFF0.
*$E028 CALL $E03A           ; Call the routine "Set the worn state of the actor
                            ; (A = 1 wear, 0 take..." (#R$E03A)
 $E02B LD IX,($A013)        ; Read #R$A012($A013) in "Game variables" into IX -
                            ; The disguise is taken out of the world: no
                            ; holder, no room
 $E02F LD (IX+$01),$00      ; Set byte +1 of the record at IX to $00
 $E033 LD (IX+$0F),$00      ; Set byte +15 of the record at IX to $00
 $E037 OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller
 $E039 RET                  ; Return to the caller

; Set the worn state of the actor (A = 1 wear, 0 take off)
;
; Called by the shared WEAR (with A = 1) and TAKE OFF (with A = 0) actions.
; Finds the actor's compact record via #R$CC0E, writes A into its byte 0, then
; re-resolves the actor and refreshes the cached record pointer at
; #R$A012($A017). Read from the code; not yet tried in the emulator.
;
;  Input:A 1 to wear, 0 to take off
; Output:$A017 The actor's new record
;        IX That record
c$E03A LD C,A          ; C = 1 to wear, 0 to take off
 $E03B LD A,($A036)    ; The actor's id
 $E03E CALL $CC0E      ; Find their compact record
 $E041 LD (IY+$00),C   ; Record whether they are wearing it
 $E044 LD IY,($A017)   ; Read #R$A012($A017) in "Game variables" into IY
 $E048 LD A,C          ; Copy C into A
 $E049 CALL $D237      ; Re-resolve the actor...
 $E04C LD ($A017),IX   ; ...and refresh the cached pointer
 $E050 LD A,(IY+$01)   ; Read byte +1 of the record at IY into A - The new body
                       ; takes over the old one's holder (+1) and room (+15)
 $E053 LD (IX+$01),A   ; Store A in byte +1 of the record at IX
 $E056 LD (IY+$01),$FF ; Set byte +1 of the record at IY to $FF - The old body
                       ; is held by nothing ($FF) and in no room
 $E05A LD A,(IY+$0F)   ; Read byte +15 of the record at IY into A
 $E05D LD (IX+$0F),A   ; Store A in byte +15 of the record at IX
 $E060 LD (IY+$0F),$00 ; Set byte +15 of the record at IY to $00
 $E064 LD B,$00        ; Load B with $00 - For everything from 1 to $6D: if the
                       ; old actor holds it...
*$E066 INC B           ; Add one to B
 $E067 LD A,B          ; Copy B into A
 $E068 CP $6E          ; Compare A with $6E
 $E06A JR Z,$E07C      ; If A equals $6E, skip ahead to #R$E07C
 $E06C CALL $D237      ; Call the routine "Resolve an id (in A) to its full
                       ; entity record" (#R$D237)
 $E06F LD A,($A036)    ; Read #R$A032($A036) in "Game variables" into A
 $E072 CP (IX+$01)     ; Compare A with byte +1 of the record at IX
 $E075 JR NZ,$E066     ; If A differs from byte +1 of the record at IX, go back
                       ; to #R$E066
 $E077 LD (IX+$01),C   ; Store C in byte +1 of the record at IX - ...the new
                       ; body holds it
 $E07A JR $E066        ; Go back to #R$E066
*$E07C CALL $CFB6      ; Call #R$CFB6 (inside "Save a sub-script call frame") -
                       ; Walk (#R$CFB6) the records it yields and set their +0
                       ; to C, until it returns Z
 $E07F JR Z,$E086      ; If the zero flag is set, skip ahead to #R$E086
 $E081 LD (IX+$00),C   ; Store C in the first byte of the record at IX
 $E084 JR $E07C        ; Go back to #R$E07C
*$E086 LD A,C          ; Copy C into A - The current actor (#R$A032($A036)) is
                       ; now the new body
 $E087 LD ($A036),A    ; Store A in #R$A032($A036) in "Game variables"
 $E08A OR $01          ; Make A non-zero, which clears the zero flag, and hand
                       ; that back to the caller
 $E08C RET             ; Return to the caller

; Sub-script: shared action 13, GO TO in a cab
;
; If the cab is with the actor (verb #R$E5FD(130)), GO TO the place; otherwise
; say 'YOU HAVE TO GET INTO THE CAB FIRST.' Read from the script.
; .
; Entry points: #R$E08F = body of record #R$E08D.
; .
; Decoded by tools/plan.py; see #R$CC78 for the language. Each sub-block is one
; instruction. Room and object numbers are as the game uses them (the reference
; pages list both). Labels for verbs 128-140 and for the common helper records
; (#R$E52F, #R$E57A, #R$E588, #R$E5A8, #R$DDBE, #R$F198) were read from those
; records' code, not tried one by one in the emulator.
; .
; In an instruction, 'plan dobj' and 'plan iobj' are not fixed objects: they
; mean the direct and indirect object currently held in the actor's plan
; registers (bytes +4 and +5 of its actor record), so the same step works on
; whatever the actor is dealing with - for the player, the objects of the
; command just typed. 'plan verb' is the verb register (+3), 'self' is the
; acting character, and '-' means none.
b$E08D DEFB $8D,$04                     ; Action record header: flags $8D; bit
                                        ; 7: checks only; byte 1 $04 -
                                        ; checks-only: the script follows
 $E08F DEFB $87,$FD,$E5,$FD,$FF,$9B,$E0 ; RUN #R$E5FD (plan dobj, -) [ok
                                        ; #R$E09B]
 $E096 DEFB $05,$FD,$9E,$6B             ; SAY TO plan dobj message #R$6B9E:
                                        ; "YOU HAVE TO GET INTO THE CAB FIRST."
 $E09A DEFB $0B                         ; RETURN OK
 $E09B DEFB $02,$1D,$FC,$FF             ; DO 29 #R$9AF4(GO TO): plan iobj, -
 $E09F DEFB $0B                         ; RETURN OK

