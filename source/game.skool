 $B2EA JR Z,$B2E2    ; No: next
 $B2EC LD A,($A035)  ; Read #R$A032($A035) in "Game variables" into A - Yes:
                     ; remember it in #R$B185...
 $B2EF LD ($B185),A  ; Store A in #R$B185 in "Parser variables"
 $B2F2 LD HL,$B171   ; Point HL at #R$B16D($B171) in "Parser variables" -
                     ; ...and count it in #R$B16D($B171)
 $B2F5 INC (HL)      ; Add one to the byte at #R$B16D($B171) in "Parser
                     ; variables"
 $B2F6 LD A,($B190)  ; Read #R$B18D($B190) in "Parser variables" into A - Stop
                     ; at the first if the verb says so (#R$B18D($B190))
 $B2F9 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
