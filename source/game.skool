; Sub-script: RUN at $E737; RUN at $E74A; RUN at $E776
;
; Addresses named in the title: #R$E737, #R$E74A, #R$E776.
; .
; Entry points: #R$E79C = body of record #R$E79A.
; .
; Decoded by tools/plan.py; see #R$CC78 for the language. Each sub-block is one
; instruction. Room and object numbers are as the game uses them (the reference
; pages list both). Labels for verbs 128-140 and for the common helper records
; (#R$E52F, #R$E57A, #R$E588, #R$E5A8, #R$DDBE, #R$F198) were read from those
; records' code, not tried one by one in the emulator.
; .
; In an instruction, 'plan dobj' and 'plan iobj' are not fixed objects: they
; mean the direct and indirect object currently held in the actor's plan
; registers (bytes +4 and +5 of its actor record), so the same step works on
; whatever the actor is dealing with - for the player, the objects of the
; command just typed. 'plan verb' is the verb register (+3), 'self' is the
; acting character, and '-' means none.
b$E79A DEFB $80,$00                     ; Action record header: flags $80; bit
                                        ; 7: checks only; byte 1 $00 -
                                        ; checks-only: the script follows
 $E79C DEFB $03,$A8,$E5                 ; RUN #R$E5A8 IDLE (no checks; takes a
                                        ; minute)
 $E79F DEFB $12,$83,$FB,$08,$B2,$E7     ; DO 131 #R$E5AD(IS IN): self, room 8
                                        ; (your room) [fail #R$E7B2]
 $E7A5 DEFB $17,$E2,$E7,$19,$FF,$B2,$E7 ; RUN #R$E7E2 HAS IT: is the actor
                                        ; carrying (dobj)? (25 daily chronicle,
                                        ; -) [fail #R$E7B2]
 $E7AC DEFB $83,$7A,$E5,$9C,$E7         ; RUN #R$E57A TICK the countdown
                                        ; (fails, and deletes it, when it runs
                                        ; out) [ok #R$E79C]
 $E7B1 DEFB $0B                         ; RETURN OK
 $E7B2 DEFB $03,$88,$E5                 ; RUN #R$E588 CANCEL the countdown
 $E7B5 DEFB $0A                         ; RETURN FAIL
 $E7B6 DEFB $03,$88,$E5                 ; RUN #R$E588 CANCEL the countdown
 $E7B9 DEFB $07,$88,$E4,$00,$FF         ; RUN #R$E488 (0 you, -)
 $E7BE DEFB $87,$52,$DD,$FA,$FF,$B9,$E7 ; RUN #R$DD52 ENTER / GO INTO (dobj)
                                        ; (plan verb, -) [ok #R$E7B9]
 $E7C5 DEFB $82,$82,$00,$FF,$B9,$E7     ; DO 130 #R$E5FD(IS HERE): 0 you, - [ok
                                        ; #R$E7B9]
 $E7CB DEFB $81,$0D,$B9,$E7             ; DO 13 #R$E432(CLIMB OUT OF) [ok
                                        ; #R$E7B9]
 $E7CF DEFB $17,$84,$DD,$00,$FF,$B9,$E7 ; RUN #R$DD84 (0 you, -) [fail #R$E7B9]
 $E7D6 DEFB $82,$0C,$FA,$FF,$B9,$E7     ; DO 12 #R$E40A(CLIMB INTO): plan verb,
                                        ; - [ok #R$E7B9]
