 $D7E7 XOR A         ; Clear A to zero (and the carry flag)
 $D7E8 LD ($D7E0),A  ; Store A in "A flag for #R$D7E1" (#R$D7E0)
 $D7EB CALL $D88A    ; Call the routine "Free the rest of the typed line's word
                     ; list (#R$9FF2)" (#R$D88A)
 $D7EE JP $DC15      ; Jump on to the routine "Fail: A = 0, HL = 0, Z set"
                     ; (#R$DC15)
*$D7F1 LD HL,($9FF2) ; Read #R$9FF2 in "Game variables" into HL - Otherwise:
