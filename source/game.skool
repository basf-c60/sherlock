; Instruction coverage over the 15 stored routes (9 November,
; tools/experiments/insn_coverage.py): all 10 instructions were executed.
;
; Output:F From the rest of his turn at $E691
c$9D13 LD HL,$9D10   ; Point HL at "Watson's greeting countdowns: the
                     ; player,..." (#R$9D10) - Countdown at #R$9D10 for
                     ; greeting the player (C = 0) (#R$9CE9)
 $9D16 LD C,$00      ; Load C with $00
 $9D18 CALL $9CE9    ; Call the routine "Say good morning to C, if just met"
                     ; (#R$9CE9)
 $9D1B LD HL,$9D11   ; Point HL at #R$9D10($9D11) in "Watson's greeting
                     ; countdowns: the player,..." - Countdown at
                     ; #R$9D10($9D11) for Inspector Lestrade (C = 2)
 $9D1E LD C,$02      ; Load C with $02
 $9D20 CALL $9CE9    ; Call the routine "Say good morning to C, if just met"
                     ; (#R$9CE9)
 $9D23 LD HL,$9D12   ; Point HL at #R$9D10($9D12) in "Watson's greeting
                     ; countdowns: the player,..." - Countdown at
                     ; #R$9D10($9D12) for Chief Constable Straker (C = 4)
 $9D26 LD C,$04      ; Load C with $04
 $9D28 CALL $9CE9    ; Call the routine "Say good morning to C, if just met"
                     ; (#R$9CE9)
 $9D2B JP $E691      ; Carry on with the rest of his turn at #R$E691

; Straker's greeting countdowns: the player, Watson
;
; Minutes to go before the next greeting or warning (see #R$9CE9).
b$9D2E DEFB $00,$00

; Chief Constable Straker's after-turn routine
;
; Once Lestrade has been introduced (#R$9D90 set), greets the player and Watson
; when he meets them (#R$9CE9; countdowns at #R$9D2E/#R$9D2E($9D2F)).
;
; Output:F From the second greeting
c$9D30 LD A,($9D90)  ; Read "Lestrade's flags" (#R$9D90) into A - #R$9D90
                     ; (Lestrade has been introduced) clear: nothing to say
 $9D33 AND A         ; Clear the carry flag for the caller (A is unchanged)
 $9D34 RET Z         ; If A is zero, return
 $9D35 LD HL,$9D2E   ; Point HL at "Straker's greeting countdowns: the player,
                     ; Watson" (#R$9D2E) - Speak to thing 0 (C = 0, the player)
                     ; via #R$9CE9 with the countdown at #R$9D2E
 $9D38 LD C,$00      ; Load C with $00
 $9D3A CALL $9CE9    ; Call the routine "Say good morning to C, if just met"
                     ; (#R$9CE9)
 $9D3D LD HL,$9D2F   ; Point HL at #R$9D2E($9D2F) in "Straker's greeting
                     ; countdowns: the player,..." - and to thing 3 (Watson)
                     ; with the countdown at #R$9D2E($9D2F)
 $9D40 LD C,$03      ; Load C with $03
 $9D42 JP $9CE9      ; Go back to the routine "Say good morning to C, if just
                     ; met" (#R$9CE9)

; A police man's warning countdowns: the player, Watson, the Major
