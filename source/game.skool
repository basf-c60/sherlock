; Script helper: succeed by chance (n in 100)
;
; RUN #R$F198 / n: refuses unless a random number from 1 to 99 (#R$D29D) is at
; most n. Read from the code; the emulator saw it succeed 75 times in 84 turns
; of play.
; .
; Used by: RUN at #R$E9A7; RUN at #R$E9B5; RUN at #R$E9C3; RUN at #R$E9CF; RUN
; at #R$ED4F; RUN at #R$ED6A; RUN at #R$ED71; RUN at #R$EDE1; RUN at #R$EDF0;
; RUN at #R$EDFC; RUN at #R$EE03; RUN at #R$F01C; RUN at #R$F02A; RUN at
; #R$F034; RUN at #R$F03B; RUN at #R$F0AA; RUN at #R$F0EE.
;
;  Input:$A034 n
; Output:F NZ when a random number from 1 to 99 is not above n; otherwise $DC15
c$F198 DEFB $07,$00  ; Action record header: flags $07; byte 1 $00
 $F19A CALL $D29D    ; Call the routine "A random number from 1 to 100"
                     ; (#R$D29D) - A random number, 1-99
 $F19D LD B,A        ; Copy A into B
 $F19E LD A,($A034)  ; n
 $F1A1 CP B          ; Is n below it?
 $F1A2 JP C,$DC15    ; Yes: refuse
 $F1A5 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - No: succeed
 $F1A7 RET           ; Return to the caller

; Action record: the Major knocks the policeman out (RUN at $F097)
;
; Addresses named in the title: #R$F097.
; .
; Prints 'You knocks the police man unconscious from behind.' (#R$6D5D) and
; sets the policeman (thing 11) to UNCONSCIOUS ($0910), high nibble 2 of +8,
; and clears bit 6 of +5. Seen: +10/+9 went from $050B (LOCAL) to $0910, +8
; from $15 to $25 and +5 from $E0 to $A0.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 13 times in 13 of them, run by major
; percival ffoulkes. Every one of its 9 instructions was executed
; (tools/experiments/insn_coverage.py).
;
; Output:F NZ; the policeman knocked out
c$F1A8 DEFB $00,$00   ; Action record header: flags $00; byte 1 $00
 $F1AA LD HL,$6D5D    ; Point HL at the message "YOU KNOCKS THE POLICE MAN
                      ; UNCONSCIOUS FROM... (#R$6D5D)
 $F1AD LD DE,$0910    ; Load DE with $0910
 $F1B0 LD B,$20       ; Load B with $20
; This entry point is used by the routine at #R$ED39.
*$F1B2 LD A,$0B       ; Load A with $0B
 $F1B4 CALL $F1C1     ; Call the routine "Set a thing's state word and state
                      ; bits" (#R$F1C1)
 $F1B7 RES 6,(IX+$05) ; Clear bit 6 of byte +5 of the record at IX
 $F1BB CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $F1BE OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller
 $F1C0 RET            ; Return to the caller

; Set a thing's state word and state bits
;
; Thing A's +9/+10 = DE (a dictionary word shown with it, such as SLEEPING, or
; 0) and the high nibble of +8 = B. Read from the code.
;
;  Input:A A thing number
;        DE The state word (0 for none)
;        B The high nibble for +8
; Output:IX The thing's record
;        F NZ
c$F1C1 CALL $D237    ; IX = thing A's record
 $F1C4 LD (IX+$09),E ; Store E in byte +9 of the record at IX - Its state word
                     ; (+9/+10) = DE
 $F1C7 LD (IX+$0A),D ; Store D in byte +10 of the record at IX
 $F1CA LD A,(IX+$08) ; Read byte +8 of the record at IX into A - +8: keep the
                     ; low nibble, replace the high nibble with B
 $F1CD AND $0F       ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $F1CF OR B          ; Set in A the bits that are set in B
 $F1D0 LD (IX+$08),A ; Store A in byte +8 of the record at IX
 $F1D3 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Succeed
 $F1D5 RET           ; Return to the caller

; Verb 136 (scripts only): is it hour n?
;
; n counts 1-24. Succeeds only when the clock shows that hour: 13-24 are the pm
; hours, 1-12 the am ones. Confirmed in the emulator (see the Trivia entry on
; appointments).
; .
; Used by: internal verb #R$F1D6(136) (IS HOUR: is the clock's hour (1-24) the
; direct object?).
;
;  Input:$A034 The hour, 1 to 24
; Output:F NZ if the clock shows it; otherwise $DC15
c$F1D6 DEFB $07,$00  ; Action record header: flags $07; byte 1 $00
 $F1D8 LD A,($A034)  ; n
 $F1DB LD B,$61      ; 'a'...
 $F1DD CP $0D        ; Compare A with $0D - ...unless n is 13 or more:
 $F1DF JR C,$F1E5    ; If A is below $0D, skip ahead to #R$F1E5
 $F1E1 LD B,$70      ; 'p'
 $F1E3 SUB $0C       ; and 12 less
*$F1E5 LD HL,$9FE0   ; Point HL at the hour, 1-12 (#R$9FE0) - Is that the hour?
 $F1E8 CP (HL)       ; Compare A with the byte at the hour, 1-12 (#R$9FE0)
 $F1E9 JP NZ,$DC15   ; No: refuse
 $F1EC LD A,($9FE2)  ; Read 'a' or 'p' (#R$9FE2) into A - And is it 'a' or 'p'
                     ; as wanted?
 $F1EF CP B          ; Compare A with B
 $F1F0 JP NZ,$DC15   ; No: refuse
 $F1F3 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Yes: succeed
