; Test the verb record's flags against the indirect-object slot
;
; Z if bit 2 of #R$A01A($A01D) is clear; otherwise NZ if the indirect-object
; slot has words (bit 0 of #R$B16D($B16E)) or bit 1 of #R$A01A($A01D) is clear,
; Z if not. Read from the code; what the two flag bits mean was not traced.
; .
; Instruction coverage over the 15 stored routes (9 November,
; tools/experiments/insn_coverage.py): 6 of 12 instructions executed; #R$B393
; #R$B395 #R$B397 #R$B399 #R$B39A #R$B39B never ran there and are read from the
; code only.
;
;  Input:$A01D The verb's flags
; Output:F Z if nothing is needed or none is missing; NZ if the slot has words
; .        or one is missing
c$B387 LD A,($A01D)  ; Read #R$A01A($A01D) in "Game variables" into A - Does
                     ; the verb take an indirect object (#R$A01A($A01D) bit 2)?
                     ; If not: Z, nothing to check
 $B38A BIT 2,A       ; Test bit 2 of A
 $B38C RET Z         ; If bit 2 of A is clear, return
 $B38D LD HL,$B16E   ; Point HL at #R$B16D($B16E) in "Parser variables" - The
                     ; slot has a noun phrase (#R$B16D($B16E) bit 0): NZ
 $B390 BIT 0,(HL)    ; Test bit 0 of the byte at #R$B16D($B16E) in "Parser
                     ; variables"
 $B392 RET NZ        ; If bit 0 of the byte at #R$B16D($B16E) in "Parser
                     ; variables" is set, return
 $B393 BIT 1,A       ; Test bit 1 of A - None typed: the verb can do without
                     ; (#R$A01A($A01D) bit 1)? Z, fine
 $B395 JR NZ,$B39A   ; If bit 1 of A is set, skip ahead to #R$B39A
 $B397 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Otherwise NZ: one is missing
 $B399 RET           ; Return to the caller
*$B39A XOR A         ; Set A to zero, which sets the zero flag for the caller
 $B39B RET           ; Return to the caller

; $B39D: bit 7 of the verb's first word reference
;
; Addresses named in the title: #R$B39D.
b$B39C DEFB $00      ; Flag

; Look the typed verb up in the verb table ($8259)
;
; Addresses named in the title: #R$8259.
; .
; Takes the verb's two word references from IY (bit 7 of the first kept in
; #R$B39C), clears and fills a match pattern at #R$B185($B186)-#R$B18D
; (#R$B483), then walks the 8-byte verb records from #R$8259 comparing each
; (#R$A4CD) until one matches - then #R$B405 and NZ - or the zero record that
; ends the table (Z). Read from the code.
; .
; How it works:
; .
; 1. Take the verb's word reference from the parse node. Bit 7 of it says ALL
; was typed with the verb; keep that in #R$B39C and clear it.
; .
; 2. Build the pattern to match at #R$B185($B186)-#R$B18D: the verb word, the
; particle at node +2 (CLOSELY, FURIOUSLY, a direction), and up to two more
; words from the node's other slots (#R$B483).
; .
; 3. Walk the eight-byte verb records from #R$8259, comparing each with the
; pattern (#R$A4CD).
; .
; 4. On a match, fill the object slots (#R$B405) and return NZ. If the zero
; record that ends the table is reached, return Z.
;
;  Input:IY The parse node
; Output:F NZ if a verb record matched, Z if none did
c$B39D PUSH IY       ; Save IY on the stack
 $B39F LD L,(IY+$00) ; Read the first byte of the record at IY into L - The
                     ; verb word, from the node's +0
 $B3A2 LD H,(IY+$01) ; Read byte +1 of the record at IY into H
 $B3A5 LD A,H        ; Copy H into A - Its bit 7 (ALL was typed with it) goes
                     ; to #R$B39C
 $B3A6 AND $80       ; Isolate bit 7 of A (mask $80)
 $B3A8 LD ($B39C),A  ; Store A in "#R$B39D: bit 7 of the verb's first word
                     ; reference" (#R$B39C)
 $B3AB RES 7,H       ; Clear bit 7 of H
 $B3AD LD ($B186),HL ; Pattern word 1 (#R$B185($B186))
 $B3B0 LD L,(IY+$02) ; Read byte +2 of the record at IY into L - The node's +2
                     ; (CLOSELY, FURIOUSLY, GO...) is pattern word 4
                     ; (#R$B185($B18C))
 $B3B3 LD H,(IY+$03) ; Read byte +3 of the record at IY into H
 $B3B6 LD ($B18C),HL ; Store HL in #R$B185($B18C) in "Parser variables"
 $B3B9 LD HL,$B188   ; Point HL at #R$B185($B188) in "Parser variables" - Clear
                     ; pattern words 2 and 3 (#R$B185($B188), #R$B185($B18A))
 $B3BC PUSH HL       ; Save HL on the stack
 $B3BD LD B,$04      ; Load B with $04
 $B3BF CALL $A2AB    ; Call the routine "Fill B bytes at HL with zero (or, from
                     ; #R$A2AC, with A)" (#R$A2AB)
 $B3C2 POP HL        ; Restore HL from the stack
 $B3C3 LD B,$02      ; Load B with $02 - Fill them with the first two of the
                     ; node's words at +4, +14, +6 and +16 that are there
                     ; (#R$B483)
 $B3C5 LD E,$04      ; Load E with $04
 $B3C7 CALL $B483    ; Call the routine "Copy the word pair at IY + E to HL, if
                     ; B is not 0" (#R$B483)
 $B3CA LD E,$0E      ; Load E with $0E
 $B3CC CALL $B483    ; Call the routine "Copy the word pair at IY + E to HL, if
                     ; B is not 0" (#R$B483)
 $B3CF LD E,$06      ; Load E with $06
 $B3D1 CALL $B483    ; Call the routine "Copy the word pair at IY + E to HL, if
                     ; B is not 0" (#R$B483)
 $B3D4 LD E,$10      ; Load E with $10
 $B3D6 CALL $B483    ; Call the routine "Copy the word pair at IY + E to HL, if
                     ; B is not 0" (#R$B483)
 $B3D9 XOR A         ; Clear A to zero (and the carry flag) - #R$A02A($A02E) =
                     ; 0
 $B3DA LD ($A02E),A  ; Store A in #R$A02A($A02E) in "Game variables"
 $B3DD LD HL,$B186   ; Point HL at #R$B185($B186) in "Parser variables" - Try
                     ; each 8-byte verb record from #R$8259
 $B3E0 LD DE,$0008   ; Load DE with $0008
 $B3E3 LD IX,$8259   ; Point IX at "Verb patterns: the verb number is the
                     ; position in..." (#R$8259)
*$B3E7 PUSH IX       ; Save IX on the stack
 $B3E9 POP IY        ; Restore IY from the stack
 $B3EB CALL $A4CD    ; Call the routine "Do the pattern words at IY name the
                     ; words at HL?..." (#R$A4CD) - Does it match the pattern
                     ; (#R$A4CD)?
 $B3EE JR Z,$B3FD    ; If the zero flag is set, skip ahead to #R$B3FD
 $B3F0 ADD IX,DE     ; Add DE to IX - No: next record, until the zero one at
                     ; the end
 $B3F2 LD A,(IX+$01) ; Read byte +1 of the record at IX into A
 $B3F5 OR (IX+$00)   ; Set in A the bits that are set in the first byte of the
                     ; record at IX
 $B3F8 JR NZ,$B3E7   ; If the result is not zero, go back to #R$B3E7
 $B3FA POP IY        ; Restore IY from the stack - None matched: Z
 $B3FC RET           ; Return to the caller
*$B3FD POP IY        ; Restore IY from the stack - Matched: fill the object
                     ; slots (#R$B405) and return NZ
 $B3FF CALL $B405    ; Call the routine "Copy the typed objects into the two
                     ; object slots, in..." (#R$B405)
 $B402 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller
 $B404 RET           ; Return to the caller

; Copy the typed objects into the two object slots, in the verb's order
;
; Once a verb record has matched (#R$B39D): works out from the record (#R$A2BD,
; #R$A01A($A01D)/#R$A01A($A01E)) and the preposition typed whether the parse
; node's first or second group of words is the direct object, notes the order
; at #R$B17D($B182), and copies six bytes of words from the node into the
; direct-object slot #R$B16D($B172) and the indirect-object slot
; #R$B175($B178), setting bit 0 of #R$B16D/#R$B16D($B16E) when a slot is not
; empty. Read from the code.
; .
; Traced in the emulator 2026-11-08 (breakpoint at #R$B451). TAKE LAMP: no
; preposition, #R$A01A($A01E) = $40, BC = $0812 - the direct object from the
; node's first group (+8), the indirect from the second (+18). GIVE WATSON
; LAMP: no preposition, #R$A01A($A01E) = $61 (bit 5 set), BC = $1208 - the
; other way round, and the game says 'You give the oil lamp to Watson.' GIVE
; LAMP TO WATSON: TO matches the node's first group's preposition (+14),
; #R$A01A($A01D) = $0C, bit 5 flipped, BC = $0812. TALK TO WATSON: TO typed
; (#R$B185($B188)) but not attached to a group, so #R$A01A($A01D)'s bit 5 ($28)
; is used as it is: $0812.
; .
; How it works:
; .
; 1. If the pattern matched with its middle words swapped (A = 1), swap the two
; prepositions at #R$B185($B188) and #R$B185($B18A).
; .
; 2. Gather the verb's flags (#R$A2BD).
; .
; 3. With no preposition typed, bit 5 of #R$A01A($A01E) decides the order of
; the two noun phrases (GIVE WATSON LAMP).
; .
; 4. Otherwise see which of the node's two groups the preposition belongs to
; (+14 or +16) and put each group in the matching slot.
;
;  Input:A 1 if the pattern matched with its middle words swapped, 0 if not
;        IY The parse node
; Output:The two object slots filled in the verb's order
c$B405 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry) - A = 1: the verb record matched with its middle
                     ; words swapped (#R$A4CD); swap #R$B185($B188) and
                     ; #R$B185($B18A) to suit
 $B406 JR Z,$B416    ; If A is zero, skip ahead to #R$B416
 $B408 LD HL,($B188) ; Read #R$B185($B188) in "Parser variables" into HL
 $B40B LD DE,($B18A) ; Read #R$B185($B18A) in "Parser variables" into DE
 $B40F LD ($B188),DE ; Store DE in #R$B185($B188) in "Parser variables"
 $B413 LD ($B18A),HL ; Store HL in #R$B185($B18A) in "Parser variables"
*$B416 CALL $A2BD    ; Gather the verb's flags (#R$A01A($A01D), #R$A01A($A01E))
 $B419 LD HL,$B188   ; Point HL at #R$B185($B188) in "Parser variables" - No
                     ; preposition typed (#R$B185($B188) = 0)?
 $B41C LD A,(HL)     ; Read the byte at #R$B185($B188) in "Parser variables"
                     ; into A
 $B41D INC HL        ; Step HL on to the next byte
 $B41E OR (HL)       ; Set in A the bits that are set in the byte HL points at
 $B41F JR NZ,$B426   ; If the result is not zero, skip ahead to #R$B426
 $B421 LD A,($A01E)  ; Read #R$A01A($A01E) in "Game variables" into A - Then
                     ; #R$A01A($A01E) bit 5, flipped, picks the order (GIVE
                     ; WATSON LAMP)
 $B424 JR $B445      ; Skip ahead to #R$B445
*$B426 DEC HL        ; Step HL back one byte - Is it the preposition of the
                     ; node's first group (+14)...
 $B427 LD A,(HL)     ; Read the byte HL points at into A
 $B428 CP (IY+$0E)   ; Compare A with byte +14 of the record at IY
 $B42B JR NZ,$B435   ; If A differs from byte +14 of the record at IY, skip
                     ; ahead to #R$B435
 $B42D INC HL        ; Step HL on to the next byte
 $B42E LD A,(HL)     ; Read the byte HL points at into A
 $B42F CP (IY+$0F)   ; Compare A with byte +15 of the record at IY
 $B432 JR Z,$B440    ; If A equals byte +15 of the record at IY, skip ahead to
                     ; #R$B440
 $B434 DEC HL        ; Step HL back one byte
*$B435 LD A,(HL)     ; Read the byte HL points at into A - ...or of its second
                     ; (+16)?
 $B436 CP (IY+$10)   ; Compare A with byte +16 of the record at IY
 $B439 JR NZ,$B440   ; If A differs from byte +16 of the record at IY, skip
                     ; ahead to #R$B440
 $B43B INC HL        ; Step HL on to the next byte
 $B43C LD A,(HL)     ; Read the byte HL points at into A
 $B43D CP (IY+$11)   ; Compare A with byte +17 of the record at IY
*$B440 LD A,($A01D)  ; Read #R$A01A($A01D) in "Game variables" into A -
                     ; #R$A01A($A01D) bit 5 - flipped if so - picks the order
 $B443 JR NZ,$B447   ; If A differs from byte +17 of the record at IY, skip
                     ; ahead to #R$B447
*$B445 XOR $20       ; Flip in A the bits that are set in $20
*$B447 BIT 5,A       ; Test bit 5 of A - Bit 5 set: B = 8 (the direct object is
                     ; the first group), C = 18
 $B449 LD BC,$1208   ; Load BC with $1208
 $B44C JR Z,$B451    ; If bit 5 of A is clear, skip ahead to #R$B451
 $B44E LD BC,$0812   ; Clear: the other way round
*$B451 LD HL,$B182   ; Point HL at #R$B17D($B182) in "Parser variables" - Note
                     ; the order at #R$B17D($B182)
 $B454 LD (HL),B     ; Store B at the address HL points to
 $B455 INC HL        ; Step HL on to the next byte
 $B456 LD (HL),C     ; Store C at the address HL points to
 $B457 LD A,B        ; Copy B into A - Copy the direct object's six bytes into
                     ; #R$B16D($B172) (count at #R$B16D)
 $B458 LD DE,$B172   ; Point DE at #R$B16D($B172) in "Parser variables"
 $B45B LD HL,$B16D   ; Point HL at "Parser variables" (#R$B16D)
 $B45E CALL $B468    ; Call #R$B468 (inside "Copy the typed objects into the
                     ; two object...")
 $B461 LD A,C        ; Copy C into A - and the indirect object's into
                     ; #R$B175($B178) (#R$B16D($B16E))
 $B462 LD DE,$B178   ; Point DE at #R$B175($B178) in "Parser variables"
 $B465 LD HL,$B16E   ; Point HL at #R$B16D($B16E) in "Parser variables"
*$B468 PUSH BC       ; Save BC on the stack - HL = the node + the offset; copy
                     ; six bytes
 $B469 LD C,A        ; Copy A into C
 $B46A LD B,$00      ; Load B with $00
 $B46C PUSH HL       ; Save HL on the stack
 $B46D PUSH IY       ; Save IY on the stack
 $B46F POP HL        ; Restore HL from the stack
 $B470 ADD HL,BC     ; Add BC to HL
 $B471 LD BC,$0006   ; Load BC with $0006
 $B474 LDIR          ; Copy BC bytes from where HL points to where DE points,
                     ; counting up
 $B476 XOR A         ; Clear A to zero (and the carry flag) - Any of them
                     ; non-zero?
 $B477 LD B,$06      ; Load B with $06
*$B479 DEC HL        ; Step HL back one byte
 $B47A OR (HL)       ; Set in A the bits that are set in the byte HL points at
 $B47B DJNZ $B479    ; Count B down and, while it is not zero, go back to
                     ; #R$B479
 $B47D POP HL        ; Restore HL from the stack
 $B47E POP BC        ; Restore BC from the stack
 $B47F RET Z         ; If the zero flag is set, return
 $B480 SET 0,(HL)    ; Set bit 0 of the byte HL points at - Then the slot is
                     ; used: set bit 0 of its count
 $B482 RET           ; Return to the caller

; Copy the word pair at IY + E to HL, if B is not 0
;
; B counts down when the pair is not empty; HL moves on two. Used by #R$B39D to
; build its match pattern. Read from the code.
;
;  Input:HL Where to copy to
;        IY A node
;        E The offset of the word pair
;        B The number of pairs still wanted
; Output:F Z if the pair was empty or B was 0
;        B One fewer if the pair was not empty
;        HL Moved on two bytes if copied
c$B483 XOR A         ; Clear A to zero (and the carry flag) - B = 0: nothing to
                     ; copy
 $B484 CP B          ; Compare A with B
 $B485 RET Z         ; If A equals B, return
 $B486 LD D,$00      ; Load D with $00 - Word pair at IY + E...
 $B488 PUSH IY       ; Save IY on the stack
 $B48A ADD IY,DE     ; Add DE to IY
 $B48C LD A,(IY+$00) ; Read the first byte of the record at IY into A -
                     ; ...copied to HL, HL+1
 $B48F LD (HL),A     ; Store A at the address HL points to
 $B490 INC HL        ; Step HL on to the next byte
 $B491 LD A,(IY+$01) ; Read byte +1 of the record at IY into A
 $B494 LD (HL),A     ; Store A at the address HL points to
 $B495 DEC HL        ; Step HL back one byte
 $B496 OR (IY+$00)   ; Set in A the bits that are set in the first byte of the
                     ; record at IY - Z if the pair was empty
 $B499 POP IY        ; Restore IY from the stack
 $B49B RET Z         ; An empty one is not counted
 $B49C DEC B         ; Subtract one from B - Count down B; HL on to the next
                     ; pair
 $B49D INC HL        ; Step HL on to the next byte
 $B49E INC HL        ; Step HL on to the next byte
 $B49F RET           ; Return to the caller

; Call the search routine in IY
;
; #R$D36A for things or #R$D39B for rooms, chosen by the slot's requirement
; code (#R$B4E2, #R$B589).
;
;  Input:HL The slot's words
;        IY The search routine ($D36A or $D39B)
; Output:A The thing or room, or $FF
;        IX The search position
c$B4A0 JP (IY)       ; Jump to the address in IY

; $B4C1: $FF until the number in the direct-object slot has been used
;
; Addresses named in the title: #R$B4C1.
b$B4A2 DEFB $00      ; Flag

; The direct object is a number: use it once
;
; The first time (#R$B4A2 still $FF), if the direct-object slot holds a number
; (bit 7 of #R$B16D($B173)), #R$A032($A034) = $FE and the number goes to
; #R$A02A($A02F); after that, or if there is no number, A = $FF: no more
; candidates. Reached from #R$B4C1 when the requirement code is 5. Read from
; the code.
;
; Output:F NZ with $A034 = $FE and $A02F the number the first time; Z otherwise
;        A $FF if there is nothing to search
c$B4A3 LD A,($B4A2)  ; Read "#R$B4C1: $FF until the number in the
                     ; direct-object..." (#R$B4A2) into A - #R$B4A2 = $FF means
                     ; the number has not been used yet; anything else: go on
                     ; to the thing search (#R$B4CF)
 $B4A6 INC A         ; Add one to A
 $B4A7 JR NZ,$B4CF   ; If A is not zero, skip ahead to #R$B4CF
 $B4A9 LD ($B4A2),A  ; Used now (#R$B4A2 = 0)
 $B4AC LD A,($B173)  ; Read #R$B16D($B173) in "Parser variables" into A - The
                     ; slot's first word (#R$B16D($B173)): bit 7 set means a
                     ; number
 $B4AF BIT 7,A       ; Test bit 7 of A
 $B4B1 JR Z,$B4CF    ; If bit 7 of A is clear, skip ahead to #R$B4CF
 $B4B3 LD A,$FE      ; Load A with $FE - The direct object is $FE: a number...
 $B4B5 LD ($A034),A  ; Store A in #R$A032($A034) in "Game variables"
 $B4B8 LD HL,($B172) ; Read #R$B16D($B172) in "Parser variables" into HL -
                     ; ...with its value, from the word at #R$B16D($B172), in
                     ; #R$A02A($A02F)
 $B4BB LD ($A02F),HL ; Store HL in #R$A02A($A02F) in "Game variables"
 $B4BE OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - NZ: a candidate
 $B4C0 RET           ; Return to the caller

; The next candidate for the direct object ($A034)
;
; Addresses named in the title: #R$A032($A034).
; .
; Requirement code 5 (#R$A00A($A00F)) means a number: the first time, if the
; slot holds one (bit 7 of #R$B16D($B173)), #R$A032($A034) = $FE and the number
; goes to #R$A02A($A02F). Otherwise searches rooms (codes below 5, #R$D39B) or
; things (#R$D36A) for the next one the slot's words name, continuing from
; #R$B17D($B17E). A = $FF when there are no more. Read from the code.
; .
; How it works:
; .
; 1. If the requirement code (#R$A00A($A00F)) is 5, the candidate is a number:
; use it once (#R$B4A3).
; .
; 2. If the slot's first word has bit 7 set, there is nothing to search: return
; $FF.
; .
; 3. Otherwise search the rooms (#R$D39B, for codes below 5) or the things
; (#R$D36A) from the saved position (#R$B17D($B17E)), skipping those the BUT
; list rejects (#R$B517), and save the new position.
;
; Output:A The next candidate for the direct object ($A034); $FF if none
;        F Z when none
;        IX Saved at $B17E
c$B4C1 LD A,($A00F)  ; Read #R$A00A($A00F) in "Game variables" into A - Direct
                     ; object a number (requirement code 5)?
 $B4C4 CP $05        ; Compare A with $05
 $B4C6 JR Z,$B4A3    ; Yes: the number case at #R$B4A3
 $B4C8 LD A,($B173)  ; Read #R$B16D($B173) in "Parser variables" into A - First
                     ; word of the direct-object slot has bit 7 set?
 $B4CB BIT 7,A       ; Test bit 7 of A
 $B4CD JR Z,$B4D4    ; No: search for things
; This entry point is used by the routine at #R$B4A3.
*$B4CF LD A,$FF      ; Load A with $FF - Yes: nothing to search, return A = $FF
 $B4D1 CP $FF        ; Compare A with $FF
 $B4D3 RET           ; Return to the caller
*$B4D4 PUSH IY       ; Save IY on the stack - Save IY; IX = the search position
                     ; (#R$B17D($B17E))
 $B4D6 LD IX,($B17E) ; Read #R$B17D($B17E) in "Parser variables" into IX
 $B4DA LD A,($A01D)  ; Read #R$A01A($A01D) in "Game variables" into A - Verb
                     ; flag #R$A01A($A01D) bit 0 (the object need not be here)
                     ; into #R$A032($A038)
 $B4DD AND $01       ; Isolate bit 0 of A (mask $01)
 $B4DF LD ($A038),A  ; Store A in #R$A032($A038) in "Game variables"
 $B4E2 LD A,($A00F)  ; Read #R$A00A($A00F) in "Game variables" into A -
                     ; Requirement code below 5: search rooms (#R$D39B),
                     ; otherwise things (#R$D36A)
 $B4E5 CP $05        ; Compare A with $05
 $B4E7 LD IY,$D39B   ; Point IY at "Find the next room that matches a word slot
                     ; of..." (#R$D39B) - IY = the room search, or...
 $B4EB JR C,$B4F1    ; If A is below $05, skip ahead to #R$B4F1
 $B4ED LD IY,$D36A   ; ...the thing search - IY is no longer the parse node,
                     ; which #R$B517 still assumes (the ALL BUT bug)
*$B4F1 CALL $B4FD    ; Call the routine "Next thing or room the direct-object
                     ; slot names,..." (#R$B4FD) - Run the search for the next
                     ; match (#R$B4FD)
 $B4F4 CP $FF        ; Compare A with $FF
 $B4F6 LD ($B17E),IX ; Store IX in #R$B17D($B17E) in "Parser variables" - Save
                     ; the new position; Z/NZ: found something or not
 $B4FA POP IY        ; Restore IY from the stack
 $B4FC RET           ; Return

; Next thing or room the direct-object slot names, skipping those $B517 rejects
;
; Addresses named in the title: #R$B517.
; .
; Sets bit 1 of #R$B16D when one is found. Read from the code.
;
; Output:A The next thing or room, $FF if none
;        F Z when none
;        $A034 The candidate
;        $B16D bit 1 set when found
c$B4FD LD HL,$B172   ; Point HL at #R$B16D($B172) in "Parser variables" - Next
                     ; thing or room named by the direct-object slot
                     ; (#R$B16D($B172), via #R$B4A0)
 $B500 CALL $B4A0    ; Call the routine "Call the search routine in IY"
                     ; (#R$B4A0)
 $B503 CP $FF        ; Compare A with $FF - None left ($FF): return Z
 $B505 RET Z         ; If A equals $FF, return
 $B506 LD ($A034),A  ; It becomes the direct object (#R$A032($A034))
 $B509 CALL $B517    ; Call the routine "ALL BUT: is the candidate one of the
                     ; things after BUT?" (#R$B517) - Does the verb's check
                     ; reject it? (#R$B517) Then try the next
 $B50C JR NZ,$B4FD   ; If the zero flag is clear, go back to the routine "Next
                     ; thing or room the direct-object slot names,..."
                     ; (#R$B4FD)
 $B50E LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A -
                     ; Accepted: A = it, and #R$B16D bit 1 notes that something
                     ; was found
 $B511 LD HL,$B16D   ; Point HL at "Parser variables" (#R$B16D)
 $B514 SET 1,(HL)    ; Set bit 1 of the byte at "Parser variables" (#R$B16D)
 $B516 RET           ; Return to the caller

; ALL BUT: is the candidate one of the things after BUT?
;
; Only when #R$A01A($A01C) is set (bit 7 of the verb's first word reference,
; copied from #R$B39C at #R$B1EC($B1ED)): walks the parse nodes after IY
; (#R$AEA9) and, in any marked with bit 6 of +1 - the node #R$B029 opens when
; BUT (or EXCEPT, a synonym) follows ALL - looks for things the words at +8
; name (#R$D36A); NZ if the candidate in #R$A032($A034) is one of them, and
; #R$B4FD then passes over it.
; .
; It does not work in practice: in the emulator, with #R$A01A = 2 (ALL BUT) and
; #R$A01A($A01C) = $80 both set, TAKE ALL BUT MONEY, DROP ALL BUT MONEY, GET
; ALL BUT MONEY and TAKE ALL EXCEPT DISGUISE all included the thing named after
; BUT, because IY here is not a parse node at all but the search routine's
; address (#R$D36A), loaded by #R$B4C1 - see the Bugs page.
;
;  Input:$A034 The candidate
; Output:F NZ if the candidate is one of the BUT things; Z if not
;        Registers kept
c$B517 LD A,($A01C)   ; Read #R$A01A($A01C) in "Game variables" into A - Only
                      ; for verbs whose first word has bit 7 (#R$A01A($A01C))
 $B51A AND A          ; Clear the carry flag for the caller (A is unchanged)
 $B51B RET Z          ; If A is zero, return
 $B51C PUSH IY        ; Save IY on the stack
 $B51E PUSH DE        ; Save DE on the stack
 $B51F PUSH IX        ; Save IX on the stack
*$B521 CALL $AEA9     ; IY = the next parse node - but IY is #R$D36A here, not
                      ; a node (see the Bugs page)
 $B524 BIT 6,(IY+$01) ; Test bit 6 of the holder byte (+1) of the thing record
                      ; at IY - A BUT node (bit 6 of +1)?
 $B528 JR Z,$B543     ; If bit 6 of the holder byte (+1) of the thing record at
                      ; IY is clear, skip ahead to #R$B543
 $B52A CALL $D04F     ; Call the routine "IX = just before the start of the
                      ; thing index (#R$8B6F)" (#R$D04F) - Then each thing its
                      ; words (+8) name (#R$D36A)...
*$B52D PUSH IY        ; Save IY on the stack
 $B52F POP HL         ; Restore HL from the stack
 $B530 LD DE,$0008    ; Load DE with $0008, the amount that is added next
 $B533 ADD HL,DE      ; Add DE to HL
 $B534 CALL $D36A     ; Call the routine "Find the next thing that matches a
                      ; word slot of the..." (#R$D36A)
 $B537 CP $FF         ; Compare A with $FF
 $B539 JR Z,$B521     ; If A equals $FF, go back to #R$B521
 $B53B LD HL,$A034    ; Point HL at #R$A032($A034) in "Game variables" - ...is
                      ; it the candidate?
 $B53E CP (HL)        ; Compare A with the byte at #R$A032($A034) in "Game
                      ; variables"
 $B53F JR NZ,$B52D    ; If A differs from the byte at #R$A032($A034) in "Game
                      ; variables", go back to #R$B52D
 $B541 OR $01         ; Set bit 0 of A - NZ: yes, leave it out
*$B543 POP IX         ; Restore IX from the stack
 $B545 POP DE         ; Restore DE from the stack
 $B546 POP IY         ; Restore IY from the stack
 $B548 RET            ; Return to the caller

; $B568: $FF until the number in the indirect-object slot has been used
;
; Addresses named in the title: #R$B568.
b$B549 DEFB $00      ; Flag

; The indirect object is a number: use it once
;
; As #R$B4A3, for the second slot (#R$B549, #R$B175($B179), #R$A032($A035),
; #R$A02A($A031)).
;
; Output:F NZ with $A035 = $FE and $A031 the number the first time
;        A $FF if there is nothing to search
c$B54A LD A,($B549)  ; Read "#R$B568: $FF until the number in the..." (#R$B549)
                     ; into A - The same for the indirect object: #R$B549 = $FF
                     ; means the number is unused; otherwise the thing search
                     ; (#R$B576)
 $B54D INC A         ; Add one to A
 $B54E JR NZ,$B576   ; If A is not zero, skip ahead to #R$B576
 $B550 LD ($B549),A  ; Used now
 $B553 LD A,($B179)  ; Read #R$B175($B179) in "Parser variables" into A - The
                     ; slot's first word (#R$B175($B179)): bit 7 set means a
                     ; number
 $B556 BIT 7,A       ; Test bit 7 of A
 $B558 JR Z,$B576    ; If bit 7 of A is clear, skip ahead to #R$B576
 $B55A LD A,$FE      ; Load A with $FE - The indirect object is $FE: a
                     ; number...
 $B55C LD ($A035),A  ; Store A in #R$A032($A035) in "Game variables"
 $B55F LD HL,($B178) ; Read #R$B175($B178) in "Parser variables" into HL -
                     ; ...with its value, from #R$B175($B178), in
                     ; #R$A02A($A031)
 $B562 LD ($A031),HL ; Store HL in #R$A02A($A031) in "Game variables"
 $B565 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - NZ: a candidate
 $B567 RET           ; Return to the caller

; The next candidate for the indirect object ($A035)
;
; Addresses named in the title: #R$A032($A035).
; .
; As #R$B4C1, for the second slot (#R$B175($B178), #R$B17D($B180),
; #R$A02A($A031), and #R$A00A($A010)'s requirement code).
;
; Output:A The next candidate for the indirect object ($A035); $FF if none
;        F Z when none
;        IX Saved at $B180
c$B568 LD A,($A010)  ; Read #R$A00A($A010) in "Game variables" into A -
                     ; Requirement code 5 (a number): the number is the only
                     ; candidate
 $B56B CP $05        ; Compare A with $05
 $B56D JR Z,$B54A    ; If A equals $05, go back to the routine "The indirect
                     ; object is a number: use it once" (#R$B54A)
 $B56F LD A,($B179)  ; Read #R$B175($B179) in "Parser variables" into A - Bit 7
                     ; of the slot's word count set: no more candidates (A =
                     ; $FF)
 $B572 BIT 7,A       ; Test bit 7 of A
 $B574 JR Z,$B57B    ; If bit 7 of A is clear, skip ahead to #R$B57B
; This entry point is used by the routine at #R$B54A.
*$B576 LD A,$FF      ; Load A with $FF
 $B578 CP $FF        ; Compare A with $FF
 $B57A RET           ; Return to the caller
*$B57B PUSH IY       ; Save IY on the stack - IX = where the last search
                     ; stopped (#R$B17D($B180))
 $B57D LD IX,($B180) ; Read #R$B17D($B180) in "Parser variables" into IX
 $B581 LD A,($A01D)  ; Read #R$A01A($A01D) in "Game variables" into A - Need it
                     ; be here? (#R$A01A($A01D) bit 0 -> #R$A032($A038))
 $B584 AND $01       ; Isolate bit 0 of A (mask $01)
 $B586 LD ($A038),A  ; Store A in #R$A032($A038) in "Game variables"
 $B589 LD A,($A010)  ; Read #R$A00A($A010) in "Game variables" into A - Code
                     ; below 5 (a room): search the rooms (#R$D39B)...
 $B58C CP $05        ; Compare A with $05
 $B58E LD IY,$D39B   ; Point IY at "Find the next room that matches a word slot
                     ; of..." (#R$D39B)
 $B592 JR C,$B598    ; If A is below $05, skip ahead to #R$B598
 $B594 LD IY,$D36A   ; ...otherwise the things (#R$D36A)
*$B598 CALL $B5A4    ; Call the routine "Next thing or room the indirect-object
                     ; slot names" (#R$B5A4) - Next match; A = $FF if there is
                     ; none
 $B59B CP $FF        ; Compare A with $FF
 $B59D LD ($B180),IX ; Store IX in #R$B17D($B180) in "Parser variables" -
                     ; Remember where it stopped
 $B5A1 POP IY        ; Restore IY from the stack
 $B5A3 RET           ; Return to the caller

; Next thing or room the indirect-object slot names
;
; Sets bit 1 of #R$B16D($B16E) when one is found.
;
; Output:A The next thing or room, $FF if none
;        F Z when none
;        $A035 The candidate
;        $B16E bit 1 set when found
c$B5A4 LD HL,$B178   ; The indirect-object slot's words (#R$B175($B178))
 $B5A7 CALL $B4A0    ; Next thing or room they name (#R$B4A0)
 $B5AA CP $FF        ; Compare A with $FF - $FF: no more
 $B5AC RET Z         ; If A equals $FF, return
 $B5AD LD ($A035),A  ; Make it the indirect object (#R$A032($A035))
 $B5B0 LD HL,$B16E   ; Point HL at #R$B16D($B16E) in "Parser variables" - Mark
                     ; the slot as having a candidate (bit 1 of #R$B16D($B16E))
 $B5B3 SET 1,(HL)    ; Set bit 1 of the byte at #R$B16D($B16E) in "Parser
                     ; variables"
 $B5B5 RET           ; Return to the caller

; Move on to the next sentence of the typed line
;
; #R$A01A($A01B) = A; the sentence list #R$9FF0 becomes what was the rest of
; the line (#R$9FF2), and #R$9FF2 the rest after that, the link being cut. Read
; from the code.
;
;  Input:A The value for $A01B
; Output:$9FF0 The rest of the typed line as the current sentence
;        $9FF2 What follows it
;        IX The new sentence node
c$B5B6 LD ($A01B),A    ; Remember A in #R$A01A($A01B)
 $B5B9 LD IX,($9FF2)   ; Read #R$9FF2 in "Game variables" into IX - The rest of
                       ; the typed line (#R$9FF2) becomes the current sentence
                       ; (#R$9FF0)
 $B5BD LD ($9FF0),IX   ; Store IX in words the player has (#R$9FF0)
 $B5C1 LD L,(IX-$02)   ; Read byte -2 of the record at IX into L - Its link
                       ; (the two bytes before it) becomes the new rest
 $B5C4 LD H,(IX-$01)   ; Read byte -1 of the record at IX into H
 $B5C7 LD ($9FF2),HL   ; Store HL in #R$9FF2 in "Game variables"
 $B5CA LD (IX-$02),$00 ; Set byte -2 of the record at IX to $00 - Cut the
                       ; sentence's own link
 $B5CE LD (IX-$01),$00 ; Set byte -1 of the record at IX to $00
 $B5D2 RET             ; Return to the caller

; Ask the player which object, or what
;
; Prints one of the parser's questions, with the words of the player's own
; command as message parameters pushed on the stack: #R$6888 'WHICH <word> ?'
; (#R$B5F5), #R$6880 '<word> WHAT ?' (#R$B609) or #R$687C '<word> THE <word>
; WHAT ?' (#R$B628). #R$B65F and #R$B6AE print #R$6855 and #R$6894 instead in
; some cases (not rendered yet).
; .
; Self-modifying: #R$B62F loads $28 (the opcode of JR Z) and #R$B633 $20 (JR
; NZ); #R$B635 writes it over the jumps at #R$B649 and #R$B658, which decide
; whether the words in the saved verb pattern (#R$B18D($B18E), +2/+3 and +4/+5,
; with +7 bit 7 and bit 5 of the first word as flags) are included.
; .
; CORRECTED: the automatic split had parts of this as data; found because the
; message reference at #R$B628 landed in a data block.
; .
; .
; .
; Line comments added from reading the code; the quoted messages come from the
; existing notes on #R$6855-#R$6894, and the exact wording of the two variants
; at $05B3 and $05DB was not rendered.
;
;  Input:$B16D, $B16E Flags telling which slots hold words
; Output:A question printed ($A59F); the player's own words are the message
; .        parameters
c$B5D3 LD A,($B16E)   ; Read #R$B16D($B16E) in "Parser variables" into A -
                      ; Indirect-object slot holds words (bit 0 of
                      ; #R$B16D($B16E))?
 $B5D6 BIT 0,A        ; Test bit 0 of A
 $B5D8 JR Z,$B610     ; No: the 'THE ... WHAT ?' form at #R$B610
 $B5DA LD A,($B183)   ; Read #R$B17D($B183) in "Parser variables" into A - Yes:
                      ; A = the slot's count byte (#R$B17D($B183)), HL = the
                      ; slot (#R$B175($B178))
 $B5DD LD HL,$B178    ; Point HL at #R$B175($B178) in "Parser variables"
 $B5E0 JR $B5EF       ; Join the 'WHICH' question
 $B5E2 LD A,($B16D)   ; Read "Parser variables" (#R$B16D) into A - (Entry for
                      ; the direct object) same test on #R$B16D
 $B5E5 BIT 0,A        ; Test bit 0 of A
 $B5E7 JR Z,$B5FC     ; If bit 0 of A is clear, skip ahead to #R$B5FC
 $B5E9 LD A,($B182)   ; Read #R$B17D($B182) in "Parser variables" into A - A =
                      ; its count byte (#R$B17D($B182)), HL = #R$B16D($B172)
 $B5EC LD HL,$B172    ; Point HL at #R$B16D($B172) in "Parser variables"
*$B5EF CALL $B83C     ; Push the slot's three words as message parameters
                      ; (#R$B83C)
 $B5F2 CALL $B5B6     ; Move on to the next sentence of the typed line
                      ; (#R$B5B6)
 $B5F5 LD HL,$6888    ; Point HL at the message "WHICH ‹word› ?" (#R$6888) -
                      ; Print 'WHICH ... ?' (#R$6888)
 $B5F8 CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $B5FB RET            ; Return to the caller
*$B5FC CALL $B633     ; Direct object with no words: push the verb's words
                      ; (#R$B633)
 $B5FF LD HL,($B186)  ; Read #R$B185($B186) in "Parser variables" into HL -
                      ; ...and the saved (#R$B185($B186)) word
 $B602 PUSH HL        ; Save HL on the stack
 $B603 LD A,($B182)   ; Read #R$B17D($B182) in "Parser variables" into A
 $B606 CALL $B5B6     ; Next sentence
 $B609 LD HL,$6880    ; Point HL at the message "‹word› WHAT ?" (#R$6880) -
                      ; Print '<word> WHAT ?' (#R$6880)
 $B60C CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $B60F RET            ; Return to the caller
*$B610 CALL $B62F     ; Call #R$B62F (inside "Ask the player which object, or
                      ; what") - Neither slot: the full question: verb words
                      ; (#R$B62F)...
 $B613 LD HL,$0000    ; Load HL with $0000
 $B616 PUSH HL        ; Save HL on the stack
 $B617 LD HL,$B172    ; Point HL at #R$B16D($B172) in "Parser variables" -
                      ; ...the direct object's words (#R$B16D($B172))...
 $B61A PUSH HL        ; Save HL on the stack
 $B61B CALL $B633     ; Call #R$B633 (inside "Ask the player which object, or
                      ; what") - ...and (#R$B633) the verb again
 $B61E LD HL,($B186)  ; Read #R$B185($B186) in "Parser variables" into HL
 $B621 PUSH HL        ; Save HL on the stack
 $B622 LD A,($B183)   ; Read #R$B17D($B183) in "Parser variables" into A
 $B625 CALL $B5B6     ; Next sentence
 $B628 LD HL,$687C    ; Point HL at the message "‹word› THE ‹word› WHAT ?"
                      ; (#R$687C) - Print '<word> THE <word> WHAT ?' (#R$687C)
 $B62B CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $B62E RET            ; Return to the caller
; This entry point is used by the routines at #R$B6AE and #R$B6DA.
*$B62F LD A,$28       ; Load A with $28 - JR Z opcode...
 $B631 JR $B635       ; Skip ahead to #R$B635
; This entry point is used by the routine at #R$B6DA.
*$B633 LD A,$20       ; JR NZ opcode...
*$B635 LD ($B649),A   ; Store A in #R$B649 in "Ask the player which object, or
                      ; what" - ...written into the jumps below
                      ; (self-modifying)
 $B638 LD ($B658),A   ; Store A in #R$B658 in "Ask the player which object, or
                      ; what"
 $B63B LD IX,($B18E)  ; Read #R$B18D($B18E) in "Parser variables" into IX
 $B63F LD L,(IX+$04)  ; Read byte +4 of the record at IX into L
 $B642 LD H,(IX+$05)  ; Read byte +5 of the record at IX into H
 $B645 BIT 7,(IX+$07) ; Test bit 7 of byte +7 of the record at IX
 $B649 JR NZ,$B64E    ; If bit 7 of byte +7 of the record at IX is set, skip
                      ; ahead to #R$B64E - Modified by #R$B635
 $B64B LD HL,$0000    ; Load HL with $0000
*$B64E EX (SP),HL     ; Swap HL with the word on top of the stack
 $B64F PUSH HL        ; Save HL on the stack
 $B650 LD L,(IX+$02)  ; Read byte +2 of the record at IX into L
 $B653 LD H,(IX+$03)  ; Read byte +3 of the record at IX into H
 $B656 BIT 5,H        ; Test bit 5 of H
 $B658 JR NZ,$B65D    ; If bit 5 of H is set, skip ahead to #R$B65D - Modified
                      ; by #R$B635
 $B65A LD HL,$0000    ; Load HL with $0000
*$B65D EX (SP),HL     ; Swap HL with the word on top of the stack
 $B65E JP (HL)        ; Jump to the address in HL
 $B65F LD A,($A00F)   ; Read #R$A00A($A00F) in "Game variables" into A - (Entry
                      ; #R$B65F) requirement code 5 or 6 (a number) wants...
 $B662 CP $05         ; Compare A with $05
 $B664 JR Z,$B671     ; If A equals $05, skip ahead to #R$B671
 $B666 CP $06         ; Compare A with $06
 $B668 JR Z,$B671     ; If A equals $06, skip ahead to #R$B671
 $B66A LD A,($B173)   ; Read #R$B16D($B173) in "Parser variables" into A -
                      ; ...or the first word of the direct-object slot has bit
                      ; 7 set
 $B66D BIT 7,A        ; Test bit 7 of A
 $B66F JR Z,$B678     ; If bit 7 of A is clear, skip ahead to #R$B678
; This entry point is used by the routine at #R$B6AE.
*$B671 LD HL,$6855    ; Point HL at the message "DON'T BE SILLY." (#R$6855) -
                      ; Print #R$6855 ('DON'T BE SILLY.')
 $B674 CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $B677 RET            ; Return to the caller
*$B678 LD HL,$B16D    ; Point HL at "Parser variables" (#R$B16D) - Otherwise:
                      ; direct-object slot holds words?
 $B67B BIT 0,(HL)     ; Test bit 0 of the byte at "Parser variables" (#R$B16D)
 $B67D LD HL,$B172    ; Point HL at #R$B16D($B172) in "Parser variables"
 $B680 CALL NZ,$B6DA  ; Yes: count them (#R$B6DA)
 $B683 CALL $B633     ; Call #R$B633 (inside "Ask the player which object, or
                      ; what") - Push the verb's words (#R$B633)
 $B686 LD A,($B16D)   ; Read "Parser variables" (#R$B16D) into A
 $B689 LD HL,$B172    ; Point HL at #R$B16D($B172) in "Parser variables"
; This entry point is used by the routine at #R$B6AE.
*$B68C LD DE,($B186)  ; Read #R$B185($B186) in "Parser variables" into DE -
                      ; Push the saved word (#R$B185($B186))
 $B690 PUSH DE        ; Save DE on the stack
 $B691 BIT 0,A        ; Test bit 0 of A - Slot has words (bit 0)?
 $B693 JR Z,$B69D     ; If bit 0 of A is clear, skip ahead to #R$B69D
 $B695 CALL $B83C     ; Call the routine "Push the three words at HL as message
                      ; parameters" (#R$B83C) - Yes: push them (#R$B83C) and
                      ; use the message at $05B3
 $B698 LD HL,$05B3    ; Load HL with $05B3
 $B69B JR $B6A6       ; Skip ahead to #R$B6A6
*$B69D LD HL,$0000    ; Load HL with $0000 - No: three zero parameters and the
                      ; message at $05DB
 $B6A0 PUSH HL        ; Save HL on the stack
 $B6A1 PUSH HL        ; Save HL on the stack
 $B6A2 PUSH HL        ; Save HL on the stack
 $B6A3 LD HL,$05DB    ; Load HL with $05DB
*$B6A6 PUSH HL        ; Save HL on the stack
 $B6A7 LD HL,$6894    ; Point HL at the message "I SEE ‹word› THAT YOU CAN
                      ; ‹word›" (#R$6894) - Print #R$6894 with those parameters
 $B6AA CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $B6AD RET            ; Return to the caller

; No indirect object: DON'T BE SILLY, or YOU CANNOT ... THE ...
;
; The second-slot counterpart of #R$B65F, handed out by #R$B303. If the slot
; wants a number (requirement codes 5 and 6) or holds one, prints 'DON'T BE
; SILLY.' (#R$B671, #R$6855). Otherwise, if the slot has words, checks them
; against the room's scenery (#R$B6F0) and then asks the question at #R$B68C.
; Read from the code.
;
;  Input:$A010 The indirect object's requirement code
; Output:A message printed ($A59F)
c$B6AE LD A,($A010)  ; Read #R$A00A($A010) in "Game variables" into A -
                     ; Indirect object requirement 5 or 6 (a number): YOU
                     ; CANNOT ... (#R$B671)
 $B6B1 CP $05        ; Compare A with $05
 $B6B3 JR Z,$B671    ; If A equals $05, go back to #R$B671
 $B6B5 CP $06        ; Compare A with $06
 $B6B7 JR Z,$B671    ; If A equals $06, go back to #R$B671
 $B6B9 LD A,($B179)  ; Read #R$B175($B179) in "Parser variables" into A - The
                     ; indirect object slot's first word (#R$B175($B179)): bit
                     ; 7 set (a number): the same
 $B6BC BIT 7,A       ; Test bit 7 of A
 $B6BE JR NZ,$B671   ; If bit 7 of A is set, go back to #R$B671
 $B6C0 LD HL,$B16E   ; Point HL at #R$B16D($B16E) in "Parser variables" - Count
                     ; in #R$B16D($B16E): bit 0 set means a noun was typed
 $B6C3 BIT 0,(HL)    ; Test bit 0 of the byte at #R$B16D($B16E) in "Parser
                     ; variables"
 $B6C5 LD HL,$B178   ; Point HL at #R$B175($B178) in "Parser variables"
 $B6C8 CALL NZ,$B6F0 ; Then copy the name words at #R$B175($B178) for the
                     ; message (#R$B6F0)
 $B6CB CALL $B62F    ; Print the start of the message (#R$B62F)
 $B6CE LD A,($B16E)  ; Read #R$B16D($B16E) in "Parser variables" into A -
                     ; Finish it using the indirect slot
 $B6D1 LD HL,$B178   ; Point HL at #R$B175($B178) in "Parser variables"
 $B6D4 JR $B68C      ; Go back to #R$B68C

; $B6FD's working pointers
;
; Addresses named in the title: #R$B6FD.
; .
; Written and read by #R$B6FD-#R$B823($B825).
b$B6D6 DEFW $0000    ; Position in the scenery list
 $B6D8 DEFW $0000    ; The slot being matched

; If the slot names scenery: 'YOU CANNOT <verb> THE <word>'
;
; #R$B6DA for the first slot (verb pattern from #R$B633), #R$B6F0 for the
; second (#R$B62F): if #R$B6FD finds the words in the room's scenery, the
; caller's return address is dropped, the words are pushed as parameters
; (#R$B83C) and #R$68A2 is printed. Confirmed in the emulator, in Holmes's
; sitting room (whose description mentions 'the two broad windows'): TAKE
; WINDOWS gave 'YOU CANNOT TAKE THE WINDOW', EXAMINE WINDOWS 'YOU CANNOT
; EXAMINE THE WINDOW' and TAKE LAMP FROM WINDOWS 'YOU CANNOT TAKE FROM THE
; WINDOW', while TAKE ELEPHANT gave 'I DO NOT KNOW THE WORD"ELEPHANT "'.
;
;  Input:HL The slot's words
; Output:F Z if the words do not name scenery; otherwise YOU CANNOT ... THE ...
; .        is printed and the caller is abandoned (entry $B6F0 does the same
; .        for the second slot)
c$B6DA CALL $B6FD    ; Count the words in the slot (#R$B6FD)
 $B6DD RET Z         ; If the zero flag is set, return - None: return
 $B6DE POP DE        ; Restore DE from the stack
 $B6DF CALL $B83C    ; Push them as parameters (#R$B83C)
 $B6E2 CALL $B633    ; Push the verb's words (#R$B633)
*$B6E5 LD HL,($B186) ; Read #R$B185($B186) in "Parser variables" into HL - And
                     ; the saved word (#R$B185($B186))
 $B6E8 PUSH HL       ; Save HL on the stack
 $B6E9 LD HL,$68A2   ; Point HL at the message "YOU CANNOT ‹word› THE ‹word›"
                     ; (#R$68A2)
 $B6EC CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $B6EF RET           ; Return to the caller
; This entry point is used by the routine at #R$B6AE.
*$B6F0 CALL $B6FD    ; Call the routine "Do the slot's words name some of the
                     ; room's scenery?" (#R$B6FD)
 $B6F3 RET Z         ; If the zero flag is set, return
 $B6F4 POP DE        ; Restore DE from the stack
 $B6F5 CALL $B83C    ; Call the routine "Push the three words at HL as message
                     ; parameters" (#R$B83C)
 $B6F8 CALL $B62F    ; Call #R$B62F (inside "Ask the player which object, or
                     ; what")
 $B6FB JR $B6E5      ; Go back to #R$B6E5

; Do the slot's words name some of the room's scenery?
;
; The actor's room record (#R$D33C) has at +7/+8 the address of a list of
; scenery words - things its description mentions that are not objects (none:
; Z). The list is read word by word (#R$B77F); adjectives (class $60) and a
; noun ($50, #R$B772 gives the class) are gathered into a pattern at
; #R$AAAB($AAAC) and matched against the slot at HL (#R$A4E0). NZ when they
; match. Read from the code; the effect confirmed (see #R$B6DA).
;
;  Input:HL The slot's words
; Output:F Z if the words do not name some scenery of the room; NZ if they do
c$B6FD XOR A         ; Clear A to zero (and the carry flag)
 $B6FE LD ($B77E),A  ; Store A in "#R$B6FD's flag" (#R$B77E)
 $B701 LD ($B6D8),HL ; Remember the slot's words
 $B704 CALL $D33C    ; Call the routine "IX = record of the actor's room"
                     ; (#R$D33C) - The actor's room record: +7/+8 point at its
                     ; scenery words; none: Z
 $B707 LD L,(IX+$07) ; Read byte +7 of the record at IX into L
 $B70A LD H,(IX+$08) ; Read byte +8 of the record at IX into H
 $B70D LD A,H        ; Copy H into A
 $B70E OR L          ; Set in A the bits that are set in L
 $B70F RET Z         ; If the result is zero, return
 $B710 PUSH HL       ; Save HL on the stack
 $B711 POP IX        ; Restore IX from the stack
 $B713 LD HL,$0000   ; Load HL with $0000
 $B716 LD ($B6D6),HL ; Store HL in "#R$B6FD's working pointers" (#R$B6D6)
 $B719 LD IY,$AAAC   ; Build each scenery phrase as a pattern at #R$AAAB($AAAC)
*$B71D LD HL,$AAAC   ; Point HL at #R$AAAB($AAAC) - Clear the pattern
 $B720 LD B,$06      ; Load B with $06
 $B722 CALL $A2AB    ; Call the routine "Fill B bytes at HL with zero (or, from
                     ; #R$A2AC, with A)" (#R$A2AB)
*$B725 CALL $B77F    ; Call the routine "Fetch the next word for #R$B6FD's name
                     ; match" (#R$B77F) - Next word (#R$B77F); none left: Z,
                     ; not scenery
 $B728 RET Z         ; If the zero flag is set, return
 $B729 CALL $B772    ; Call the routine "A = the class of dictionary word DE"
                     ; (#R$B772) - A noun ($50) ends the phrase; an adjective
                     ; ($60) goes in the first adjective place
 $B72C CP $50        ; Compare A with $50
 $B72E JR Z,$B75A    ; If A equals $50, jump on to #R$B75A
 $B730 CP $60        ; Compare A with $60
 $B732 JR NZ,$B725   ; If A differs from $60, go back to #R$B725
 $B734 LD (IY+$02),E ; Store E in byte +2 of the record at IY
 $B737 LD (IY+$03),D ; Store D in byte +3 of the record at IY
 $B73A CALL $B77F    ; Call the routine "Fetch the next word for #R$B6FD's name
                     ; match" (#R$B77F) - Second word: a noun ends it, a second
                     ; adjective is kept
 $B73D RET Z         ; If the zero flag is set, return
 $B73E CALL $B772    ; Call the routine "A = the class of dictionary word DE"
                     ; (#R$B772)
 $B741 CP $50        ; Compare A with $50
 $B743 JR Z,$B75A    ; If A equals $50, skip ahead to #R$B75A
 $B745 CP $60        ; Compare A with $60
 $B747 JR NZ,$B71D   ; If A differs from $60, go back to #R$B71D
 $B749 LD (IY+$04),E ; Store E in byte +4 of the record at IY
 $B74C LD (IY+$05),D ; Store D in byte +5 of the record at IY
 $B74F CALL $B77F    ; Call the routine "Fetch the next word for #R$B6FD's name
                     ; match" (#R$B77F) - Third word: must be the noun
 $B752 RET Z         ; If the zero flag is set, return
 $B753 CALL $B772    ; Call the routine "A = the class of dictionary word DE"
                     ; (#R$B772)
 $B756 CP $50        ; Compare A with $50
 $B758 JR NZ,$B71D   ; If A differs from $50, go back to #R$B71D
*$B75A LD (IY+$00),E ; Store E in the first byte of the record at IY - The noun
                     ; goes first in the pattern
 $B75D LD (IY+$01),D ; Store D in byte +1 of the record at IY
 $B760 LD HL,($B6D8) ; Read #R$B6D8 in "#R$B6FD's working pointers" into HL -
                     ; Do the slot's words name it (#R$A4E0)? No: on to the
                     ; next phrase
 $B763 CALL $A4E0    ; Call #R$A4E0 (inside "Do the pattern words at IY name
                     ; the words...")
 $B766 JR NZ,$B71D   ; If the zero flag is clear, go back to #R$B71D
 $B768 LD IX,($B6D6) ; Read "#R$B6FD's working pointers" (#R$B6D6) into IX -
                     ; Yes: free the word list #R$B77F built (#R$A1AF) and
                     ; return NZ
 $B76C CALL $A1AF    ; Call the routine "Free every node of the list starting
                     ; at IX" (#R$A1AF)
 $B76F OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller
 $B771 RET           ; Return to the caller

; A = the class of dictionary word DE
;
; The high nibble of the word's first byte in the dictionary at #R$5DBE($5DBF):
; $50 for nouns, $60 for adjectives (the parse at #R$B6FD looks for these).
; Read from the code; classes checked against source/dictionary.py (ACID,
; ALDERGATE $6x; AGENT $5x).
;
;  Input:DE A dictionary word reference
; Output:A The class: $50 noun, $60 adjective
c$B772 LD HL,$5DBF   ; Point HL at #R$5DBE($5DBF) - The dictionary's class
                     ; table at #R$5DBE($5DBF): one byte per word, indexed by
                     ; DE & $0FFF
 $B775 LD A,D        ; Copy D into A
 $B776 AND $0F       ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $B778 LD D,A        ; Copy A into D
 $B779 ADD HL,DE     ; Add DE to HL
 $B77A LD A,(HL)     ; Read the byte HL points at into A - The class is its
                     ; high nibble
 $B77B AND $F0       ; Keep only bits 4, 5, 6, 7 of A (mask $F0)
 $B77D RET           ; Return to the caller

; $B6FD's flag
;
; Addresses named in the title: #R$B6FD.
; .
; Cleared by #R$B6FE, tested by #R$B77F.
b$B77E DEFB $00      ; Flag

; Fetch the next word for $B6FD's name match
;
; Addresses named in the title: #R$B6FD.
; .
; Fetch the next word of a message for #R$B6FD's name match. #R$B77E is $FF
; once the last word of the message has been given out.
; .
; How it works:
; .
; 1. If #R$B77E is $FF, the message is finished: take the most recent saved
; call position from the list headed at #R$B6D6 (none left: return Z), unhook
; it, free its node (#R$A1C7) and carry on reading just after the call.
; .
; 2. Read the next byte. If bit 7 is set it starts a two-byte dictionary
; reference, which is put in DE. If its class ($70 bits) is $60, $30 or $20 it
; is the last word of the message, so #R$B77E is set to $FF. Return NZ with the
; word in DE.
; .
; 3. Below $20 is a control code. Code 2 is a jump: add the 16-bit offset to
; the position and carry on. Code $0B is a call: make a 2-byte node holding the
; position after the call, put it on the front of the list at #R$B6D6 and go to
; the sub-message. Codes $1D to $1F end the text. Other codes are skipped.
; .
; 4. $20 to $5F is a run of packed letters, (byte AND $1F) + 1 of them at five
; bits each (#R$A990); they are stepped over, not returned.
; .
; 5. $60 and above is one of the common words (#R$A840): return NZ with A = 0.
;
;  Input:IX The message position
; Output:F Z when no words are left; NZ when a word was found
;        DE The dictionary reference when A is not 0
;        IX The position after the word
c$B77F LD A,($B77E)  ; Read "#R$B6FD's flag" (#R$B77E) into A - Finished the
                     ; sub-message last time (#R$B77E = $FF)?
 $B782 CP $FF        ; Compare A with $FF
 $B784 JR NZ,$B7AA   ; If A differs from $FF, skip ahead to #R$B7AA
*$B786 LD HL,($B6D6) ; Read "#R$B6FD's working pointers" (#R$B6D6) into HL -
                     ; Then go back to where the last one was called from (none
                     ; left: Z)
 $B789 LD A,L        ; Copy L into A
 $B78A OR H          ; Set in A the bits that are set in H
 $B78B RET Z         ; If the result is zero, return
 $B78C XOR A         ; Clear A to zero (and the carry flag) - Unhook the saved
                     ; position from the list at #R$B6D6...
 $B78D LD ($B77E),A  ; Store A in "#R$B6FD's flag" (#R$B77E)
 $B790 PUSH HL       ; Save HL on the stack
 $B791 POP IX        ; Restore IX from the stack
 $B793 LD L,(IX-$02) ; Read byte -2 of the record at IX into L
 $B796 LD H,(IX-$01) ; Read byte -1 of the record at IX into H
 $B799 LD ($B6D6),HL ; Store HL in "#R$B6FD's working pointers" (#R$B6D6)
 $B79C LD L,(IX+$00) ; Read the first byte of the record at IX into L - ...and
                     ; free its node (#R$A1C7)
 $B79F LD H,(IX+$01) ; Read byte +1 of the record at IX into H
 $B7A2 CALL $A1C7    ; Call the routine "Free node IX back to the heap"
                     ; (#R$A1C7)
 $B7A5 INC HL        ; Step HL on to the next byte
 $B7A6 INC HL        ; Step HL on to the next byte
 $B7A7 PUSH HL       ; Save HL on the stack
 $B7A8 POP IX        ; Restore IX from the stack
*$B7AA LD A,(IX+$00) ; Read the first byte of the record at IX into A - The
                     ; next byte
 $B7AD INC IX        ; Step IX on to the next byte
 $B7AF BIT 7,A       ; Test bit 7 of A
 $B7B1 JR Z,$B7CD    ; If bit 7 of A is clear, skip ahead to #R$B7CD
 $B7B3 LD D,A        ; Copy A into D - A dictionary reference: DE
 $B7B4 LD E,(IX+$00) ; Read the first byte of the record at IX into E
 $B7B7 INC IX        ; Step IX on to the next byte
 $B7B9 AND $70       ; Keep only bits 4, 5, 6 of A (mask $70) - A word of class
                     ; $60, $30 or $20 is the last of its message (the printer,
                     ; #R$A647, ends there): #R$B77E = $FF
 $B7BB CP $60        ; Compare A with $60
 $B7BD JR Z,$B7C6    ; If A equals $60, skip ahead to #R$B7C6
 $B7BF CP $30        ; Compare A with $30
 $B7C1 JR Z,$B7C6    ; If A equals $30, skip ahead to #R$B7C6
 $B7C3 CP $20        ; Compare A with $20 - Return NZ with the word in DE
 $B7C5 RET NZ        ; If A differs from $20, return
*$B7C6 LD A,$FF      ; Load A with $FF
 $B7C8 LD ($B77E),A  ; Store A in "#R$B6FD's flag" (#R$B77E)
 $B7CB AND A         ; Clear the carry flag for the caller (A is unchanged)
 $B7CC RET           ; Return to the caller
*$B7CD CP $20        ; Compare A with $20 - $00-$1F: a control code
 $B7CF JR C,$B7F7    ; If A is below $20, skip ahead to #R$B7F7
 $B7D1 CP $60        ; Compare A with $60 - $20-$5F: a run of packed letters to
                     ; skip (the printer takes $20-$3F as single characters:
                     ; see Bugs)
 $B7D3 JR C,$B7DD    ; If A is below $60, skip ahead to #R$B7DD
 $B7D5 CALL $A840    ; Call #R$A840 (inside "Message bytes $60 and up: a common
                     ; word") - $60 and up: one of the common words at #R$67B7
                     ; (#R$A840); NZ, A = 0
 $B7D8 OR $01        ; Set bit 0 of A
 $B7DA LD A,$00      ; Load A with $00
 $B7DC RET           ; Return to the caller
*$B7DD AND $1F       ; Keep only bits 0, 1, 2, 3, 4 of A (mask $1F) - (A AND
                     ; $1F) + 1 letters...
 $B7DF INC A         ; Add one to A
 $B7E0 LD B,A        ; Copy A into B
 $B7E1 PUSH IX       ; Save IX on the stack
 $B7E3 POP HL        ; Restore HL from the stack
 $B7E4 INC HL        ; Step HL on to the next byte
 $B7E5 LD C,$00      ; Load C with $00
*$B7E7 CALL $A990    ; Call the routine "Unpack the next five-bit letter (C =
                     ; bit position)" (#R$A990) - ...five bits each (#R$A990, C
                     ; counts the half bytes)
 $B7EA DJNZ $B7E7    ; Count B down and, while it is not zero, go back to
                     ; #R$B7E7
 $B7EC PUSH HL       ; Save HL on the stack
 $B7ED POP IX        ; Restore IX from the stack
 $B7EF LD A,C        ; Copy C into A
 $B7F0 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $B7F1 JR NZ,$B7AA   ; If A is not zero, go back to #R$B7AA
 $B7F3 DEC IX        ; Step IX back one byte
 $B7F5 JR $B7AA      ; Go back to #R$B7AA
*$B7F7 CP $02        ; Compare A with $02 - Code 2: a jump - follow it
 $B7F9 JR NZ,$B807   ; If A differs from $02, skip ahead to #R$B807
 $B7FB LD E,(IX+$00) ; Read the first byte of the record at IX into E
 $B7FE LD D,(IX+$01) ; Read byte +1 of the record at IX into D
 $B801 ADD IX,DE     ; Add DE to IX
*$B803 DEC IX        ; Step IX back one byte
 $B805 JR $B7AA      ; Go back to #R$B7AA
*$B807 CP $0B        ; Compare A with $0B - Code $0B: a call - save the
                     ; position after it on the list at #R$B6D6...
 $B809 JR NZ,$B834   ; If A differs from $0B, jump on to #R$B834
 $B80B LD E,(IX+$00) ; Read the first byte of the record at IX into E - DE =
                     ; the word pair at IX (its link)
 $B80E LD D,(IX+$01) ; Read byte +1 of the record at IX into D
 $B811 PUSH IX       ; Save IX on the stack - Get a 2-byte heap node (#R$A11C)
 $B813 POP HL        ; Restore HL from the stack
 $B814 LD A,$02      ; Load A with $02
 $B816 CALL $A11C    ; Call the routine "Allocate A + 3 bytes from the free
                     ; list, cleared" (#R$A11C)
 $B819 LD (IX+$00),L ; Store L in the first byte of the record at IX - Put the
                     ; old link in it
 $B81C LD (IX+$01),H ; Store H in byte +1 of the record at IX
 $B81F PUSH HL       ; Save HL on the stack
 $B820 LD HL,($B6D6) ; Read "#R$B6FD's working pointers" (#R$B6D6) into HL -
                     ; Push the node on the front of the list headed at #R$B6D6
 $B823 LD ($B6D6),IX ; Store IX in "#R$B6FD's working pointers" (#R$B6D6)
 $B827 LD (IX-$02),L ; Store L in byte -2 of the record at IX
 $B82A LD (IX-$01),H ; Store H in byte -1 of the record at IX
 $B82D POP HL        ; Restore HL from the stack
 $B82E ADD HL,DE     ; Add DE to HL - ...and go to the sub-message
 $B82F PUSH HL       ; Save HL on the stack
 $B830 POP IX        ; Restore IX from the stack
 $B832 JR $B803      ; Go back to #R$B803
*$B834 CP $1D        ; Compare A with $1D - Other codes below $1D are passed
                     ; over (their operands are not); $1D-$1F end the text
 $B836 JP C,$B7AA    ; If A is below $1D, go back to #R$B7AA
 $B839 JP $B786      ; Go back to #R$B786

; Push the three words at HL as message parameters
;
; Takes its own return address off the stack, pushes the three word references
; from HL, and returns under them, so that the message printed next (#R$A59F)
; finds them as its parameters. Read from the code.
;
;  Input:HL Three word references
; Output:The three words pushed as message parameters under the return address
c$B83C POP IX        ; Pop the return address into IX
 $B83E LD B,$03      ; Load B with $03 - Push the three words at HL as message
                     ; parameters (3 x 2 bytes)
*$B840 LD E,(HL)     ; Read the byte HL points at into E
 $B841 INC HL        ; Step HL on to the next byte
 $B842 LD D,(HL)     ; Read the byte HL points at into D
 $B843 INC HL        ; Step HL on to the next byte
 $B844 PUSH DE       ; Save DE on the stack
 $B845 DJNZ $B840    ; Count B down and, while it is not zero, go back to
                     ; #R$B840
 $B847 POP HL        ; Restore HL from the stack - Re-order the stack so the
                     ; first word is on top...
 $B848 EX (SP),HL    ; Swap HL with the word on top of the stack
 $B849 PUSH HL       ; Save HL on the stack
 $B84A JP (IX)       ; ...and return to the caller through IX

; I DO NOT KNOW THE VERB "<word>"
;
; Pushes the typed verb's words (#R$B185($B186)-#R$B18D) and prints #R$686A.
; Its address is handed out at #R$B1A6($B1A7) when no verb record matches. Read
; from the code.
;
; Output:The message "I DO NOT KNOW THE VERB" printed with the typed verb
c$B84C LD HL,($B18A) ; Read #R$B185($B18A) in "Parser variables" into HL - The
                     ; 'I do not know the verb' routine: push the four saved
                     ; words (#R$B185($B18A), #R$B185($B188), #R$B185($B186),
                     ; #R$B185($B18C))
 $B84F PUSH HL       ; Save HL on the stack
 $B850 LD HL,($B188) ; Read #R$B185($B188) in "Parser variables" into HL
 $B853 PUSH HL       ; Save HL on the stack
 $B854 LD HL,($B186) ; Read #R$B185($B186) in "Parser variables" into HL
 $B857 PUSH HL       ; Save HL on the stack
 $B858 LD HL,($B18C) ; Read #R$B185($B18C) in "Parser variables" into HL
 $B85B PUSH HL       ; Save HL on the stack
 $B85C LD HL,$686A   ; Point HL at the message "I DO NOT KNOW THE VERB"
                     ; ‹word›"" (#R$686A)
 $B85F CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $B862 RET           ; Return to the caller

; JP $C929 (check the record)
;
; Addresses named in the title: #R$C929.
; .
; An address the parser hands out at #R$B20F($B210) when a verb record has
; matched: the command is then checked against the record (#R$C929).
;
; Output:As $C929
c$B863 JP $C929      ; Jump on to the routine "Check the action record against
                     ; the command's..." (#R$C929)

; Speech hand-over variables
;
; #R$B866: the order or remark node found by #R$B90E. #R$B868: where the quoted
; words being handed over start.
b$B866 DEFW $0000    ; Node found by #R$B90E
 $B868 DEFW $0000    ; Start of the quoted words

; Hand quoted words to the person spoken to (SAY TO / TALK TO)
;
; Called by the TALK TO body (#R$DDAE) with A = 1 if the person has a plan
; script (an actor, #R$CC0E) and 0 if not. Takes the next quoted sentence off
; the list at #R$9FEC. For an actor, #R$B8AA puts it on the order/remark list
; (#R$9FEE) as an 8-byte node: +0 the person, +1 0, +5/+6 the words, +7 =
; #R$A022($A024) (2 for a statement); the person deals with it on its next turn
; (#R$B936). For anyone else the words are just used up. Read from the code;
; the effect (Watson getting out of his chair, Watson and Lestrade answering
; statements) is confirmed in the emulator - see #R$CBA7, #R$BA67 and #R$BB67.
; .
; CORRECTED: the automatic split had #R$B866-#R$B90D as data and text.
; .
; How it works:
; .
; 1. Take the next quoted sentence from the list at #R$9FEC and unlink it.
; .
; 2. If the person has a plan script (A = 1), parse the words as a sentence of
; their own (#R$B8AA) and put them on the order and remark list at #R$9FEE as
; an 8-byte node.
; .
; 3. Otherwise skip the words to the end of the line and mark it with a $90
; token.
;
;  Input:A 1 if the person spoken to has a plan script; 0 if not
; Output:The quoted sentence handed over or used up
c$B86A PUSH AF       ; Save AF on the stack
 $B86B LD IX,$9FEE   ; Point IX at orders and remarks (#R$9FEE) - Take the next
                     ; quoted sentence off its list (#R$9FEC, #R$A0F7); none:
                     ; done
 $B86F CALL $A0F7    ; Call the routine "Move IX to the next node of a list"
                     ; (#R$A0F7)
 $B872 JR Z,$B8A8    ; If the zero flag is set, jump on to #R$B8A8
 $B874 LD C,(IX+$00) ; Read the first byte of the record at IX into C -
                     ; Remember where its words are (#R$B868) and unlink it
 $B877 LD B,(IX+$01) ; Read byte +1 of the record at IX into B
 $B87A LD ($B868),BC ; Store BC in #R$B868 in "Speech hand-over variables"
 $B87E LD L,(IX-$02) ; Read byte -2 of the record at IX into L
 $B881 LD H,(IX-$01) ; Read byte -1 of the record at IX into H
 $B884 LD ($9FEC),HL ; Store HL in quoted speech waiting to (#R$9FEC)
 $B887 CALL $A1C7    ; Call the routine "Free node IX back to the heap"
                     ; (#R$A1C7)
 $B88A POP AF        ; Restore AF from the stack - A person with a plan script
                     ; (A = 1): parse it and hand it over (#R$B8AA)
 $B88B PUSH AF       ; Save AF on the stack
 $B88C AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $B88D JR Z,$B894    ; If A is zero, skip ahead to #R$B894
 $B88F CALL $B8AA    ; Call #R$B8AA (inside "Hand quoted words to the person
                     ; spoken to...")
 $B892 JR Z,$B8A8    ; If the zero flag is set, skip ahead to #R$B8A8
*$B894 LD BC,($B868) ; Read #R$B868 in "Speech hand-over variables" into BC -
                     ; Otherwise just use the words up, to the end of the line
                     ; ($C0),
 $B898 LD ($A02B),BC ; Store BC in #R$A02A($A02B) in "Game variables"
*$B89C CALL $AE7F    ; Call the routine "Read the next token of the typed line"
                     ; (#R$AE7F)
 $B89F CP $C0        ; Compare A with $C0
 $B8A1 JR NZ,$B89C   ; If A differs from $C0, go back to #R$B89C
 $B8A3 LD HL,($A029) ; Read #R$A022($A029) in "Game variables" into HL - and
                     ; mark the end with a $90 token
 $B8A6 LD (HL),$90   ; Store $90 at the address HL points to
*$B8A8 POP AF        ; Restore AF from the stack
 $B8A9 RET           ; Return to the caller
*$B8AA LD HL,($B868) ; Read #R$B868 in "Speech hand-over variables" into HL -
                     ; Parse the words as a sentence of their own
 $B8AD LD ($A02B),HL ; Store HL in #R$A02A($A02B) in "Game variables"
 $B8B0 XOR A         ; Clear A to zero (and the carry flag)
 $B8B1 LD ($A024),A  ; Store A in #R$A022($A024) in "Game variables"
 $B8B4 LD HL,($9FF0) ; Read words the player has (#R$9FF0) into HL - with an
                     ; empty sentence list (the player's own is kept on the
                     ; stack)
 $B8B7 PUSH HL       ; Save HL on the stack
 $B8B8 LD HL,$0000   ; Load HL with $0000
 $B8BB LD ($9FF0),HL ; Store HL in words the player has (#R$9FF0)
*$B8BE CALL $AAB2    ; Call the routine "Parse the next sentence from the word
                     ; list" (#R$AAB2) - Parse (#R$AAB2); A = 2 counts as
                     ; parsed; anything else is nonsense
 $B8C1 JR Z,$B8C7    ; If the zero flag is set, skip ahead to #R$B8C7
 $B8C3 CP $02        ; Compare A with $02
 $B8C5 JR NZ,$B904   ; If A differs from $02, jump on to #R$B904
*$B8C7 LD HL,($A02B) ; Read #R$A02A($A02B) in "Game variables" into HL - Go on
                     ; until the end of the quotation, then mark it with $90
 $B8CA LD A,(HL)     ; Read the byte HL points at into A
 $B8CB AND $F0       ; Keep only bits 4, 5, 6, 7 of A (mask $F0)
 $B8CD CP $C0        ; Compare A with $C0
 $B8CF JR NZ,$B8BE   ; If A differs from $C0, go back to #R$B8BE
 $B8D1 LD (HL),$90   ; Store $90 at the address HL points to
 $B8D3 LD A,$08      ; Load A with $08 - An 8-byte node on the order/remark
                     ; list #R$9FEE (#R$A11C)
 $B8D5 CALL $A11C    ; Call the routine "Allocate A + 3 bytes from the free
                     ; list, cleared" (#R$A11C)
 $B8D8 LD HL,($9FEE) ; Read orders and remarks (#R$9FEE) into HL
 $B8DB LD ($9FEE),IX ; Store IX in orders and remarks (#R$9FEE)
 $B8DF LD (IX-$02),L ; Store L in byte -2 of the record at IX
 $B8E2 LD (IX-$01),H ; Store H in byte -1 of the record at IX
 $B8E5 LD HL,($9FF0) ; Read words the player has (#R$9FF0) into HL - +5/+6: the
                     ; parsed words
 $B8E8 LD (IX+$05),L ; Store L in byte +5 of the record at IX
 $B8EB LD (IX+$06),H ; Store H in byte +6 of the record at IX
 $B8EE POP HL        ; Restore HL from the stack
 $B8EF LD ($9FF0),HL ; Store HL in words the player has (#R$9FF0)
 $B8F2 XOR A         ; Clear A to zero (and the carry flag) - +1 = 0, +0 = the
                     ; person spoken to
 $B8F3 LD (IX+$01),A ; Store A in byte +1 of the record at IX
 $B8F6 LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A
 $B8F9 LD (IX+$00),A ; Store A in the first byte of the record at IX
 $B8FC LD A,($A024)  ; Read #R$A022($A024) in "Game variables" into A - +7 =
                     ; the mode: 2 for a statement
 $B8FF LD (IX+$07),A ; Store A in byte +7 of the record at IX
 $B902 XOR A         ; Set A to zero, which sets the zero flag for the caller
 $B903 RET           ; Return to the caller
*$B904 PUSH AF       ; Save AF on the stack - Nonsense: free the words
                     ; (#R$D87D) and put the player's list back
 $B905 CALL $D87D    ; Call the routine "Free the current sentence's word list
                     ; (#R$9FF0)" (#R$D87D)
 $B908 POP AF        ; Restore AF from the stack
 $B909 POP HL        ; Restore HL from the stack
 $B90A LD ($9FF0),HL ; Store HL in words the player has (#R$9FF0)
 $B90D RET           ; Return to the caller

; Find the current actor's waiting order or remark
;
; #R$B91F, then remember the node at #R$B866 and point IY at its words (+5/+6).
;
;  Input:$A036 The actor
; Output:IX The waiting node, kept at $B866
;        IY The sentence node it points to
;        F Z if found
c$B90E CALL $B91F    ; Find the current actor's waiting order or remark
                     ; (#R$B91F)
 $B911 LD ($B866),IX ; Keep it (#R$B866)
 $B915 LD E,(IX+$05) ; Read byte +5 of the record at IX into E - IY = the
                     ; sentence node it points to (+5/+6)
 $B918 LD D,(IX+$06) ; Read byte +6 of the record at IX into D
 $B91B PUSH DE       ; Save DE on the stack
 $B91C POP IY        ; Restore IY from the stack
 $B91E RET           ; Return to the caller

; Is an order or a remark waiting for the current actor?
;
; Walks the list headed at #R$9FEE (the pseudo-node at #R$9FF0 holds the head)
; for an 8-byte node whose +0 is the current actor (#R$A032($A036)). Z if one
; is found (IX = the node), NZ if not. Nodes are made by a plan script's ASK
; (#R$CDBF: +1 = $FF, +2/+3/+4 = verb and objects) and by #R$B8D1 when the
; player speaks to someone (+1 = 0, +5/+6 = the words, +7 from #R$A022($A024)).
; #R$CC37 calls this for every actor at the start of its turn and sets
; #R$CC0B($CC0D) for #R$CC78.
; .
; CORRECTED 2026-11-07: this was titled 'setup-only', from a test that saw 25
; hits during the intro and none during LOOK. Re-tested with breakpoints
; stepped over properly: LOOK 19 hits, WAIT 67, TAKE LAMP 18 - once per actor
; whose turn comes up, every turn. N ('YOU CANNOT GO NORTH.', which takes no
; time) 0. The id sequence the old test saw (0, 2-6, 104, 7-13, 31, 34, 36-43)
; is simply the actor table's order.
;
;  Input:$A036 The actor
; Output:F Z with IX the waiting node; NZ if none
;        IX Changed
c$B91F LD IX,$9FF0   ; Start of the order/remark list
*$B923 CALL $A0F7    ; Next node: Z at the end
 $B926 JR Z,$B931    ; None left
 $B928 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Is it
                     ; for the current actor?
 $B92B CP (IX+$00)   ; Compare A with the first byte of the record at IX
 $B92E RET Z         ; Yes: Z, IX = the node
 $B92F JR $B923      ; No: keep looking
*$B931 OR $01        ; Not found: NZ
 $B933 RET           ; Return to the caller

; The actor an order is for (two copies)
;
; #R$B935 is set from A on entry to #R$B936 and copied to #R$B934 once an order
; is being taken. Read from the code.
b$B934 DEFB $00      ; Actor (taken)
 $B935 DEFB $00      ; Actor (asked)

; Deal with an order or remark addressed to the current actor
;
; Called from #R$CCB3, instead of the actor's script step, when #R$B91F found
; something for it. A node with +7 = 2 goes to #R$BA20 (Watson's and Lestrade's
; replies, #R$BA67 and #R$BB67). A node from a plan script's ASK (+1 = $FF) is
; handled at #R$B98C: its verb and objects become the command, the node is
; removed, and the caller carries the command out (#R$C4D1). Otherwise the
; words the player said are parsed for this actor (#R$B191). Read from the
; code.
; .
; How it works:
; .
; 1. Find the node waiting for this actor (#R$B90E). If its +7 is 2 it is a
; remark: give Watson's or Lestrade's reply (#R$BA20).
; .
; 2. If its +1 is $FF it came from a plan script's ASK: turn it into a command
; (#R$B98C).
; .
; 3. Otherwise it is words the player said: restore the ALL flag and search
; position from the node, and parse the current sentence for this actor
; (#R$B191).
; .
; 4. If parsing fails, drop the sentences one by one and return Z. Otherwise
; keep the ALL position, drop the sentence unless it is an ALL, and return with
; the command to run.
;
;  Input:A The actor
; Output:F From the order or remark
c$B936 PUSH IX       ; Save IX on the stack
 $B938 PUSH IY       ; Save IY on the stack
 $B93A PUSH HL       ; Save HL on the stack
 $B93B LD ($B935),A  ; Note the actor
; This entry point is used by the routine at #R$B98C.
*$B93E CALL $B90E    ; IX = its order or remark (#R$B90E)
 $B941 LD A,(IX+$07) ; Read byte +7 of the record at IX into A - A remark (+7 =
                     ; 2): Watson's or Lestrade's reply (#R$BA20)
 $B944 CP $02        ; Compare A with $02
 $B946 JP Z,$BA20    ; If A equals $02, jump on to the routine "A remark for
                     ; Watson or Inspector Lestrade: let..." (#R$BA20)
 $B949 LD A,(IX+$01) ; Read byte +1 of the record at IX into A - From a plan
                     ; script's ASK (+1 = $FF)?
 $B94C CP $FF        ; Compare A with $FF
 $B94E JR Z,$B98C    ; If A equals $FF, jump on to the routine "Take the
                     ; command out of an ASK order" (#R$B98C)
 $B950 LD A,($B935)  ; Read #R$B935 in "The actor an order is for (two copies)"
                     ; into A - Words the player said: whom they are for
 $B953 LD ($B934),A  ; Store A in "The actor an order is for (two copies)"
                     ; (#R$B934)
 $B956 LD A,(IX+$02) ; Read byte +2 of the record at IX into A - The ALL flag
                     ; and the ALL search position, kept in the order
 $B959 LD ($A01C),A  ; Store A in #R$A01A($A01C) in "Game variables"
 $B95C LD C,(IX+$03) ; Read byte +3 of the record at IX into C
 $B95F LD B,(IX+$04) ; Read byte +4 of the record at IX into B
 $B962 LD ($B17E),BC ; Store BC in #R$B17D($B17E) in "Parser variables"
 $B966 CALL $B191    ; Call the routine "Match the typed command against the
                     ; verb patterns" (#R$B191) - Parse the order's current
                     ; sentence for this actor (#R$B191)
 $B969 JR Z,$B9B4    ; If the zero flag is set, jump on to #R$B9B4
 $B96B LD IX,($B866) ; Read "Speech hand-over variables" (#R$B866) into IX -
                     ; Parsed: keep the ALL position and flag
 $B96F LD BC,($B17E) ; Read #R$B17D($B17E) in "Parser variables" into BC
 $B973 LD (IX+$03),C ; Store C in byte +3 of the record at IX
 $B976 LD (IX+$04),B ; Store B in byte +4 of the record at IX
 $B979 LD A,($A01C)  ; Read #R$A01A($A01C) in "Game variables" into A
 $B97C LD (IX+$02),A ; Store A in byte +2 of the record at IX
 $B97F AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry) - Not an ALL: drop the sentence (#R$B9CA)
 $B980 CALL Z,$B9CA  ; If A is zero, call #R$B9CA (inside "Take the command out
                     ; of an ASK order")
; This entry point is used by the routine at #R$B98C.
*$B983 LD A,$01      ; Load A with $01 - NZ: there is a command to carry out
; This entry point is used by the routine at #R$B98C.
*$B985 POP HL        ; Restore HL from the stack
 $B986 POP IY        ; Restore IY from the stack
 $B988 POP IX        ; Restore IX from the stack
 $B98A AND A         ; Clear the carry flag for the caller (A is unchanged)
 $B98B RET           ; Return to the caller

; Take the command out of an ASK order
;
; The order's verb and objects (+2, +3, +4, resolved by #R$CEDE) become the
; command; #R$B9FA removes the node.
; .
; #R$B9AC-#R$B9F9 belong to the remark path of #R$B936: #R$B9CA hands the
; remark's remaining words back (node +5/+6) one sentence at a time, freeing
; what has been used. CORRECTED: the automatic split had #R$B9AC-#R$B9F9 as
; data.
; .
; Reached from #R$B936 when an actor has been given an order (ASK): the order's
; verb and objects are turned into the command the actor will run and the order
; is removed from the list. Orders are issued by ASK instructions in the
; scripts - for example Lestrade's own script at #R$EA6D, ASK the local
; policeman TO GO FURIOUSLY TO Tricia's front door - and the block ran in the
; stored routes (count below).
; .
; The tail from #R$B9AC drops an order's sentences when the order cannot be
; parsed or an ALL has run out, and #R$B9CA hands back the remark's remaining
; words one sentence at a time. It never ran in the stored routes, so it was
; provoked on 9 November (tools/experiments/tails_test7.py: orders typed as SAY
; TO LESTRADE "...", with the player put in Lestrade's room): WAIT and GO EAST
; - an order he cannot carry out - go #R$B9B4, #R$B9AC, #R$B9CA and he says
; 'Sorry, I cannot do that now.'; TAKE ALL and DROP ALL, whose ALL has run out,
; go #R$B9B4, #R$B9BA, #R$B9CA (#R$B9BE-#R$B9C5 on the way); WAIT AND WAIT and
; GO EAST AND GO EAST drop the first sentence and go round again (#R$B9E9,
; #R$B9F2, back to #R$B9AC); TAKE ALL AND WAIT goes through #R$B9C7 to try the
; next sentence; and HELLO AND GOODBYE (which is not an order but speech) goes
; through #R$B9CA, #R$B9E9, #R$B9F2 and he answers only the first sentence.
; Every instruction of the tail has now run.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 300 times in 14 of them. Every one of its
; 45 instructions was executed (tools/experiments/insn_coverage.py plus the
; targeted tests described above).
;
;  Input:IX The ASK order
; Output:$A033 The verb
;        $A034 The direct object, $ A035 the indirect object
c$B98C LD A,(IX+$02)   ; Read byte +2 of the record at IX into A - The ordered
                       ; verb
 $B98F CALL $CEDE      ; Call the routine "Resolve a plan argument byte"
                       ; (#R$CEDE)
 $B992 LD ($A033),A    ; Store A in #R$A032($A033) in "Game variables"
 $B995 LD A,(IX+$03)   ; Read byte +3 of the record at IX into A - Its direct
                       ; object
 $B998 CALL $CEDE      ; Call the routine "Resolve a plan argument byte"
                       ; (#R$CEDE)
 $B99B LD ($A034),A    ; Store A in #R$A032($A034) in "Game variables"
 $B99E LD A,(IX+$04)   ; Read byte +4 of the record at IX into A - Its indirect
                       ; object
 $B9A1 CALL $CEDE      ; Call the routine "Resolve a plan argument byte"
                       ; (#R$CEDE)
 $B9A4 LD ($A035),A    ; Store A in #R$A032($A035) in "Game variables"
 $B9A7 CALL $B9FA      ; Remove the order from the list
 $B9AA JR $B983        ; Go back to #R$B983
*$B9AC CALL $B9CA      ; Call #R$B9CA (inside "Take the command out of an ASK
                       ; order") - Unparsable: drop the order's sentences one
                       ; by one...
 $B9AF JR NZ,$B9AC     ; If the zero flag is clear, go back to #R$B9AC
*$B9B1 XOR A           ; Clear A to zero (and the carry flag) - ...and return
                       ; Z: nothing to do
 $B9B2 JR $B985        ; Go back to #R$B985
; This entry point is used by the routine at #R$B936.
*$B9B4 LD A,($A01C)    ; Read #R$A01A($A01C) in "Game variables" into A - An
                       ; ALL that has run out: clear the flag, drop the
                       ; sentence...
 $B9B7 AND A           ; Test A for zero (this leaves A as it was and clears
                       ; carry)
 $B9B8 JR Z,$B9AC      ; If A is zero, go back to #R$B9AC
 $B9BA LD IX,($B866)   ; Read "Speech hand-over variables" (#R$B866) into IX
 $B9BE LD (IX+$02),$00 ; Set byte +2 of the record at IX to $00
 $B9C2 CALL $B9CA      ; Call #R$B9CA (inside "Take the command out of an ASK
                       ; order")
 $B9C5 JR Z,$B9B1      ; If the zero flag is set, go back to #R$B9B1
 $B9C7 JP $B93E        ; ...and try the next one
; This entry point is used by the routine at #R$B936.
*$B9CA LD IX,($B866)   ; Read "Speech hand-over variables" (#R$B866) into IX -
                       ; Drop the order's current sentence (IY) and any BUT
                       ; nodes after it
*$B9CE LD L,(IY-$02)   ; Read byte -2 of the record at IY into L
 $B9D1 LD H,(IY-$01)   ; Read byte -1 of the record at IY into H
 $B9D4 LD (IX+$05),L   ; Store L in byte +5 of the record at IX
 $B9D7 LD (IX+$06),H   ; Store H in byte +6 of the record at IX
 $B9DA PUSH IX         ; Save IX on the stack
 $B9DC PUSH IY         ; Save IY on the stack
 $B9DE POP IX          ; Restore IX from the stack
 $B9E0 CALL $A1C7      ; Call the routine "Free node IX back to the heap"
                       ; (#R$A1C7)
 $B9E3 POP IX          ; Restore IX from the stack
 $B9E5 LD A,L          ; Copy L into A - None left: remove the order and return
                       ; Z
 $B9E6 OR H            ; Set in A the bits that are set in H
 $B9E7 JR Z,$B9F5      ; If the result is zero, skip ahead to #R$B9F5
 $B9E9 PUSH HL         ; Save HL on the stack
 $B9EA POP IY          ; Restore IY from the stack
 $B9EC BIT 6,(IY+$01)  ; Test bit 6 of byte +1 of the record at IY
 $B9F0 JR NZ,$B9CE     ; If bit 6 of byte +1 of the record at IY is set, go
                       ; back to #R$B9CE
 $B9F2 OR $01          ; Make A non-zero, which clears the zero flag, and hand
                       ; that back to the caller - More to come: NZ
 $B9F4 RET             ; Return to the caller
*$B9F5 CALL $B9FA      ; Call the routine "Remove node IX from the order/remark
                       ; list and free it" (#R$B9FA)
 $B9F8 XOR A           ; Set A to zero, which sets the zero flag for the caller
 $B9F9 RET             ; Return to the caller

; Remove node IX from the order/remark list and free it
;
; Unlinks IX from the list at #R$9FEE (#R$A104 finds its predecessor) and frees
; it (#R$A1C7).
;
;  Input:IX The node to remove
; Output:The node unlinked from $9FEE and freed
c$B9FA LD IY,$9FEE   ; Point IY at orders and remarks (#R$9FEE) - Find the node
                     ; before IX in the list at #R$9FEE (#R$A104)
 $B9FE PUSH IX       ; Save IX on the stack
 $BA00 POP DE        ; Restore DE from the stack
 $BA01 CALL $A104    ; Call the routine "Find the node before node DE in the
                     ; list at IY" (#R$A104)
 $BA04 LD L,(IX-$02) ; Read byte -2 of the record at IX into L - Unhook IX: the
                     ; previous node's link = IX's link
 $BA07 LD H,(IX-$01) ; Read byte -1 of the record at IX into H
 $BA0A LD (IY-$02),L ; Store L in byte -2 of the record at IY
 $BA0D LD (IY-$01),H ; Store H in byte -1 of the record at IY
 $BA10 JP $A1C7      ; Free it (#R$A1C7)

; Variables used by the code at $BA20-$BF58
;
; Addresses named in the title: #R$BA20, #R$BF58.
; .
; #R$BA13 and #R$BA13($BA15) are record pointers stepped by #R$BE3C and
; #R$BE4B; #R$BA13($BA19)-#R$BA1B are copied to #R$BA60($BA62) by #R$BB46;
; #R$BA1B($BA1C) and #R$BA1B($BA1D) are counters/flags for the routine at
; #R$BB67; #R$BA1B($BA1E) holds a record pointer. Read from code.
; .
; CORRECTED: was split into data and text blocks.
b$BA13 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BA1B DEFB $00,$00,$00,$00,$00

; A remark for Watson or Inspector Lestrade: let them reply
;
; Reached from #R$B936 when the node waiting for the actor has +7 = 2 (made by
; #R$B8D1 when the player speaks to someone). For Watson (actor 3) the reply
; code is at #R$BA67, for Lestrade (2) at #R$BB67; #R$BA3E runs it on the
; player's words (IY = node +5/+6, through #R$D1DB), then frees the words
; (#R$A1AF) and the node (#R$B9FA). Other actors ignore remarks. The two reply
; routines are described at #R$BA67 and #R$BB67, and both were tried in the
; emulator.
;
;  Input:$A036 The person spoken to (2 Lestrade, 3 Watson)
;        IX The remark node
; Output:F Carry set (the turn is used)
;        A 1
c$BA20 LD A,($A036)  ; Who is being spoken to?
 $BA23 LD HL,$BA67   ; Point HL at "Watson's reply to something the player
                     ; says" (#R$BA67) - Watson's reply code
 $BA26 CP $03        ; Compare A with $03
 $BA28 JR Z,$BA31    ; If A equals $03, skip ahead to #R$BA31
 $BA2A LD HL,$BB67   ; Lestrade's reply code
 $BA2D CP $02        ; Compare A with $02
 $BA2F JR NZ,$BA34   ; Anyone else: ignore it
*$BA31 CALL $BA3E    ; Let them reply
*$BA34 LD A,$01      ; Load A with $01 - Done (carry set: the turn is used)
 $BA36 POP HL        ; Restore HL from the stack
 $BA37 POP IY        ; Restore IY from the stack
 $BA39 POP IX        ; Restore IX from the stack
 $BA3B AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $BA3C SCF           ; Set the carry flag for the caller
 $BA3D RET           ; Return to the caller
*$BA3E PUSH IX       ; Save IX on the stack - Run reply code HL on the remark
                     ; at IX
 $BA40 XOR A         ; Clear A to zero (and the carry flag)
 $BA41 LD ($9FEB),A  ; Store A in #R$9FEB in "Game variables"
 $BA44 LD E,(IX+$05) ; Read byte +5 of the record at IX into E
 $BA47 LD D,(IX+$06) ; Read byte +6 of the record at IX into D
 $BA4A PUSH DE       ; Save DE on the stack
 $BA4B PUSH DE       ; Save DE on the stack
 $BA4C POP IY        ; Restore IY from the stack
 $BA4E CALL $D1DB    ; Call the routine "Jump to HL" (#R$D1DB)
 $BA51 POP IX        ; Restore IX from the stack
 $BA53 PUSH AF       ; Save AF on the stack
 $BA54 CALL $A1AF    ; Call the routine "Free every node of the list starting
                     ; at IX" (#R$A1AF) - Free the words
 $BA57 POP AF        ; Restore AF from the stack
 $BA58 POP IX        ; Restore IX from the stack
 $BA5A PUSH AF       ; Save AF on the stack
 $BA5B CALL $B9FA    ; Call the routine "Remove node IX from the order/remark
                     ; list and free it" (#R$B9FA) - Remove the remark
 $BA5E POP AF        ; Restore AF from the stack
 $BA5F RET           ; Return to the caller

; More variables for $BA67-$BB5C
;
; Addresses named in the title: #R$BA67, #R$BB5C.
; .
; #R$BA60/#R$BA60($BA61) flags set at #R$BA67 and #R$BB46;
; #R$BA60($BA62)-#R$BA60($BA64) a 3-byte copy compared with the table at
; #R$9FF2($9FF6); #R$BA60($BA65) a record pointer.
b$BA60 DEFB $00,$00,$00,$00,$00,$00,$00

; Watson's reply to something the player says
;
; Parses the remark into a statement (#R$BD7E: subject #R$BA13($BA19), relation
; #R$BA13($BA1A) from the verb's place in #R$994D, object #R$BA1B), then looks
; for it in Watson's own list at #R$9A7D (empty: $FF at once) and in the case
; table (#R$BD51). A statement about the case is remembered: added to the list
; at #R$9FF2($9FF4) (5-byte heap nodes holding the three bytes) unless already
; there. Watson then answers 'THAT IS BRILLIANT HOLMES.' (#R$6F54) or, by
; chance, asks whether there is 'SOME CONNECTION BETWEEN THE ... AND ...' two
; things (#R$6F62, using #R$BD06); a statement with flags bit 5 set (the four
; 'Tricia Fender / Phipps KILLED ...' ones) gets a different answer.
; .
; Confirmed in the emulator: SAY TO WATSON "MRS BROWN KILLED HERSELF" at the
; start gets a reply and the list at #R$9FF2($9FF4) gains a node 5E 05 60 (Mrs
; Brown / KILLED / herself); "PHIPPS HAS PLANS" gets a reply and a node 06 03
; 61. The reply is one of two wordings that alternated in the runs of 9
; November, whichever statement was said: 'Watson remarks " That is brilliant
; Holmes, I do not know how you do it. "' and 'Watson says " That is brilliant
; Holmes. "' (the earlier version of this note tied each wording to a
; statement; that was wrong). "THE LAMP IS ON", which is not about the case,
; gets 'Watson says " What "'; "THE LAMP IS OPEN" gets no reply at all.
; .
; .
; .
; Line comments added from reading the code. The match kinds 1-4 stored in
; #R$BA60 are named from the branches (#R$BD4B hit, #R$BD51 hit, and the two
; dice rolls under 50 and 70); what #R$BA70 carry and #R$BA73 zero from #R$BD7E
; mean was not traced.
;
;  Input:IY The remark's sentence node
;        A 0
; Output:F From the reply
c$BA67 LD ($BA60),A   ; Store A in "More variables for #R$BA67-#R$BB5C"
                      ; (#R$BA60) - A = 0 on entry: clear the two flags #R$BA60
                      ; (how the statement was matched) and #R$BA60($BA61)
                      ; (remember Parse the next statement out of the remark
                      ; into Carry: nothing usable, jump to the reply code at
                      ; Z: try the next one
 $BA6A LD ($BA61),A   ; Store A in #R$BA60($BA61) in "More variables for
                      ; #R$BA67-#R$BB5C"
*$BA6D CALL $BD7E     ; Call #R$BD7E (inside "Find the statement
                      ; #R$BA13($BA19)-#R$BA1B in the case...")
 $BA70 JP C,$BBBE     ; If the carry flag is set, jump on to #R$BBBE
 $BA73 JR Z,$BAA6     ; If the zero flag is set, jump on to #R$BAA6
 $BA75 CALL $BD4B     ; Call #R$BD4B (inside "Try to prove statement IX") - Is
                      ; it in Watson's own list (#R$BD4B)?
 $BA78 JR NZ,$BA85    ; If the zero flag is clear, skip ahead to #R$BA85
 $BA7A LD A,$01       ; Yes: match kind 1
*$BA7C CALL $BB46     ; Record the kind in #R$BA60 and set #R$BA60($BA61)
                      ; (#R$BB46)
 $BA7F LD ($BA65),IX  ; Store IX in #R$BA60($BA65) in "More variables for
                      ; #R$BA67-#R$BB5C" - Remember the record found, for the
                      ; handler at #R$BB5C
 $BA83 JR $BAAB       ; Skip ahead to #R$BAAB
*$BA85 CALL $BD51     ; Call the routine "Find the statement
                      ; #R$BA13($BA19)-#R$BA1B in the case table" (#R$BD51) -
                      ; Is it in the case table (#R$BD51)?
 $BA88 JR NZ,$BA9D    ; If the zero flag is clear, skip ahead to #R$BA9D
 $BA8A LD A,$02       ; Yes: kind 2
 $BA8C BIT 5,(IX+$03) ; Test bit 5 of byte +3 of the record at IX - Statement
                      ; flag bit 5 (the 'Tricia Fender / Phipps KILLED' ones)?
 $BA90 JR NZ,$BA7C    ; If bit 5 of byte +3 of the record at IX is set, go back
                      ; to #R$BA7C
 $BA92 CALL $D29D     ; Otherwise roll 1-100 (#R$D29D)...
 $BA95 CP $32         ; ...
 $BA97 LD A,$03       ; Load A with $03 - ...kind 3 if under 50
 $BA99 JR C,$BA7C     ; If A is below $32, go back to #R$BA7C
 $BA9B JR $BAA6       ; Else give up on this one
*$BA9D CALL $D29D     ; Not in either table: roll 1-100...
 $BAA0 CP $46         ; ...
 $BAA2 LD A,$04       ; Load A with $04 - ...kind 4 if under 70
 $BAA4 JR C,$BA7C     ; If A is below $46, go back to #R$BA7C
*$BAA6 CALL $AEA9     ; Call the routine "IY = the next node in the list (Z at
                      ; the end)" (#R$AEA9) - Next word group of the remark
                      ; (#R$AEA9); more: loop to #R$BA6D
 $BAA9 JR NZ,$BA6D    ; If the zero flag is clear, go back to #R$BA6D
*$BAAB LD A,($BA60)   ; Read "More variables for #R$BA67-#R$BB5C" (#R$BA60)
                      ; into A - Was anything matched?
 $BAAE AND A          ; Test A for zero (this leaves A as it was and clears
                      ; carry)
 $BAAF JP Z,$BB3F     ; No: the stock reply at #R$BB3F
 $BAB2 LD A,($BA61)   ; Read #R$BA60($BA61) in "More variables for
                      ; #R$BA67-#R$BB5C" into A - Is the statement to be
                      ; remembered?
 $BAB5 AND A          ; Test A for zero (this leaves A as it was and clears
                      ; carry)
 $BAB6 JR Z,$BB16     ; No: skip to #R$BB16
 $BAB8 LD IX,$9FF6    ; Point IX at #R$9FF2($9FF6) in "Game variables" - Walk
                      ; the list of remembered statements at #R$9FF2($9FF6)
                      ; (#R$A0F7)...
*$BABC CALL $A0F7     ; Call the routine "Move IX to the next node of a list"
                      ; (#R$A0F7)
 $BABF JR Z,$BAF5     ; ...end of list: not there, make a node
 $BAC1 LD A,($BA62)   ; Read #R$BA60($BA62) in "More variables for
                      ; #R$BA67-#R$BB5C" into A - ...comparing the three bytes
                      ; #R$BA60($BA62)-#R$BA60($BA64) with each node
 $BAC4 CP (IX+$00)    ; Compare A with the first byte of the record at IX
 $BAC7 JR NZ,$BABC    ; If A differs from the first byte of the record at IX,
                      ; go back to #R$BABC
 $BAC9 LD A,($BA63)   ; Read #R$BA60($BA63) in "More variables for
                      ; #R$BA67-#R$BB5C" into A
 $BACC CP (IX+$01)    ; Compare A with byte +1 of the record at IX
 $BACF JR NZ,$BABC    ; If A differs from byte +1 of the record at IX, go back
                      ; to #R$BABC
 $BAD1 LD A,($BA64)   ; Read #R$BA60($BA64) in "More variables for
                      ; #R$BA67-#R$BB5C" into A
 $BAD4 CP (IX+$02)    ; Compare A with byte +2 of the record at IX
 $BAD7 JR NZ,$BABC    ; If A differs from byte +2 of the record at IX, go back
                      ; to #R$BABC
 $BAD9 PUSH IY        ; Save IY on the stack - Found it already: unlink the
                      ; node from the list (#R$A104)...
 $BADB PUSH IX        ; Save IX on the stack
 $BADD POP DE         ; Restore DE from the stack
 $BADE LD IY,$9FF4    ; Point IY at #R$9FF2($9FF4) in "Game variables"
 $BAE2 CALL $A104     ; Call the routine "Find the node before node DE in the
                      ; list at IY" (#R$A104)
 $BAE5 LD A,(IX-$02)  ; Read byte -2 of the record at IX into A - ...closing
                      ; the gap
 $BAE8 LD (IY-$02),A  ; Store A in byte -2 of the record at IY
 $BAEB LD A,(IX-$01)  ; Read byte -1 of the record at IX into A
 $BAEE LD (IY-$01),A  ; Store A in byte -1 of the record at IY
 $BAF1 POP IY         ; Restore IY from the stack
 $BAF3 JR $BAFA       ; Skip ahead to #R$BAFA
*$BAF5 LD A,$05       ; Load A with $05 - Not there: get a 5-byte heap node
                      ; (#R$A11C)
 $BAF7 CALL $A11C     ; Call the routine "Allocate A + 3 bytes from the free
                      ; list, cleared" (#R$A11C)
*$BAFA LD A,($BA62)   ; Read #R$BA60($BA62) in "More variables for
                      ; #R$BA67-#R$BB5C" into A - Fill in the node with the
                      ; three bytes...
 $BAFD LD HL,($BA63)  ; Read #R$BA60($BA63) in "More variables for
                      ; #R$BA67-#R$BB5C" into HL
 $BB00 LD (IX+$00),A  ; Store A in the first byte of the record at IX
 $BB03 LD (IX+$01),L  ; Store L in byte +1 of the record at IX
 $BB06 LD (IX+$02),H  ; Store H in byte +2 of the record at IX
 $BB09 LD HL,($9FF4)  ; Read #R$9FF2($9FF4) in "Game variables" into HL -
                      ; ...and put it at the head of the list #R$9FF2($9FF4)
                      ; (most recent first)
 $BB0C LD ($9FF4),IX  ; Store IX in #R$9FF2($9FF4) in "Game variables"
 $BB10 LD (IX-$02),L  ; Store L in byte -2 of the record at IX
 $BB13 LD (IX-$01),H  ; Store H in byte -1 of the record at IX
*$BB16 LD A,($BA60)   ; Read "More variables for #R$BA67-#R$BB5C" (#R$BA60)
                      ; into A - Kind 1 (already in Watson's list)?
 $BB19 CP $01         ; Compare A with $01
 $BB1B JR Z,$BB5C     ; Yes: jump to its handler (#R$BB5C)
 $BB1D CALL $D29D     ; Otherwise roll 1-100
 $BB20 CP $19         ; Compare A with $19 - 25 or more: the stock reply
 $BB22 JR C,$BB3F     ; If A is below $19, skip ahead to #R$BB3F
 $BB24 LD IX,$BA62    ; Point IX at #R$BA60($BA62) in "More variables for
