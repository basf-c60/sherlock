; The pre-check of the checks-only record at #R$F380 (flags $C8, bit 6). It
; tests the direct object (#R$A012($A013)): its holder (+1) must equal the
; actor's id less 1, and the actor must not be the direct object itself;
; otherwise it refuses (#R$DC15). Read from the code only; no breakpoint was
; set here.
;
;  Input:$A013 The direct object's record
; Output:F NZ if it is held by the actor's number less 1 and is not the actor;
; .        otherwise $DC15
c$F389 LD IX,($A013) ; IX = the direct object's record
 $F38D LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Its
                     ; holder (+1) must be the actor's number less 1; else
                     ; refuse (#R$DC15)
 $F390 DEC A         ; Subtract one from A
 $F391 CP (IX+$01)   ; Compare A with byte +1 of the record at IX
 $F394 JP NZ,$DC15   ; If A differs from byte +1 of the record at IX, go back
                     ; to the routine "Fail: A = 0, HL = 0, Z set" (#R$DC15)
 $F397 LD HL,$A034   ; Point HL at #R$A032($A034) in "Game variables" - And the
                     ; actor must not be the direct object itself
 $F39A INC A         ; Add one to A
 $F39B CP (HL)       ; Compare A with the byte at #R$A032($A034) in "Game
                     ; variables"
 $F39C JP Z,$DC15    ; If A equals the byte at #R$A032($A034) in "Game
                     ; variables", go back to the routine "Fail: A = 0, HL = 0,
                     ; Z set" (#R$DC15)
 $F39F OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Pass
 $F3A1 RET           ; Return to the caller

; Plan script: returned as a sub-script by $9B20
;
; Addresses named in the title: #R$9B20.
; .
; Entry points: #R$F3AD = returned as a sub-script by #R$9B20.
; .
; Decoded by tools/plan.py; see #R$CC78 for the language. Each sub-block is one
; instruction. Room and object numbers are as the game uses them (the reference
; pages list both). Labels for verbs 128-140 and for the common helper records
; (#R$E52F, #R$E57A, #R$E588, #R$E5A8, #R$DDBE, #R$F198) were read from those
; records' code, not tried one by one in the emulator.
; .
; In an instruction, 'plan dobj' and 'plan iobj' are not fixed objects: they
; mean the direct and indirect object currently held in the actor's plan
; registers (bytes +4 and +5 of its actor record), so the same step works on
; whatever the actor is dealing with - for the player, the objects of the
; command just typed. 'plan verb' is the verb register (+3), 'self' is the
; acting character, and '-' means none.
b$F3A2 DEFB $03,$88,$E5         ; RUN #R$E588 CANCEL the countdown
 $F3A5 DEFB $07,$06,$E5,$FB,$FD ; RUN #R$E506 (self, plan dobj)
 $F3AA DEFB $0E,$69,$F3         ; GOTO #R$F369
 $F3AD DEFB $07,$41,$9C,$FD,$FF ; Entry (returned as a sub-script by #R$9B20):
                                ; RUN #R$9C41 (plan dobj, -)
 $F3B2 DEFB $83,$54,$E6,$C1,$F3 ; RUN #R$E654 [ok #R$F3C1]
 $F3B7 DEFB $83,$6F,$E6,$C1,$F3 ; RUN #R$E66F [ok #R$F3C1]
 $F3BC DEFB $07,$BC,$E6,$FC,$FB ; RUN #R$E6BC (plan iobj, self)
 $F3C1 DEFB $0B                 ; RETURN OK

; Draw a picture (the picture interpreter)
;
; HL = the picture's bytecode (from the table at #R$F60C via #R$A277). The pen
; starts at (127, 63). Commands, read from the code: $00 end; $08 move the pen
; (next two bytes); bit 7 set: draw a line (#R$F56E); bit 6: fill (#R$F490);
; bit 5: colour runs of attribute cells. Plots through the ROM's PIXEL-ADD
; (#LINK(rom_symbols#a22AA)($22AA)), which is why the harness skips it.
; .
; Confirmed in the emulator: with SkoolKit's copy of the 48K ROM at $0000,
; calling this for each of the 13 pictures draws a recognisable scene (Baker
; Street's lamp post and door, the entrance hallway's stairs, a grand piano,
; Brown's house at night...) in the top right quarter of the screen and
; returns. The game harness still skips it, to keep play fast.
; .
; How it works:
; .
; 1. The pen starts at (127, 63). Take the next command; 0 ends the picture.
; .
; 2. $08 moves the pen to the (x, y) in the next two bytes (x always has bit 7
; set, so the pen stays in the right half of the screen).
; .
; 3. A command with bit 7 set draws a line (#R$F56E): its low three bits give
; the direction, and the rest the number of steps and run lengths.
; .
; 4. Other commands set the colour, fill an area (#R$F490) or draw other
; shapes; each is followed by its operands.
;
;  Input:HL The picture's bytecode
; Output:The picture drawn; registers kept
c$F3C2 PUSH IY       ; Save IY on the stack
 $F3C4 PUSH HL       ; Save HL on the stack
 $F3C5 PUSH HL       ; Save HL on the stack - IY = the bytecode
 $F3C6 POP IY        ; Restore IY from the stack
 $F3C8 PUSH DE       ; Save DE on the stack
 $F3C9 PUSH BC       ; Save BC on the stack
 $F3CA LD D,$7F      ; Load D with $7F - The pen starts at (127, 63)
 $F3CC LD E,$3F      ; Load E with $3F
 $F3CE LD B,$01      ; Load B with $01
 $F3D0 LD C,$01      ; Load C with $01
 $F3D2 LD L,$01      ; Load L with $01
*$F3D4 LD A,(IY+$00) ; Read the first byte of the record at IY into A - Next
                     ; command; 0 ends the picture
 $F3D7 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $F3D8 JP Z,$F488    ; If A is zero, jump on to #R$F488
 $F3DB INC IY        ; Step IY on to the next byte
 $F3DD CP $08        ; Compare A with $08 - $08: move the pen to (x, y) from
                     ; the next two bytes
 $F3DF JR NZ,$F3EF   ; If A differs from $08, skip ahead to #R$F3EF
 $F3E1 LD D,(IY+$00) ; Read the first byte of the record at IY into D
 $F3E4 SET 7,D       ; Set bit 7 of D - x always has bit 7 set: the pen stays
                     ; in the right half of the screen
 $F3E6 INC IY        ; Step IY on to the next byte
 $F3E8 LD E,(IY+$00) ; Read the first byte of the record at IY into E
 $F3EB INC IY        ; Step IY on to the next byte
 $F3ED JR $F3D4      ; Go back to #R$F3D4
*$F3EF BIT 7,A       ; Test bit 7 of A - Bit 7: a line
 $F3F1 JR Z,$F414    ; If bit 7 of A is clear, skip ahead to #R$F414
 $F3F3 LD B,A        ; Copy A into B - C = bits 2-0: which way it goes
 $F3F4 AND $07       ; Keep only bits 0, 1, 2 of A (mask $07)
 $F3F6 LD C,A        ; Copy A into C
 $F3F7 LD A,B        ; Copy B into A - B = bits 6-3 of this byte and bits 7-6
                     ; of the next: one length, plus 1
 $F3F8 RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $F3F9 AND $3C       ; Keep only bits 2, 3, 4, 5 of A (mask $3C)
 $F3FB LD B,A        ; Copy A into B
 $F3FC LD A,(IY+$00) ; Read the first byte of the record at IY into A - L =
                     ; bits 5-0 of the next byte: the other length, plus 1
 $F3FF AND $3F       ; Keep only bits 0, 1, 2, 3, 4, 5 of A (mask $3F)
 $F401 LD L,A        ; Copy A into L
 $F402 INC L         ; Add one to L
 $F403 LD A,(IY+$00) ; Read the first byte of the record at IY into A
 $F406 INC IY        ; Step IY on to the next byte
 $F408 RLCA          ; Rotate A left one place (bit 7 goes to carry and bit 0)
 $F409 RLCA          ; Rotate A left one place (bit 7 goes to carry and bit 0)
 $F40A AND $03       ; Keep only bits 0, 1 of A (mask $03)
 $F40C OR B          ; Set in A the bits that are set in B
 $F40D LD B,A        ; Copy A into B
 $F40E INC B         ; Add one to B
 $F40F CALL $F56E    ; Call the routine "Draw a line from the pen" (#R$F56E) -
                     ; Draw it (#R$F56E)
 $F412 JR $F3D4      ; Go back to #R$F3D4
*$F414 BIT 6,A       ; Test bit 6 of A - Bit 6: fill in colour bits 2-0 from
                     ; the point in the next two bytes (#R$F490)
 $F416 JR Z,$F42E    ; If bit 6 of A is clear, skip ahead to #R$F42E
 $F418 AND $07       ; Keep only bits 0, 1, 2 of A (mask $07)
 $F41A PUSH DE       ; Save DE on the stack
 $F41B LD D,(IY+$00) ; Read the first byte of the record at IY into D
 $F41E SET 7,D       ; Set bit 7 of D
 $F420 INC IY        ; Step IY on to the next byte
 $F422 LD E,(IY+$00) ; Read the first byte of the record at IY into E
 $F425 INC IY        ; Step IY on to the next byte
 $F427 CALL $F490    ; Call the routine "Fill the area around the pen in colour
                     ; A" (#R$F490)
 $F42A POP DE        ; Restore DE from the stack
 $F42B JP $F3D4      ; Go back to #R$F3D4
*$F42E BIT 5,A       ; Test bit 5 of A - Bit 5: runs of attribute cells in
                     ; paper colour bits 2-0 (any other byte is ignored)
 $F430 JP Z,$F3D4    ; If bit 5 of A is clear, go back to #R$F3D4
 $F433 AND $07       ; Keep only bits 0, 1, 2 of A (mask $07)
 $F435 RLCA          ; Rotate A left one place (bit 7 goes to carry and bit 0)
 $F436 RLCA          ; Rotate A left one place (bit 7 goes to carry and bit 0)
 $F437 RLCA          ; Rotate A left one place (bit 7 goes to carry and bit 0)
 $F438 PUSH HL       ; Save HL on the stack
 $F439 PUSH DE       ; Save DE on the stack
 $F43A PUSH BC       ; Save BC on the stack
 $F43B LD C,A        ; Copy A into C
 $F43C LD H,(IY+$00) ; Read the first byte of the record at IY into H - HL =
                     ; the attribute address: high byte, then low byte + $10
 $F43F INC IY        ; Step IY on to the next byte
 $F441 LD A,(IY+$00) ; Read the first byte of the record at IY into A
 $F444 ADD A,$10     ; Add $10 to A
 $F446 LD L,A        ; Copy A into L
 $F447 INC IY        ; Step IY on to the next byte
*$F449 LD A,(IY+$00) ; Read the first byte of the record at IY into A - Next
                     ; run; $FF ends them
 $F44C INC IY        ; Step IY on to the next byte
 $F44E CP $FF        ; Compare A with $FF
 $F450 JR Z,$F482    ; If A equals $FF, jump on to #R$F482
 $F452 LD B,A        ; Copy A into B - E = bits 1-0: the direction (0 up, 1
                     ; right, 2 down, 3 left)
 $F453 AND $03       ; Keep only bits 0, 1 of A (mask $03)
 $F455 LD E,A        ; Copy A into E
 $F456 LD A,B        ; Copy B into A - B = bits 7-2, plus 1: how many cells
 $F457 RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $F458 RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $F459 AND $3F       ; Keep only bits 0, 1, 2, 3, 4, 5 of A (mask $3F)
 $F45B INC A         ; Add one to A
 $F45C LD B,A        ; Copy A into B
*$F45D LD A,(HL)     ; Read the byte HL points at into A - Give the cell the
                     ; new paper; if its ink is that colour too, flip the ink
 $F45E AND $07       ; Keep only bits 0, 1, 2 of A (mask $07)
 $F460 RLCA          ; Rotate A left one place (bit 7 goes to carry and bit 0)
 $F461 RLCA          ; Rotate A left one place (bit 7 goes to carry and bit 0)
 $F462 RLCA          ; Rotate A left one place (bit 7 goes to carry and bit 0)
 $F463 CP C          ; Compare A with C
 $F464 JR NZ,$F468   ; If A differs from C, skip ahead to #R$F468
 $F466 XOR $38       ; Flip in A the bits that are set in $38
*$F468 RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $F469 RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $F46A RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $F46B OR C          ; Set in A the bits that are set in C
 $F46C LD (HL),A     ; Store A at the address HL points to
 $F46D LD A,E        ; Copy E into A - Step to the next cell: up (#R$F514),
                     ; right (#R$F540), down (#R$F525) or left (#R$F536)
 $F46E AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $F46F CALL Z,$F514  ; If A is zero, call the routine "Move attribute address
                     ; HL up a row (not past the top)" (#R$F514)
 $F472 DEC A         ; Subtract one from A
 $F473 CALL Z,$F540  ; If A has become zero, call #R$F540 (inside "Move
                     ; attribute address HL up a row (not...")
 $F476 DEC A         ; Subtract one from A
 $F477 CALL Z,$F525  ; If A has become zero, call #R$F525 (inside "Move
                     ; attribute address HL up a row (not...")
 $F47A DEC A         ; Subtract one from A
 $F47B CALL Z,$F536  ; If A has become zero, call #R$F536 (inside "Move
                     ; attribute address HL up a row (not...")
 $F47E DJNZ $F45D    ; Count B down and, while it is not zero, go back to
                     ; #R$F45D
 $F480 JR $F449      ; Go back to #R$F449
*$F482 POP BC        ; Restore BC from the stack
 $F483 POP DE        ; Restore DE from the stack
 $F484 POP HL        ; Restore HL from the stack
 $F485 JP $F3D4      ; Go back to #R$F3D4
*$F488 POP BC        ; Restore BC from the stack - End of the picture
 $F489 POP DE        ; Restore DE from the stack
 $F48A POP HL        ; Restore HL from the stack
 $F48B POP IY        ; Restore IY from the stack
 $F48D RET           ; Return to the caller

; Fill state
;
; Two flags used by the fill (#R$F490) to remember whether the rows above and
; below have been seeded.
b$F48E DEFB $00,$00

; Fill the area around the pen in colour A
;
; A scan-line flood fill: the colour goes to #R$F60B, seeds are kept on the
; stack (a $00B0 marker ends them), and each row is filled left and right,
; seeding the rows above and below (#R$F48E/#R$F48E($F48F)). Read from the
; code; the drawn pictures show it works.
; .
; How it works:
; .
; 1. Keep the colour at #R$F60B and put a marker on the stack.
; .
; 2. From the seed, go left until the pixel is set or the edge is reached,
; colouring as it goes.
; .
; 3. Work along the lines above and below: the first clear pixel of each run of
; clear pixels is pushed as a seed for later.
; .
; 4. Pop seeds and repeat until the marker is reached.
;
;  Input:A The colour
;        DE The seed point
; Output:The area around the seed filled; DE, HL kept
c$F490 LD ($F60B),A  ; Store A in "Fill pattern for the picture interpreter"
                     ; (#R$F60B) - The colour to fill with
 $F493 PUSH DE       ; Save DE on the stack
 $F494 PUSH HL       ; Save HL on the stack
 $F495 LD HL,$00B0   ; Load HL with $00B0 - A marker on the stack ($00B0: no
                     ; line has E = $B0) under the seeds
 $F498 PUSH HL       ; Save HL on the stack
*$F499 CALL $F50D    ; Call the routine "Is the pixel under the pen set? (NZ if
                     ; so)" (#R$F50D) - From the seed, go left (D - 1) while
                     ; the pixel is clear...
 $F49C JR NZ,$F4A5   ; If the zero flag is clear, skip ahead to #R$F4A5
 $F49E CALL $F565    ; Call #R$F565 (inside "Move the pen one pixel (Z when it
                     ; would...")
 $F4A1 JR NZ,$F499   ; If the zero flag is clear, go back to #R$F499
 $F4A3 JR $F4AB      ; (stopped by the left edge, x = $80: start here)
*$F4A5 CALL $F5D2    ; Call the routine "Plot the pen position in the current
                     ; colour" (#R$F5D2) - (stopped by a set pixel: colour it
                     ; and step back right)
 $F4A8 CALL $F55E    ; Call #R$F55E (inside "Move the pen one pixel (Z when it
                     ; would...")
*$F4AB LD HL,$0000   ; Load HL with $0000 - Nothing seeded yet on the lines
                     ; either side
 $F4AE LD ($F48E),HL ; Store HL in "Fill state" (#R$F48E)
*$F4B1 CALL $F54A    ; Call the routine "Move the pen one pixel (Z when it
                     ; would leave the..." (#R$F54A) - Line E + 1 (none at the
                     ; edge): a clear pixel starts a run there...
 $F4B4 LD A,$00      ; Load A with $00
 $F4B6 JR Z,$F4CD    ; If the zero flag is set, skip ahead to #R$F4CD
 $F4B8 CALL $F50D    ; Call the routine "Is the pixel under the pen set? (NZ if
                     ; so)" (#R$F50D)
 $F4BB LD A,$00      ; Load A with $00
 $F4BD JR NZ,$F4C8   ; If the zero flag is clear, skip ahead to #R$F4C8
 $F4BF LD A,($F48E)  ; Read "Fill state" (#R$F48E) into A - ...and the first of
                     ; each run is pushed as a seed (#R$F48E)
 $F4C2 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $F4C3 JR NZ,$F4C8   ; If A is not zero, skip ahead to #R$F4C8
 $F4C5 PUSH DE       ; Save DE on the stack
 $F4C6 LD A,$01      ; Load A with $01
*$F4C8 PUSH AF       ; Save AF on the stack
 $F4C9 CALL $F555    ; Call #R$F555 (inside "Move the pen one pixel (Z when it
                     ; would...") - Back to the line
 $F4CC POP AF        ; Restore AF from the stack
*$F4CD LD ($F48E),A  ; Store A in "Fill state" (#R$F48E)
 $F4D0 CALL $F555    ; Call #R$F555 (inside "Move the pen one pixel (Z when it
                     ; would...") - The same for line E - 1 (#R$F48E($F48F))
 $F4D3 LD A,$00      ; Load A with $00
 $F4D5 JR Z,$F4EC    ; If the zero flag is set, skip ahead to #R$F4EC
 $F4D7 CALL $F50D    ; Call the routine "Is the pixel under the pen set? (NZ if
                     ; so)" (#R$F50D)
 $F4DA LD A,$00      ; Load A with $00
 $F4DC JR NZ,$F4E7   ; If the zero flag is clear, skip ahead to #R$F4E7
 $F4DE LD A,($F48F)  ; Read #R$F48E($F48F) in "Fill state" into A
 $F4E1 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $F4E2 JR NZ,$F4E7   ; If A is not zero, skip ahead to #R$F4E7
 $F4E4 PUSH DE       ; Save DE on the stack
 $F4E5 LD A,$01      ; Load A with $01
*$F4E7 PUSH AF       ; Save AF on the stack
 $F4E8 CALL $F54A    ; Call the routine "Move the pen one pixel (Z when it
                     ; would leave the..." (#R$F54A) - Back to the line
 $F4EB POP AF        ; Restore AF from the stack
*$F4EC LD ($F48F),A  ; Store A in #R$F48E($F48F) in "Fill state"
 $F4EF CALL $F5D2    ; Call the routine "Plot the pen position in the current
                     ; colour" (#R$F5D2) - Fill this pixel and move right
 $F4F2 CALL $F55E    ; Call #R$F55E (inside "Move the pen one pixel (Z when it
                     ; would...")
 $F4F5 JR Z,$F4FF    ; If the zero flag is set, skip ahead to #R$F4FF
 $F4F7 CALL $F50D    ; Call the routine "Is the pixel under the pen set? (NZ if
                     ; so)" (#R$F50D) - Next pixel clear: carry on along the
                     ; line
 $F4FA JR Z,$F4B1    ; If the zero flag is set, go back to #R$F4B1
 $F4FC CALL $F5D2    ; Set: colour it too, and the line is done
*$F4FF POP DE        ; Restore DE from the stack - Take the next seed, until
                     ; the marker
 $F500 LD A,E        ; Copy E into A
 $F501 CP $B0        ; Compare A with $B0
 $F503 JR NZ,$F499   ; If A differs from $B0, go back to #R$F499
 $F505 LD A,$00      ; Load A with $00 - Restore the colour to 0
 $F507 LD ($F60B),A  ; Store A in "Fill pattern for the picture interpreter"
                     ; (#R$F60B)
 $F50A POP HL        ; Restore HL from the stack
 $F50B POP DE        ; Restore DE from the stack
 $F50C RET           ; Return to the caller

; Is the pixel under the pen set? (NZ if so)
;
; Through #R$F5FB (the ROM's PIXEL-ADD).
;
;  Input:D, E The pen position
; Output:F NZ if the pixel is set
;        HL Kept
c$F50D PUSH HL       ; Save HL on the stack - Is the pixel at the pen set? (NZ
                     ; if so)
 $F50E CALL $F5FB    ; Call the routine "Find the screen byte and bit for the
                     ; pen" (#R$F5FB)
 $F511 AND (HL)      ; Keep only the bits of A that are set in the byte HL
                     ; points at
 $F512 POP HL        ; Restore HL from the stack
 $F513 RET           ; Return to the caller

; Move attribute address HL up a row (not past the top)
;
; #R$F525 down, #R$F536 left, #R$F540 right: the four moves of a colour run
; (bit 5 commands in #R$F3C2).
; .
; How it works:
; .
; 1. Each of the four entry points moves HL, the address of an attribute byte,
; one cell: #R$F514 up a row, #R$F525 down a row, #R$F536 left and #R$F540
; right.
; .
; 2. A row is 32 bytes. After the move the high byte is checked against the
; edges of the attribute area (#LINK(rom_symbols#a5800)($5800) to $59FF): if
; the move left it, it is undone, so the address never leaves the screen.
;
;  Input:HL An attribute address
; Output:HL The address one cell on, or unchanged at the edge
;        AF is preserved
c$F514 PUSH AF       ; Save AF on the stack - HL 32 bytes back, unless that
                     ; leaves the attribute area
 $F515 PUSH DE       ; Save DE on the stack
 $F516 LD DE,$0020   ; Load DE with $0020
 $F519 AND A         ; Clear the carry flag, so that the subtraction that
                     ; follows is a plain one (a compare)
 $F51A SBC HL,DE     ; Subtract DE from HL (a compare: carry = HL was smaller,
                     ; zero = equal)
 $F51C LD A,H        ; Copy H into A
 $F51D CP $57        ; Compare A with $57
 $F51F JR NZ,$F522   ; If A differs from $57, skip ahead to #R$F522
 $F521 ADD HL,DE     ; Add DE to HL
*$F522 POP DE        ; Restore DE from the stack
 $F523 POP AF        ; Restore AF from the stack
 $F524 RET           ; Return to the caller
; This entry point is used by the routine at #R$F3C2.
*$F525 PUSH AF       ; Save AF on the stack - HL 32 bytes on, unless that
                     ; leaves the attribute area
 $F526 PUSH DE       ; Save DE on the stack
 $F527 LD DE,$0020   ; Load DE with $0020, the amount that is added next
 $F52A ADD HL,DE     ; Add DE to HL
 $F52B LD A,H        ; Copy H into A
 $F52C CP $5A        ; Compare A with $5A
 $F52E JR NZ,$F532   ; If A differs from $5A, skip ahead to #R$F531($F532)
 $F530 AND A         ; Clear the carry flag, so that the subtraction that
                     ; follows is a plain one (a compare)
 $F531 SBC HL,DE     ; Subtract DE from HL (a compare: carry = HL was smaller,
                     ; zero = equal)
 $F533 POP DE        ; Restore DE from the stack
 $F534 POP AF        ; Restore AF from the stack
 $F535 RET           ; Return to the caller
; This entry point is used by the routine at #R$F3C2.
*$F536 PUSH AF       ; Save AF on the stack - HL one byte back, unless that
                     ; leaves the attribute area
 $F537 DEC HL        ; Step HL back one byte
 $F538 LD A,H        ; Copy H into A
 $F539 CP $57        ; Compare A with $57
 $F53B JR NZ,$F53E   ; If A differs from $57, skip ahead to #R$F53E
 $F53D INC HL        ; Step HL on to the next byte
*$F53E POP AF        ; Restore AF from the stack
 $F53F RET           ; Return to the caller
; This entry point is used by the routine at #R$F3C2.
*$F540 PUSH AF       ; Save AF on the stack - HL one byte on, unless that
                     ; leaves the attribute area
 $F541 INC HL        ; Step HL on to the next byte
 $F542 LD A,H        ; Copy H into A
 $F543 CP $5A        ; Compare A with $5A
 $F545 JR NZ,$F548   ; If A differs from $5A, skip ahead to #R$F548
 $F547 DEC HL        ; Step HL back one byte
*$F548 POP AF        ; Restore AF from the stack
 $F549 RET           ; Return to the caller

; Move the pen one pixel (Z when it would leave the picture area)
;
; E is the pen's y and D its x. #R$F54A moves down (stopping at 176), #R$F555
; up (stopping at 0), #R$F55E right (stopping at 255), #R$F565 left - stopping
; when bit 7 of D would clear, so the pen can never leave the right half of the
; screen, which is why every picture sits there.
;
;  Input:E The pen's y
; Output:E One more unless it would reach 176
;        F Z at the edge
c$F54A INC E         ; Add one to E - One pixel up (E + 1) - unless that
                     ; reaches y = 176 ($B0): then put it back and Z
 $F54B LD H,A        ; Copy A into H
 $F54C LD A,E        ; Copy E into A
 $F54D CP $B0        ; Compare A with $B0
 $F54F LD A,H        ; Copy H into A
 $F550 RET NZ        ; If A differs from $B0, return
 $F551 DEC E         ; Subtract one from E
 $F552 XOR A         ; Clear A to zero (and the carry flag)
 $F553 LD A,H        ; Copy H into A
 $F554 RET           ; Return to the caller
; This entry point is used by the routines at #R$F490 and #R$F56E.
*$F555 DEC E         ; Subtract one from E - One down (E - 1), not below 0
 $F556 LD H,A        ; Copy A into H
 $F557 LD A,E        ; Copy E into A
 $F558 CP $FF        ; Compare A with $FF
 $F55A LD A,H        ; Copy H into A
 $F55B RET NZ        ; If A differs from $FF, return
 $F55C INC E         ; Add one to E
 $F55D RET           ; Return to the caller
; This entry point is used by the routines at #R$F490 and #R$F56E.
*$F55E INC D         ; Add one to D - One right (D + 1), not past 255
 $F55F RET NZ        ; If D is not zero, return
 $F560 DEC D         ; Subtract one from D
 $F561 LD H,A        ; Copy A into H
 $F562 XOR A         ; Clear A to zero (and the carry flag)
 $F563 LD A,H        ; Copy H into A
 $F564 RET           ; Return to the caller
; This entry point is used by the routines at #R$F490 and #R$F56E.
*$F565 DEC D         ; Subtract one from D - One left (D - 1), not out of the
                     ; right half (bit 7 of D must stay set)
 $F566 BIT 7,D       ; Test bit 7 of D
 $F568 RET NZ        ; If bit 7 of D is set, return
 $F569 INC D         ; Add one to D
 $F56A LD H,A        ; Copy A into H
 $F56B XOR A         ; Clear A to zero (and the carry flag)
 $F56C LD A,H        ; Copy H into A
 $F56D RET           ; Return to the caller

; Draw a line from the pen
;
; L = the number of steps, B the run length before a step on the minor axis, C
; the directions (bit 0: which axis is major; bits 1 and 2: up or down, left or
; right). Plots each point with #R$F5D2. Read from the code.
;
;  Input:L The number of steps
;        B The run length before a step on the other axis
;        C The direction bits
;        D, E The pen
; Output:D, E The pen after the line
;        BC, HL Kept
c$F56E BIT 0,C       ; Test bit 0 of C - Bit 0 set: the line is mostly along E
 $F570 JR NZ,$F5A2   ; If bit 0 of C is set, jump on to #R$F5A2
 $F572 PUSH HL       ; Save HL on the stack
 $F573 PUSH BC       ; Save BC on the stack
*$F574 CALL $F5D2    ; Mostly along D: plot the point
 $F577 BIT 2,C       ; Test bit 2 of C - Step along D: left with bit 2, right
                     ; without
 $F579 JR Z,$F582    ; If bit 2 of C is clear, skip ahead to #R$F582
 $F57B CALL $F565    ; Call #R$F565 (inside "Move the pen one pixel (Z when it
                     ; would...")
 $F57E JR Z,$F59F    ; If the zero flag is set, skip ahead to #R$F59F
 $F580 JR $F587      ; Skip ahead to #R$F587
*$F582 CALL $F55E    ; Call #R$F55E (inside "Move the pen one pixel (Z when it
                     ; would...")
 $F585 JR Z,$F59F    ; If the zero flag is set, skip ahead to #R$F59F
*$F587 DEC B         ; Subtract one from B - End of a run?
 $F588 JR NZ,$F59C   ; If B is not zero, skip ahead to #R$F59C
 $F58A BIT 1,C       ; Test bit 1 of C - Then one step along E: E - 1 with bit
                     ; 1, E + 1 without
 $F58C JR Z,$F595    ; If bit 1 of C is clear, skip ahead to #R$F595
 $F58E CALL $F555    ; Call #R$F555 (inside "Move the pen one pixel (Z when it
                     ; would...")
 $F591 JR Z,$F59F    ; If the zero flag is set, skip ahead to #R$F59F
 $F593 JR $F59A      ; Skip ahead to #R$F59A
*$F595 CALL $F54A    ; Call the routine "Move the pen one pixel (Z when it
                     ; would leave the..." (#R$F54A)
 $F598 JR Z,$F59F    ; If the zero flag is set, skip ahead to #R$F59F
*$F59A POP BC        ; Restore BC from the stack - and the run length again
 $F59B PUSH BC       ; Save BC on the stack
*$F59C DEC L         ; Subtract one from L - L points in all
 $F59D JR NZ,$F574   ; If L is not zero, go back to #R$F574
*$F59F POP BC        ; Restore BC from the stack - (or until the pen meets the
                     ; edge of the picture)
 $F5A0 POP HL        ; Restore HL from the stack
 $F5A1 RET           ; Return to the caller
*$F5A2 PUSH HL       ; Save HL on the stack
 $F5A3 PUSH BC       ; Save BC on the stack
*$F5A4 CALL $F5D2    ; Mostly along E: plot the point
 $F5A7 BIT 1,C       ; Test bit 1 of C - Step along E: E - 1 with bit 1, E + 1
                     ; without
 $F5A9 JR Z,$F5B2    ; If bit 1 of C is clear, skip ahead to #R$F5B2
 $F5AB CALL $F555    ; Call #R$F555 (inside "Move the pen one pixel (Z when it
                     ; would...")
 $F5AE JR Z,$F5CF    ; If the zero flag is set, skip ahead to #R$F5CF
 $F5B0 JR $F5B7      ; Skip ahead to #R$F5B7
*$F5B2 CALL $F54A    ; Call the routine "Move the pen one pixel (Z when it
                     ; would leave the..." (#R$F54A)
 $F5B5 JR Z,$F5CF    ; If the zero flag is set, skip ahead to #R$F5CF
*$F5B7 DEC B         ; Subtract one from B - End of a run?
 $F5B8 JR NZ,$F5CC   ; If B is not zero, skip ahead to #R$F5CC
 $F5BA BIT 2,C       ; Test bit 2 of C - Then one step along D: left with bit
                     ; 2, right without
 $F5BC JR Z,$F5C5    ; If bit 2 of C is clear, skip ahead to #R$F5C5
 $F5BE CALL $F565    ; Call #R$F565 (inside "Move the pen one pixel (Z when it
                     ; would...")
 $F5C1 JR Z,$F5CF    ; If the zero flag is set, skip ahead to #R$F5CF
 $F5C3 JR $F5CA      ; Skip ahead to #R$F5CA
*$F5C5 CALL $F55E    ; Call #R$F55E (inside "Move the pen one pixel (Z when it
                     ; would...")
 $F5C8 JR Z,$F5CF    ; If the zero flag is set, skip ahead to #R$F5CF
*$F5CA POP BC        ; Restore BC from the stack - and the run length again
 $F5CB PUSH BC       ; Save BC on the stack
*$F5CC DEC L         ; Subtract one from L - L points in all
 $F5CD JR NZ,$F5A4   ; If L is not zero, go back to #R$F5A4
*$F5CF POP BC        ; Restore BC from the stack
 $F5D0 POP HL        ; Restore HL from the stack
 $F5D1 RET           ; Return to the caller

; Plot the pen position in the current colour
;
; Sets the pixel at (D, E) and gives its character cell the ink in #R$F60B,
; keeping the cell's paper.
; .
; How it works:
; .
; 1. Find the screen byte and bit for the pixel at (D, E) (#R$F5FB).
; .
; 2. Work out the attribute byte for that character cell.
; .
; 3. Keep the cell's paper and set its ink to the pen colour at #R$F60B. If the
; paper is already that colour, use the opposite ink so the pixel shows.
; .
; 4. Set the pixel itself.
;
; Input:D X coordinate
;       E Y coordinate
;       HL is preserved; A and F are not
c$F5D2 PUSH HL       ; Save HL on the stack
 $F5D3 CALL $F5FB    ; Call the routine "Find the screen byte and bit for the
                     ; pen" (#R$F5FB) - HL = the pixel's screen byte, A its bit
                     ; (#R$F5FB)
 $F5D6 PUSH AF       ; Save AF on the stack
 $F5D7 PUSH HL       ; Save HL on the stack
 $F5D8 LD A,H        ; Copy H into A - Find its attribute byte ($58xx)
 $F5D9 AND $18       ; Keep only bits 3, 4 of A (mask $18)
 $F5DB RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $F5DC RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $F5DD RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $F5DE ADD A,$58     ; Add $58 to A
 $F5E0 LD H,A        ; Copy A into H
 $F5E1 LD A,(HL)     ; Read the byte HL points at into A - Keep the paper, set
                     ; the ink to the pen colour (#R$F60B)
 $F5E2 AND $38       ; Keep only bits 3, 4, 5 of A (mask $38)
 $F5E4 LD (HL),A     ; Store A at the address HL points to
 $F5E5 LD A,($F60B)  ; Read "Fill pattern for the picture interpreter"
                     ; (#R$F60B) into A
 $F5E8 RLCA          ; Rotate A left one place (bit 7 goes to carry and bit 0)
 $F5E9 RLCA          ; Rotate A left one place (bit 7 goes to carry and bit 0)
 $F5EA RLCA          ; Rotate A left one place (bit 7 goes to carry and bit 0)
 $F5EB CP (HL)       ; Compare A with the byte HL points at - (if the paper is
                     ; that colour too, use the opposite ink)
 $F5EC JR NZ,$F5F0   ; If A differs from the byte HL points at, skip ahead to
                     ; #R$F5F0
 $F5EE XOR $38       ; Flip in A the bits that are set in $38
*$F5F0 RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $F5F1 RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $F5F2 RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $F5F3 OR (HL)       ; Set in A the bits that are set in the byte HL points at
 $F5F4 LD (HL),A     ; Store A at the address HL points to
 $F5F5 POP HL        ; Restore HL from the stack - Then set the pixel
 $F5F6 POP AF        ; Restore AF from the stack
 $F5F7 OR (HL)       ; Set in A the bits that are set in the byte HL points at
 $F5F8 LD (HL),A     ; Store A at the address HL points to
 $F5F9 POP HL        ; Restore HL from the stack
 $F5FA RET           ; Return to the caller

; Find the screen byte and bit for the pen
;
; The ROM's PIXEL-ADD (#LINK(rom_symbols#a22AA)($22AA)) with B = y and C = x,
; then a mask for the bit.
;
;  Input:D, E The pen position
; Output:HL The screen byte
;        A The bit mask
;        BC Kept
c$F5FB PUSH BC       ; Save BC on the stack - B = E (y), C = D (x): the ROM's
                     ; pixel address routine (#LINK(rom_symbols#a22AA)($22AA))
                     ; gives HL = the screen byte, A = the bit position
 $F5FC LD B,E        ; Copy E into B
 $F5FD LD C,D        ; Copy D into C
 $F5FE CALL $22AA    ; Call the ROM pixel-address routine
                     ; (#LINK(rom_symbols#a22AA)($22AA))
 $F601 LD B,A        ; Copy A into B - Turn the position into a mask: one bit
                     ; rotated into place
 $F602 INC B         ; Add one to B
 $F603 LD A,$01      ; Load A with $01
*$F605 RRC A         ; Rotate A right
 $F607 DJNZ $F605    ; Count B down and, while it is not zero, go back to
                     ; #R$F605
 $F609 POP BC        ; Restore BC from the stack - Return the screen byte in HL
                     ; and the mask in A
 $F60A RET           ; Return to the caller

; Fill pattern for the picture interpreter
;
; Set by #R$F490 (A on entry) and used while filling. CORRECTED: the automatic
; split had this as code.
b$F60B DEFB $38      ; Fill pattern

; Which rooms have a picture
;
; 14 three-byte entries (room, address of its picture), ended by $FF; #R$A0D8
; points here and #R$A25D searches it (#R$D34E) when a room is described with
; pictures switched on (#R$A00A($A011)). Rooms 54 and 55 share one picture.
b$F60C DEFB $05,$47,$FF ; Room 5 (baker street): #R$FF47
 $F60F DEFB $4A,$82,$FE ; Room 74 (daphnes room): #R$FE82
 $F612 DEFB $47,$A8,$FD ; Room 71 (browns library): #R$FDA8
 $F615 DEFB $59,$ED,$FC ; Room 89 (west side): #R$FCED
 $F618 DEFB $58,$3A,$FC ; Room 88 (east side): #R$FC3A
 $F61B DEFB $36,$6E,$FB ; Room 54 (platform one): #R$FB6E
 $F61E DEFB $37,$6E,$FB ; Room 55 (platform two): #R$FB6E
 $F621 DEFB $0B,$AA,$FA ; Room 11 (scotland yard): #R$FAAA
 $F624 DEFB $3E,$F0,$F9 ; Room 62 (browns front gate): #R$F9F0
 $F627 DEFB $06,$28,$F9 ; Room 6 (entrance hallway): #R$F928
 $F62A DEFB $5C,$68,$F8 ; Room 92 (jones front gate): #R$F868
 $F62D DEFB $5F,$BE,$F7 ; Room 95 (small room): #R$F7BE
 $F630 DEFB $3D,$ED,$F6 ; Room 61 (basils bedroom): #R$F6ED
 $F633 DEFB $0C,$38,$F6 ; Room 12 (slater street): #R$F638
 $F636 DEFB $FF,$00     ; End marker, and a spare byte

