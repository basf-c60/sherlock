 $BB8A CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $BB8D RET            ; Return to the caller
*$BB8E LD A,($BA1D)   ; Read #R$BA1B($BA1D) in "Variables used by the code at
                      ; #R$BA20-#R$BF58" into A - #R$BA1B($BA1D) zero: go to
                      ; the summary at #R$BBC9
 $BB91 AND A          ; Test A for zero (this leaves A as it was and clears
                      ; carry)
 $BB92 JR Z,$BBC9     ; If A is zero, jump on to #R$BBC9
 $BB94 LD IX,($BA1E)  ; Read #R$BA1B($BA1E) in "Variables used by the code at
                      ; #R$BA20-#R$BF58" into IX - Otherwise IX = the last
                      ; record found (#R$BA1B($BA1E))
 $BB98 PUSH IX        ; Save IX on the stack
 $BB9A CALL $BE5A     ; Step over it (#R$BE5A)...
*$BB9D LD A,(IX+$03)  ; Read byte +3 of the record at IX into A - ...and look
                      ; at what follows for records with flags bits 7-6 = 10 or
