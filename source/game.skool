 $D7F4 LD A,L        ; Copy L into A
 $D7F5 OR H          ; Set in A the bits that are set in H
 $D7F6 RET NZ        ; If the result is not zero, return
 $D7F7 JP $DC15      ; Jump on to the routine "Fail: A = 0, HL = 0, Z set"
