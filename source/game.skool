 $BBA0 AND $C0        ; Keep only bits 6, 7 of A (mask $C0)
 $BBA2 CP $80         ; Compare A with $80
 $BBA4 JR Z,$BBB1     ; If A equals $80, skip ahead to #R$BBB1
 $BBA6 BIT 3,(IX+$03) ; Test bit 3 of byte +3 of the record at IX
 $BBAA JR NZ,$BBB1    ; If bit 3 of byte +3 of the record at IX is set, skip
                      ; ahead to #R$BBB1
 $BBAC CALL $BE72     ; Call the routine "Step IX over a whole group of case
                      ; records" (#R$BE72)
 $BBAF JR $BB9D       ; Go back to #R$BB9D
*$BBB1 POP IX         ; Restore IX from the stack - Restore IX; NZ: the 'do not
                      ; believe you have the evidence' reply #R$72A6 (#R$BBC4)
 $BBB3 JR NZ,$BBC4    ; If the zero flag is clear, skip ahead to #R$BBC4
 $BBB5 LD HL,$7295    ; Z: reply #R$7295
*$BBB8 PUSH IX        ; Save IX on the stack - Print the reply with IX as the
                      ; subject
 $BBBA CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $BBBD RET            ; Return to the caller
; This entry point is used by the routine at #R$BA67.
*$BBBE LD HL,$7243    ; Point HL at the message "YOU SAY" WHAT"." (#R$7243) -
                      ; Reply #R$7243
 $BBC1 JP $A59F       ; Go back to the routine "Print the message at HL"
                      ; (#R$A59F)
*$BBC4 LD HL,$72A6    ; Point HL at the message "YOU SAY" I DO NOT BELIEVE THAT
                      ; YOU HAVE THE... (#R$72A6)
 $BBC7 JR $BBB8       ; Go back to #R$BBB8
*$BBC9 CALL $BC46     ; Summary: try to prove every waiting statement (#R$BC46)
 $BBCC CALL $BC9C     ; Call the routine "Find the first waiting statement that
