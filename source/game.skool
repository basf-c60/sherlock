*$BC43 OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller - Return NZ
 $BC45 RET            ; Return to the caller

; Check every statement that is waiting to be proven
;
; Walks the case table (#R$9965) and, for each statement with bit 0 set and bit
; 5 clear, tries to prove it (#R$BCC9).
; .
; How it works:
; .
; 1. Push every statement of the case table at #R$9965 that is waiting (bit 0
; of +3 set) and is not one of the bit-5 kind, ending the list with a 0.
; .
; 2. Pop them one at a time and try to prove each (#R$BCC9).
;
; Output:Each waiting statement of the case table checked and, if provable,
; .           marked
c$BC46 LD IX,$9965    ; Point IX at "The case: statements about the crime, and
                      ; the..." (#R$9965)
 $BC4A LD HL,$0000    ; Load HL with $0000 - A 0 on the stack marks the end of
                      ; the list
 $BC4D PUSH HL        ; Save HL on the stack
*$BC4E LD A,(IX+$00)  ; Read the first byte of the record at IX into A - Walk
                      ; the case table; $FF ends it
 $BC51 CP $FF         ; Compare A with $FF
 $BC53 JR Z,$BC68     ; If A equals $FF, skip ahead to #R$BC68
 $BC55 BIT 0,(IX+$03) ; Test bit 0 of byte +3 of the record at IX - Push each
                      ; statement that is waiting (bit 0) and not of the bit-5
                      ; kind
 $BC59 JR Z,$BC63     ; If bit 0 of byte +3 of the record at IX is clear, skip
                      ; ahead to #R$BC63
 $BC5B BIT 5,(IX+$03) ; Test bit 5 of byte +3 of the record at IX
 $BC5F JR NZ,$BC63    ; If bit 5 of byte +3 of the record at IX is set, skip
                      ; ahead to #R$BC63
 $BC61 PUSH IX        ; Save IX on the stack
*$BC63 CALL $BE5A     ; Call the routine "Step IX over one case record (4
                      ; bytes, or 6 with a..." (#R$BE5A) - Next statement
                      ; (#R$BE5A)
 $BC66 JR $BC4E       ; Go back to #R$BC4E
*$BC68 POP HL         ; Restore HL from the stack - Then pop them one by one
                      ; and try to prove each (#R$BCC9)
 $BC69 LD A,H         ; Copy H into A
 $BC6A OR L           ; Set in A the bits that are set in L
 $BC6B RET Z          ; If the result is zero, return
 $BC6C PUSH HL        ; Save HL on the stack
 $BC6D POP IX         ; Restore IX from the stack
 $BC6F CALL $BCC9     ; Call the routine "Try to prove statement IX" (#R$BCC9)
 $BC72 JR $BC68       ; Go back to #R$BC68

; Count the waiting statements that can now be proven
;
; B = how many; IX (#R$BA1B($BA1E)) = the last one. Read from the code.
;
; Output:A, B How many waiting statements can now be proven
;        IX The last of them ($BA1E)
c$BC74 LD IX,$9965    ; Point IX at "The case: statements about the crime, and
                      ; the..." (#R$9965) - Walk the case table (#R$9965) to
                      ; its $FF end; B counts
 $BC78 LD B,$00       ; Load B with $00
*$BC7A LD A,(IX+$00)  ; Read the first byte of the record at IX into A
 $BC7D CP $FF         ; Compare A with $FF
 $BC7F JR Z,$BC96     ; If A equals $FF, skip ahead to #R$BC96
 $BC81 BIT 0,(IX+$03) ; Test bit 0 of byte +3 of the record at IX - Only
                      ; statements Holmes has been told (+3 bit 0)...
 $BC85 JR Z,$BC91     ; If bit 0 of byte +3 of the record at IX is clear, skip
                      ; ahead to #R$BC91
 $BC87 CALL $BCC9     ; Call the routine "Try to prove statement IX" (#R$BCC9)
                      ; - ...that can now be proved (#R$BCC9)
 $BC8A JR Z,$BC91     ; If the zero flag is set, skip ahead to #R$BC91
 $BC8C LD ($BA1E),IX  ; Store IX in #R$BA1B($BA1E) in "Variables used by the
                      ; code at #R$BA20-#R$BF58" - Remember the last one found
                      ; (#R$BA1B($BA1E))
 $BC90 INC B          ; Add one to B
*$BC91 CALL $BE5A     ; Call the routine "Step IX over one case record (4
                      ; bytes, or 6 with a..." (#R$BE5A) - Next record
                      ; (#R$BE5A)
 $BC94 JR $BC7A       ; Go back to #R$BC7A
*$BC96 LD A,B         ; Copy B into A - A = how many; IX = the last of them
 $BC97 LD IX,($BA1E)  ; Read #R$BA1B($BA1E) in "Variables used by the code at
                      ; #R$BA20-#R$BF58" into IX
 $BC9B RET            ; Return to the caller

; Find the first waiting statement that cannot be proven yet
;
; IX (#R$BA1B($BA1E)) = that statement; B = how many there are. Read from the
; code.
;
; Output:B How many waiting statements cannot be proven yet
;        IX The first of them ($BA1E)
c$BC9C LD IX,$9965    ; Point IX at "The case: statements about the crime, and
                      ; the..." (#R$9965) - As #R$BC74, but for the statements
                      ; that cannot yet be proved
 $BCA0 LD B,$00       ; Load B with $00
*$BCA2 LD A,(IX+$00)  ; Read the first byte of the record at IX into A
 $BCA5 CP $FF         ; Compare A with $FF
 $BCA7 JR Z,$BCC4     ; If A equals $FF, skip ahead to #R$BCC4
 $BCA9 BIT 0,(IX+$03) ; Test bit 0 of byte +3 of the record at IX
 $BCAD JR Z,$BCBD     ; If bit 0 of byte +3 of the record at IX is clear, skip
                      ; ahead to #R$BCBD
 $BCAF CALL $BCC9     ; Call the routine "Try to prove statement IX" (#R$BCC9)
                      ; - Told but not provable...
 $BCB2 JR NZ,$BCBD    ; If the zero flag is clear, skip ahead to #R$BCBD
 $BCB4 LD A,B         ; Copy B into A - ...the first one is remembered
                      ; (#R$BA1B($BA1E))
 $BCB5 INC B          ; Add one to B
 $BCB6 AND A          ; Test A for zero (this leaves A as it was and clears
                      ; carry)
 $BCB7 JR NZ,$BCBD    ; If A is not zero, skip ahead to #R$BCBD
 $BCB9 LD ($BA1E),IX  ; Store IX in #R$BA1B($BA1E) in "Variables used by the
                      ; code at #R$BA20-#R$BF58"
*$BCBD PUSH BC        ; Save BC on the stack
 $BCBE CALL $BE72     ; Call the routine "Step IX over a whole group of case
                      ; records" (#R$BE72) - Next group of records (#R$BE72)
 $BCC1 POP BC         ; Restore BC from the stack
 $BCC2 JR $BCA2       ; Go back to #R$BCA2
*$BCC4 LD IX,($BA1E)  ; Read #R$BA1B($BA1E) in "Variables used by the code at
                      ; #R$BA20-#R$BF58" into IX - IX = the first unprovable
                      ; statement
 $BCC8 RET            ; Return to the caller

; Try to prove statement IX
;
; If it has evidence (flags bit 2), checks it (#R$BF08) and fails if it is not
; all there. Then marks it proven (bit 1 set, bit 0 clear) and runs its routine
; (+4/+5) if bit 4 is set; a statement with bit 5 set is only marked as waiting
; (bit 0). Z = proven.
; .
; How it works:
; .
; 1. If the statement has evidence (flags bit 2), check all of it (#R$BF08). If
; any is missing, return NZ: not proved.
; .
; 2. If flags bit 5 is set, the statement is only marked as waiting (bit 0 set)
; and Z is returned. It will be settled later by #R$BC46.
; .
; 3. Otherwise mark it proved (bit 1 set, bit 0 clear). If bit 4 is set, run
; its routine at +4/+5 (#R$D1DB): the routines from #R$99FC on, which print
; what Lestrade or Watson says and may set a marker.
; .
; 4. Return Z: proved.
;
;  Input:IX The statement record
; Output:F Z if proved (or marked as waiting), NZ if the evidence is not all
; .        there
c$BCC9 BIT 2,(IX+$03) ; Test bit 2 of byte +3 of the record at IX - Does the
                      ; statement have evidence (flags bit 2)?
 $BCCD JR Z,$BCDA     ; If bit 2 of byte +3 of the record at IX is clear, skip
                      ; ahead to #R$BCDA
 $BCCF PUSH IX        ; Save IX on the stack - Yes: check the evidence
                      ; (#R$BF08)...
 $BCD1 PUSH BC        ; Save BC on the stack
 $BCD2 CALL $BF08     ; Call the routine "Check every piece of evidence in the
                      ; group after IX..." (#R$BF08) - Yes: is it all there
                      ; (#R$BF08)? If not, NZ - not proven
 $BCD5 POP BC         ; Restore BC from the stack
 $BCD6 POP IX         ; Restore IX from the stack
 $BCD8 JR Z,$BD03     ; ...not all there: fail, NZ (#R$BD03)
*$BCDA BIT 5,(IX+$03) ; Test bit 5 of byte +3 of the record at IX - Flags bit 5
                      ; set?
 $BCDE JR Z,$BCE6     ; If bit 5 of byte +3 of the record at IX is clear, skip
                      ; ahead to #R$BCE6
 $BCE0 SET 0,(IX+$03) ; Set bit 0 of byte +3 of the record at IX - Then only
                      ; mark it as waiting (bit 0)
 $BCE4 JR $BD01       ; Skip ahead to #R$BD01
*$BCE6 SET 1,(IX+$03) ; Otherwise mark it proven (bit 1 set)...
 $BCEA RES 0,(IX+$03) ; ...and bit 0 clear
 $BCEE BIT 4,(IX+$03) ; Test bit 4 of byte +3 of the record at IX - Bit 4 set:
                      ; it has a routine...
 $BCF2 JR Z,$BD01     ; If bit 4 of byte +3 of the record at IX is clear, skip
                      ; ahead to #R$BD01
 $BCF4 LD L,(IX+$04)  ; Read byte +4 of the record at IX into L - ...run the
                      ; routine at +4/+5 (#R$D1DB)
 $BCF7 LD H,(IX+$05)  ; Read byte +5 of the record at IX into H
 $BCFA PUSH IX        ; Save IX on the stack
 $BCFC CALL $D1DB     ; Call the routine "Jump to HL" (#R$D1DB)
 $BCFF POP IX         ; Restore IX from the stack
*$BD01 XOR A          ; Set A to zero, which sets the zero flag for the caller
                      ; - Z: proven
 $BD02 RET            ; Return to the caller
*$BD03 OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller - NZ: not proven
 $BD05 RET            ; Return to the caller
; This entry point is used by the routine at #R$BA67.
*$BD06 PUSH IY        ; Save IY on the stack - Look for a remembered statement
                      ; (list at #R$9FF2($9FF6), nodes of subject, relation,
                      ; object) that shares one end with the statement at IX
                      ; but
 $BD08 PUSH IX        ; Save IX on the stack
 $BD0A POP IY         ; Restore IY from the stack
 $BD0C LD IX,$9FF6    ; Point IX at #R$9FF2($9FF6) in "Game variables" - IX
                      ; walks the list (#R$A0F7)
*$BD10 CALL $A0F7     ; Call the routine "Move IX to the next node of a list"
                      ; (#R$A0F7)
 $BD13 JR Z,$BD46     ; End of list: nothing found, NZ (#R$BD46)
 $BD15 LD B,(IX+$02)  ; Read byte +2 of the record at IX into B - Compare
                      ; subject with subject, subject with object, object with
                      ; object, object with subject in turn...
 $BD18 LD C,(IY+$02)  ; Read byte +2 of the record at IY into C
 $BD1B LD A,(IX+$00)  ; Read the first byte of the record at IX into A
 $BD1E CP (IY+$00)    ; Compare A with the first byte of the record at IY
 $BD21 JR Z,$BD3E     ; If A equals the first byte of the record at IY, skip
                      ; ahead to #R$BD3E
 $BD23 LD C,(IY+$00)  ; Read the first byte of the record at IY into C
 $BD26 CP (IY+$02)    ; Compare A with byte +2 of the record at IY
 $BD29 JR Z,$BD3E     ; If A equals byte +2 of the record at IY, skip ahead to
                      ; #R$BD3E
 $BD2B LD B,(IX+$00)  ; Read the first byte of the record at IX into B
 $BD2E LD A,(IX+$02)  ; Read byte +2 of the record at IX into A
 $BD31 CP (IY+$02)    ; Compare A with byte +2 of the record at IY
 $BD34 JR Z,$BD3E     ; If A equals byte +2 of the record at IY, skip ahead to
                      ; #R$BD3E
 $BD36 LD C,(IY+$02)  ; Read byte +2 of the record at IY into C
 $BD39 CP (IY+$00)    ; Compare A with the first byte of the record at IY
 $BD3C JR NZ,$BD10    ; If A differs from the first byte of the record at IY,
                      ; go back to #R$BD10
*$BD3E LD A,B         ; ...B and C then hold the two things that do not match;
 $BD3F CP C           ; Compare A with C - if they are the same thing, try the
                      ; next node
 $BD40 JR Z,$BD10     ; If A equals C, go back to #R$BD10
 $BD42 POP IY         ; Restore IY from the stack - Found: B and C are the pair
                      ; to connect, Z
 $BD44 XOR A          ; Set A to zero, which sets the zero flag for the caller
 $BD45 RET            ; Return to the caller
*$BD46 OR $01         ; Set bit 0 of A
 $BD48 POP IY         ; Restore IY from the stack
 $BD4A RET            ; Return to the caller
; This entry point is used by the routine at #R$BA67.
*$BD4B LD IX,$9A7D    ; Watson's own list (#R$9A7D)
 $BD4F JR $BD55       ; Join the walk

; Find the statement $BA19-$BA1B in the case table
;
; Addresses named in the title: #R$BA13($BA19), #R$BA1B.
; .
; Z with IX = the statement if found (#R$BD69 compares subject, relation and
; object in that order). #R$BD4B searches Watson's own list at #R$9A7D the same
; way.
; .
; How it works:
; .
; 1. Start at the first record of the case table (#R$9965), or - from #R$BD4B -
; at Watson's own list (#R$9A7D).
; .
; 2. A first byte of $FF ends the table: return NZ.
; .
; 3. Compare the record with the statement being looked for: its relation
; (#R$BA13($BA1A)) with byte +1, then its subject (#R$BA13($BA19)) with +0,
; then its object (#R$BA1B) with +2. All three must match.
; .
; 4. On a match return Z with IX at the record; otherwise step to the next
; record (#R$BE5A), skipping any evidence records that belong to this one, and
; repeat.
;
;  Input:$BA19 The statement's subject
;        $BA1A Its relation
;        $BA1B Its object
; Output:F Z if found, NZ if not
;        IX The record, if found
c$BD51 LD IX,$9965    ; The case table (#R$9965)
; This entry point is used by the routine at #R$BCC9.
*$BD55 LD A,(IX+$00)  ; Read the first byte of the record at IX into A - First
                      ; byte $FF ends the table
 $BD58 CP $FF         ; Compare A with $FF
 $BD5A JR Z,$BD66     ; If A equals $FF, skip ahead to #R$BD66
 $BD5C CALL $BD69     ; Does this record match the statement (#R$BD69)?
 $BD5F JR Z,$BD68     ; Yes: Z, IX = the record
 $BD61 CALL $BE5A     ; Call the routine "Step IX over one case record (4
                      ; bytes, or 6 with a..." (#R$BE5A) - Step to the next
                      ; record (#R$BE5A)
 $BD64 JR $BD55       ; Go back to #R$BD55
*$BD66 OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller - End of table: NZ
*$BD68 RET            ; Return to the caller
*$BD69 LD A,($BA1A)   ; Read #R$BA13($BA1A) in "Variables used by the code at
                      ; #R$BA20-#R$BF58" into A - Compare the relation
                      ; (#R$BA13($BA1A)) with +1...
 $BD6C CP (IX+$01)    ; Compare A with byte +1 of the record at IX
 $BD6F RET NZ         ; If A differs from byte +1 of the record at IX, return
 $BD70 LD A,($BA19)   ; Read #R$BA13($BA19) in "Variables used by the code at
                      ; #R$BA20-#R$BF58" into A - ...then the subject
                      ; (#R$BA13($BA19)) with +0...
 $BD73 CP (IX+$00)    ; Compare A with the first byte of the record at IX
 $BD76 RET NZ         ; If A differs from the first byte of the record at IX,
                      ; return
 $BD77 LD A,($BA1B)   ; Read #R$BA1B in "Variables used by the code at
                      ; #R$BA20-#R$BF58" into A - ...then the object (#R$BA1B)
                      ; with +2; Z if all three agree
 $BD7A CP (IX+$02)    ; Compare A with byte +2 of the record at IX
 $BD7D RET            ; Return to the caller
; This entry point is used by the routines at #R$BA67 and #R$BB67.
*$BD7E PUSH IY        ; Save IY on the stack - The statement's subject: the
                      ; node's words at +$18...
 $BD80 POP HL         ; Restore HL from the stack
 $BD81 LD DE,$0018    ; Load DE with $0018, the amount that is added next
 $BD84 ADD HL,DE      ; Add DE to HL
 $BD85 BIT 7,(IY+$19) ; Test bit 7 of byte +25 of the record at IY - ...or for
                      ; HE the last person named (#R$9FF2($9FF6))...
 $BD89 JR Z,$BD8E     ; If bit 7 of byte +25 of the record at IY is clear, skip
                      ; ahead to #R$BD8E
 $BD8B LD HL,$9FF6    ; Point HL at #R$9FF2($9FF6) in "Game variables"
*$BD8E BIT 6,(IY+$19) ; Test bit 6 of byte +25 of the record at IY - ...or for
                      ; IT/THEY the last thing (#R$9FFA($9FFC))
 $BD92 JR Z,$BD97     ; If bit 6 of byte +25 of the record at IY is clear, skip
                      ; ahead to #R$BD97
 $BD94 LD HL,$9FFC    ; Point HL at #R$9FFA($9FFC) in "Game variables"
*$BD97 LD DE,$B172    ; Point DE at #R$B16D($B172) in "Parser variables" - into
                      ; the first object slot; the words at +8 into the second
 $BD9A LD BC,$0006    ; Load BC with $0006
 $BD9D LDIR           ; Copy BC bytes from where HL points to where DE points,
                      ; counting up
 $BD9F PUSH IY        ; Save IY on the stack
 $BDA1 POP HL         ; Restore HL from the stack
 $BDA2 LD DE,$0008    ; Load DE with $0008, the amount that is added next
 $BDA5 ADD HL,DE      ; Add DE to HL
 $BDA6 LD DE,$B178    ; Point DE at #R$B175($B178) in "Parser variables"
 $BDA9 LD BC,$0006    ; Load BC with $0006
 $BDAC LDIR           ; Copy BC bytes from where HL points to where DE points,
                      ; counting up
 $BDAE LD L,(IY+$00)  ; Read the first byte of the record at IY into L -
                      ; #R$BA13($BA17) = the verb word; then make the statement
                      ; (#R$BDC2)
 $BDB1 LD A,(IY+$01)  ; Read byte +1 of the record at IY into A
 $BDB4 AND $0F        ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $BDB6 LD H,A         ; Copy A into H
 $BDB7 LD ($BA17),HL  ; Store HL in #R$BA13($BA17) in "Variables used by the
                      ; code at #R$BA20-#R$BF58"
 $BDBA PUSH IY        ; Save IY on the stack
 $BDBC CALL $BDC2     ; Call the routine "Turn the player's remark into a
                      ; statement" (#R$BDC2)
 $BDBF POP IY         ; Restore IY from the stack
 $BDC1 RET            ; Return to the caller

; Turn the player's remark into a statement
;
; The relation is the position of the remark's verb in the list at #R$994D; the
; subject and object are the first two things named (#R$BE3C, #R$BE4B), each
; copied as a 6-byte entry into #R$9FF2($9FF6) (people) or #R$9FFA($9FFC)
; (things) by #R$BE22. Carry set if the remark names more than that. Read from
; the code.
; .
; #R$BE22 copies thing A's 6-byte entry to #R$9FF2($9FF6) (a person, +5 bit 6)
; or #R$9FFA($9FFC); #R$BE3C and #R$BE4B step through the parser's object slots
; at #R$B16D($B172) and #R$B175($B178). CORRECTED: the automatic split had
; #R$BE19($BE1A)-#R$BE59 as data.
; .
; How it works:
; .
; 1. Start both searches at the top of the thing index (#R$D04F).
; .
; 2. Look the remark's verb word up in the list of relation words at #R$994D.
; Its position in that list (counting from 1) is the statement's relation. If
; it is not there the remark is not a statement: return Z.
; .
; 3. Allow things that are not in the room to be named (#R$A032($A038) = 2).
; .
; 4. Find the thing that matches the subject words (#R$BE3C). None means it is
; not a statement. A second match means the subject is ambiguous: return carry.
; Otherwise remember it and copy its six-byte entry to #R$9FF2($9FF6) if it is
; a person or #R$9FFA($9FFC) if not (#R$BE22), so that HE, IT and THEY can
; refer to it later.
; .
; 5. Do the same for the object words (#R$BE4B).
; .
; 6. Return NZ: the statement's subject, relation and object are in
; #R$BA13($BA19), #R$BA13($BA1A) and #R$BA1B.
;
;  Input:$BA17 The remark's verb word
; Output:F NZ if it made a statement, Z if it is not one
;        Carry set if a name was ambiguous
c$BDC2 CALL $D04F     ; Call the routine "IX = just before the start of the
                      ; thing index (#R$8B6F)" (#R$D04F) - Both searches start
                      ; at the top of the thing index
 $BDC5 LD ($BA13),IX  ; Store IX in "Variables used by the code at
                      ; #R$BA20-#R$BF58" (#R$BA13)
 $BDC9 LD ($BA15),IX  ; Store IX in #R$BA13($BA15) in "Variables used by the
                      ; code at #R$BA20-#R$BF58"
 $BDCD LD DE,($BA17)  ; DE = the remark's verb word
 $BDD1 LD HL,$994D    ; Point HL at "The case's relation words" (#R$994D) -
                      ; Find it in the list of relation words at #R$994D (B
                      ; counts from 1)
 $BDD4 LD B,$01       ; Load B with $01
*$BDD6 LD A,(HL)      ; Read the byte HL points at into A
 $BDD7 INC HL         ; Step HL on to the next byte
 $BDD8 OR (HL)        ; Set in A the bits that are set in the byte HL points at
 $BDD9 DEC HL         ; Step HL back one byte
 $BDDA RET Z          ; If the result is zero, return - Not there (the list
                      ; ends with 0): not a statement (Z)
 $BDDB LD A,E         ; Copy E into A
 $BDDC CP (HL)        ; Compare A with the byte HL points at
 $BDDD JR NZ,$BDE5    ; If A differs from the byte HL points at, skip ahead to
                      ; #R$BDE5
 $BDDF INC HL         ; Step HL on to the next byte
 $BDE0 LD A,D         ; Copy D into A
 $BDE1 CP (HL)        ; Compare A with the byte HL points at
 $BDE2 DEC HL         ; Step HL back one byte
 $BDE3 JR Z,$BDEA     ; If A equals the byte HL points at, skip ahead to
                      ; #R$BDEA
*$BDE5 INC HL         ; Step HL on to the next byte
 $BDE6 INC HL         ; Step HL on to the next byte
 $BDE7 INC B          ; Add one to B
 $BDE8 JR $BDD6       ; Go back to #R$BDD6
*$BDEA LD A,B         ; Copy B into A - Its position is the relation
 $BDEB LD ($BA1A),A   ; Store A in #R$BA13($BA1A) in "Variables used by the
                      ; code at #R$BA20-#R$BF58"
 $BDEE LD A,$02       ; Load A with $02 - The things named need not be here
                      ; (#R$A032($A038) = 2)
 $BDF0 LD ($A038),A   ; Store A in #R$A032($A038) in "Game variables"
 $BDF3 CALL $BE3C     ; Call #R$BE3C (inside "Turn the player's remark into a
                      ; statement") - The first thing matching the subject
                      ; words
 $BDF6 CP $FF         ; Compare A with $FF
 $BDF8 RET Z          ; If A equals $FF, return - None: not a statement
 $BDF9 LD ($BA19),A   ; Store A in #R$BA13($BA19) in "Variables used by the
                      ; code at #R$BA20-#R$BF58"
 $BDFC CALL $BE3C     ; Call #R$BE3C (inside "Turn the player's remark into a
                      ; statement") - More than one: carry (which one is
                      ; meant?)
 $BDFF CP $FF         ; Compare A with $FF
 $BE01 JR NZ,$BE3A    ; If A differs from $FF, jump on to #R$BE3A
 $BE03 LD A,($BA19)   ; Read #R$BA13($BA19) in "Variables used by the code at
                      ; #R$BA20-#R$BF58" into A - Copy the subject's entry
 $BE06 CALL $BE22     ; Call #R$BE22 (inside "Turn the player's remark into a
                      ; statement")
 $BE09 CALL $BE4B     ; Call #R$BE4B (inside "Turn the player's remark into a
                      ; statement") - The same for the object words
 $BE0C CP $FF         ; Compare A with $FF
 $BE0E RET Z          ; If A equals $FF, return
 $BE0F LD ($BA1B),A   ; Store A in #R$BA1B in "Variables used by the code at
                      ; #R$BA20-#R$BF58"
 $BE12 CALL $BE4B     ; Call #R$BE4B (inside "Turn the player's remark into a
                      ; statement")
 $BE15 CP $FF         ; Compare A with $FF
 $BE17 JR NZ,$BE3A    ; If A differs from $FF, skip ahead to #R$BE3A
 $BE19 LD A,($BA1B)   ; Read #R$BA1B in "Variables used by the code at
                      ; #R$BA20-#R$BF58" into A
 $BE1C CALL $BE22     ; Call #R$BE22 (inside "Turn the player's remark into a
                      ; statement")
 $BE1F OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller - Succeed (NZ)
 $BE21 RET            ; Return to the caller
*$BE22 CALL $D237     ; Call the routine "Resolve an id (in A) to its full
                      ; entity record" (#R$D237) - HL = the thing's record
 $BE25 PUSH IX        ; Save IX on the stack
 $BE27 POP HL         ; Restore HL from the stack
 $BE28 BIT 6,(IX+$05) ; Test bit 6 of byte +5 of the record at IX - A person
                      ; (+5 bit 6) goes to #R$9FF2($9FF6), anything else to
                      ; #R$9FFA($9FFC)
 $BE2C LD DE,$9FF6    ; Point DE at #R$9FF2($9FF6) in "Game variables"
 $BE2F JR NZ,$BE34    ; If bit 6 of byte +5 of the record at IX is set, skip
                      ; ahead to #R$BE34
 $BE31 LD DE,$9FFC    ; Point DE at #R$9FFA($9FFC) in "Game variables"
*$BE34 LD BC,$0006    ; Load BC with $0006 - Copy six bytes
 $BE37 LDIR           ; Copy BC bytes from where HL points to where DE points,
                      ; counting up
 $BE39 RET            ; Return to the caller
*$BE3A SCF            ; Set the carry flag for the caller - Carry: ambiguous
 $BE3B RET            ; Return to the caller
*$BE3C LD IX,($BA13)  ; Read "Variables used by the code at #R$BA20-#R$BF58"
                      ; (#R$BA13) into IX - Next thing matching the subject
                      ; slot (#R$B16D($B172))
 $BE40 LD HL,$B172    ; Point HL at #R$B16D($B172) in "Parser variables"
 $BE43 CALL $D36A     ; Call the routine "Find the next thing that matches a
                      ; word slot of the..." (#R$D36A)
 $BE46 LD ($BA13),IX  ; Store IX in "Variables used by the code at
                      ; #R$BA20-#R$BF58" (#R$BA13)
 $BE4A RET            ; Return to the caller
*$BE4B LD IX,($BA15)  ; Read #R$BA13($BA15) in "Variables used by the code at
                      ; #R$BA20-#R$BF58" into IX - Next thing matching the
                      ; object slot (#R$B175($B178))
 $BE4F LD HL,$B178    ; Point HL at #R$B175($B178) in "Parser variables"
 $BE52 CALL $D36A     ; Call the routine "Find the next thing that matches a
                      ; word slot of the..." (#R$D36A)
 $BE55 LD ($BA15),IX  ; Store IX in #R$BA13($BA15) in "Variables used by the
                      ; code at #R$BA20-#R$BF58"
 $BE59 RET            ; Return to the caller

; Step IX over one case record (4 bytes, or 6 with a routine)
;
; Used by the routines at #R$BB67, #R$BC46, #R$BC74, #R$BD51, #R$BE72 and
; #R$BF08.
;
;  Input:IX A case record
; Output:IX The next case record (4 bytes on, or 6 if a routine address
; .         follows)
;        AF Kept
c$BE5A PUSH AF        ; Save AF on the stack - Step IX four bytes on...
 $BE5B LD DE,$0002    ; Load DE with $0002, the amount that is added next
 $BE5E ADD IX,DE      ; Add DE to IX
 $BE60 ADD IX,DE      ; Add DE to IX
 $BE62 BIT 5,(IX-$01) ; Test bit 5 of byte -1 of the record at IX - ...and two
                      ; more if the record's last byte has bit 5 or bit 4 set
                      ; (a routine address follows)
 $BE66 JR NZ,$BE6E    ; If bit 5 of byte -1 of the record at IX is set, skip
                      ; ahead to #R$BE6E
 $BE68 BIT 4,(IX-$01) ; Test bit 4 of byte -1 of the record at IX
 $BE6C JR Z,$BE70     ; If bit 4 of byte -1 of the record at IX is clear, skip
                      ; ahead to #R$BE70
*$BE6E ADD IX,DE      ; Add DE to IX
*$BE70 POP AF         ; Restore AF from the stack
 $BE71 RET            ; Return to the caller

; Step IX over a whole group of case records
;
; Used by the routines at #R$BB67, #R$BC9C and #R$BE91.
;
;  Input:IX The first record of a group
; Output:IX The first record after the group
;        AF Kept
c$BE72 PUSH AF       ; Save AF on the stack - B counts the nesting depth of the
                     ; group
 $BE73 LD B,$00      ; Load B with $00
*$BE75 LD C,(IX+$03) ; Read byte +3 of the record at IX into C - C = this case
                     ; record's byte 3; step IX on (#R$BE5A)
 $BE78 CALL $BE5A    ; Call the routine "Step IX over one case record (4 bytes,
                     ; or 6 with a..." (#R$BE5A)
 $BE7B BIT 3,C       ; Test bit 3 of C - Bit 3 closes a level (not below zero)
 $BE7D JR Z,$BE84    ; If bit 3 of C is clear, skip ahead to #R$BE84
 $BE7F LD A,B        ; Copy B into A
 $BE80 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $BE81 JR Z,$BE84    ; If A is zero, skip ahead to #R$BE84
 $BE83 DEC B         ; Subtract one from B
*$BE84 BIT 2,C       ; Test bit 2 of C - Bit 2 opens one
 $BE86 JR Z,$BE8B    ; If bit 2 of C is clear, skip ahead to #R$BE8B
 $BE88 INC B         ; Add one to B
 $BE89 JR $BE75      ; Go back to #R$BE75
*$BE8B LD A,B        ; Copy B into A - Until the depth is back to zero
 $BE8C AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $BE8D JR NZ,$BE75   ; If A is not zero, go back to #R$BE75
 $BE8F POP AF        ; Restore AF from the stack
 $BE90 RET           ; Return to the caller

; Check one piece of evidence (NZ if it holds)
;
; See the case table at #R$9965 for the four kinds. Marks it done (bit 1 set,
; bit 0 clear) when it holds.
; .
; How it works:
; .
; 1. If the evidence is already marked done (bit 1 of its flags), it holds:
; finish.
; .
; 2. The top two bits of the flags give the kind. Kind 0: both things named in
; the record must have been seen by the player (bit 7 of their +6 flags); if so
; it holds. Kind $80 is a marker that only some other routine can set, so it
; never holds by itself.
; .
; 3. Kind $40: both things must have been examined (bit 6 of +6). Then, as for
; kind $C0 (which has no test of its own), it holds only if it has no children,
; or if all of its children hold (#R$BF08).
; .
; 4. When it holds, mark it done (bit 1 set, bit 0 clear) and return NZ.
;
;  Input:IX An evidence record in the case table
; Output:F NZ if it holds, Z if not
c$BE91 BIT 1,(IX+$03) ; Test bit 1 of byte +3 of the record at IX - Already
                      ; done?
 $BE95 JR NZ,$BE72    ; If bit 1 of byte +3 of the record at IX is set, go back
                      ; to the routine "Step IX over a whole group of case
                      ; records" (#R$BE72)
 $BE97 LD A,(IX+$03)  ; Read byte +3 of the record at IX into A - Which kind of
                      ; test?
 $BE9A AND $C0        ; Keep only bits 6, 7 of A (mask $C0)
 $BE9C CP $00         ; Compare A with $00
 $BE9E JR NZ,$BECD    ; If A differs from $00, jump on to #R$BECD
 $BEA0 LD A,(IX+$00)  ; Read the first byte of the record at IX into A - Seen:
                      ; the first thing...
 $BEA3 PUSH IX        ; Save IX on the stack
 $BEA5 CALL $D237     ; Call the routine "Resolve an id (in A) to its full
                      ; entity record" (#R$D237)
 $BEA8 BIT 7,(IX+$06) ; Test bit 7 of byte +6 of the record at IX
 $BEAC POP IX         ; Restore IX from the stack
 $BEAE JR Z,$BE72     ; If the zero flag is set, go back to the routine "Step
                      ; IX over a whole group of case records" (#R$BE72)
 $BEB0 LD A,(IX+$02)  ; Read byte +2 of the record at IX into A - ...and the
                      ; second
 $BEB3 PUSH IX        ; Save IX on the stack
 $BEB5 CALL $D237     ; Call the routine "Resolve an id (in A) to its full
                      ; entity record" (#R$D237)
 $BEB8 BIT 7,(IX+$06) ; Test bit 7 of byte +6 of the record at IX
 $BEBC POP IX         ; Restore IX from the stack
 $BEBE JR Z,$BE72     ; If the zero flag is set, go back to the routine "Step
                      ; IX over a whole group of case records" (#R$BE72)
*$BEC0 SET 1,(IX+$03) ; Set bit 1 of byte +3 of the record at IX - It holds:
                      ; mark it done
 $BEC4 RES 0,(IX+$03) ; Clear bit 0 of byte +3 of the record at IX
 $BEC8 OR $01         ; Set bit 0 of A
 $BECA JP $BE72       ; Go back to the routine "Step IX over a whole group of
                      ; case records" (#R$BE72)
*$BECD CP $80         ; Compare A with $80 - Kind $80: never by itself
 $BECF JR Z,$BE72     ; If A equals $80, go back to the routine "Step IX over a
                      ; whole group of case records" (#R$BE72)
 $BED1 CP $40         ; Compare A with $40 - Kind $40: examined?
 $BED3 JR NZ,$BEF6    ; If A differs from $40, skip ahead to #R$BEF6
 $BED5 LD A,(IX+$00)  ; Read the first byte of the record at IX into A - The
                      ; first thing...
 $BED8 PUSH IX        ; Save IX on the stack
 $BEDA CALL $D237     ; Call the routine "Resolve an id (in A) to its full
                      ; entity record" (#R$D237)
 $BEDD BIT 6,(IX+$06) ; Test bit 6 of byte +6 of the record at IX
 $BEE1 POP IX         ; Restore IX from the stack
 $BEE3 JR Z,$BE72     ; If the zero flag is set, go back to the routine "Step
                      ; IX over a whole group of case records" (#R$BE72)
 $BEE5 LD A,(IX+$02)  ; Read byte +2 of the record at IX into A - ...and the
                      ; second
 $BEE8 PUSH IX        ; Save IX on the stack
 $BEEA CALL $D237     ; Call the routine "Resolve an id (in A) to its full
                      ; entity record" (#R$D237)
 $BEED BIT 6,(IX+$06) ; Test bit 6 of byte +6 of the record at IX
 $BEF1 POP IX         ; Restore IX from the stack
 $BEF3 JP Z,$BE72     ; If the zero flag is set, go back to the routine "Step
                      ; IX over a whole group of case records" (#R$BE72)
*$BEF6 BIT 2,(IX+$03) ; Test bit 2 of byte +3 of the record at IX - Children to
                      ; check as well?
 $BEFA JR Z,$BEC0     ; If bit 2 of byte +3 of the record at IX is clear, go
                      ; back to #R$BEC0
 $BEFC PUSH IX        ; Save IX on the stack - All of them
 $BEFE CALL $BF08     ; Call the routine "Check every piece of evidence in the
                      ; group after IX..." (#R$BF08)
 $BF01 POP IX         ; Restore IX from the stack
 $BF03 JR NZ,$BEC0    ; If the zero flag is clear, go back to #R$BEC0
 $BF05 JP $BE72       ; Go back to the routine "Step IX over a whole group of
                      ; case records" (#R$BE72)

; Check every piece of evidence in the group after IX (Z if one fails)
;
; Used by the routines at #R$BCC9 and #R$BE91.
;
;  Input:IX A case record
; Output:F Z if a piece of evidence fails; NZ if all are satisfied
;        IX Moved on
c$BF08 CALL $BE5A     ; Step over the first case record (#R$BE5A)
*$BF0B BIT 3,(IX+$03) ; Test bit 3 of byte +3 of the record at IX - Bit 3 (the
                      ; last of the group) noted in the flags
 $BF0F PUSH AF        ; Save AF on the stack
 $BF10 CALL $BE91     ; Is this record's evidence satisfied? (#R$BE91)
 $BF13 JR NZ,$BF18    ; If the zero flag is clear, skip ahead to #R$BF18 - Not:
                      ; Z result, stop
 $BF15 POP AF         ; Restore AF from the stack
 $BF16 XOR A          ; Set A to zero, which sets the zero flag for the caller
 $BF17 RET            ; Return to the caller
*$BF18 POP AF         ; Restore AF from the stack - Satisfied: go on to the
                      ; next record unless that was the last
 $BF19 JR Z,$BF0B     ; If the zero flag is set, go back to #R$BF0B
 $BF1B RET            ; Return to the caller

; Print a case statement: thing, relation, thing
;
; IX is a statement record of the case table (#R$9965): prints the first
; thing's name (#R$A4BC, #R$D3E8), the relation's verb words from the table at
; #R$994D (#R$BF45; relation 0 prints AND), then the second thing. Used by
; message code $05 (#R$A711). Read from the code; the output is what Lestrade
; says when a statement is waiting.
;
;  Input:IX A statement record of the case table
; Output:The statement printed: thing, relation, thing
c$BF1C LD A,(IX+$00) ; Read the first byte of the record at IX into A - The
                     ; statement's subject: thing +0 ... its name words
                     ; (#R$A4BC, +7)
 $BF1F CALL $A4BC    ; Call the routine "HL = thing A's record + 7" (#R$A4BC)
 $BF22 PUSH HL       ; Save HL on the stack
 $BF23 POP IY        ; Restore IY from the stack
 $BF25 CALL $D3E8    ; Print them (#R$D3E8)
 $BF28 CALL $BF45    ; The relation word, from the table at #R$994D (#R$BF45)
 $BF2B JR Z,$BF3D    ; Relation 0: print the word $005D instead
 $BF2D CALL $A887    ; Print the relation word (#R$A887)
*$BF30 LD A,(IX+$02) ; Read byte +2 of the record at IX into A - The
                     ; statement's object (+2): its name words
 $BF33 CALL $A4BC    ; Call the routine "HL = thing A's record + 7" (#R$A4BC)
 $BF36 PUSH HL       ; Save HL on the stack
 $BF37 POP IY        ; Restore IY from the stack
 $BF39 CALL $D3E8    ; Call the routine "Print the name words at IY" (#R$D3E8)
 $BF3C RET           ; Return to the caller - Done
*$BF3D LD DE,$005D   ; Load DE with $005D
 $BF40 CALL $A887    ; Call #R$A887 (inside "Print the dictionary word that HL
                     ; refers to")
 $BF43 JR $BF30      ; Go back to #R$BF30

; DE = the words for a statement's relation (+1)
;
; Relation n (1-11) gives entry n-1 of #R$994D, returned NZ; 0 returns Z. Read
; from the code.
;
;  Input:IX A statement record
; Output:DE The relation's words
;        F NZ if there is one; Z if the relation is 0
c$BF45 LD A,(IX+$01) ; Read byte +1 of the record at IX into A - The
                     ; statement's relation number (+1)
 $BF48 AND A         ; Clear the carry flag for the caller (A is unchanged)
 $BF49 RET Z         ; 0: none, return Z
 $BF4A DEC A         ; Subtract one from A - Relation 1-11 into an index
 $BF4B LD E,A        ; Copy A into E
 $BF4C LD D,$00      ; Load D with $00
 $BF4E LD HL,$994D   ; Point HL at "The case's relation words" (#R$994D) -
                     ; Table of relation words at #R$994D, 2 bytes each
 $BF51 ADD HL,DE     ; Add DE to HL
 $BF52 ADD HL,DE     ; Add DE to HL
 $BF53 LD E,(HL)     ; Read the byte HL points at into E - DE = the word
                     ; reference
 $BF54 INC HL        ; Step HL on to the next byte
 $BF55 LD D,(HL)     ; Read the byte HL points at into D
 $BF56 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - NZ: found
 $BF58 RET           ; Return to the caller

; Day names, and the clock text being built
;
; Seven three-letter day names (Mon-Sun) for #R$BFC6, then #R$BF6E, the
; 11-character clock text ('MON 00:00am' as it stands in the file) that #R$BF79
; fills in and prints.
t$BF59 DEFM "MonTueWedThuFriSatSun" ; Mon Tue Wed Thu Fri Sat Sun
 $BF6E DEFM "MON 00:00am"           ; The clock text

; Print the clock: day, hour, minute, a or p
;
; Builds 'Mon 08:02am' in #R$BF6E from the day (#R$9FE1), the hour (#R$9FE0),
; the minute (#R$9FDF) and the letter (#R$9FE2), and prints it in the status
; bar (#R$C1A8). Confirmed by every emulator run: the clock text is what the
; harness captures between commands.
; .
; How it works:
; .
; 1. Write the three-letter day name into the buffer at #R$BF6E, choosing it
; from the table at #R$BF59 by the day number (#R$9FE1).
; .
; 2. Write the hour (#R$9FE0) and the minute (#R$9FDF) as two digits each,
; found by repeated subtraction of ten (#R$BFBB), with the space and colon
; already in the buffer.
; .
; 3. Write the letter a or p (#R$9FE2) and print the eleven characters, for
; example 'Mon 08:02am', in the status bar (#R$C1A8).
;
; Output:The clock printed in the status bar ($C1A8)
c$BF79 LD IX,$BF6E   ; IX = the text buffer #R$BF6E ('Mon 08:02am'; the space
                     ; and colon are already in it)
 $BF7D LD A,($9FE1)  ; Day number...
 $BF80 LD HL,$BF59   ; ...three letters per day from the table at #R$BF59
                     ; (#R$BFC6)
 $BF83 CALL $BFC6    ; ...as three letters
 $BF86 INC IX        ; Step over the space
 $BF88 LD A,($9FE0)  ; Read the hour, 1-12 (#R$9FE0) into A - Hour: two digits
                     ; (#R$BFB0)
 $BF8B CALL $BFB0    ; Call #R$BFB0 (inside "Print the clock: day, hour,
                     ; minute, a or p")
 $BF8E INC IX        ; Step over the colon
 $BF90 LD A,($9FDF)  ; Read the minute (#R$9FDF) into A - Minute: two digits
 $BF93 CALL $BFB0    ; Call #R$BFB0 (inside "Print the clock: day, hour,
                     ; minute, a or p")
 $BF96 LD A,($9FE2)  ; Read 'a' or 'p' (#R$9FE2) into A - The a or p
 $BF99 LD (IX+$00),A ; Store A in the first byte of the record at IX
 $BF9C LD HL,$BF6E   ; Point HL at #R$BF6E - Print the 11 characters in the
                     ; status bar (#R$C1A8)
 $BF9F LD B,$0B      ; Load B with $0B
 $BFA1 JP $C1A8      ; Jump on to the routine "Print the clock line: B
                     ; characters from HL at..." (#R$C1A8)
*$BFA4 CALL $BFAA    ; Two-digit writer: tens digit, then...
 $BFA7 LD A,L        ; Copy L into A - ...the units as a digit
 $BFA8 ADD A,$30     ; Add $30 to A
*$BFAA LD (IX+$00),A ; Store A in the first byte of the record at IX - Store
                     ; the character at IX and move on
 $BFAD INC IX        ; Step IX on to the next byte
 $BFAF RET           ; Return to the caller
*$BFB0 LD L,A        ; Copy A into L - Split A by 10 into tens (A) and units
                     ; (L) (#R$BFBB)
 $BFB1 LD H,$00      ; Load H with $00
 $BFB3 LD DE,$000A   ; Load DE with $000A
 $BFB6 CALL $BFBB    ; Call #R$BFBB (inside "Print the clock: day, hour,
                     ; minute, a or p")
 $BFB9 JR $BFA4      ; Go back to #R$BFA4
*$BFBB LD C,$2F      ; Load C with $2F - Repeated subtraction: C counts from
                     ; '0'
*$BFBD INC C         ; Add one to C
 $BFBE AND A         ; Clear the carry flag, so that the subtraction that
                     ; follows is a plain one (a compare)
 $BFBF SBC HL,DE     ; Subtract DE from HL (a compare: carry = HL was smaller,
                     ; zero = equal)
 $BFC1 JR NC,$BFBD   ; If it did not go below zero, go back to #R$BFBD
 $BFC3 ADD HL,DE     ; Add DE to HL
 $BFC4 LD A,C        ; Copy C into A
 $BFC5 RET           ; Return to the caller
*$BFC6 LD C,A        ; Copy A into C - Copy three characters of day name number
                     ; A (x3 into the table)
 $BFC7 ADD A,A       ; Double A (shift it left one bit)
 $BFC8 ADD A,C       ; Add C to A
 $BFC9 LD C,A        ; Copy A into C
 $BFCA LD B,$00      ; Load B with $00
 $BFCC ADD HL,BC     ; Add BC to HL
 $BFCD LD B,$03      ; Load B with $03
*$BFCF LD A,(HL)     ; Read the byte HL points at into A
 $BFD0 LD (IX+$00),A ; Store A in the first byte of the record at IX
 $BFD3 INC IX        ; Step IX on to the next byte
 $BFD5 INC HL        ; Step HL on to the next byte
 $BFD6 DJNZ $BFCF    ; Count B down and, while it is not zero, go back to
                     ; #R$BFCF
 $BFD8 RET           ; Return to the caller

; Advance the clock by one minute
;
; Counts the minutes since the start (#R$9FDD), then the minute (#R$9FDF); at
; 60 the hour (#R$9FE0) moves on, 12 wrapping to 1; at 12 the 'a'/'p' letter
; (#R$9FE2) flips (XOR $11 turns $61 into $70 and back), and when it becomes
; 'a' the day (#R$9FE1) moves on. Read from the code; consistent with the clock
; the game prints.
; .
; How it works:
; .
; 1. Count the minute since the start (#R$9FDD) and add one to the minute
; (#R$9FDF).
; .
; 2. At 60, the minute becomes 0 and the hour (#R$9FE0) goes up; 13 becomes 1.
; .
; 3. When the hour reaches 12, am and pm swap; going to am starts the next day
; (#R$9FE1).
;
; Output:The minute counter, the minute, hour, am/pm and day moved on by one
; .          minute
c$BFD9 LD HL,($9FDD) ; Read minutes since the start (#R$9FDD) into HL
 $BFDC INC HL        ; Step HL on to the next byte
 $BFDD LD ($9FDD),HL ; Store HL in minutes since the start (#R$9FDD)
 $BFE0 LD HL,$9FDF   ; Point HL at the minute (#R$9FDF)
 $BFE3 INC (HL)      ; Add one to the byte at the minute (#R$9FDF)
 $BFE4 LD A,(HL)     ; Read the byte at the minute (#R$9FDF) into A
 $BFE5 CP $3C        ; Compare A with $3C - ...reached 60?
 $BFE7 RET NZ        ; If A differs from $3C, return
 $BFE8 LD (HL),$00   ; Yes: back to 0
 $BFEA LD HL,$9FE0   ; Point HL at the hour, 1-12 (#R$9FE0)
 $BFED INC (HL)      ; Add one to the byte at the hour, 1-12 (#R$9FE0)
 $BFEE LD A,(HL)     ; Read the byte at the hour, 1-12 (#R$9FE0) into A
 $BFEF CP $0D        ; Compare A with $0D - ...13 becomes 1
 $BFF1 JR NZ,$BFF6   ; If A differs from $0D, skip ahead to #R$BFF6
 $BFF3 LD (HL),$01   ; Store $01 at the address HL points to
 $BFF5 RET           ; Return to the caller
*$BFF6 CP $0C        ; Compare A with $0C - Reached 12?
 $BFF8 RET NZ        ; If A differs from $0C, return
 $BFF9 LD A,($9FE2)  ; Read 'a' or 'p' (#R$9FE2) into A - Then 'a' and 'p' swap
 $BFFC XOR $11       ; Flip in A the bits that are set in $11
 $BFFE LD ($9FE2),A  ; Store A in 'a' or 'p' (#R$9FE2)
 $C001 CP $61        ; Compare A with $61 - Now 'a'?
 $C003 RET NZ        ; If A differs from $61, return
 $C004 LD A,($9FE1)  ; Read the day (#R$9FE1) into A - Then it is the next day
 $C007 INC A         ; Add one to A
 $C008 LD ($9FE1),A  ; Store A in the day (#R$9FE1)
 $C00B RET           ; Return to the caller

; What part of the day is it? (A = 1-5)
;
; 1 night (8pm to 5:59am), 5 dawn (the 6am hour), 4 day (7am to 12:59pm), 3
; afternoon (1pm to 6:59pm), 2 dusk (the 7pm hour). Read from the code; #R$D078
; treats 1 as dark.
; .
; The five parts, from the code: 1 night (8pm to 5:59am), 2 the 7pm hour, 3
; afternoon (1pm to 6:59pm), 4 morning (7am to 12:59pm), 5 the 6am hour. The
; message codes $17, $16, $15, $14 and $0F show text only in parts 1-5
; respectively (#R$A68C).
; .
; How it works:
; .
; 1. In the morning (am), 12 midnight to 5:59 is night (1), 6am is dawn (5) and
; 7 to 11am is morning (4).
; .
; 2. In the afternoon (pm), 12 noon is morning (4), 1 to 6pm is afternoon (3),
; 7pm is evening (2) and 8pm onwards is night (1).
;
; Output:A The part of the day: 1 night, 2 evening, 3 afternoon, 4 morning, 5
; .        dawn
c$C00C LD A,($9FE2)  ; Read 'a' or 'p' (#R$9FE2) into A - am or pm?
 $C00F CP $61        ; Compare A with $61
 $C011 LD A,($9FE0)  ; Read the hour, 1-12 (#R$9FE0) into A
 $C014 JR Z,$C02B    ; If A equals $61, skip ahead to #R$C02B
 $C016 CP $0C        ; Compare A with $0C - pm: 12 noon to 12:59 counts as
                     ; morning (4)
 $C018 JR Z,$C035    ; If A equals $0C, skip ahead to #R$C035
 $C01A CP $08        ; Compare A with $08 - 8pm or later: night (1)
 $C01C JR C,$C021    ; If A is below $08, skip ahead to #R$C021
*$C01E LD A,$01      ; Load A with $01
 $C020 RET           ; Return to the caller
*$C021 CP $07        ; Compare A with $07 - 7pm: evening (2)
 $C023 JR NZ,$C028   ; If A differs from $07, skip ahead to #R$C028
 $C025 LD A,$02      ; Load A with $02
 $C027 RET           ; Return to the caller
*$C028 LD A,$03      ; Load A with $03 - 1pm to 6pm: afternoon (3)
 $C02A RET           ; Return to the caller
*$C02B CP $0C        ; Compare A with $0C - am: midnight to 5am is night (1)
 $C02D JR Z,$C01E    ; If A equals $0C, go back to #R$C01E
 $C02F CP $06        ; Compare A with $06
 $C031 JR C,$C01E    ; If A is below $06, go back to #R$C01E
 $C033 JR Z,$C038    ; 6am: dawn (5)
*$C035 LD A,$04      ; Load A with $04 - 7am to 11am: morning (4)
 $C037 RET           ; Return to the caller
*$C038 LD A,$05      ; Load A with $05
 $C03A RET           ; Return to the caller

; Read the ZX Printer's status (port $FB, bit 6)
;
; IN A,($FB) and AND $40. Called by #R$B002($B003), the PRINT special word,
; before turning printing on. CORRECTED: was data. Read from the code; not
; tried (the harness has no printer).
;
; Output:A Bit 6 set if the printer is not ready (the ZX Printer status)
;        F NZ in that case
c$C03B IN A,($FB)    ; Read port ($FB) into A
 $C03D AND $40       ; Isolate bit 6 of A (mask $40)
 $C03F RET           ; Return to the caller

; Save the game to tape, then verify it
;
; Prints a prompt taken from the ROM's tape messages (#R$C1C0 with HL = $09A2:
; the ROM's 'Start tape, then press any key.', then a key is waited for),
; writes a 17-byte header (#R$C0FE: a code file named 'SHD V2.0') and the block
; with SA-BYTES (#LINK(rom_symbols#a04C2)($04C2)), then asks for the tape to be
; rewound ('REWIND TAPE', #R$C0A5) and verifies both with LD-BYTES
; (#LINK(rom_symbols#a0556)($0556)) - 'TAPE ERROR' (#R$C0B1) if they do not
; match. Read from the code.
;
;  Input:IX The start of the block
;        DE Its length
; Output:The block saved to tape and verified
c$C040 LD HL,$09A2   ; Load HL with $09A2 - 'Start tape, then press any key.'
                     ; (from the ROM), and wait for a key
 $C043 CALL $C1C0    ; Call the routine "Print a prompt at HL, wait for a key,
                     ; newline" (#R$C1C0)
 $C046 LD ($C109),DE ; Store DE in #R$C109 in "The saved game's tape header: a
                     ; CODE file..." - Keep the block's length and start
 $C04A LD ($C10B),IX ; Store IX in #R$C10B in "The saved game's tape header: a
                     ; CODE file..."
 $C04E LD IX,$C0FE   ; Point IX at "The saved game's tape header: a CODE file
                     ; 'SHD..." (#R$C0FE) - Save the 17-byte header at #R$C0FE
                     ; (a code file, 'SHD V2.0') with the ROM's SA-BYTES
 $C052 LD DE,$0011   ; Load DE with $0011
 $C055 XOR A         ; Clear A to zero (and the carry flag)
 $C056 CALL $04C2    ; Call the ROM tape-save routine
                     ; (#LINK(rom_symbols#a04C2)($04C2))
 $C059 LD B,$32      ; Load B with $32 - A pause of fifty frames
*$C05B HALT          ; Wait for the next interrupt
 $C05C DJNZ $C05B    ; Count B down and, while it is not zero, go back to
                     ; #R$C05B
 $C05E DI            ; Disable interrupts
 $C05F LD DE,($C109) ; Read #R$C109 in "The saved game's tape header: a CODE
                     ; file..." into DE - Then the block itself
 $C063 LD IX,($C10B) ; Read #R$C10B in "The saved game's tape header: a CODE
                     ; file..." into IX
 $C067 LD A,$FF      ; Load A with $FF
 $C069 CALL $04C2    ; Call the ROM tape-save routine
                     ; (#LINK(rom_symbols#a04C2)($04C2))
 $C06C DI            ; Disable interrupts
 $C06D LD HL,$C0A5   ; Point HL at "Tape message: 'REWIND TAPE.'" (#R$C0A5)
 $C070 CALL $C1CB    ; Call the routine "Print a message: plain ASCII, last
                     ; byte has bit 7 set" (#R$C1CB)
 $C073 LD HL,$09AC   ; Load HL with $09AC - ', then press any key.' (the end of
                     ; the ROM's message), and wait
 $C076 CALL $C1C0    ; Call the routine "Print a prompt at HL, wait for a key,
                     ; newline" (#R$C1C0)
 $C079 LD IX,$C0FE   ; Point IX at "The saved game's tape header: a CODE file
                     ; 'SHD..." (#R$C0FE) - Read the header back in VERIFY mode
                     ; (LD-BYTES with carry clear)
 $C07D LD DE,$0011   ; Load DE with $0011
 $C080 LD A,$00      ; Load A with $00
 $C082 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $C083 CALL $0556    ; Call the ROM tape-load routine
                     ; (#LINK(rom_symbols#a0556)($0556))
 $C086 JR NC,$C098   ; If the carry flag is clear, skip ahead to #R$C098 - (no
                     ; match: TAPE ERROR)
 $C088 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
; This entry point is used by the routine at #R$C0DF.
*$C089 LD DE,($C109) ; Read #R$C109 in "The saved game's tape header: a CODE
                     ; file..." into DE - Then verify the block
 $C08D LD IX,($C10B) ; Read #R$C10B in "The saved game's tape header: a CODE
                     ; file..." into IX
 $C091 LD A,$FF      ; Load A with $FF
 $C093 CALL $0556    ; Call the ROM tape-load routine
                     ; (#LINK(rom_symbols#a0556)($0556))
 $C096 DI            ; Disable interrupts
 $C097 RET C         ; Matched: return with carry set
*$C098 DI            ; Disable interrupts - 'TAPE ERROR.' and ' press any key.'
 $C099 LD HL,$C0B1   ; Point HL at "Tape message: 'TAPE ERROR.'" (#R$C0B1)
 $C09C CALL $C1CB    ; Call the routine "Print a message: plain ASCII, last
                     ; byte has bit 7 set" (#R$C1CB)
 $C09F LD HL,$09B2   ; Load HL with $09B2
 $C0A2 JP $C1C0      ; Jump on to the routine "Print a prompt at HL, wait for a
                     ; key, newline" (#R$C1C0)

; Tape message: 'REWIND TAPE.'
;
; Printed by #R$C1CB, which stops after the character with bit 7 set (the full
; stop, $AE). CORRECTED: the last byte had been split off as data.
t$C0A5 DEFM "REWIND TAPE",$AE

; Tape message: 'TAPE ERROR.'
;
; Printed by #R$C1CB, which stops after the character with bit 7 set (the full
; stop, $AE). CORRECTED: the last byte had been split off as data.
t$C0B1 DEFM "TAPE ERROR",$AE

; Tape message: 'PLAY SAVED GAME TAPE TO BE LOADED', newline, '.'
;
; Printed by #R$C1CB, which stops after the character with bit 7 set (the full
; stop, $AE). CORRECTED: the last byte had been split off as data.
t$C0BC DEFM "PLAY SAVED GAME TAPE TO BE LOADED",$0D,$AE

; Load the saved-game block from tape
;
; DE = length, IX = start (kept at #R$C109/#R$C10B). Prints 'PLAY SAVED GAME
; TAPE TO BE LOADED' (#R$C0BC), reads the 17-byte header into #R$C0FE with
; LD-BYTES until one arrives, then the block (#R$C089). Read from the code.
;
;  Input:IX The start of the block
;        DE Its length
; Output:F Carry set when the block loaded correctly
c$C0DF LD ($C109),DE ; Store DE in #R$C109 in "The saved game's tape header: a
                     ; CODE file..." - Keep the block's length (DE) and start
                     ; (IX) at #R$C109/#R$C10B
 $C0E3 LD ($C10B),IX ; Store IX in #R$C10B in "The saved game's tape header: a
                     ; CODE file..."
 $C0E7 LD HL,$C0BC   ; Point HL at "Tape message: 'PLAY SAVED GAME TAPE TO
                     ; BE..." (#R$C0BC) - Print 'PLAY SAVED GAME TAPE TO BE
                     ; LOADED' (#R$C1CB)
 $C0EA CALL $C1CB    ; Call the routine "Print a message: plain ASCII, last
                     ; byte has bit 7 set" (#R$C1CB)
*$C0ED LD IX,$C0FE   ; Point IX at "The saved game's tape header: a CODE file
                     ; 'SHD..." (#R$C0FE) - Read a 17-byte header into #R$C0FE
                     ; with the ROM's LD-BYTES
                     ; (#LINK(rom_symbols#a0556)($0556), A = 0: a header)
 $C0F1 LD DE,$0011   ; Load DE with $0011
 $C0F4 LD A,$00      ; Load A with $00
 $C0F6 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $C0F7 CALL $0556    ; Call the ROM tape-load routine
                     ; (#LINK(rom_symbols#a0556)($0556)) - (carry clear: no
                     ; header read - try again)
 $C0FA JR NC,$C0ED   ; If the carry flag is clear, go back to #R$C0ED
 $C0FC JR $C089      ; Then read the block itself (#R$C089, A = $FF)

; The saved game's tape header: a CODE file 'SHD V2.0'
;
; The standard 17-byte header SA-BYTES writes first: type 3 (code), the
; ten-letter name 'SHD V2.0  ', then the length, start and second parameter.
; The length and start words are where #R$C046/#R$C04A and #R$C0DF keep DE and
; IX between the header and the block, so they are filled in when the game is
; saved. A load reads a header into the same place. The original tape carries a
; block with this very name and range (#R$840B-#R$A01A($A01F), the saved-game
; block of #R$B0EE) - apparently a saved game, loaded before the main block and
; overwritten by it (see loader_notes.md). Read from the code.
b$C0FE DEFB $03          ; Type: 3 (code)
 $C0FF DEFM "SHD V2.0  " ; Name
 $C109 DEFW $0000        ; Length (DE)
 $C10B DEFW $0000        ; Start (IX)
 $C10D DEFW $8000        ; Parameter 2

; Set the border, then clear the screen and attributes
;
; Sets the border to white, then fills the whole display file (6,144 bytes at
; #LINK(rom_symbols#a4000)($4000)) with zero and the whole attribute file (768
; bytes at #LINK(rom_symbols#a5800)($5800)) with $38 (INK 0 / PAPER 7: black on
; white, no bright, no flash) - i.e. a standard CLS.
; .
; Confirmed in the emulator: hooking every write to screen memory during boot
; shows exactly 6,144 writes at this routine's first LDIR and 767-768 at its
; second, matching the display and attribute file sizes exactly.
;
; Output:The screen cleared, the attributes black on white and the border white
c$C10F LD A,$07      ; White border while we clear the screen
 $C111 OUT ($FE),A   ; Write A to port ($FE)
 $C113 LD HL,$4000   ; HL, DE = display file, one byte apart (for the LDIR
                     ; fill)
 $C116 LD DE,$4001   ; Load DE with $4001
 $C119 LD BC,$1800   ; BC = 6144, the whole display file
 $C11C LD (HL),$00   ; Seed the first byte with 0...
 $C11E LDIR          ; ...then copy it across the rest
 $C120 LD BC,$02FF   ; BC = 767, the rest of the attribute file
 $C123 LD (HL),$38   ; Seed the first attribute byte (black on white)...
 $C125 LDIR          ; ...then copy it across the rest
 $C127 RET           ; Return to the caller

; Flag: text lines are narrow (a picture is showing)
;
; 1 while a room's picture is in the top right quarter of the screen and the
; text is kept to the left half (18 characters to a line); 0 for full-width
; lines. Set by #R$C129, cleared by #R$C142, read by the character printer
; (#R$C2E2) and the scroll (#R$C316). Confirmed in the emulator: describing the
; entrance hallway (room 6) sets it and the line length to 18; the next command
; clears it.
b$C128 DEFB $00      ; Flag

; Narrow the text lines to the left half (a picture is showing)
;
; Called at #R$A284, after the 18 newlines that clear the text window and
; before the room's picture is drawn in the top right quarter (#R$F3C2). Sets
; #R$C128, the characters-left count (#R$C1F5) to 18, the print position to
; $5020 and the pixel shift to 2, and clears the page line count
; (#R$A012($A019)). From then on the scroll (#R$C316) moves only the left 16
; bytes of each pixel line and leaves the colours alone, so the picture stays
; where it is while the text runs beside it.
; .
; CORRECTED 2026-11-08: the 18 was read as a number of lines. Confirmed in the
; emulator: in room 6 the description comes out 18 characters to a line ('You
; are in an | entrance hallway. | Above there is the | stairway...').
;
; Output:$C1F5 18 characters to a line
;        $C1F8 The print position
;        $C128 1
c$C129 XOR A         ; Clear A to zero (and the carry flag) - New page: no
                     ; lines printed yet
 $C12A LD ($A019),A  ; Store A in #R$A012($A019) in "Game variables"
 $C12D INC A         ; Add one to A - Narrow mode on
 $C12E LD ($C128),A  ; Store A in "Flag: text lines are narrow (a picture is
                     ; showing)" (#R$C128)
 $C131 LD A,$12      ; 18 characters to a line
; This entry point is used by the routine at #R$C142.
*$C133 LD ($C1F5),A  ; Characters left on this line
 $C136 LD HL,$5020   ; Load HL with $5020 - Print at the start of screen row 17
 $C139 LD ($C1F8),HL ; Store HL in #R$C1F8 in "Command-window state"
 $C13C LD A,$02      ; Load A with $02 - Pixel shift 2
 $C13E LD ($C1FA),A  ; Store A in #R$C1F8($C1FA) in "Command-window state"
 $C141 RET           ; Return to the caller

; Text lines full width again (36 characters)
;
; Clears #R$C128 and sets the characters-left count (#R$C1F5) to 36, the print
; position to $5020 (the start of screen row 17, where every line of text is
; printed before the window scrolls up) and the pixel shift to 2, by joining
; the end of #R$C129. It does not clear anything. Called by the page-wait at
; #R$C306, by the boot set-up at #R$C14A, and at #R$D71D each time the player
; is asked for a command - which is why a picture stays up only until the text
; that follows the next command scrolls it away.
; .
; CORRECTED 2026-11-08: this was described as clearing the screen and resetting
; a line count; the routine after it (#R$C14A) clears the screen, and the 36 is
; characters to a line, not lines.
;
; Output:$C1F5 36 characters to a line
;        $C128 0
c$C142 XOR A         ; Not in narrow mode
 $C143 LD ($C128),A  ; Store A in "Flag: text lines are narrow (a picture is
                     ; showing)" (#R$C128)
 $C146 LD A,$24      ; 36 characters to a line
 $C148 JR $C133      ; Set the rest up as #R$C129 does

; Set up the screen at the start of the game
;
; Clears the screen (#R$C10F), sets up the command window (36 characters left
; on its line (#R$C1F4), the cursor at $50E0 - the start of the bottom row -
; and pixel shift 2), makes the text lines full width (#R$C142), draws the
; chain strip (#R$C190) across screen row 18, pixel lines 1 to 6, and colours
; that row with attribute $78. Called once, at #R$A048($A049). Read from the
; code.
;
; Output:The screen cleared and the command window set up
c$C14A CALL $C10F    ; Clear the screen
 $C14D LD A,$24      ; Load A with $24 - 36 characters left on the command line
 $C14F LD ($C1F4),A  ; Store A in "Command-window state" (#R$C1F4)
 $C152 LD HL,$50E0   ; Load HL with $50E0 - Cursor at the start of the bottom
                     ; row ($50E0)
 $C155 LD ($C1F6),HL ; Store HL in #R$C1F6 in "Command-window state"
 $C158 LD A,$02      ; Load A with $02 - Pixel shift 2
 $C15A LD ($C1FB),A  ; Store A in #R$C1FB in "Command-window state"
 $C15D CALL $C142    ; Text lines full width
 $C160 LD HL,$5140   ; Load HL with $5140 - HL = row 18, pixel line 1; DE = the
                     ; chain pattern
 $C163 LD DE,$C190   ; Point DE at "The chain strip that holds the clock: a
                     ; 32-pixel..." (#R$C190)
 $C166 LD B,$06      ; Six pixel lines
*$C168 LD C,$08      ; Load C with $08 - Each is the pattern's four bytes eight
                     ; times over
 $C16A PUSH BC       ; Save BC on the stack
 $C16B PUSH HL       ; Save HL on the stack
*$C16C LD B,$04      ; Load B with $04
 $C16E PUSH DE       ; Save DE on the stack
*$C16F LD A,(DE)     ; Read the byte DE points at into A
 $C170 LD (HL),A     ; Store A at the address HL points to
 $C171 INC DE        ; Step DE on to the next byte
 $C172 INC L         ; Add one to L
 $C173 DJNZ $C16F    ; Count B down and, while it is not zero, go back to
                     ; #R$C16F
 $C175 POP DE        ; Restore DE from the stack
 $C176 DEC C         ; Subtract one from C
 $C177 JR NZ,$C16C   ; If C is not zero, go back to #R$C16C
 $C179 INC DE        ; Step DE on to the next byte - Next four bytes of the
                     ; pattern
 $C17A INC DE        ; Step DE on to the next byte
 $C17B INC DE        ; Step DE on to the next byte
 $C17C INC DE        ; Step DE on to the next byte
 $C17D POP HL        ; Restore HL from the stack - Next pixel line down
 $C17E POP BC        ; Restore BC from the stack
 $C17F INC H         ; Add one to H
 $C180 DJNZ $C168    ; Count B down and, while it is not zero, go back to
                     ; #R$C168
 $C182 LD HL,$5A40   ; Load HL with $5A40 - Colour row 18 with attribute $78
 $C185 LD DE,$5A41   ; Load DE with $5A41
 $C188 LD BC,$001F   ; Load BC with $001F
 $C18B LD (HL),$78   ; Store $78 at the address HL points to
 $C18D LDIR          ; Copy BC bytes from where HL points to where DE points,
                     ; counting up
 $C18F RET           ; Return to the caller

; The chain strip that holds the clock: a 32-pixel pattern, six lines deep
;
; Drawn once at start-up (#R$A048($A049) calls #R$C14A): each of the six
; four-byte rows is repeated eight times across the screen from $5140, one
; pixel line apart, and the attribute row at $5A40 is set to $78. It is the
; chain-like strip between the room text and the command window, which the
; clock is printed into (#R$C1A8) - see the screenshot on the Pictures page.
; Read from the code; checked against the emulator's screen.
b$C190 DEFB $00,$3F,$C1,$C0 ; Pixel line 1: ........ ..###### ##.....# ##......
 $C194 DEFB $20,$FE,$01,$C4 ; Pixel line 2: ..#..... #######. .......# ##...#..
 $C198 DEFB $81,$E8,$0D,$81 ; Pixel line 3: #......# ###.#... ....##.# #......#
 $C19C DEFB $41,$B0,$17,$82 ; Pixel line 4: .#.....# #.##.... ...#.### #.....#.
 $C1A0 DEFB $83,$80,$7F,$01 ; Pixel line 5: #.....## #....... .####### .......#
 $C1A4 DEFB $23,$83,$FC,$04 ; Pixel line 6: ..#...## #.....## ######.. .....#..

; Print the clock line: B characters from HL at screen address $5041
;
; A space, the B characters, a space, through PRINT-CHAR (#R$C388). The clock
; printer jumps here (#R$BFA1) with the eleven characters of 'Mon 08:02am'
; built at #R$BF6E. Read from the code.
;
;  Input:HL The text
;        B The number of characters
; Output:The text printed at the status bar
c$C1A8 LD DE,$5041   ; Load DE with $5041 - DE = the text, HL = screen address
                     ; $5041 (row 18)
 $C1AB EX DE,HL      ; Swap DE and HL
 $C1AC LD C,$00      ; C = pixel shift 0
 $C1AE LD A,$20      ; Load A with $20 - A space first (#R$C388 prints a
                     ; character)
 $C1B0 CALL $C388    ; Call the routine "PLOT-CHAR: draw one character glyph at
                     ; HL, shifted by..." (#R$C388)
*$C1B3 LD A,(DE)     ; Read the byte DE points at into A - Then B characters
                     ; from DE
 $C1B4 CALL $C388    ; Call the routine "PLOT-CHAR: draw one character glyph at
                     ; HL, shifted by..." (#R$C388)
 $C1B7 INC DE        ; Step DE on to the next byte
 $C1B8 DJNZ $C1B3    ; Count B down and, while it is not zero, go back to
                     ; #R$C1B3
 $C1BA LD A,$20      ; Load A with $20 - And a space after
 $C1BC CALL $C388    ; Call the routine "PLOT-CHAR: draw one character glyph at
                     ; HL, shifted by..." (#R$C388)
 $C1BF RET           ; Return to the caller

; Print a prompt at HL, wait for a key, newline
;
; #R$C1CB, then #R$C415, then a newline. The save and load routines use it with
; HL pointing into the ROM's own tape messages ($09A2, $09AC, $09B2). Read from
; the code.
;
;  Input:HL A message ending with bit 7 set
; Output:The message printed, a key waited for and a new line started
c$C1C0 CALL $C1CB    ; (#R$C1CB)
 $C1C3 CALL $C415    ; (#R$C415)
 $C1C6 LD A,$0D      ; Load A with $0D - Print a carriage return (13) (#R$C1FD)
 $C1C8 JP $C1FD      ; Jump on to #R$C1FD

; Print a message: plain ASCII, last byte has bit 7 set
;
; A short, self-contained loop: read a byte, strip bit 7, print it (via the
; gated entry at #R$C1FD), then check whether the *original* byte (before
; stripping) had bit 7 set - if so, that was the last character of the message
; and the loop stops; otherwise it advances and repeats.
; .
; This is genuinely real code - confirmed by finding all four of its actual
; callers (#R$C070, #R$C09C, #R$C0EA, #R$C1C0), not assumed from reading alone.
; What it is NOT, also confirmed rather than assumed: the path room
; descriptions or parser responses take. Breakpointing this address directly
; during a real `LOOK` command in the emulator produced zero hits. Its callers,
; and what kind of message actually goes through this simpler, uncompressed
; format, haven't been identified yet - see source/world_model_notes.md.
; .
; Its callers turn out to be the save and load routines: the tape messages at
; #R$C0A5-$C0DE ('REWIND TAPE.', 'TAPE ERROR.', 'PLAY SAVED GAME TAPE TO BE
; LOADED') are in this form, and #R$C1C0 prints the ROM's own tape messages
; through it.
;
;  Input:HL A message whose last byte has bit 7 set
; Output:The message printed
;        HL At the last byte
c$C1CB LD A,(HL)     ; A = this message byte, with the terminator bit stripped
 $C1CC AND $7F       ; Keep only bits 0, 1, 2, 3, 4, 5, 6 of A (mask $7F)
 $C1CE CALL $C1FD    ; Print it
 $C1D1 BIT 7,(HL)    ; Did the ORIGINAL byte have the terminator bit set?
 $C1D3 RET NZ        ; ...then that was the last character - stop
 $C1D4 INC HL        ; Else: next byte
 $C1D5 JR $C1CB      ; Jump to #R$C1CB
 $C1D7 RET           ; Return to the caller
; This entry point is used by the routine at #R$A11C.
*$C1D8 LD HL,$13C5   ; Load HL with $13C5 - HL = $13C5; (#R$C1C0); then on to
                     ; #R$A0EB
 $C1DB CALL $C1C0    ; Call the routine "Print a prompt at HL, wait for a key,
                     ; newline" (#R$C1C0)
 $C1DE JP $A0EB      ; Go back to #R$A0EB

; Print gatekeeper: check two flags, then dispatch
;
; Checks #LINK(rom_symbols#a5C3C)($5C3C) first (a flag this project has not
; fully explained - 'printer echo' is a guess, not confirmed - but which is
; never zero in this project's emulator, since there's no real ROM to set it,
; meaning some code paths that check it will always take their 'disabled'
; branch here); if it's zero, returns immediately, printing nothing.
; .
; If #LINK(rom_symbols#a5C3C)($5C3C) is set, checks #R$A022($A027) (the same
; flag this project has found gating the shared echo/word-buffer routine at
; #R$A9B7): when #R$A022($A027) is zero, jumps straight to #R$C2BA to print the
; character normally; when #R$A022($A027) is set, falls through into a
; case-folding and quote-tracking region (around #R$AA11($AA12)-#R$AA4F($AA50),
; not fully traced) that eventually calls back into #R$C2BA anyway.
; .
; Confirmed as the real entry point (correcting an earlier, prose-only attempt
; at this same routine that guessed a slightly wrong start address from a
; misaligned disassembly window) by finding two genuine, independent call
; targets landing exactly here: #R$AA11 (`JP #R$C1E1`) and #R$AA41 (`CALL
; #R$C1E1`).
;
;  Input:A The character
; Output:The character printed in the command window or the text window, as the
; .          flags $5C3C and $A027 say
c$C1E1 PUSH AF       ; Save the character to print
 $C1E2 LD A,($5C3C)  ; Is output enabled at all right now?
 $C1E5 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $C1E6 JR NZ,$C1EA   ; If A is not zero, skip ahead to #R$C1EA
 $C1E8 POP AF        ; No: print nothing
 $C1E9 RET           ; Return to the caller
*$C1EA LD A,($A027)  ; Are we in the other, quote/case-folding mode?
 $C1ED AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $C1EE JR NZ,$C1FC   ; If A is not zero, skip ahead to the routine "Echo a
                     ; typed character in the command window" (#R$C1FC)
 $C1F0 POP AF        ; No: print the character the plain way
 $C1F1 JP $C2BA      ; Jump on to the routine "Print one character (or handle a
                     ; newline) at the..." (#R$C2BA)

; Command-window state
;
; The bottom window, where the player's typing is echoed. #R$C1F4: characters
; left on the line (36 to a line: the font is 7 pixels wide);
; #R$C1F6/#R$C1F6($C1F7): the screen address being written; #R$C1FB: the pixel
; offset within the byte. #R$C1F5 is the text window's own characters-left
; count, and #R$C1F8-#R$C1F8($C1FA) its print position and pixel shift. Read
; from the code.
b$C1F4 DEFB $00         ; Characters left on the line
 $C1F5 DEFB $00         ; Line count (see #R$C306)
 $C1F6 DEFW $0000       ; Screen address
 $C1F8 DEFB $00,$00,$00 ; Not identified
 $C1FB DEFB $00         ; Pixel offset

; Echo a typed character in the command window
;
; Letters are shown in capitals (#R$C240); ENTER becomes a space and a new
; line, DELETE steps back 7 pixels (#R$C249, #R$C267); at the end of a line the
; window scrolls (#R$C271). A '+' is drawn after the character as the cursor -
; the '+' at the bottom of the screen in the emulator screenshot (Pictures
; page).
; .
; How it works:
; .
; 1. ENTER prints a space over the cursor and starts a new line; DELETE rubs
; the last character out (#R$C249).
; .
; 2. Anything else is shown in capitals (#R$C240) and printed (#R$C388).
; .
; 3. When the line is full, or after ENTER, the window scrolls up (#R$C271) and
; 36 characters are available again.
; .
; 4. Save the characters left, pixel shift and print position. Draw a '+'
; cursor after the character.
;
;  Input:A The character typed (ENTER $0D, DELETE $08, anything else)
; Output:All registers kept
;        The character shown in the command window
c$C1FC POP AF        ; Restore AF from the stack - Restore AF, then (entry
                     ; #R$C1FD) save HL, BC, AF
; This entry point is used by the routines at #R$C1C0 and #R$C1CB.
*$C1FD PUSH HL       ; Save HL on the stack
 $C1FE PUSH BC       ; Save BC on the stack
 $C1FF PUSH AF       ; Save AF on the stack
 $C200 LD A,($C1FB)  ; Read #R$C1FB in "Command-window state" into A - C = the
                     ; command window's pixel shift, HL = its print position
 $C203 LD C,A        ; Copy A into C
 $C204 POP AF        ; Restore AF from the stack
 $C205 PUSH AF       ; Save AF on the stack
 $C206 LD HL,($C1F6) ; Read #R$C1F6 in "Command-window state" into HL
 $C209 CP $0D        ; Compare A with $0D - ENTER: print a space over the
                     ; cursor and start a new line
 $C20B JR NZ,$C214   ; If A differs from $0D, skip ahead to #R$C214
 $C20D LD A,$20      ; Load A with $20
 $C20F CALL $C388    ; Call the routine "PLOT-CHAR: draw one character glyph at
                     ; HL, shifted by..." (#R$C388)
 $C212 JR $C224      ; Skip ahead to #R$C224
*$C214 CP $08        ; Compare A with $08 - DELETE: rub the last character out
                     ; (#R$C249)
 $C216 JR Z,$C249    ; If A equals $08, jump on to the routine "Rub out the
                     ; last character in the command window" (#R$C249)
 $C218 CALL $C240    ; Call the routine "Upper-case A if it is a lower-case
                     ; letter" (#R$C240) - Anything else: in capitals
                     ; (#R$C240), printed
 $C21B CALL $C388    ; Call the routine "PLOT-CHAR: draw one character glyph at
                     ; HL, shifted by..." (#R$C388)
 $C21E LD A,($C1F4)  ; Read "Command-window state" (#R$C1F4) into A - Line
                     ; full?
 $C221 DEC A         ; Subtract one from A
 $C222 JR NZ,$C22D   ; If A is not zero, skip ahead to #R$C22D
*$C224 LD L,$E0      ; Load L with $E0 - New line: back to the start of the
                     ; bottom row, pixel shift 2...
 $C226 LD C,$02      ; Load C with $02
 $C228 CALL $C271    ; ...scroll the window up (#R$C271)...
 $C22B LD A,$24      ; ...and 36 characters to go
; This entry point is used by the routine at #R$C249.
*$C22D LD ($C1F4),A  ; Store A in "Command-window state" (#R$C1F4) - Save the
                     ; characters left, pixel shift and print position
 $C230 LD A,C        ; Copy C into A
 $C231 LD ($C1FB),A  ; Store A in #R$C1FB in "Command-window state"
 $C234 LD ($C1F6),HL ; Store HL in #R$C1F6 in "Command-window state"
 $C237 LD A,$2B      ; Load A with $2B - Draw the '+' cursor after it
                     ; (overwritten by the next character)
 $C239 CALL $C388    ; Call the routine "PLOT-CHAR: draw one character glyph at
                     ; HL, shifted by..." (#R$C388)
 $C23C POP AF        ; Restore AF from the stack
 $C23D POP BC        ; Restore BC from the stack
 $C23E POP HL        ; Restore HL from the stack
 $C23F RET           ; Return to the caller

; Upper-case A if it is a lower-case letter
;
; Used by the routines at #R$C1FC and #R$C41F.
;
;  Input:A A character
; Output:A The character, in capitals if it was a lower-case letter
c$C240 CP $61        ; Compare A with $61 - Lower-case letter (a-z)?
 $C242 RET C         ; If A is below $61, return
 $C243 CP $7B        ; Compare A with $7B
 $C245 RET NC        ; If A is $7B or more, return
 $C246 AND $5F       ; Keep only bits 0, 1, 2, 3, 4, 6 of A (mask $5F) - Make
                     ; it upper case (AND $5F)
 $C248 RET           ; Return to the caller

; Rub out the last character in the command window
;
; Used by the routine at #R$C1FC.
;
;  Input:C Pixel shift
;        HL Print position
; Output:Control joins the input loop at $C22D
c$C249 LD A,$20      ; Load A with $20 - Print a space over the last character
                     ; (#R$C388)
 $C24B CALL $C388    ; Call the routine "PLOT-CHAR: draw one character glyph at
                     ; HL, shifted by..." (#R$C388)
 $C24E CALL $C267    ; Call the routine "Step the print position back one
                     ; 7-pixel character" (#R$C267) - Step the cursor back
                     ; twice (#R$C267)
 $C251 CALL $C267    ; Call the routine "Step the print position back one
                     ; 7-pixel character" (#R$C267)
 $C254 LD A,($C1F4)  ; Read "Command-window state" (#R$C1F4) into A - Column
                     ; counter #R$C1F4 + 1
 $C257 INC A         ; Add one to A
 $C258 CP $25        ; Compare A with $25 - Not yet 37: back to the input loop
                     ; (#R$C22D)
 $C25A JR NZ,$C22D   ; If A differs from $25, go back to #R$C22D
 $C25C LD L,$FE      ; Load L with $FE - Otherwise move to the start of the
                     ; next line (#R$C29C)...
 $C25E LD C,$07      ; Load C with $07
 $C260 CALL $C29C    ; Call the routine "Move part of the command window down a
                     ; row and clear..." (#R$C29C)
 $C263 LD A,$01      ; Load A with $01 - ...column 1, and back to the input
                     ; loop
 $C265 JR $C22D      ; Go back to #R$C22D

; Step the print position back one 7-pixel character
;
; Used by the routine at #R$C249.
;
;  Input:C The pixel shift in the cell
;        L The cell
; Output:C, L Stepped back one 7-pixel character
c$C267 LD A,C        ; Copy C into A - Step the print position back one
                     ; character: C (the pixel column in the cell) minus 7...
 $C268 SUB $07       ; Subtract $07 from A
 $C26A LD C,A        ; Copy A into C
 $C26B RET NC        ; ...no borrow: done
 $C26C DEC L         ; Subtract one from L - Borrow: back to the previous cell
                     ; (L = L - 1), C + 8
 $C26D ADD A,$08     ; Add $08 to A
 $C26F LD C,A        ; Copy A into C
 $C270 RET           ; Return to the caller

; Scroll the command window up one line and clear the bottom line
;
; Copies the text rows of the bottom third of the screen up by one character
; row ($5080 to $5060, 8 pixel lines) and blanks the last line.
;
; Output:The command window scrolled up one line and its bottom row cleared
;        HL, DE, BC Kept
c$C271 PUSH HL       ; Save HL on the stack - Rows 20-23 of the screen...
 $C272 PUSH DE       ; Save DE on the stack
 $C273 PUSH BC       ; Save BC on the stack
 $C274 LD HL,$5080   ; Load HL with $5080 - ...up one character row to rows
                     ; 19-22
 $C277 LD DE,$5060   ; Load DE with $5060
 $C27A LD A,$08      ; Load A with $08 - For each of the eight pixel lines:
*$C27C PUSH HL       ; Save HL on the stack
 $C27D PUSH DE       ; Save DE on the stack
 $C27E LD BC,$0080   ; Load BC with $0080 - move four character rows (128
                     ; bytes)
 $C281 LDIR          ; Copy BC bytes from where HL points to where DE points,
                     ; counting up
 $C283 POP DE        ; Restore DE from the stack
 $C284 POP HL        ; Restore HL from the stack
 $C285 INC H         ; Add one to H - Next pixel line
 $C286 INC D         ; Add one to D
 $C287 DEC A         ; Subtract one from A
 $C288 JR NZ,$C27C   ; If A is not zero, go back to #R$C27C
 $C28A LD HL,$50E0   ; Clear the bottom row, row 23
; This entry point is used by the routine at #R$C29C.
*$C28D LD B,$24      ; Load B with $24 - 36 spaces, from pixel shift 1
 $C28F LD C,$01      ; Load C with $01
 $C291 LD A,$20      ; Load A with $20
*$C293 CALL $C388    ; Call the routine "PLOT-CHAR: draw one character glyph at
                     ; HL, shifted by..." (#R$C388)
 $C296 DJNZ $C293    ; Count B down and, while it is not zero, go back to
                     ; #R$C293
 $C298 POP BC        ; Restore BC from the stack
 $C299 POP DE        ; Restore DE from the stack
 $C29A POP HL        ; Restore HL from the stack
 $C29B RET           ; Return to the caller

; Move part of the command window down a row and clear the gap
;
; LDDR of 128 bytes - four character rows ending at $50DF - down by 32 bytes,
; for each of the eight pixel lines; then HL = $5060 and on into the
; row-clearing code of #R$C271 (#R$C28D). Called at #R$C260 by the character
; printer when the typed line runs past the end of a screen line. Read from the
; code.
;
; Output:Part of the command window moved down one row and the gap cleared
;        HL, DE, BC Kept
c$C29C PUSH HL       ; Save HL on the stack - Rows 19-22 down a row, from the
                     ; end backwards
 $C29D PUSH DE       ; Save DE on the stack
 $C29E PUSH BC       ; Save BC on the stack
 $C29F LD HL,$50DF   ; Load HL with $50DF
 $C2A2 LD DE,$50FF   ; Load DE with $50FF
 $C2A5 LD A,$08      ; Load A with $08 - For each of the eight pixel lines:
*$C2A7 PUSH HL       ; Save HL on the stack
 $C2A8 PUSH DE       ; Save DE on the stack
 $C2A9 LD BC,$0080   ; Load BC with $0080 - move four character rows (128
                     ; bytes)
 $C2AC LDDR          ; Copy BC bytes from where HL points to where DE points,
                     ; counting down
 $C2AE POP DE        ; Restore DE from the stack
 $C2AF POP HL        ; Restore HL from the stack
 $C2B0 INC H         ; Add one to H - Next pixel line
 $C2B1 INC D         ; Add one to D
 $C2B2 DEC A         ; Subtract one from A
 $C2B3 JR NZ,$C2A7   ; If A is not zero, go back to #R$C2A7
 $C2B5 LD HL,$5060   ; Load HL with $5060 - Then clear row 19 with #R$C271's
                     ; code
 $C2B8 JR $C28D      ; Go back to #R$C28D

; Print one character (or handle a newline) at the cursor
;
; The routine PLOT-CHAR's caller: restores the persisted cursor
; position/column-shift from #R$C1F8/#R$C1F8($C1FA), and either plots the
; passed-in character directly (calling PLOT-CHAR via #R$C2EE), or, if the
; character is a carriage return ($0D), counts the line in #R$A012($A019),
; waits for a key after fifteen (#R$C306), and scrolls the window up (#R$C316)
; to print the next line at the start of row 17. A character that fills the
; line (36 to a line, 18 beside a picture: #R$C1F5) is followed by a newline of
; its own.
; .
; This, plus PLOT-CHAR and the page-wait wrapper at #R$C306, forms the game's
; whole low-level text-output path: every piece of printed text - room
; descriptions, parser responses, dialogue - goes through here one character at
; a time.
; .
; CONFIRMED, not just asserted: an earlier pass in this project breakpointed
; this exact address during a real LOOK command and got zero hits, which was
; written up (honestly) as an unresolved worry rather than a disproof. Re-run
; later with the bug in that test fixed, the same breakpoint produces 170 real
; hits during a single LOOK, with a real, traceable caller chain leading back
; through the print gatekeeper at #R$C1E1 - see world_model_notes.md's
; 'room-text print path is resolved' section for the full account, including
; what the original bug was.
; .
; How it works:
; .
; 1. Pick up the text print position (#R$C1F8) and pixel shift
; (#R$C1F8($C1FA)).
; .
; 2. A character other than ENTER is printed (#R$C388); if the line is then
; full a new line is started.
; .
; 3. A new line after fifteen lines of text (#R$A012($A019)) waits for a key
; (#R$C306) first. Scroll the text up a row (#R$C316), and start the new line
; with 36 characters (18 beside a picture).
;
;  Input:A The character (or $0D for a new line)
; Output:The character printed at the text cursor; registers kept
c$C2BA PUSH HL       ; Save HL on the stack - Pick up the print position and
                     ; pixel shift
 $C2BB PUSH BC       ; Save BC on the stack
 $C2BC PUSH AF       ; Save AF on the stack
 $C2BD LD HL,($C1F8) ; Read #R$C1F8 in "Command-window state" into HL
 $C2C0 LD A,($C1FA)  ; Read #R$C1F8($C1FA) in "Command-window state" into A
 $C2C3 LD C,A        ; Copy A into C
 $C2C4 POP AF        ; Restore AF from the stack
 $C2C5 PUSH AF       ; Save AF on the stack
 $C2C6 CP $0D        ; Compare A with $0D - Not a newline: print it
 $C2C8 JR NZ,$C2EE   ; If A differs from $0D, skip ahead to #R$C2EE
*$C2CA LD A,($A019)  ; Read #R$A012($A019) in "Game variables" into A -
                     ; Newline: fifteen lines since the last pause?
 $C2CD CP $0F        ; Compare A with $0F
 $C2CF JR NZ,$C2D6   ; If A differs from $0F, skip ahead to #R$C2D6
 $C2D1 CALL $C306    ; Call the routine "Page-wait: flash the cursor, wait for
                     ; a key, clear" (#R$C306) - Yes: wait for a key (#R$C306)
                     ; and start the count again
 $C2D4 LD A,$FF      ; Load A with $FF
*$C2D6 INC A         ; Add one to A - Count the line
 $C2D7 LD ($A019),A  ; Store A in #R$A012($A019) in "Game variables"
 $C2DA LD HL,$5020   ; Back to the start of row 17...
 $C2DD LD C,$02      ; Load C with $02 - ...and scroll everything above up a
                     ; row (#R$C316)
 $C2DF CALL $C316    ; Call the routine "Scroll the text up a line, printing
                     ; the line that..." (#R$C316)
 $C2E2 LD A,($C128)  ; Read "Flag: text lines are narrow (a picture is
                     ; showing)" (#R$C128) into A - A fresh line: 36
                     ; characters, or 18 beside a picture
 $C2E5 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $C2E6 LD A,$24      ; Load A with $24
 $C2E8 JR Z,$C2F8    ; If A is zero, skip ahead to #R$C2F8
 $C2EA LD A,$12      ; Load A with $12
 $C2EC JR $C2F8      ; Skip ahead to #R$C2F8
*$C2EE CALL $C388    ; Print the character
 $C2F1 LD A,($C1F5)  ; Read the characters left on the line (#R$C1F5) into A -
                     ; Line full? Then take a newline
 $C2F4 DEC A         ; Subtract one from A
 $C2F5 JP Z,$C2CA    ; If A has become zero, go back to #R$C2CA
*$C2F8 LD ($C1F5),A  ; Store A in the characters left on the line (#R$C1F5) -
                     ; Save the characters left, print position and pixel shift
 $C2FB LD ($C1F8),HL ; Store HL in #R$C1F8 in "Command-window state"
 $C2FE LD A,C        ; Copy C into A
 $C2FF LD ($C1FA),A  ; Store A in #R$C1F8($C1FA) in "Command-window state"
 $C302 POP AF        ; Restore AF from the stack
 $C303 POP BC        ; Restore BC from the stack
 $C304 POP HL        ; Restore HL from the stack
 $C305 RET           ; Return to the caller

; Page-wait: flash the cursor, wait for a key, clear
;
; Called by the character printer (#R$C2D1) when a newline comes after fifteen
; lines of text (#R$A012($A019) = 15) since the player last typed a command or
; pressed a key. Sets FLASH on the attribute at $5A5F - the right-hand end of
; the chain strip on row 18 - waits for a key via the GET-KEY wrapper at
; #R$C415, turns FLASH off again and makes the text lines full width (#R$C142).
; Nothing is cleared: the text simply carries on scrolling.
; .
; Confirmed in the emulator 2026-11-08: typing LOOK. LOOK in the sitting room
; stops here with #R$A012($A019) = 15 part way through the second description,
; waiting for a key. CORRECTED: this was said to be triggered by #R$C1F5 (the
; characters left on the line) and to clear the screen.
;
; Output:A key waited for, the window cleared; HL kept
c$C306 PUSH HL       ; Save HL (the print position)
 $C307 LD HL,$5A5F   ; HL -> the attribute byte for the prompt line
 $C30A SET 7,(HL)    ; Turn on FLASH there, as a "press a key" cue
 $C30C CALL $C415    ; Block here until the player presses something
 $C30F RES 7,(HL)    ; Turn FLASH back off
 $C311 CALL $C142    ; Clear the screen and reset the text window
 $C314 POP HL        ; Restore HL
 $C315 RET           ; Return to the caller

; Scroll the text up a line, printing the line that goes if printing is on
;
; Moves screen rows 1-17 up to rows 0-16, eight pixel lines at a time: all 32
; bytes of each line in full-width mode, only the left 16 when a picture is
; showing (#R$C128 set). In full-width mode the colours of rows 1-17 move up
; too, and before anything moves the top row goes to the ZX Printer (#R$C3E4)
; if printing is on. Then row 17 is cleared with 36 (or 18) spaces. Called by
; the character printer at #R$C2DF on every newline. Read from the code; the
; narrow mode confirmed in the emulator (see #R$C129).
; .
; How it works:
; .
; 1. At full width, send the top row to the printer (#R$C3E4) if printing is
; on.
; .
; 2. Move text rows 1 to 17 up to rows 0 to 16, eight pixel lines each, 32
; bytes a line (16 beside a picture).
; .
; 3. Clear the bottom text row.
;
;  Input:HL The print position
;        C The pixel shift
; Output:The text rows moved up one line; the top row sent to the printer first
; .          when at full width
c$C316 LD A,($C128)  ; Read "Flag: text lines are narrow (a picture is
                     ; showing)" (#R$C128) into A - Full width: send the top
                     ; row to the printer first
 $C319 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $C31A CALL Z,$C3E4  ; If A is zero, call the routine "Send the screen's top
                     ; character row to the ZX..." (#R$C3E4)
 $C31D PUSH BC       ; Save BC on the stack
 $C31E PUSH HL       ; Save HL on the stack
 $C31F PUSH DE       ; Save DE on the stack
 $C320 LD HL,$4020   ; Load HL with $4020 - From row 1 to row 0, 17 rows
 $C323 LD DE,$4000   ; Load DE with #LINK(rom_symbols#a4000)($4000)
 $C326 LD BC,$0011   ; Load BC with $0011
 $C329 LD A,($C128)  ; Read "Flag: text lines are narrow (a picture is
                     ; showing)" (#R$C128) into A - 32 bytes a line, or 16
                     ; beside a picture
 $C32C AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $C32D LD A,$20      ; Load A with $20
 $C32F JR Z,$C333    ; If A is zero, skip ahead to #R$C333
 $C331 LD A,$10      ; Load A with $10
*$C333 PUSH HL       ; Save HL on the stack
 $C334 PUSH DE       ; Save DE on the stack
 $C335 PUSH BC       ; Save BC on the stack
 $C336 LD C,$08      ; Load C with $08 - Eight pixel lines
*$C338 PUSH HL       ; Save HL on the stack
 $C339 PUSH DE       ; Save DE on the stack
 $C33A PUSH BC       ; Save BC on the stack
 $C33B LD C,A        ; Copy A into C - Move one pixel line of the row
 $C33C LDIR          ; Copy BC bytes from where HL points to where DE points,
                     ; counting up
 $C33E POP BC        ; Restore BC from the stack
 $C33F POP DE        ; Restore DE from the stack
 $C340 POP HL        ; Restore HL from the stack
 $C341 INC H         ; Add one to H - Next pixel line
 $C342 INC D         ; Add one to D
 $C343 DEC C         ; Subtract one from C
 $C344 JR NZ,$C338   ; If C is not zero, go back to #R$C338
 $C346 POP BC        ; Restore BC from the stack
 $C347 POP DE        ; Restore DE from the stack
 $C348 POP HL        ; Restore HL from the stack
 $C349 PUSH AF       ; Save AF on the stack - Both pointers on a character row
 $C34A CALL $C37D    ; Call the routine "Swap DE and HL, then move HL down a
                     ; character row" (#R$C37D)
 $C34D CALL $C37D    ; Call the routine "Swap DE and HL, then move HL down a
                     ; character row" (#R$C37D)
 $C350 POP AF        ; Restore AF from the stack
 $C351 DEC C         ; Subtract one from C - Next row
 $C352 JR NZ,$C333   ; If C is not zero, go back to #R$C333
 $C354 CP $10        ; Compare A with $10 - Full width: move the colours of
                     ; rows 1-17 up too
 $C356 JR Z,$C363    ; If A equals $10, skip ahead to #R$C363
 $C358 LD HL,$5820   ; Load HL with $5820
 $C35B LD DE,$5800   ; Load DE with #LINK(rom_symbols#a5800)($5800)
 $C35E LD BC,$0220   ; Load BC with $0220
 $C361 LDIR          ; Copy BC bytes from where HL points to where DE points,
                     ; counting up
*$C363 LD A,($C128)  ; Read "Flag: text lines are narrow (a picture is
                     ; showing)" (#R$C128) into A - Clear row 17: 36 spaces, or
                     ; 18
 $C366 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $C367 LD B,$24      ; Load B with $24
 $C369 JR Z,$C36D    ; If A is zero, skip ahead to #R$C36D
 $C36B LD B,$12      ; Load B with $12
*$C36D LD HL,$5020   ; Load HL with $5020 - from pixel shift 2
 $C370 LD C,$02      ; Load C with $02
 $C372 LD A,$20      ; Load A with $20
*$C374 CALL $C388    ; Call the routine "PLOT-CHAR: draw one character glyph at
                     ; HL, shifted by..." (#R$C388)
 $C377 DJNZ $C374    ; Count B down and, while it is not zero, go back to
                     ; #R$C374
 $C379 POP DE        ; Restore DE from the stack
 $C37A POP HL        ; Restore HL from the stack
 $C37B POP BC        ; Restore BC from the stack
 $C37C RET           ; Return to the caller

; Swap DE and HL, then move HL down a character row
;
; Adds 32 to L, and 8 to H when that carries - the next character row, crossing
; into the next third of the screen when it has to. Because it swaps first,
; #R$C316 calls it twice to move both of its pointers on and leave them the
; right way round.
; .
; CORRECTED 2026-11-08: this was described as the next pixel line; 32 bytes on
; in the Spectrum's screen is the next character row.
;
;  Input:DE, HL Two screen addresses
; Output:HL The other pointer moved down one character row
;        DE The pointer that was HL
c$C37D EX DE,HL      ; Work on the other pointer
 $C37E LD A,L        ; Copy L into A - Down a character row
 $C37F ADD A,$20     ; Add $20 to A
 $C381 LD L,A        ; Copy A into L
 $C382 RET NC        ; Still in the same third
 $C383 LD A,H        ; Copy H into A - Into the next third
 $C384 ADD A,$08     ; Add $08 to A
 $C386 LD H,A        ; Copy A into H
 $C387 RET           ; Return to the caller

; PLOT-CHAR: draw one character glyph at HL, shifted by C
;
; The genuine low-level character printer. Computes the source glyph address as
; A*8 + $3C00 - which is exactly the real 128K/48K ROM's own character-bitmap
; layout (space, code 32, sits at $3D00 = $3C00 + 32*8), confirming A is a
; plain ASCII code here, not some internal token.
; .
; For each of the glyph's 8 pixel rows, shifts the byte right by C bits
; (carrying into the next screen byte, via the 'or c' merge at #R$C3B0/#R$C3CD)
; so that text can be printed at any pixel column, not just 8-pixel-aligned
; ones - this is why the routine is more involved than a plain 1:1 glyph copy.
; .
; This has no real ROM font table to read from in this project's emulator
; harness (see harness_notes.md), so glyphs render as blank pixels there - but
; the routine still faithfully receives the real character codes, which is what
; matters for recovering message text: hooking A at this address is how every
; piece of game text quoted in this disassembly (the opening room description,
; parser responses, etc.) was actually captured, per message-rendering.md's
; guidance to call the real printer rather than hand-decode bytes.
;
;  Input:A The character
;        HL The screen address
;        C The pixel shift
; Output:The glyph drawn; all registers kept
c$C388 PUSH AF       ; Save everything - A is the character to plot
 $C389 PUSH BC       ; Save BC on the stack
 $C38A PUSH DE       ; Save DE on the stack
 $C38B PUSH HL       ; Save HL on the stack
 $C38C LD L,A        ; HL = A (as a word)
 $C38D LD H,$00      ; Load H with $00
 $C38F ADD HL,HL     ; HL = A * 8...
 $C390 ADD HL,HL     ; Double HL (shift it left one bit)
 $C391 ADD HL,HL     ; Double HL (shift it left one bit)
 $C392 LD DE,$3C00   ; ...plus the font table base ($3C00: the ROM layout)
 $C395 ADD HL,DE     ; Add DE to HL
 $C396 EX DE,HL      ; DE = this glyph's address; HL = the screen position
 $C397 POP HL        ; Restore HL from the stack
 $C398 PUSH HL       ; Save HL on the stack
 $C399 LD B,$08      ; 8 pixel rows to plot
*$C39B LD A,(DE)     ; Fetch this row of the glyph
 $C39C PUSH BC       ; Save BC on the stack
 $C39D PUSH AF       ; Save AF on the stack
 $C39E DEC C         ; Is the column-shift zero (byte-aligned print)?
 $C39F INC C         ; Add one to C
 $C3A0 LD B,$FF      ; Load B with $FF
 $C3A2 JR Z,$C3AB    ; Fast path: no shifting needed
*$C3A4 SRL A         ; Shift the glyph byte right by the column offset...
 $C3A6 SRL B         ; ...building a matching mask alongside it
 $C3A8 DEC C         ; Count C down; loop until zero
 $C3A9 JR NZ,$C3A4   ; If C is not zero, go back to #R$C3A4
*$C3AB LD C,A        ; Copy A into C
 $C3AC LD A,B        ; Copy B into A
 $C3AD CPL           ; Clear the bits this glyph will occupy...
 $C3AE AND (HL)      ; Keep only the bits of A that are set in the byte HL
                     ; points at
 $C3AF OR C          ; ...and merge the shifted glyph bits in
 $C3B0 LD (HL),A     ; Store A at the address HL points to
 $C3B1 POP AF        ; Restore the row counter
 $C3B2 POP BC        ; Restore BC from the stack
 $C3B3 DEC C         ; Fast-aligned path rejoins here (from the sign-flag
                     ; branch above)
 $C3B4 INC C         ; Add one to C
 $C3B5 JR Z,$C3D0    ; If C has become zero, skip ahead to #R$C3D0
 $C3B7 PUSH BC       ; Remaining shift = 8 - column offset (the overflow into
 $C3B8 PUSH AF       ; the next screen byte)
 $C3B9 LD A,$08      ; C = 8 - C
 $C3BB SUB C         ; Subtract C from A
 $C3BC LD C,A        ; Copy A into C
 $C3BD POP AF        ; Restore AF from the stack
 $C3BE LD B,$FF      ; Shift the glyph byte left by that remaining amount...
*$C3C0 SLA A         ; ...building a matching mask alongside it
 $C3C2 SLA B         ; Shift B left, C times
 $C3C4 DEC C         ; Subtract one from C
 $C3C5 JR NZ,$C3C0   ; If C is not zero, go back to #R$C3C0
 $C3C7 LD C,A        ; C = A; A = B complemented
 $C3C8 LD A,B        ; Copy B into A
 $C3C9 CPL           ; Flip every bit of A
 $C3CA INC HL        ; Move to the next screen byte along
 $C3CB AND (HL)      ; Clear the bits this glyph will occupy there...
 $C3CC OR C          ; Set in A the bits that are set in C
 $C3CD LD (HL),A     ; ...and merge the overflow bits in
 $C3CE DEC HL        ; Move back (net: one screen byte to the right overall)
 $C3CF POP BC        ; Restore BC from the stack
*$C3D0 INC DE        ; Step DE on to the next byte
 $C3D1 INC H         ; Next pixel row down
 $C3D2 DJNZ $C39B    ; Count B down and, while it is not zero, go back to
                     ; #R$C39B
 $C3D4 POP HL        ; Restore caller's registers
 $C3D5 POP DE        ; Restore DE from the stack
 $C3D6 POP BC        ; Restore BC from the stack
 $C3D7 LD A,C        ; C = the new column-shift for the next character:
 $C3D8 ADD A,$07     ; add the glyph width (7 wide, since 1 col overlaps)...
 $C3DA CP $08        ; ...wrapping back into 0-7 and bumping the screen
 $C3DC JR C,$C3E1    ; ...column (inc L) when it does
 $C3DE SUB $08       ; Subtract $08 from A
 $C3E0 INC L         ; Add one to L
*$C3E1 LD C,A        ; Copy A into C
 $C3E2 POP AF        ; Restore the flags this routine was called with
 $C3E3 RET           ; Return to the caller

; Send the screen's top character row to the ZX Printer, if printing is on
;
; Only when #R$A002($A008) is set (by the PRINT special word; NOPRINT clears
; it): eight pixel lines from #LINK(rom_symbols#a4000)($4000), each through
; #R$C403, then the printer motor is stopped (OUT ($FB),4). Read from the code;
; not tried (no printer in the harness).
;
;  Input:$A008 Non-zero when printing is on
; Output:The top character row sent to the ZX Printer; registers kept
c$C3E4 LD A,($A008)  ; Read #R$A002($A008) in "Game variables" into A -
                     ; Printing off (no PRINT command): nothing to do
 $C3E7 AND A         ; Clear the carry flag for the caller (A is unchanged)
 $C3E8 RET Z         ; If A is zero, return
 $C3E9 PUSH HL       ; Save HL on the stack
 $C3EA PUSH DE       ; Save DE on the stack
 $C3EB PUSH BC       ; Save BC on the stack
 $C3EC LD HL,$4000   ; Load HL with #LINK(rom_symbols#a4000)($4000) - The top
                     ; character row: eight pixel lines from
                     ; #LINK(rom_symbols#a4000)($4000)
 $C3EF LD B,$08      ; Load B with $08
*$C3F1 PUSH BC       ; Save BC on the stack
 $C3F2 PUSH HL       ; Save HL on the stack
 $C3F3 CALL $C403    ; Call the routine "Print one pixel line on the ZX
                     ; Printer" (#R$C403)
 $C3F6 POP HL        ; Restore HL from the stack
 $C3F7 INC H         ; Add one to H - Next pixel line down
 $C3F8 POP BC        ; Restore BC from the stack
 $C3F9 DJNZ $C3F1    ; Count B down and, while it is not zero, go back to
                     ; #R$C3F1
 $C3FB LD A,$04      ; Load A with $04 - Stop the printer motor
 $C3FD OUT ($FB),A   ; Write A to port ($FB)
 $C3FF POP BC        ; Restore BC from the stack

; The end of $C3E4 (POP DE, POP HL, RET)
;
; Addresses named in the title: #R$C3E4.
; .
; The last instructions of #R$C3E4, after its OUT ($FB),4. CORRECTED: was
; described as a shared tail for a joystick routine; #R$C403 is the printer,
; and #R$C412's JP #LINK(rom_symbols#a0F12)($0F12) goes into the ROM, not here.
;
; Output:HL, DE restored
c$C400 POP DE        ; Restore DE from the stack
 $C401 POP HL        ; Restore HL from the stack
 $C402 RET           ; Return to the caller

; Print one pixel line on the ZX Printer
;
; Port $FB is the ZX Printer's. Sets the printer speed (slower for the last two
; of the eight lines: the B < 3 test at #R$C403-#R$C407), waits until the
; printer is ready (IN A,($FB), RET M / JR NC) and joins the 48K ROM's
; COPY-LINE code at #LINK(rom_symbols#a0F12)($0F12), which prints one pixel
; line. Called eight times by #R$C3E4 for each character row sent to the
; printer, so it is reached only when printing is on (PRINT special word).
; CORRECTED: was 'Read a Kempston-style joystick port' - the Kempston joystick
; is port $1F; $FB with a jump into the ROM's COPY-LINE is the printer. Read
; from the code; not tried (no printer in the harness).
;
;  Input:B The pixel line number
;        HL The screen address of the line
; Output:The line sent to the printer through the ROM at $0F12
c$C403 LD A,B        ; Copy B into A - Slow the motor for the last two lines (B
                     ; < 3): the start of the ROM's COPY-LINE ($0EF4), copied
                     ; without its BREAK test
 $C404 CP $03        ; Compare A with $03
 $C406 SBC A,A       ; Subtract A and the carry from A
 $C407 AND $02       ; Isolate bit 1 of A (mask $02)
 $C409 OUT ($FB),A   ; Write A to port ($FB)
 $C40B LD D,A        ; Copy A into D
*$C40C IN A,($FB)    ; Read port ($FB) into A - Wait for the printer: bit 6 set
                     ; (no printer) returns, bit 7 is the stylus
 $C40E ADD A,A       ; Double A (shift it left one bit)
 $C40F RET M         ; If the last result was negative (sign flag set), return
 $C410 JR NC,$C40C   ; If it did not overflow, go back to #R$C40C
 $C412 JP $0F12      ; Join the ROM's COPY-LINE where it starts sending the 32
                     ; bytes

; GET-KEY, but block until a key is actually pressed
;
; A thin blocking wrapper: repeatedly calls the real GET-KEY at #R$C41F,
; ignoring the 'no key' result, until bit 7 of the return value is set - then
; masks that bit off and returns the plain ASCII code. Used wherever the game
; needs to pause for 'press a key to continue' (e.g. the page-wait logic in the
; print-window routine below), as opposed to the non-blocking poll used
; elsewhere (e.g. in the boot sequence above).
;
; Output:A The key pressed (bit 7 cleared)
c$C415 CALL $C41F    ; Ask if a key is available
 $C418 BIT 7,A       ; Was one?
 $C41A JR Z,$C415    ; No: keep asking
 $C41C AND $7F       ; Yes: strip the "a key was pressed" tag, keep just the
                     ; ASCII
 $C41E RET           ; Return to the caller

; GET-KEY: has the player pressed a key?
;
; Saves IY/IX/HL/DE/BC, points IY at the standard system-variable area
; (#LINK(rom_symbols#a5C3A)($5C3A)), then does EI; HALT; DI - i.e. waits for
; exactly one interrupt, which is where a real Spectrum's ROM would normally
; have scanned the keyboard into FLAGS/LAST-K.
; .
; Checks FLAGS bit 5 ("a new key is waiting"); if not, returns A=0. If a key is
; waiting, clears that bit, reads LAST-K (the ROM's already-decoded ASCII
; value), remaps three ROM editing-key codes (an underscore-shaped delete-left
; key, and two others) onto plainer control codes the game's own line editor
; expects, calls a small helper at #R$C240 (not yet examined), then sets bit 7
; of A before returning - so the caller's contract is: A=0 means no key, A =
; ASCII|$80 means this key was pressed.
; .
; Called from three places, all real CALL instructions: #R$A07F($A080)
; (non-blocking poll during boot), #R$A53A($A53B), and #R$C415($C416) (the
; wait-for-a-key loop at #R$C415).
; .
; Confirmed in the emulator: this is the only place in the whole 41,600-byte
; block that reads FLAGS/LAST-K at all, and there are zero raw `IN
; A,($FE)`-style port reads anywhere in the block, so this is genuinely the
; game's one and only keyboard entry point, not just a convenient guess. See
; harness_notes.md for how this was verified by hooking it directly and
; recovering legible printed game text.
; .
; How it works:
; .
; 1. Save the registers and point IY at the system variables.
; .
; 2. Allow one interrupt (EI, HALT) so the keyboard is scanned.
; .
; 3. If no new key is flagged, return 0. Otherwise take the key from
; #LINK(rom_symbols#a5C08)($5C08), turn the ROM's editing codes into backspace
; and '[', and put it in capitals.
; .
; 4. Set bit 7 to say a key was pressed.
;
; Output:A The key with bit 7 set, or 0 if none
;        All other registers kept
c$C41F PUSH IY       ; Save every register this routine touches
 $C421 PUSH IX       ; Save IX, HL, DE, BC
 $C423 PUSH HL       ; Save HL on the stack
 $C424 PUSH DE       ; Save DE on the stack
 $C425 PUSH BC       ; Save BC on the stack
 $C426 LD IY,$5C3A   ; IY -> system variables, as ROM interrupt code expects
 $C42A EI            ; Let exactly one interrupt happen...
 $C42B HALT          ; ...(this is where the keyboard actually gets scanned)
 $C42C DI            ; Disable interrupts
 $C42D LD A,($5C3B)  ; Was a new key flagged as available?
 $C430 BIT 5,A       ; Test bit 5 of A
 $C432 JR NZ,$C437   ; If bit 5 of A is set, skip ahead to #R$C437
 $C434 XOR A         ; No: return with A=0
 $C435 JR $C456      ; Skip ahead to #R$C456
*$C437 RES 5,A       ; Yes: consume the "new key" flag
 $C439 LD ($5C3B),A  ; Store A in FLAGS (#LINK(rom_symbols#a5C3B)($5C3B))
 $C43C LD A,($5C08)  ; A = the key, already decoded to ASCII by the ROM
 $C43F CP $5F        ; Is it the ROM's DELETE-key code?
 $C441 JR NZ,$C445   ; If A differs from $5F, skip ahead to #R$C445
 $C443 LD A,$18      ; ...remap it to a plain backspace
*$C445 CP $0C        ; Is it this other ROM editing code?
 $C447 JR NZ,$C44B   ; If A differs from $0C, skip ahead to #R$C44B
 $C449 LD A,$08      ; ...remap it too
*$C44B CP $0B        ; Is it this third ROM editing code?
 $C44D JR NZ,$C451   ; If A differs from $0B, skip ahead to #R$C451
 $C44F LD A,$5B      ; ...remap it to '['
*$C451 CALL $C240    ; Upper-case A if it is a lower-case letter (#R$C240)
 $C454 SET 7,A       ; Tag the result: bit 7 set means "a key was pressed"
*$C456 POP BC        ; Restore every saved register
 $C457 POP DE        ; Restore DE, HL, IX, IY and return
 $C458 POP HL        ; (Restore the remaining registers)
 $C459 POP IX        ; Restore IX from the stack
 $C45B POP IY        ; Restore IY from the stack
 $C45D RET           ; Return to the caller

; Is B below the last number for this object slot?
;
; Carry when B is below 106 if the slot's requirement code (#R$A00A($A010), or
; #R$A00A($A00F) when entered at #R$C463) is below 5, or below 110 if it is 5
; or more - 106 and 110 being one past the last room and the last thing. Used
; by the guessing loops #R$C55A and #R$C60D. Read from the code.
;
;  Input:B The candidate number
; Output:F Carry when it is within the allowed range (below 106 for a room, 110
; .        for a thing)
c$C45E LD A,($A010)  ; Read #R$A00A($A010) in "Game variables" into A -
                     ; Indirect object's requirement code (#R$A00A($A010))...
 $C461 JR $C466      ; Skip ahead to #R$C466
; This entry point is used by the routines at #R$C4D1 and #R$C583.
*$C463 LD A,($A00F)  ; (or the direct object's #R$A00A($A00F) from here)
*$C466 CP $05        ; Code below 5 means a room, otherwise a thing
 $C468 LD A,B        ; Copy B into A - A = the candidate number B
 $C469 JR C,$C46E    ; If A is below $05, skip ahead to #R$C46E
 $C46B CP $6E        ; Compare A with $6E - Things: carry if B is below 110
 $C46D RET           ; Return to the caller
*$C46E CP $6A        ; Compare A with $6A - Rooms: carry if B is below 106
 $C470 RET           ; Return to the caller

; Words for a +5 flag that should be set but is not
;
; Dictionary word references, one per bit of an object's +5 flags, printed by
; #R$CB7B after 'THE <object> IS'. 0 = no word. Together the two tables name
; the flags: bit 0 locked, bit 2 full, bit 4 on (lit), bit 5 open, bit 6 alive;
; bit 7 is 'revealed' (#R$9C56). Bits 5 and 7 are confirmed by play; the rest
; are read from these words.
w$C471 DEFW $0930    ; Bit 0: UNLOCKED
 $C473 DEFW $0000    ; Bit 1: none
 $C475 DEFW $0288    ; Bit 2: EMPTY
 $C477 DEFW $0000    ; Bit 3: none
 $C479 DEFW $05EF    ; Bit 4: OFF
 $C47B DEFW $01BB    ; Bit 5: CLOSED
 $C47D DEFW $0225    ; Bit 6: DEAD
 $C47F DEFW $0000    ; Bit 7: none

; Words for a +5 flag that is set but should not be
;
; Dictionary word references, one per bit of an object's +5 flags, printed by
; #R$CB7B after 'THE <object> IS'. 0 = no word. Together the two tables name
; the flags: bit 0 locked, bit 2 full, bit 4 on (lit), bit 5 open, bit 6 alive;
; bit 7 is 'revealed' (#R$9C56). Bits 5 and 7 are confirmed by play; the rest
; are read from these words.
w$C481 DEFW $0517    ; Bit 0: LOCKED
 $C483 DEFW $0000    ; Bit 1: none
 $C485 DEFW $035F    ; Bit 2: FULL
 $C487 DEFW $0000    ; Bit 3: none
 $C489 DEFW $05FF    ; Bit 4: ON
 $C48B DEFW $060B    ; Bit 5: OPEN
 $C48D DEFW $0000    ; Bit 6: none
 $C48F DEFW $0000    ; Bit 7: none

; Rooms saved before an action
;
; #R$C491: the current actor's room, and #R$C492: the direct object's room,
; saved by #R$CA22 before the action body runs, so #R$CAAF can tell afterwards
; whether anything moved. Read from the code.
b$C491 DEFB $00      ; The actor's room
 $C492 DEFB $00      ; The direct object's room

; Set the direct object's requirement from the parsed words
;
; For a command that has not reached an action record yet: #R$A00A($A00F)
; becomes 0, 4, 5 (a number) or 7 from the parser's word-class flags in
; #R$A01A($A01D)/#R$A01A($A01E). #R$C4B2 does the same for the indirect object
; (#R$A00A($A010)). Read from the code.
;
;  Input:$A01D, $A01E The verb's flags
; Output:$A00F The direct object's requirement: 0 none, 4, 5 a number or 7 an
; .            ordinary thing
c$C493 XOR A         ; Clear A to zero (and the carry flag) - Requirement 0: no
                     ; direct object
 $C494 LD HL,$A01D   ; Point HL at #R$A01A($A01D) in "Game variables"
 $C497 BIT 3,(HL)    ; Test bit 3 of the byte at #R$A01A($A01D) in "Game
                     ; variables" - #R$A01A($A01D) bit 3 (a direct object)
                     ; clear: store 0
 $C499 JR Z,$C4AE    ; If bit 3 of the byte at #R$A01A($A01D) in "Game
                     ; variables" is clear, skip ahead to #R$C4AE
 $C49B LD A,$04      ; Requirement 4...
 $C49D BIT 7,(HL)    ; Test bit 7 of the byte at #R$A01A($A01D) in "Game
                     ; variables" - ...if bit 7 is set
 $C49F JR NZ,$C4AE   ; If bit 7 of the byte at #R$A01A($A01D) in "Game
                     ; variables" is set, skip ahead to #R$C4AE
 $C4A1 LD A,($A01E)  ; Read #R$A01A($A01E) in "Game variables" into A - Else:
                     ; both of #R$A01A($A01E)'s bits 2-3 set (a number)?
 $C4A4 AND $0C       ; Keep only bits 2, 3 of A (mask $0C)
 $C4A6 CP $0C        ; Compare A with $0C
 $C4A8 LD A,$05      ; Load A with $05 - Yes: requirement 5
 $C4AA JR Z,$C4AE    ; If A equals $0C, skip ahead to #R$C4AE
 $C4AC LD A,$07      ; No: 7, an ordinary thing
*$C4AE LD ($A00F),A  ; Store A in #R$A00A($A00F) in "Game variables" - Store at
                     ; #R$A00A($A00F)
 $C4B1 RET           ; Return to the caller

; Set the indirect object's requirement from the parsed words
;
; Used by the routines at #R$A37D, #R$B191 and #R$C4D1.
;
;  Input:$A01D, $A01E The verb's flags
; Output:$A010 The indirect object's requirement: 0 none, 4, 5 a number or 7 an
; .            ordinary thing
c$C4B2 XOR A         ; A = 0: no indirect object
 $C4B3 LD HL,$A01D   ; Point HL at #R$A01A($A01D) in "Game variables" - Verb
                     ; flag #R$A01A($A01D) bit 2 (takes an indirect object)?
 $C4B6 BIT 2,(HL)    ; Test bit 2 of the byte at #R$A01A($A01D) in "Game
                     ; variables"
 $C4B8 JR Z,$C4CD    ; No: requirement code 0
 $C4BA LD A,$04      ; Load A with $04 - Bit 6 set (TAKE TO)?: code 4
 $C4BC BIT 6,(HL)    ; Test bit 6 of the byte at #R$A01A($A01D) in "Game
                     ; variables"
 $C4BE JR NZ,$C4CD   ; If bit 6 of the byte at #R$A01A($A01D) in "Game
                     ; variables" is set, skip ahead to #R$C4CD
 $C4C0 LD A,($A01E)  ; Read #R$A01A($A01E) in "Game variables" into A -
                     ; #R$A01A($A01E) bits 0-1 both set (the object is a
                     ; number)?: code 5
 $C4C3 AND $03       ; Keep only bits 0, 1 of A (mask $03)
 $C4C5 CP $03        ; Compare A with $03
 $C4C7 LD A,$05      ; Load A with $05
 $C4C9 JR Z,$C4CD    ; If A equals $03, skip ahead to #R$C4CD
 $C4CB LD A,$07      ; Otherwise code 7 (a thing that must be here)
*$C4CD LD ($A010),A  ; Store A in #R$A00A($A010) in "Game variables" - Store as
                     ; #R$A00A($A010)
 $C4D0 RET           ; Return to the caller

; Carry out the command in $A033-$A035 for the current actor
;
; Addresses named in the title: #R$A032($A033), #R$A032($A035).
; .
; The one entry point for doing a command, used for the player's typed commands
; and for every DO in a plan script. Verbs #R$E497(128) and up go to #R$C583
; (the script-only verbs). Otherwise the requirement codes are set from the
; parse (#R$C493, #R$C4B2); when the verb needs an object but none was given
; (#R$A032($A034) = $FF), each candidate object (#R$C463) is tried in turn
; until one works (#R$C55A) - which is how a character's 'DO TAKE' with no
; object picks something up. Then #R$C929 finds and runs the action record.
; Read from the code.
; .
; How it works:
; .
; 1. A verb number with bit 7 set is a script-only verb: use the numbered
; record (#R$C583).
; .
; 2. Otherwise find the verb's pattern record (#R$A2B1), gather its flags
; (#R$A2BD), and set the two objects' requirement codes (#R$C493, #R$C4B2).
; .
; 3. If a number is required, the object must be $FE. If a required direct
; object is still $FF, ask for it.
; .
; 4. Guess the indirect object when it is missing and the verb allows (#R$C542,
; #R$C55A), then check the record (#R$C929) and carry it out.
;
;  Input:$A033 The verb
;        $A034 The direct object, $ A035 the indirect object
;        $A036 The actor
; Output:F Z if refused; NZ if the action was done
c$C4D1 LD A,($A033)  ; The verb number (#R$A032($A033)): bit 7 set means a
                     ; script-only verb (#R$C583)
 $C4D4 BIT 7,A       ; A script-only verb (128 and up)?
 $C4D6 JP NZ,$C583   ; Yes: #R$C583
 $C4D9 CALL $A2B1    ; Call the routine "HL = verb A's record in the verb
                     ; table" (#R$A2B1) - Its pattern record (#R$A2B1) into IX;
                     ; set the verb flags (#R$A2BD)
 $C4DC PUSH HL       ; Save HL on the stack
 $C4DD POP IX        ; Restore IX from the stack
 $C4DF CALL $A2BD    ; Call the routine "Gather a verb record's flag nibbles
                     ; into #R$A01A($A01D) and..." (#R$A2BD)
 $C4E2 CALL $C493    ; Requirement codes of the two objects (#R$C493, #R$C4B2)
 $C4E5 CALL $C4B2    ; ...and the indirect object
 $C4E8 XOR A         ; Clear A to zero (and the carry flag) - #R$A00A($A00B) =
                     ; 0
 $C4E9 LD ($A00B),A  ; Store A in #R$A00A($A00B) in "Game variables"
 $C4EC LD A,($A01D)  ; Read #R$A01A($A01D) in "Game variables" into A - Verb
                     ; takes no objects (#R$A01A($A01D) bits 2-3 clear)?
 $C4EF AND $0C       ; Keep only bits 2, 3 of A (mask $0C)
 $C4F1 JR Z,$C53A    ; Yes: run it as it is (#R$C53A)
 $C4F3 LD A,($A00F)  ; Read #R$A00A($A00F) in "Game variables" into A - Direct
                     ; object a number (code 5)? Then #R$A032($A034) must be
                     ; $FE...
 $C4F6 CP $05        ; Compare A with $05
 $C4F8 JR NZ,$C502   ; If A differs from $05, skip ahead to #R$C502
 $C4FA LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A
 $C4FD CP $FE        ; Compare A with $FE
 $C4FF JP NZ,$CB41   ; ...else refuse (Z)
*$C502 LD A,($A010)  ; Read #R$A00A($A010) in "Game variables" into A - Same
                     ; for the indirect object and #R$A032($A035)
 $C505 CP $05        ; Compare A with $05
 $C507 JR NZ,$C511   ; If A differs from $05, skip ahead to #R$C511
 $C509 LD A,($A035)  ; Read #R$A032($A035) in "Game variables" into A
 $C50C CP $FE        ; Compare A with $FE
 $C50E JP NZ,$CB41   ; If A differs from $FE, jump on to the routine "Return Z
                     ; (does nothing)" (#R$CB41)
*$C511 LD A,($A00F)  ; Read #R$A00A($A00F) in "Game variables" into A - Does
                     ; the verb want a direct object, and is #R$A032($A034)
                     ; still $FF?
 $C514 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $C515 JR Z,$C531    ; If A is zero, skip ahead to #R$C531
 $C517 LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - Needs
                     ; an object but none given?
 $C51A CP $FF        ; Compare A with $FF
 $C51C JR NZ,$C531   ; If A differs from $FF, skip ahead to #R$C531
 $C51E LD B,$FF      ; Guess it: candidates B = 0, 1, 2... (#R$C463 ends the
                     ; loop)
*$C520 INC B         ; Add one to B - Try the next candidate
 $C521 CALL $C463    ; Call #R$C463 (inside "Is B below the last number for
                     ; this object...")
 $C524 RET Z         ; If the zero flag is set, return
 $C525 LD ($A034),A  ; Store A in #R$A032($A034) in "Game variables" - Try the
                     ; candidate as the direct object
 $C528 PUSH BC       ; Save BC on the stack
 $C529 CALL $C55A    ; Call the routine "Guess the indirect object: try each
                     ; one until the..." (#R$C55A) - ...with a guess at the
                     ; indirect object (#R$C55A)
 $C52C POP BC        ; Restore BC from the stack
 $C52D JR NZ,$C53A   ; Worked: run it (#R$C53A)
 $C52F JR $C520      ; Else the next candidate
*$C531 CALL $C542    ; Call the routine "Should the indirect object be
                     ; guessed?" (#R$C542)
 $C534 JR Z,$C53A    ; If the zero flag is set, skip ahead to #R$C53A
 $C536 CALL $C560    ; Call #R$C560 (inside "Guess the indirect object: try
                     ; each one...") - Guess it (#R$C560)
 $C539 RET Z         ; If the zero flag is set, return
*$C53A LD A,$01      ; Load A with $01 - #R$A00A($A00B) = 1, then find and run
                     ; the action record (#R$C929)
 $C53C LD ($A00B),A  ; Store A in #R$A00A($A00B) in "Game variables"
 $C53F JP $C929      ; Jump on to the routine "Check the action record against
                     ; the command's..." (#R$C929)

; Should the indirect object be guessed?
;
; NZ when the action record wants an indirect object (#R$A00A($A010), its
; header byte 1's low nibble, is not 0), none was typed (#R$A032($A035) = $FF)
; and bit 1 of #R$A01A($A01D) is clear. Read from the code.
;
;  Input:$A010, $A035, $A01D
; Output:F NZ when an indirect object should be guessed; Z when not
c$C542 LD A,($A010)  ; Read #R$A00A($A010) in "Game variables" into A - No
                     ; indirect object wanted (#R$A00A($A010) = 0): no guessing
                     ; - Z
 $C545 AND A         ; Clear the carry flag for the caller (A is unchanged)
 $C546 RET Z         ; If A is zero, return
 $C547 LD A,($A035)  ; Read #R$A032($A035) in "Game variables" into A - One was
                     ; typed (#R$A032($A035) is not $FF): no guessing - Z
 $C54A CP $FF        ; Compare A with $FF
 $C54C JR NZ,$C558   ; If A differs from $FF, skip ahead to #R$C558
 $C54E LD A,($A01D)  ; Read #R$A01A($A01D) in "Game variables" into A - None
                     ; typed: #R$A01A($A01D) bit 1 set means the verb can do
                     ; without
 $C551 AND $02       ; Isolate bit 1 of A (mask $02)
 $C553 JR NZ,$C558   ; If bit 1 of A was set, skip ahead to #R$C558
 $C555 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Otherwise NZ: guess one
 $C557 RET           ; Return to the caller
*$C558 XOR A         ; Set A to zero, which sets the zero flag for the caller -
                     ; Return Z
 $C559 RET           ; Return to the caller

; Guess the indirect object: try each one until the record's checks pass
;
; If #R$C542 says so, puts 0, 1, 2... in #R$A032($A035) in turn (up to the
; limit from #R$C45E) and runs the record's checks (#R$C929) until one passes -
; so a command can work without naming the second thing. Read from the code;
; not tried in the emulator.
;
; Output:F NZ when a candidate indirect object let the record's checks pass; Z
; .        when none did
;        $A035 The candidate that passed
c$C55A CALL $C542    ; Should the indirect object be guessed (#R$C542)?
 $C55D JP Z,$C929    ; No: just run the checks (#R$C929)
; This entry point is used by the routine at #R$C4D1.
*$C560 LD B,$FF      ; Load B with $FF - Candidate B = 0, 1, 2...
*$C562 INC B         ; Add one to B
 $C563 CALL $C45E    ; Out of range (#R$C45E)?
 $C566 JR Z,$C570    ; Yes: give up (Z)
 $C568 LD ($A035),A  ; Try it as the indirect object
 $C56B CALL $C929    ; Does the record's check pass (#R$C929)?
 $C56E JR Z,$C562    ; If the zero flag is set, go back to #R$C562 - No: next
                     ; candidate; yes: return NZ
*$C570 RET           ; Return to the caller

; $A00F = an action record's requirement code (header byte 0, low nibble)
;
; Addresses named in the title: #R$A00A($A00F).
;
;  Input:IX An action record
; Output:$A00F The direct object's requirement code (the low nibble of byte 0)
c$C571 LD A,(IX+$00) ; Read the first byte of the record at IX into A -
                     ; #R$A00A($A00F) = the record header's low nibble of byte
                     ; 0
 $C574 AND $0F       ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $C576 LD ($A00F),A  ; Store A in #R$A00A($A00F) in "Game variables"
 $C579 RET           ; Return to the caller

; $A010 = the record's header byte 1, low nibble (the indirect object's
; requirement)
;
; Addresses named in the title: #R$A00A($A010).
;
;  Input:IX An action record
; Output:$A010 The indirect object's requirement code (the low nibble of byte
; .            1)
c$C57A LD A,(IX+$01) ; Read byte +1 of the record at IX into A - #R$A00A($A010)
                     ; = the low nibble of byte 1
 $C57D AND $0F       ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $C57F LD ($A010),A  ; Store A in #R$A00A($A010) in "Game variables"
 $C582 RET           ; Return to the caller

; Pick one of the 13 numbered action records
;
; A = a record number with bit 7 set (a verb of 128 or more, from a DO in a
; plan script). Looks the record up in the table at #R$9FAB, then copies the
; low nibble of its byte 0 to #R$A00A($A00F) and of its byte 1 to
; #R$A00A($A010) (via #R$C571 and #R$C57A), and clears #R$A00A($A00B).
; Continues past this disassembly window - not traced further.
; .
; .
; .
; Line comments added from reading the code. CB41 is taken to be the "return Z"
; stub; the guessing loops only try candidates until the record runs, as the
; helpers at #R$C463/#R$C60D/#R$C613 describe.
; .
; Instruction coverage over the 15 stored routes (9 November,
; tools/experiments/insn_coverage.py): 54 of 57 instructions executed; #R$C5C5
; #R$C5C8 #R$C5CA never ran there and are read from the code only.
; .
; How it works:
; .
; 1. The record number (bit 7 dropped) indexes the 13 record addresses at
; #R$9FAB.
; .
; 2. Set both requirement codes from the record's header (#R$C571, #R$C57A).
; .
; 3. If the record takes no objects, run it at once (#R$C5F4). If the direct
; object must be a number, #R$A032($A034) must be $FE or the command is
; refused.
; .
; 4. Guess a missing indirect object (#R$C60D) and run the record.
;
;  Input:A A record number with bit 7 set
; Output:F Z if refused; NZ if the record ran
c$C583 AND $7F       ; Record number (bit 7 dropped) into DE
 $C585 LD E,A        ; Copy A into E
 $C586 LD D,$00      ; Load D with $00
 $C588 LD HL,$9FAB   ; Look it up in the table of 13 record addresses at
                     ; #R$9FAB (2 bytes each)...
 $C58B ADD HL,DE     ; Add DE to HL
 $C58C ADD HL,DE     ; Add DE to HL
 $C58D LD E,(HL)     ; ...
 $C58E INC HL        ; Step HL on to the next byte
 $C58F LD D,(HL)     ; Read the byte HL points at into D
 $C590 EX DE,HL      ; IX = HL = the record
; This entry point is used by the routine at #R$CE18.
*$C591 PUSH HL       ; Save HL on the stack
 $C592 POP IX        ; Restore IX from the stack
 $C594 CALL $C571    ; #R$A00A($A00F) = requirement code of the direct object
                     ; from the record's header (#R$C571)
 $C597 CALL $C57A    ; #R$A00A($A010) = the indirect object's (#R$C57A)
 $C59A XOR A         ; #R$A00A($A00B) = 0
 $C59B LD ($A00B),A  ; Store A in #R$A00A($A00B) in "Game variables"
 $C59E LD A,($A00F)  ; Read #R$A00A($A00F) in "Game variables" into A - Both
                     ; requirement codes zero (the record takes no objects)?
 $C5A1 LD HL,$A010   ; Point HL at #R$A00A($A010) in "Game variables"
 $C5A4 OR (HL)       ; Set in A the bits that are set in the byte at
                     ; #R$A00A($A010) in "Game variables"
 $C5A5 JR Z,$C5F4    ; Yes: run the record at once (#R$C5F4)
 $C5A7 LD A,($A00F)  ; Read #R$A00A($A00F) in "Game variables" into A - Direct
                     ; object a number (code 5 or 6)?
 $C5AA CP $05        ; Compare A with $05
 $C5AC JR Z,$C5B2    ; If A equals $05, skip ahead to #R$C5B2
 $C5AE CP $06        ; Compare A with $06
 $C5B0 JR NZ,$C5BA   ; If A differs from $06, skip ahead to #R$C5BA
*$C5B2 LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - Then
                     ; #R$A032($A034) must already hold $FE ('a number was
                     ; given')...
 $C5B5 CP $FE        ; Compare A with $FE
 $C5B7 JP NZ,$CB41   ; ...if not, give up: Z (#R$CB41)
*$C5BA LD A,($A010)  ; Read #R$A00A($A010) in "Game variables" into A - Same
                     ; test for the indirect object and #R$A032($A035)
 $C5BD CP $05        ; Compare A with $05
 $C5BF JR Z,$C5C5    ; If A equals $05, skip ahead to #R$C5C5
 $C5C1 CP $06        ; Compare A with $06
 $C5C3 JR NZ,$C5CD   ; If A differs from $06, skip ahead to #R$C5CD
*$C5C5 LD A,($A035)  ; Read #R$A032($A035) in "Game variables" into A
 $C5C8 CP $FE        ; Compare A with $FE
 $C5CA JP NZ,$CB41   ; If A differs from $FE, jump on to the routine "Return Z
                     ; (does nothing)" (#R$CB41)
*$C5CD LD A,($A00F)  ; Read #R$A00A($A00F) in "Game variables" into A - Does
                     ; the record want a direct object, and is #R$A032($A034)
                     ; still $FF (none named)?
 $C5D0 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $C5D1 JR Z,$C5EB    ; If A is zero, skip ahead to #R$C5EB
 $C5D3 LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A
 $C5D6 CP $FF        ; Compare A with $FF
 $C5D8 JR NZ,$C5EB   ; If A differs from $FF, skip ahead to #R$C5EB
 $C5DA LD B,$00      ; Then guess it: try candidate B = 0, 1, 2... (#R$C463
                     ; says when B has run out)
*$C5DC CALL $C463    ; Next candidate into A
 $C5DF RET Z         ; Candidates exhausted: return Z
 $C5E0 LD ($A034),A  ; Make it the direct object
 $C5E3 CALL $C60D    ; Guess the indirect object too and run the record
                     ; (#R$C60D)
 $C5E6 JR NZ,$C5F4   ; NZ: the record ran, finish
 $C5E8 INC B         ; Add one to B - Else try the next candidate
 $C5E9 JR $C5DC      ; Go back to #R$C5DC
*$C5EB CALL $C5FC    ; Should the indirect object be guessed (#R$C5FC)?
 $C5EE JR Z,$C5F4    ; No: run the record as it is
 $C5F0 CALL $C613    ; Yes: guess it and run the record (#R$C613)
 $C5F3 RET Z         ; Return its Z/NZ
*$C5F4 LD A,$01      ; Load A with $01 - Run the record: #R$A00A($A00B) = 1...
 $C5F6 LD ($A00B),A  ; Store A in #R$A00A($A00B) in "Game variables"
 $C5F9 JP $C989      ; ...and go to #R$C989

; Should the indirect object be guessed? (numbered records)
;
; As #R$C542 without the #R$A01A($A01D) test, for the numbered action records
; (#R$C583).
;
;  Input:$A010, $A035
; Output:F NZ when the indirect object should be guessed; Z when not
c$C5FC LD A,($A010)  ; Read #R$A00A($A010) in "Game variables" into A -
                     ; Indirect object requirement code (#R$A00A($A010)) zero:
                     ; no, Z
 $C5FF AND A         ; Clear the carry flag for the caller (A is unchanged)
 $C600 RET Z         ; If A is zero, return
 $C601 LD A,($A035)  ; Read #R$A032($A035) in "Game variables" into A -
                     ; Indirect object still $FF (not named)?
 $C604 CP $FF        ; Compare A with $FF
 $C606 JR NZ,$C60B   ; If A differs from $FF, skip ahead to #R$C60B
 $C608 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Yes: NZ (guess it)
 $C60A RET           ; Return to the caller
*$C60B XOR A         ; Set A to zero, which sets the zero flag for the caller -
                     ; No: Z
 $C60C RET           ; Return to the caller

; Guess the indirect object for a numbered record
;
; As #R$C55A, with the checks run through #R$C989. Read from the code.
;
; Output:F NZ when a candidate made the record run; Z when none did
;        $A035 The candidate
c$C60D CALL $C5FC    ; Call the routine "Should the indirect object be guessed?
                     ; (numbered..." (#R$C5FC)
 $C610 JP Z,$C989    ; If the zero flag is set, jump on to the routine "Run the
                     ; numbered action record IX" (#R$C989)
; This entry point is used by the routine at #R$C583.
*$C613 PUSH BC       ; Save BC on the stack - Guess it: candidate B = 0, 1,
                     ; 2...
 $C614 LD B,$00      ; Load B with $00
*$C616 CALL $C45E    ; Call the routine "Is B below the last number for this
                     ; object slot?" (#R$C45E) - Out of range (#R$C45E)? Then
                     ; give up
 $C619 JR Z,$C626    ; If the zero flag is set, skip ahead to #R$C626
 $C61B LD ($A035),A  ; Try it as the indirect object (#R$A032($A035))...
 $C61E CALL $C989    ; ...by running the record (#R$C989)
 $C621 JR NZ,$C626   ; NZ: it ran
 $C623 INC B         ; Add one to B - Else the next candidate
 $C624 JR $C616      ; Go back to #R$C616
*$C626 POP BC        ; Restore BC from the stack
 $C627 RET           ; Return to the caller

; Check the direct object against the action record's requirement
;
; The low nibble of an action record's byte 0 is a requirement code for the
; direct object, copied to #R$A00A($A00F) by #R$C571; the low nibble of byte 1
; is the same for the indirect object (#R$C6BE). Returns Z to refuse (#R$C632
; is JP #R$DC15). Codes 7-15 are handed to #R$C7A6.
; .
; 0: none. 1 and 2: the object must be a room whose record (#R$D224, the room
; table at #R$840B) has bit 7 of byte 0 set; 1 also needs #R$D471 to find
; something. 3: #R$D471 must find something. 4 and 7: anything. 5: a number
; (#R$A032($A034) = $FE) with bit 7 of the value clear (WAIT UNTIL); 6: the
; same with bit 7 set (PAY TO). 8: the object must be here (#R$C821). 9: TAKE -
; here, in exactly one location (#R$C8A7), not a person (#R$C8BE), small enough
; for the actor to carry (#R$C8C6), and not held by a person (#R$C8AF). 10:
; here and held by the actor. 11: here and in more than one location - a door
; or passage. 12: a person, with no visibility check (FOLLOW). 13-15: here and
; a person.
; .
; Confirmed in the emulator: TAKE PLAIN DOOR, TAKE WATSON, GO THROUGH PLAIN
; DOOR and TAKE DISGUISE get 'I SEE NO ... THAT YOU CAN ...'; DROP LAMP when
; not carried, TALK TO LAMP, GO THROUGH LAMP, FOLLOW LAMP, GIVE LAMP TO WATSON
; when not carried and a second TAKE LAMP get 'YOU CANNOT ... THE ...'; PAY 5
; TO WATSON gets 'DON'T BE SILLY.'
; .
; After the code check, a record with flags bit 4 has five more header bytes: a
; byte of test modes and two pairs of masks, tested against the objects' +5
; flags by #R$C74E (#R$C691 for the direct object; the indirect object's half
; is the same at #R$C6BE's end).
;
;  Input:IY The action record
; Output:F NZ if the direct object meets the record's requirement; otherwise
; .        the command is refused through $DC15
c$C628 LD A,(IY+$00)  ; Read the first byte of the record at IY into A - The
                      ; requirement code: the low nibble of the record's byte
                      ; 0; 0 needs nothing
 $C62B AND $0F        ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $C62D JR NZ,$C635    ; If any of bits 0, 1, 2, 3 of A was set, skip ahead to
                      ; #R$C635
; This entry point is used by the routines at #R$C6BE, #R$C74E and #R$C7A6.
*$C62F OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller - Pass: NZ
 $C631 RET            ; Return to the caller
; This entry point is used by the routine at #R$C7A6.
*$C632 JP $DC15       ; Refuse
*$C635 CP $05         ; Compare A with $05 - Codes 5 and 6: a number
 $C637 JR C,$C660     ; If A is below $05, jump on to #R$C660
 $C639 CP $07         ; Compare A with $07
 $C63B JR NC,$C682    ; If A is $07 or more, jump on to #R$C682
 $C63D LD A,($A034)   ; Read #R$A032($A034) in "Game variables" into A - It
                      ; must be a number ($FE), its value at #R$A02A($A02F)...
 $C640 CP $FE         ; Compare A with $FE
 $C642 JR NZ,$C654    ; If A differs from $FE, skip ahead to #R$C654
 $C644 LD HL,($A02F)  ; Read #R$A02A($A02F) in "Game variables" into HL
 $C647 LD A,(IY+$00)  ; Read the first byte of the record at IY into A
 $C64A AND $0F        ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $C64C CP $05         ; Compare A with $05 - ...with bit 7 of its low byte
                      ; clear for code 5 (WAIT UNTIL), set for 6 (money: PAY
                      ; TO)
 $C64E JR NZ,$C65A    ; If A differs from $05, skip ahead to #R$C65A
 $C650 BIT 7,L        ; Test bit 7 of L
 $C652 JR Z,$C62F     ; If bit 7 of L is clear, go back to #R$C62F
; This entry point is used by the routine at #R$C6BE.
*$C654 XOR A          ; Clear A to zero (and the carry flag) - Refused:
                      ; #R$A01A($A021) = 0
 $C655 LD ($A021),A   ; Store A in #R$A01A($A021) in "Game variables"
 $C658 JR $C632       ; Go back to #R$C632
*$C65A BIT 7,L        ; Test bit 7 of L
 $C65C JR NZ,$C62F    ; If bit 7 of L is set, go back to #R$C62F
 $C65E JR $C654       ; Go back to #R$C654
*$C660 CP $03         ; Compare A with $03 - Codes 1 and 2: a room whose record
                      ; has bit 7 of byte 0 set
 $C662 JR NC,$C670    ; If A is $03 or more, skip ahead to #R$C670
 $C664 LD A,($A034)   ; Read #R$A032($A034) in "Game variables" into A
 $C667 CALL $D224     ; Call the routine "Find a room record" (#R$D224)
 $C66A BIT 7,(IX+$00) ; Test bit 7 of the first byte of the record at IX
 $C66E JR Z,$C654     ; If bit 7 of the first byte of the record at IX is
                      ; clear, go back to #R$C654
*$C670 BIT 0,(IY+$00) ; Test bit 0 of the first byte of the record at IY -
                      ; Codes 1 and 3: and next door to the actor (#R$D471)
 $C674 JR Z,$C62F     ; If bit 0 of the first byte of the record at IY is
                      ; clear, go back to #R$C62F
 $C676 LD A,($A034)   ; Read #R$A032($A034) in "Game variables" into A
 $C679 CALL $D471     ; Call #R$D471 (inside "Find the exit from the actor's
                      ; room through...")
 $C67C CP $FF         ; Compare A with $FF
 $C67E JR Z,$C654     ; If A equals $FF, go back to #R$C654
 $C680 JR $C62F       ; Go back to #R$C62F
*$C682 LD A,($A034)   ; Read #R$A032($A034) in "Game variables" into A - Codes
                      ; 7-15 (#R$C7A6), with the object noted at #R$CB79($CB7A)
                      ; for #R$CB7B
 $C685 LD ($CB7A),A   ; Store A in #R$CB79($CB7A) in "The flags #R$CB7B is to
                      ; name"
 $C688 LD C,A         ; Copy A into C
 $C689 LD A,(IY+$00)  ; Read the first byte of the record at IY into A
 $C68C CALL $C7A6     ; Call the routine "Check object C against requirement
                      ; code A (7-15)" (#R$C7A6)
 $C68F JR Z,$C654     ; If the zero flag is set, go back to #R$C654
 $C691 BIT 4,(IY+$00) ; Test bit 4 of the first byte of the record at IY -
                      ; Flags bit 4: then the +5 flag masks from the header
                      ; (#R$C74E)
 $C695 JR Z,$C62F     ; If bit 4 of the first byte of the record at IY is
                      ; clear, go back to #R$C62F
 $C697 LD A,(IY+$02)  ; Read byte +2 of the record at IY into A
 $C69A LD L,(IY+$03)  ; Read byte +3 of the record at IY into L
 $C69D LD H,(IY+$04)  ; Read byte +4 of the record at IY into H
 $C6A0 BIT 6,(IY+$00) ; Test bit 6 of the first byte of the record at IY - (two
                      ; bytes further on when the header also has a pre-check
                      ; address, bit 6)
 $C6A4 JR Z,$C6AF     ; If bit 6 of the first byte of the record at IY is
                      ; clear, skip ahead to #R$C6AF
 $C6A6 LD A,(IY+$04)  ; Read byte +4 of the record at IY into A
 $C6A9 LD L,(IY+$05)  ; Read byte +5 of the record at IY into L
 $C6AC LD H,(IY+$06)  ; Read byte +6 of the record at IY into H
*$C6AF RRCA           ; Rotate A right one place (bit 0 goes to carry and bit
                      ; 7)
 $C6B0 RRCA           ; Rotate A right one place (bit 0 goes to carry and bit
                      ; 7)
 $C6B1 RRCA           ; Rotate A right one place (bit 0 goes to carry and bit
                      ; 7)
 $C6B2 RRCA           ; Rotate A right one place (bit 0 goes to carry and bit
                      ; 7)
 $C6B3 LD B,A         ; Copy A into B
 $C6B4 CALL $C74E     ; Call the routine "Test object C's +5 flags against a
                      ; record's masks" (#R$C74E)
 $C6B7 RET NZ         ; If the zero flag is clear, return
; This entry point is used by the routine at #R$C6BE.
*$C6B8 LD A,$01       ; Load A with $01 - The flags were wrong: #R$A01A($A021)
                      ; = 1
 $C6BA LD ($A021),A   ; Store A in #R$A01A($A021) in "Game variables"
 $C6BD RET            ; Return to the caller

; Check the indirect object against the action record's requirement
;
; As #R$C628, for the indirect object and the low nibble of byte 1
; (#R$A00A($A010)). #R$C6B8 sets #R$A01A($A021) = 1 (the indirect object is
; being checked); #R$C654 sets it to 0.
; .
; How it works:
; .
; 1. Take the indirect object's requirement code from the low nibble of byte 1
; of the record. Zero means no requirement: pass.
; .
; 2. Codes 5 and 6 want a number (the parser's number marker is $FE, the value
; in #R$A02A($A031)): code 5 needs bit 7 of the value clear, code 6 needs it
; set.
; .
; 3. Codes 1 and 2 want a room whose record has bit 7 of its first byte set;
; codes 1 and 3 also want the room to be next door to the actor (#R$D471).
; .
; 4. Codes 7 to 15 are handed to #R$C7A6 along with the object's id, which is
; also stored at #R$CB79($CB7A) so that a refusal can name it.
; .
; 5. If the record's flags have bit 4 set, the objects' +5 flag bytes are then
; tested against the masks in the record's header (#R$C74E). A failure there
; sets #R$A01A($A021) and refuses.
;
;  Input:IY The action record
; Output:F NZ if the indirect object is acceptable, Z if refused (the refusal
; .        is printed by $DC15)
c$C6BE LD A,(IY+$01)  ; Read byte +1 of the record at IY into A - The
                      ; requirement code: the low nibble of the record's byte
                      ; 1; 0 needs nothing
 $C6C1 AND $0F        ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $C6C3 JR NZ,$C6CB    ; If any of bits 0, 1, 2, 3 of A was set, skip ahead to
                      ; #R$C6CB
*$C6C5 OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller - Pass: NZ
 $C6C7 RET            ; Return to the caller
 $C6C8 JP $DC15       ; Refuse
*$C6CB CP $05         ; Compare A with $05 - Codes 5 and 6: a number
 $C6CD JR C,$C6F5     ; If A is below $05, skip ahead to #R$C6F5
 $C6CF CP $07         ; Compare A with $07
 $C6D1 JR NC,$C719    ; If A is $07 or more, jump on to #R$C719
 $C6D3 LD A,($A035)   ; Read #R$A032($A035) in "Game variables" into A - It
                      ; must be a number ($FE), its value at #R$A02A($A031)...
 $C6D6 CP $FE         ; Compare A with $FE
 $C6D8 JP NZ,$C654    ; If A differs from $FE, go back to #R$C654
 $C6DB LD HL,($A031)  ; Read #R$A02A($A031) in "Game variables" into HL
 $C6DE LD A,(IY+$01)  ; Read byte +1 of the record at IY into A - ...with bit 7
                      ; of its low byte clear for code 5...
 $C6E1 AND $0F        ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $C6E3 CP $05         ; Compare A with $05
 $C6E5 JR NZ,$C6EE    ; If A differs from $05, skip ahead to #R$C6EE
 $C6E7 BIT 7,L        ; Test bit 7 of L
 $C6E9 JR Z,$C6C5     ; If bit 7 of L is clear, go back to #R$C6C5
 $C6EB JP $C654       ; Go back to #R$C654
*$C6EE BIT 7,L        ; Test bit 7 of L - ...and set for code 6
 $C6F0 JR NZ,$C6C5    ; If bit 7 of L is set, go back to #R$C6C5
 $C6F2 JP $C654       ; Go back to #R$C654
*$C6F5 CP $03         ; Compare A with $03 - Codes 1 and 2: a room whose record
                      ; has bit 7 of byte 0 set
 $C6F7 JR NC,$C706    ; If A is $03 or more, skip ahead to #R$C706
 $C6F9 LD A,($A035)   ; Read #R$A032($A035) in "Game variables" into A
 $C6FC CALL $D224     ; Call the routine "Find a room record" (#R$D224)
 $C6FF BIT 7,(IX+$00) ; Test bit 7 of the first byte of the record at IX
 $C703 JP Z,$C654     ; If bit 7 of the first byte of the record at IX is
                      ; clear, go back to #R$C654
*$C706 BIT 0,(IY+$01) ; Test bit 0 of byte +1 of the record at IY - Codes 1 and
                      ; 3: and next door to the actor (#R$D471)
 $C70A JR Z,$C6C5     ; If bit 0 of byte +1 of the record at IY is clear, go
                      ; back to #R$C6C5
 $C70C LD A,($A035)   ; Read #R$A032($A035) in "Game variables" into A
 $C70F CALL $D471     ; Call #R$D471 (inside "Find the exit from the actor's
                      ; room through...")
 $C712 CP $FF         ; Compare A with $FF
 $C714 JP Z,$C654     ; If A equals $FF, go back to #R$C654
 $C717 JR $C6C5       ; Go back to #R$C6C5
*$C719 LD A,($A035)   ; Read #R$A032($A035) in "Game variables" into A - Codes
                      ; 7-15 (#R$C7A6), with the object noted at #R$CB79($CB7A)
 $C71C LD ($CB7A),A   ; Store A in #R$CB79($CB7A) in "The flags #R$CB7B is to
                      ; name"
 $C71F LD C,A         ; Copy A into C
 $C720 LD A,(IY+$01)  ; Read byte +1 of the record at IY into A
 $C723 CALL $C7A6     ; Call the routine "Check object C against requirement
                      ; code A (7-15)" (#R$C7A6)
 $C726 RET Z          ; If the zero flag is set, return
 $C727 BIT 4,(IY+$00) ; Test bit 4 of the first byte of the record at IY -
                      ; Flags bit 4: then the indirect object's +5 masks from
                      ; the header (#R$C74E)
 $C72B JP Z,$C62F     ; If bit 4 of the first byte of the record at IY is
                      ; clear, go back to #R$C62F
 $C72E LD A,(IY+$02)  ; Read byte +2 of the record at IY into A
 $C731 LD L,(IY+$05)  ; Read byte +5 of the record at IY into L
 $C734 LD H,(IY+$06)  ; Read byte +6 of the record at IY into H
 $C737 BIT 6,(IY+$00) ; Test bit 6 of the first byte of the record at IY - (two
                      ; bytes further on when the header also has a pre-check
                      ; address, bit 6)
 $C73B JR Z,$C746     ; If bit 6 of the first byte of the record at IY is
                      ; clear, skip ahead to #R$C746
 $C73D LD A,(IY+$04)  ; Read byte +4 of the record at IY into A
 $C740 LD L,(IY+$07)  ; Read byte +7 of the record at IY into L
 $C743 LD H,(IY+$08)  ; Read byte +8 of the record at IY into H
*$C746 LD B,A         ; Copy A into B
 $C747 CALL $C74E     ; Call the routine "Test object C's +5 flags against a
                      ; record's masks" (#R$C74E)
 $C74A RET NZ         ; If the zero flag is clear, return
 $C74B JP $C6B8       ; The flags were wrong: #R$A01A($A021) = 1, and refuse

; Test object C's +5 flags against a record's masks
;
; B holds two 2-bit modes and L/H two masks. Mode 0: every mask bit must be
; set; 1: at least one (or the mask is 0); 2: none may be set; 3: not all may
; be set (read from the code; modes 1 and 3 were not tried). On failure the
; offending bits go to #R$CB79 (bit 7 set when a bit was present that should
; not be) and HL = #R$CB7B, the refusal that names the flag.
; .
; Confirmed in the emulator: OPEN YOUR DOOR when it is open leaves #R$CB79 =
; $A0 and prints 'YOUR DOOR IS OPEN'; CLOSE YOUR DOOR when it is closed leaves
; $20 and prints 'YOUR DOOR IS CLOSED'. The door's +5 goes $80 -> $A0 when
; opened and back when closed.
;
;  Input:C An object
;        B Two modes (bits 2-3 for mask L, bits 0-1 for mask H)
;        L, H The masks
; Output:F NZ if the object's +5 flags pass both tests; Z if not
c$C74E LD A,C        ; Copy C into A - C = the object's +5 flags
 $C74F CALL $D237    ; Call the routine "Resolve an id (in A) to its full
                     ; entity record" (#R$D237)
 $C752 LD C,(IX+$05) ; Read byte +5 of the record at IX into C
 $C755 LD A,B        ; Copy B into A - First the mode in bits 2-3 of B with
                     ; mask L...
 $C756 RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $C757 RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $C758 AND $03       ; Keep only bits 0, 1 of A (mask $03)
 $C75A LD D,L        ; Copy L into D
 $C75B CALL $C763    ; Call #R$C763 (inside "Test object C's +5 flags against a
                     ; record's...")
 $C75E RET Z         ; (failed: return Z)
 $C75F LD A,B        ; Copy B into A - ...then the mode in bits 0-1 with mask H
 $C760 AND $03       ; Keep only bits 0, 1 of A (mask $03)
 $C762 LD D,H        ; Copy H into D
*$C763 JR NZ,$C76D   ; If any of bits 0, 1 of A was set, skip ahead to #R$C76D
                     ; - Mode 0: every mask bit must be set
 $C765 LD A,D        ; Copy D into A
 $C766 AND C         ; Keep only the bits of A that are set in C
 $C767 CP D          ; Compare A with D
; This entry point is used by the routine at #R$C7A6.
*$C768 JP Z,$C62F    ; If A equals D, go back to #R$C62F
 $C76B JR $C792      ; (missing: note the bits that are not)
*$C76D CP $01        ; Compare A with $01 - Mode 1: at least one (or no mask at
                     ; all)
 $C76F JR NZ,$C77B   ; If A differs from $01, skip ahead to #R$C77B
 $C771 LD A,D        ; Copy D into A
 $C772 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $C773 JR Z,$C768    ; If A is zero, go back to #R$C768
 $C775 AND C         ; Keep only the bits of A that are set in C
 $C776 JR Z,$C795    ; If none of those bits of A are set, skip ahead to
                     ; #R$C795
 $C778 JP $C62F      ; Go back to #R$C62F
*$C77B CP $02        ; Compare A with $02 - Mode 2: none may be set
 $C77D JR NZ,$C788   ; If A differs from $02, skip ahead to #R$C788
 $C77F LD A,D        ; Copy D into A
 $C780 AND C         ; Keep only the bits of A that are set in C
 $C781 JP Z,$C62F    ; If none of those bits of A are set, go back to #R$C62F
 $C784 OR $80        ; Set bit 7 of A - (note them, with bit 7: present but
                     ; should not be)
 $C786 JR $C797      ; Skip ahead to #R$C797
*$C788 LD A,D        ; Copy D into A - Mode 3: not all may be set
 $C789 AND C         ; Keep only the bits of A that are set in C
 $C78A CP D          ; Compare A with D
 $C78B JP NZ,$C62F   ; If A differs from D, go back to #R$C62F
 $C78E OR $80        ; Set bit 7 of A
 $C790 JR $C797      ; Skip ahead to #R$C797
*$C792 XOR $FF       ; Flip in A the bits that are set in $FF
 $C794 AND D         ; Keep only the bits of A that are set in D
*$C795 AND $7F       ; Keep only bits 0, 1, 2, 3, 4, 5, 6 of A (mask $7F)
*$C797 LD ($CB79),A  ; Failed: the bits go to #R$CB79
 $C79A LD A,($A00B)  ; Read #R$A00A($A00B) in "Game variables" into A - ...but
                     ; the failure is ignored while #R$A00A($A00B) is clear
 $C79D AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $C79E JP Z,$C62F    ; If A is zero, go back to #R$C62F
 $C7A1 LD HL,$CB7B   ; Point HL at "Refuse by naming the flag that failed: "THE
                     ; ......" (#R$CB7B) - Z, with HL = the refusal that names
                     ; the flag (#R$CB7B)
 $C7A4 XOR A         ; Set A to zero, which sets the zero flag for the caller
 $C7A5 RET           ; Return to the caller

; Check object C against requirement code A (7-15)
;
; The second half of the requirement checks; see #R$C628 for the codes. Each
; refusal goes to #R$C632, each pass to #R$C62F.
; .
; How it works:
; .
; 1. Mask the code to its low nibble. Codes 7 to 15 split into six groups; each
; ends by jumping to the pass at #R$C62F or the refusal at #R$C632.
; .
; 2. Code 7: anything will do. Code 8: the object must be in the actor's room
; (#R$C821).
; .
; 3. Code 9 (TAKE): in the room; in exactly one place (#R$C8A7), so doors and
; the like are out; not a person (#R$C8BE); of a size the actor can carry
; (#R$C8C6); and not already held by a person (#R$C8AF).
; .
; 4. Code 10: in the room and held by the actor (#R$D275). Code 11: in the room
; and in more than one place, which is what a door is. Code 12: a person
; anywhere. Codes 13 to 15: a person who is in the room.
;
;  Input:A The requirement code (7-15)
;        C The object's id
;        IY The action record
; Output:F NZ if the object passes, Z if it is refused
c$C7A6 AND $0F       ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $C7A8 CP $07        ; Compare A with $07 - 7: anything at all
 $C7AA JP Z,$C62F    ; If A equals $07, go back to #R$C62F
 $C7AD CP $08        ; Compare A with $08 - 8: it must be here (#R$C821)
 $C7AF JR NZ,$C7BB   ; If A differs from $08, skip ahead to #R$C7BB
 $C7B1 LD A,C        ; Copy C into A
 $C7B2 CALL $C821    ; Call the routine "Can the current actor (#R$A032($A036))
                     ; see thing A?" (#R$C821)
*$C7B5 JP Z,$C632    ; If the zero flag is set, go back to #R$C632
 $C7B8 JP $C62F      ; Go back to #R$C62F
*$C7BB CP $09        ; Compare A with $09 - 9: something to take - here,
 $C7BD JR NZ,$C7E4   ; If A differs from $09, skip ahead to #R$C7E4
 $C7BF LD A,C        ; Copy C into A
 $C7C0 CALL $C821    ; Call the routine "Can the current actor (#R$A032($A036))
                     ; see thing A?" (#R$C821)
 $C7C3 JP Z,$C632    ; If the zero flag is set, go back to #R$C632
 $C7C6 LD A,C        ; Copy C into A - in only one place (#R$C8A7),
 $C7C7 CALL $C8A7    ; Call the routine "How many locations has object A? (Z if
                     ; exactly one)" (#R$C8A7)
 $C7CA JP NZ,$C632   ; If the zero flag is clear, go back to #R$C632
 $C7CD LD A,C        ; Copy C into A - not a person (#R$C8BE),
 $C7CE CALL $C8BE    ; Call the routine "Is object A a person? (NZ if so)"
                     ; (#R$C8BE)
 $C7D1 JP NZ,$C632   ; If the zero flag is clear, go back to #R$C632
 $C7D4 LD B,C        ; Copy C into B - something the actor can carry (#R$C8C6),
 $C7D5 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A
 $C7D8 CALL $C8C6    ; Call the routine "Can the actor carry object A as well
                     ; as what it holds?" (#R$C8C6)
 $C7DB JP Z,$C632    ; If the zero flag is set, go back to #R$C632
 $C7DE LD A,C        ; Copy C into A - and then whether a person holds it
                     ; (#R$C8AF, on at #R$C768)
 $C7DF CALL $C8AF    ; Call the routine "Is object A held, at any depth, by a
                     ; person?" (#R$C8AF)
 $C7E2 JR $C768      ; Go back to #R$C768
*$C7E4 CP $0A        ; Compare A with $0A - 10: here and carried by the actor
                     ; (#R$D275)
 $C7E6 JR NZ,$C7F9   ; If A differs from $0A, skip ahead to #R$C7F9
 $C7E8 LD A,C        ; Copy C into A
 $C7E9 CALL $C821    ; Call the routine "Can the current actor (#R$A032($A036))
                     ; see thing A?" (#R$C821)
 $C7EC JP Z,$C632    ; If the zero flag is set, go back to #R$C632
 $C7EF LD A,C        ; Copy C into A
 $C7F0 CALL $D275    ; Call the routine "Is thing A carried by the actor,
                     ; perhaps inside..." (#R$D275)
 $C7F3 JP NC,$C632   ; If the carry flag is clear, go back to #R$C632
 $C7F6 JP $C62F      ; Go back to #R$C62F
*$C7F9 CP $0B        ; Compare A with $0B - 11: here and in more than one place
                     ; (a door, say)
 $C7FB JR NZ,$C80A   ; If A differs from $0B, skip ahead to #R$C80A
 $C7FD LD A,C        ; Copy C into A
 $C7FE CALL $C821    ; Call the routine "Can the current actor (#R$A032($A036))
                     ; see thing A?" (#R$C821)
 $C801 JP Z,$C632    ; If the zero flag is set, go back to #R$C632
 $C804 LD A,C        ; Copy C into A
 $C805 CALL $C8A7    ; Call the routine "How many locations has object A? (Z if
                     ; exactly one)" (#R$C8A7)
 $C808 JR $C7B5      ; Go back to #R$C7B5
*$C80A CP $0C        ; Compare A with $0C - 12: a person, anywhere
 $C80C JR NZ,$C814   ; If A differs from $0C, skip ahead to #R$C814
 $C80E LD A,C        ; Copy C into A
 $C80F CALL $C8BE    ; Call the routine "Is object A a person? (NZ if so)"
                     ; (#R$C8BE)
 $C812 JR $C7B5      ; Go back to #R$C7B5
*$C814 LD A,C        ; Copy C into A - 13-15: a person who is here
 $C815 CALL $C821    ; Call the routine "Can the current actor (#R$A032($A036))
                     ; see thing A?" (#R$C821)
 $C818 JP Z,$C632    ; If the zero flag is set, go back to #R$C632
 $C81B LD A,C        ; Copy C into A
 $C81C CALL $C8BE    ; Call the routine "Is object A a person? (NZ if so)"
                     ; (#R$C8BE)
 $C81F JR $C7B5      ; Go back to #R$C7B5

; Can the current actor ($A036) see thing A?
;
; Addresses named in the title: #R$A032($A036).
; .
; NZ if it can. Yes when the thing is what the actor is in or on (the root of
; the actor's own containment chain, #R$C863); no when the thing's +5 bit 7 is
; clear (the underground trains, objects 37-41); yes when the thing's chain
; ends at the actor (carried, or in something open the actor carries) or at the
; same holder as the actor's; and when neither is held by anything, yes if the
; actor's room (#R$A00A, set by #R$CC29) is one of the thing's rooms (+0 is how
; many, from +15 on).
; .
; CORRECTED 2026-11-08: the test is from the current actor's point of view, not
; the player's. Confirmed in the emulator: during one WAIT at the start,
; #R$CC64 asks it about the player (thing 0) for every actor, and it answers
; yes only for Watson (actor 3, room 8) and the player himself, both in the
; sitting room; Mrs Hudson (actor 2, room 10) and everyone else get no.
; .
; Resolves the id in A via #R$D237 and the current id in #R$A032($A036) via
; #R$C863 (the containment-chain walker above), and compares them - essentially
; 'does this candidate's ultimate container match the thing in #R$A032($A036)
; (usually the player, or the room being checked)'. Called from 12 real,
; confirmed sites across the code, among them the already-documented #R$CC64
; (which uses the result to decide whether to enable output for an NPC's turn),
; which independently confirms this is a genuine 'is this visible / present
; here' test rather than a guess from its name alone.
; .
; Confirmed with a real id catalog, not just plausible-sounding prose:
; breakpointing this during known commands shows a stable, repeated id for
; objects that are actually present (LAMP -> 22, the two armchairs -> 23 and
; 24, WATSON -> 3), and only a handful of never-repeated ids for a typed object
; that isn't there (PIPE - not carried or in the room - gives up after 5 hits
; with no stable id). id 3 for WATSON independently confirms a guess this
; project made several rounds earlier (that actor id 3, whose room this project
; separately found to match the player's, was 'very plausibly Watson') - see
; source/world_model_notes.md for the full account, including two
; lower-confidence results (SOFA, MONEY) that don't fit the clean pattern as
; neatly.
; .
; How it works:
; .
; 1. The thing is seen if it is what the actor is in or on, or the actor's own
; container.
; .
; 2. A thing with +5 bit 7 clear cannot be seen.
; .
; 3. Things held by the actor, or with the same top-level holder, can be seen;
; things with different holders cannot.
; .
; 4. If neither is held, the thing can be seen when it is in the actor's room.
;
;  Input:A A thing number
; Output:F NZ if the actor ($A036) can see it; Z if not
c$C821 PUSH IX        ; Save IX on the stack
 $C823 PUSH BC        ; Save BC on the stack
 $C824 CALL $D237     ; Call the routine "Resolve an id (in A) to its full
                      ; entity record" (#R$D237) - IX = the thing's record; B =
                      ; the thing
 $C827 LD B,A         ; Copy A into B
 $C828 LD A,($A036)   ; Read #R$A032($A036) in "Game variables" into A - A =
                      ; what the actor is in or held by, at the top (#R$C863)
 $C82B CALL $C863     ; Call the routine "Is thing number A here? (#R$C86E)"
                      ; (#R$C863)
 $C82E CP B           ; Compare A with B - The thing itself: yes
 $C82F JR Z,$C85D     ; If A equals B, jump on to #R$C85D
 $C831 BIT 7,(IX+$05) ; Test bit 7 of the flags byte (+5) of the thing record
                      ; at IX (revealed) - +5 bit 7 clear: no
 $C835 JR Z,$C85A     ; If bit 7 of the flags byte (+5) of the thing record at
                      ; IX is clear, skip ahead to #R$C85A
 $C837 LD C,A         ; Copy A into C - B = the actor's top; A = the thing's
                      ; own top
 $C838 LD A,B         ; Copy B into A
 $C839 LD B,C         ; Copy C into B
 $C83A CALL $C863     ; Call the routine "Is thing number A here? (#R$C86E)"
                      ; (#R$C863)
 $C83D LD C,A         ; Copy A into C
 $C83E LD A,($A036)   ; Read #R$A032($A036) in "Game variables" into A - Held
                      ; by the actor: yes
 $C841 CP C           ; Compare A with C
 $C842 JR Z,$C85D     ; If A equals C, skip ahead to #R$C85D
 $C844 LD A,C         ; Copy C into A - Different tops: no
 $C845 CP B           ; Compare A with B
 $C846 JR NZ,$C85A    ; If A differs from B, skip ahead to #R$C85A
 $C848 INC A          ; Add one to A - The same holder (not $FF): yes
 $C849 JR NZ,$C85D    ; If A is not zero, skip ahead to #R$C85D
 $C84B LD B,(IX+$00)  ; Read the number byte (+0) of the thing record at IX
                      ; into B - Neither held: is the actor's room one of the
                      ; thing's rooms?
 $C84E LD A,($A00A)   ; Read the current actor's room (#R$A00A) into A
*$C851 CP (IX+$0F)    ; Compare A with the rooms byte (+15) of the thing record
                      ; at IX
 $C854 JR Z,$C85D     ; If A equals the rooms byte (+15) of the thing record at
                      ; IX, skip ahead to #R$C85D
 $C856 INC IX         ; Step IX on to the next byte
 $C858 DJNZ $C851     ; Count B down and, while it is not zero, go back to
                      ; #R$C851
*$C85A XOR A          ; Clear A to zero (and the carry flag) - Z: no
 $C85B JR $C85F       ; Skip ahead to #R$C85F
*$C85D OR $01         ; Set bit 0 of A - NZ: yes
*$C85F POP BC         ; Restore BC from the stack
 $C860 POP IX         ; Restore IX from the stack
 $C862 RET            ; Return to the caller

; Is thing number A here? ($C86E)
;
; Addresses named in the title: #R$C86E.
; .
; Finds its record (#R$D237) and runs #R$C86E. Read from the code.
;
;  Input:A A thing number
; Output:A The top of its containment chain
;        IX Kept
c$C863 PUSH IX       ; Save IX on the stack - Save IX; find thing A's record
                     ; (#R$D237)
 $C865 CALL $D237    ; Call the routine "Resolve an id (in A) to its full
                     ; entity record" (#R$D237)
 $C868 CALL $C86E    ; Is it held, at any depth (#R$C86E)?
 $C86B POP IX        ; Restore IX from the stack
 $C86D RET           ; Return to the caller

; Follow an object's containment chain to its root
;
; Resolves an id via #R$D237, then repeatedly follows a 'next id' held at the
; resolved record's own offset +1 (not a memory address - another id, resolved
; the same way each time), continuing while bit 5 or bit 3 of the new record's
; offset +5 is set, and stopping either when +1 is $FF or when bit 7 of +5 is
; clear. Read as 'find what ultimately contains this thing, walking up through
; however many levels of nesting' - a room contains a container, which contains
; an item, which an actor might be carrying.
; .
; Bit 5 of offset +5 is now confirmed: it's 'is this thing open' (see #R$DE9D
; below, a shared OPEN/CLOSE implementation that sets and clears exactly this
; bit). That makes this routine's bit-5 check read naturally: keep following
; the chain (i.e. treat what's inside as reachable) only while each container
; along the way is open. Bits 3 and 7 are still not confirmed.
; .
; How it works:
; .
; 1. Start with the thing's holder (+1). If it is $FF nothing holds it, and the
; answer is the last holder reached.
; .
; 2. Otherwise move up to the holder's record, but only climb further when the
; holder's +5 bit 7 is set and it also has bit 5 or bit 3 set (it lets what is
; inside be seen).
; .
; 3. Return the highest holder reached.
;
;  Input:IX A thing's record
; Output:A The highest holder reached, $FF if none
;        IX Kept
c$C86E PUSH IX        ; Save IX on the stack - A = the holder number so far
                      ; ($FF at the start); IX = the thing
 $C870 EX AF,AF'      ; Swap AF with the shadow copy
 $C871 LD A,$FF       ; Load A with $FF
*$C873 EX AF,AF'      ; Swap AF with the shadow copy
 $C874 LD A,(IX+$01)  ; Read byte +1 of the record at IX into A - Held by
                      ; nothing ($FF): stop with A = the last holder
 $C877 CP $FF         ; Compare A with $FF
 $C879 JR Z,$C895     ; If A equals $FF, skip ahead to #R$C895
 $C87B EX AF,AF'      ; Swap AF with the shadow copy
 $C87C LD A,(IX+$01)  ; Read byte +1 of the record at IX into A - Otherwise A'
                      ; = its holder, and IX = the holder's record (#R$D237)
 $C87F CALL $D237     ; Call the routine "Resolve an id (in A) to its full
                      ; entity record" (#R$D237)
 $C882 BIT 7,(IX+$05) ; Test bit 7 of byte +5 of the record at IX - Keep
                      ; climbing only if the holder has +5 bit 7 set...
 $C886 JR Z,$C894     ; If bit 7 of byte +5 of the record at IX is clear, skip
                      ; ahead to #R$C894
 $C888 BIT 5,(IX+$05) ; Test bit 5 of byte +5 of the record at IX - ...and bit
                      ; 5 or bit 3 (it lets what is inside be seen)
 $C88C JR NZ,$C873    ; If bit 5 of byte +5 of the record at IX is set, go back
                      ; to #R$C873
 $C88E BIT 3,(IX+$05) ; Test bit 3 of byte +5 of the record at IX
 $C892 JR NZ,$C873    ; If bit 3 of byte +5 of the record at IX is set, go back
                      ; to #R$C873
*$C894 EX AF,AF'      ; Swap AF with the shadow copy - Return the highest
                      ; holder reached
*$C895 POP IX         ; Restore IX from the stack
 $C897 RET            ; Return to the caller

; Follow IY's containment chain
;
; Swaps IX and IY (#R$C89E), follows the chain (#R$C86E), and swaps back.
;
;  Input:IY A thing's record
; Output:A The highest holder reached
;        IX, IY Kept
c$C898 CALL $C89E    ; Call #R$C89E (inside "Follow IY's containment chain") -
                     ; Swap IX and IY (#R$C89E), climb the chain (#R$C86E),
                     ; swap them back
 $C89B CALL $C86E    ; Call the routine "Follow an object's containment chain
                     ; to its root" (#R$C86E)
*$C89E PUSH IX       ; Save IX on the stack
 $C8A0 PUSH IY       ; Save IY on the stack
 $C8A2 POP IX        ; Restore IX from the stack
 $C8A4 POP IY        ; Restore IY from the stack
 $C8A6 RET           ; Return to the caller

; How many locations has object A? (Z if exactly one)
;
; Byte 0 of the object's record minus 1.
;
;  Input:A A thing number
; Output:F Z if the thing has exactly one location
;        A Its location count less 1
c$C8A7 CALL $D237    ; Call the routine "Resolve an id (in A) to its full
                     ; entity record" (#R$D237) - A = byte 0 of the thing's
                     ; record, less 1 (Z if it was 1)
 $C8AA LD A,(IX+$00) ; Read the first byte of the record at IX into A
 $C8AD DEC A         ; Subtract one from A
 $C8AE RET           ; Return to the caller

; Is object A held, at any depth, by a person?
;
; Climbs the containment chain (+1) until it reaches nothing ($FF, Z) or a
; container that is a person (NZ).
;
;  Input:A A thing number
; Output:F NZ if some person holds it at any depth; Z if not
c$C8AF CALL $D237    ; IX = the thing's record (#R$D237)
*$C8B2 LD A,(IX+$01) ; Read byte +1 of the record at IX into A - Its holder
                     ; (+1): $FF - held by nothing - return Z
 $C8B5 CP $FF        ; Compare A with $FF
 $C8B7 RET Z         ; If A equals $FF, return
 $C8B8 CALL $C8BE    ; Call the routine "Is object A a person? (NZ if so)"
                     ; (#R$C8BE) - Is the holder a person (+5 bit 6)? NZ: yes,
                     ; return
 $C8BB RET NZ        ; If the zero flag is clear, return
 $C8BC JR $C8B2      ; Otherwise climb to the holder and ask again

; Is object A a person? (NZ if so)
;
; Bit 6 of the object's +5 flags.
;
;  Input:A A thing number
; Output:F NZ if it is a person (+5 bit 6)
c$C8BE CALL $D237     ; Call the routine "Resolve an id (in A) to its full
                      ; entity record" (#R$D237)
 $C8C1 BIT 6,(IX+$05) ; Test bit 6 of byte +5 of the record at IX
 $C8C5 RET            ; Return to the caller

; Can the actor carry object A as well as what it holds?
;
; Adds the object's size (#R$D2F2) to the actor's load and compares it with the
; actor's capacity (+3). NZ if it fits. Read from the code.
;
;  Input:A The actor
;        B The thing
; Output:F NZ if the actor can carry the thing as well as what it holds; Z if
; .        not
;        BC Kept
c$C8C6 PUSH BC        ; Save BC on the stack
 $C8C7 PUSH AF        ; Save AF on the stack
 $C8C8 LD A,B         ; Copy B into A - B = the thing's weight (+3) plus all it
                      ; holds (#R$D2F2)
 $C8C9 CALL $D237     ; Call the routine "Resolve an id (in A) to its full
                      ; entity record" (#R$D237)
 $C8CC LD A,B         ; Copy B into A
 $C8CD CALL $D2F2     ; Call the routine "Total weight (+3) of everything in
                      ; thing A, at any..." (#R$D2F2)
 $C8D0 ADD A,(IX+$03) ; Add byte +3 of the record at IX to A
 $C8D3 JR NC,$C8D7    ; If it did not overflow, skip ahead to #R$C8D7
 $C8D5 LD A,$FF       ; Load A with $FF
*$C8D7 LD B,A         ; Copy A into B
 $C8D8 POP AF         ; Restore AF from the stack
 $C8D9 LD C,A         ; Copy A into C - The actor's +3 is how much it can
                      ; carry; take off what it already carries,
 $C8DA CALL $D237     ; Call the routine "Resolve an id (in A) to its full
                      ; entity record" (#R$D237)
 $C8DD LD A,C         ; Copy C into A
 $C8DE CALL $D2F2     ; Call the routine "Total weight (+3) of everything in
                      ; thing A, at any..." (#R$D2F2)
 $C8E1 SUB (IX+$03)   ; Subtract byte +3 of the record at IX from A
 $C8E4 NEG            ; Negate A
 $C8E6 SUB B          ; Subtract B from A - then the thing: not enough left
                      ; (carry) gives Z, no
 $C8E7 POP BC         ; Restore BC from the stack
 $C8E8 JR C,$C8ED     ; If the carry flag is set, skip ahead to #R$C8ED
 $C8EA OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller - NZ: it can carry it
 $C8EC RET            ; Return to the caller
*$C8ED XOR A          ; Set A to zero, which sets the zero flag for the caller
 $C8EE RET            ; Return to the caller

; Point $A013 and $A015 at the direct and indirect objects' records
;
; Addresses named in the title: #R$A012($A013), #R$A012($A015).
; .
; Rooms (#R$D224) for requirement codes below 5, things (#R$D237) otherwise; a
; number or nothing ($FE, $FF) is left alone. Read from the code.
;
;  Input:$A034, $A035 The objects
; Output:$A013 The direct object's record
;        $A015 The indirect object's record
c$C8EF LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - The
                     ; direct object (#R$A032($A034)): $FE or $FF (a number, or
                     ; none) has no record
 $C8F2 CP $FE        ; Compare A with $FE
 $C8F4 JR NC,$C90C   ; If A is $FE or more, skip ahead to #R$C90C
 $C8F6 LD A,($A00F)  ; Read #R$A00A($A00F) in "Game variables" into A - Its
                     ; requirement code (#R$A00A($A00F)) below 5: a room
                     ; (#R$D224)...
 $C8F9 CP $05        ; Compare A with $05
 $C8FB LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A
 $C8FE JR NC,$C905   ; If A is $05 or more, skip ahead to #R$C905
 $C900 CALL $D224    ; Call the routine "Find a room record" (#R$D224)
 $C903 JR $C908      ; Skip ahead to #R$C908
*$C905 CALL $D237    ; ...otherwise a thing (#R$D237)
*$C908 LD ($A013),IX ; Its record to #R$A012($A013)
*$C90C LD A,($A035)  ; Read #R$A032($A035) in "Game variables" into A - The
                     ; same for the indirect object (#R$A032($A035), code
                     ; #R$A00A($A010)) into #R$A012($A015)
 $C90F CP $FE        ; Compare A with $FE
 $C911 RET NC        ; If A is $FE or more, return
 $C912 LD A,($A010)  ; Read #R$A00A($A010) in "Game variables" into A
 $C915 CP $05        ; Compare A with $05
 $C917 LD A,($A035)  ; Read #R$A032($A035) in "Game variables" into A
 $C91A JR NC,$C921   ; If A is $05 or more, skip ahead to #R$C921
 $C91C CALL $D224    ; Call the routine "Find a room record" (#R$D224)
 $C91F JR $C924      ; Skip ahead to #R$C924
*$C921 CALL $D237    ; Call the routine "Resolve an id (in A) to its full
                     ; entity record" (#R$D237)
*$C924 LD ($A015),IX ; Store IX in the direct and indirect objects' records
                     ; (#R$A012($A015))
 $C928 RET           ; Return to the caller

; Check the action record against the command's objects
;
; Points at the objects' records (#R$C8EF), then on into the checks at #R$C933.
; Read from the code.
;
;  Input:$A033 The verb
;        $A034, $ A035 The objects
; Output:F Z if refused; NZ if the action ran
c$C929 CALL $C8EF    ; Set up the objects' records (#R$C8EF)
 $C92C LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - Direct
                     ; object $FE or more (a number or nothing)? Jump to
                     ; #R$C972
 $C92F CP $FE        ; Compare A with $FE
 $C931 JR NC,$C972   ; If A is $FE or more, jump on to #R$C972

; Find the action record for the current command
;
; UPDATED 2026-11-07: when the one acting is a person (+5 bit 6 of
; #R$A012($A017)), its own record is searched first: #R$D1DC with A = 0 finds
; the zero entry that starts a person's list, and #R$D349 then looks along the
; pairs after it for the verb. So a person's list holds actions it does itself,
; not actions done to it - Tricia Fender's (TELL ABOUT / TELL, shared 3) and
; Mrs Jones's (shared 22) are the only ones. Only if that fails is the direct
; object's list searched. Confirmed in the emulator
; (tools/experiments/tell_test.py): SAY TO TRICIA FENDER "TELL ME ABOUT THE
; BLOODSTAINED CLOTHES" reaches shared action 3 (#R$E1B4) with Tricia acting
; and the clothes as indirect object, while TELL TRICIA FENDER ABOUT ... (the
; player acting) does not.
; .
; Chooses which action record carries out the current verb (#R$A032($A033)). If
; the actor (#R$A012($A017)) or the direct object (#R$A012($A013)) has its own
; entry for the verb (found by #R$D1DC), the entry's second byte is an index
; into the shared action table at #R$AA71 (#R$C960). Otherwise the verb's
; default record comes from #R$9F38 (#R$C972); a verb with no default fails via
; #R$DC15. Either way, #R$C996 then runs the record.
; .
; Confirmed by logging which path each real command took: OPEN PLAIN DOOR used
; the door's own list (object 50, entry 6), SIT IN YOUR ARMCHAIR the armchair's
; (object 23, entry 9); LOOK, TAKE, DROP, INVENTORY and WAIT used their
; defaults.
; .
; How it works:
; .
; 1. If the actor is a person (+5 bit 6) and lists this verb in its own actions
; (#R$D1DC), look the verb up in the shared actions table (#R$D349); a shared
; action that is found is run.
; .
; 2. If the direct object needs to be a thing (requirement code 7 or more) and
; lists this verb in its own actions, use that.
; .
; 3. Otherwise look the verb up in the default-action table at #R$9F38; with no
; default the command fails (#R$DC15).
;
;  Input:$A017 The actor's record
;        $A033 The verb
; Output:The action record chosen and run through $C996
c$C933 LD IX,($A017)  ; IX = the actor's own record
 $C937 BIT 6,(IX+$05) ; Not yet explained: bit 6 of the actor's flags byte
 $C93B JR Z,$C94D     ; If bit 6 of byte +5 of the record at IX is clear, skip
                      ; ahead to #R$C94D
 $C93D XOR A          ; Clear A to zero (and the carry flag)
 $C93E CALL $D1DC     ; Does the actor list this verb itself?
 $C941 JR NC,$C94D    ; If the carry flag is clear, skip ahead to #R$C94D
 $C943 LD A,($A033)   ; Look the verb up in the shared actions table (#R$D349)
 $C946 CALL $D349     ; Call the routine "Search a table of two-byte entries
                      ; for A" (#R$D349)
 $C949 CP $FF         ; $FF = no shared action
 $C94B JR NZ,$C960    ; Yes: use the shared action it names
*$C94D LD A,($A00F)   ; Not yet explained (#R$A00A($A00F) < 7: skip the object
                      ; check)
 $C950 CP $07         ; Compare A with $07
 $C952 JR C,$C972     ; If A is below $07, skip ahead to #R$C972
 $C954 LD IX,($A013)  ; IX = the direct object's own record
 $C958 LD A,($A033)   ; Does the object list this verb?
 $C95B CALL $D1DC     ; Call the routine "Does this object list verb A in its
                      ; own action list?" (#R$D1DC)
 $C95E JR NC,$C972    ; No: use the verb's default action

; Look up a numbered entry in the table at $AA71
;
; Addresses named in the title: #R$AA71.
; .
; Given a number in (IX+1), computes #R$AA71 + (that number - 1)*2 and reads a
; 16-bit value from there - a plain, direct-indexed table lookup, not a search.
; .
; Confirmed real: dumped the table's first 20 entries and every one is a valid
; address inside the loaded 'p' block. They fall into two distinct bands -
; roughly $9Axx and $Exxx - and checking one entry from each band shows the
; $9Axx one is genuine executable code (a real CALL and a real JP Z appear at
; the very start of it, 2 bytes in - the first 2 bytes look like they double as
; a small header), while the $Exxx ones checked so far don't look like straight
; code - more likely a smaller, more compact per-entry record of some kind. Not
; yet resolved which; see source/world_model_notes.md.
; .
; IMPORTANT, and corrected from an earlier draft of this comment: (IX+1) is NOT
; simply 'which verb the player typed'. Breakpointing this address during real
; play shows the exact same value (11, with IX fixed at #R$8F06($8F08)) firing
; after LOOK, INVENTORY, and TAKE alike - three different verbs - but never
; after an unrecognised command, and OPEN additionally fires a completely
; different value (6, IX=#R$90E4($90E5)) three times *before* that same
; 11/#R$8F06($8F08) check. The cleaner reading, not yet fully confirmed: IX
; points at whichever record is currently being tested (a fixed, generic one at
; #R$8F06($8F08) that every successfully-parsed command checks at the end, plus
; an object-specific one - #R$90E4($90E5), very possibly the door object itself
; - tried while resolving which specific thing OPEN applies to), and the number
; at +1 is that record's own 'primary action' field - exactly discovery.md's
; 'an action-number byte immediately precedes this address' pattern, just keyed
; per-record rather than globally per-verb. See source/world_model_notes.md for
; the tests behind this.
;
;  Input:IX A record whose +1 is a number
; Output:HL The action record at entry (number - 1) of the table at $AA71
c$C960 LD A,(IX+$01) ; The number to look up (meaning depends on IX - see
                     ; prose)
 $C963 LD E,A        ; Copy A into E
 $C964 LD D,$00      ; Load D with $00
 $C966 LD HL,$AA71   ; The table's base
 $C969 DEC DE        ; Step DE back one byte
 $C96A ADD HL,DE     ; (number-1) * 2, added twice for a word-sized stride
 $C96B ADD HL,DE     ; Add DE to HL
 $C96C LD E,(HL)     ; This entry's own table value...
 $C96D INC HL        ; Step HL on to the next byte
 $C96E LD D,(HL)     ; ...becomes the result
 $C96F EX DE,HL      ; Swap DE and HL
 $C970 JR $C996      ; Run it
; This entry point is used by the routines at #R$C929 and #R$C933.
*$C972 LD A,($A033)  ; Look the verb up in the default-action table
 $C975 LD IX,$9F38   ; Point IX at "Each verb's default action record"
                     ; (#R$9F38)
 $C979 CALL $D34E    ; Call the routine "Find a 3-byte record by id, in a
                     ; sentinel-terminated..." (#R$D34E)
 $C97C CP $FF        ; No default for this verb?
 $C97E JP Z,$DC15    ; Then fail
 $C981 LD L,(IX+$01) ; HL = the default action record
 $C984 LD H,(IX+$02) ; Read byte +2 of the record at IX into H
 $C987 JR $C996      ; Run it

; Run the numbered action record IX
;
; HL = the record; the objects' records are set up (#R$C8EF) and the record run
; (#R$C996). Read from the code.
;
;  Input:IX A numbered action record
; Output:F From the record
;        IX Kept
c$C989 PUSH IX       ; Save IX on the stack - Keep IX; HL = the numbered action
                     ; record
 $C98B POP HL        ; Restore HL from the stack
 $C98C PUSH HL       ; Save HL on the stack
 $C98D CALL $C8EF    ; Call the routine "Point #R$A012($A013) and
                     ; #R$A012($A015) at the direct and indirect..." (#R$C8EF)
                     ; - Fill in the object records (#R$C8EF) and run it
                     ; (#R$C996)
 $C990 CALL $C996    ; Call the routine "Run a numbered action record; a script
                     ; record becomes..." (#R$C996)
 $C993 POP IX        ; Restore IX from the stack
 $C995 RET           ; Return to the caller

; Run a numbered action record; a script record becomes the actor's plan
;
; Runs it through #R$C9BF; with carry (a script) the record is started as the
; actor's plan (#R$CF80, the actor's entry at #R$9FDB). Read from the code.
;
;  Input:HL An action record
; Output:F Carry set if a script was started as the actor's plan; Z if refused;
; .        NZ if done
c$C996 PUSH IY       ; Save IY on the stack - Try the action record in HL
                     ; (#R$C9BF)
 $C998 PUSH BC       ; Save BC on the stack
 $C999 CALL $C9BF    ; Call the routine "Run an action record (HL = the
                     ; record)" (#R$C9BF)
 $C99C POP BC        ; Restore BC from the stack
 $C99D POP IY        ; Restore IY from the stack
 $C99F JR C,$C9A7    ; Carry: it is a script record
 $C9A1 JP Z,$CB43    ; Z: failed - end the actor's go (#R$CB43)
 $C9A4 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - NZ: done
 $C9A6 RET           ; Return to the caller
*$C9A7 PUSH HL       ; Save HL on the stack - Script record: save the actor's
                     ; current script as a sub-script frame (#R$CF80)...
 $C9A8 PUSH BC       ; Save BC on the stack
 $C9A9 LD HL,($9FD9) ; Read the plan instruction (#R$9FD9) into HL
 $C9AC LD B,$01      ; Load B with $01
 $C9AE CALL $CF80    ; Call the routine "Save a sub-script call frame"
                     ; (#R$CF80)
 $C9B1 POP BC        ; Restore BC from the stack
 $C9B2 POP HL        ; Restore HL from the stack
 $C9B3 LD IX,($9FDB) ; Read the current actor's (#R$9FDB) into IX - ...and set
                     ; the actor's script to the new one (HL, in +1/+2 of its
                     ; record)
 $C9B7 LD (IX+$01),L ; Store L in byte +1 of the record at IX
 $C9BA LD (IX+$02),H ; Store H in byte +2 of the record at IX
 $C9BD SCF           ; Set the carry flag for the caller - Carry: a script was
                     ; started
 $C9BE RET           ; Return to the caller

; Run an action record (HL = the record)
;
; Action records are a small data format that every verb's behaviour is written
; in. Byte 0 is a flags byte, byte 1 holds a value whose high nibble is stored
; at #R$A01A($A01F) (meaning not confirmed - see below). UPDATED: the low
; nibbles of bytes 0 and 1 are requirement codes for the direct and indirect
; objects, checked by #R$C628 and #R$C6BE, and the rest depends on the flags:
; .
; bit 5: before anything else, refuse (HL = #R$CBBB) if #R$D078 says so; bit 6:
; bytes 2-3 are the address of a pre-check routine, run through #R$CB34 - it
; returns Z to refuse; bit 4: five more header bytes follow (UPDATED: flag
; tests on the objects' +5 bits, done by #R$C74E - see #R$C628); bit 7: stop
; after the checks with carry set, without running the body - UPDATED: the
; bytes after such a header are a plan script, which the caller (#R$C9A7) makes
; the actor run as a sub-script. The executable body starts after the header:
; record + 2, + 2 more if bit 6, + 5 more if bit 4. #R$CA64 runs the body
; through the dispatcher at #R$CB2C.
; .
; Every flag rule above was read from this routine and then checked against the
; records it runs: the computed body address lands on sensible code for all the
; records examined (e.g. SIT IN's $78 header puts the body at record + 9,
; #R$E413).
; .
; Tested and NOT confirmed: that the byte-1 value is the number of minutes the
; action takes. The clock does move by 5 for one WAIT (value 5) and 2 for GET
; OUT (value 2), but another WAIT moved it by 1 and SIT IN (value 2) by 1.
; .
; UPDATED 2026-11-07: #R$A01A($A01F) is how many minutes the action takes - the
; main loop (#R$A064) adds it to the actor's next-turn time. Confirmed in the
; emulator by watching the player's next-turn time (actor table +6/+7): WAIT
; (WAIT HERE, byte 1 $50) moves it on by 5, TAKE LAMP (#R$DCC1, $10) and
; EXAMINE LAMP (#R$DF40, $10) by 1 each. Records run inside sub-scripts and
; characters' interruptions make the clock look less regular from the player's
; side, which is probably what threw the earlier test.
; .
; How it works:
; .
; 1. Refuse if it is too dark (#R$D078) and the record cares about that.
; .
; 2. Check the direct object (#R$C628) and the indirect object (#R$C6BE)
; against the record.
; .
; 3. If bit 6 of the record is set, run its pre-check routine; if that refuses,
; stop.
; .
; 4. Otherwise take the high nibble of byte 1 as the action's length
; (#R$A01A($A01F)) and run the body, narrating the action first and describing
; any change.
;
;  Input:HL An action record
; Output:F Z with HL = the refusal handler if refused; NZ if the record's
; .        checks pass; carry set if it is a script
c$C9BF PUSH HL        ; IY = the action record
 $C9C0 POP IY         ; Restore IY from the stack
 $C9C2 CALL $D078     ; Is the action ruled out by #R$D078?
 $C9C5 JR NC,$C9D3    ; No: carry on
 $C9C7 LD A,(IY+$00)  ; Yes - but only refuse if this record says that matters
 $C9CA AND $20        ; Isolate bit 5 of A (mask $20)
 $C9CC JR Z,$C9D3     ; If bit 5 of A was clear, skip ahead to #R$C9D3
 $C9CE LD HL,$CBBB    ; HL = the refusal handler
*$C9D1 XOR A          ; Refuse (Z)
 $C9D2 RET            ; Return to the caller
*$C9D3 CALL $C628     ; Check the direct object against the record (#R$C628);
                      ; refuse if it fails
 $C9D6 JR Z,$C9D1     ; If the zero flag is set, go back to #R$C9D1
 $C9D8 CALL $C6BE     ; Check the indirect object (#R$C6BE); refuse if it fails
 $C9DB JR Z,$C9D1     ; If the zero flag is set, go back to #R$C9D1
 $C9DD BIT 6,(IY+$00) ; Does the record have a pre-check routine?
 $C9E1 JR Z,$C9F2     ; If bit 6 of the first byte of the record at IY is
                      ; clear, skip ahead to #R$C9F2
 $C9E3 LD L,(IY+$02)  ; Yes: HL = its address...
 $C9E6 LD H,(IY+$03)  ; Read byte +3 of the record at IY into H
 $C9E9 PUSH IY        ; Save IY on the stack
 $C9EB CALL $CB34     ; ...run it with the current IX/IY
 $C9EE POP IY         ; Restore IY from the stack
 $C9F0 JR Z,$C9D1     ; Refused? Then stop
*$C9F2 LD A,($A00B)   ; Not yet explained: nothing more to do unless
                      ; #R$A00A($A00B) is set
 $C9F5 AND A          ; A zero: return NZ (nothing to do)
 $C9F6 JR NZ,$C9FB    ; If A is not zero, skip ahead to #R$C9FB
 $C9F8 OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller
 $C9FA RET            ; Return to the caller
*$C9FB PUSH IY        ; Store the high nibble of byte 1 at #R$A01A($A01F)
 $C9FD LD A,(IY+$01)  ; The record's high nibble of byte 1...
 $CA00 RRCA           ; ...rotated down four places (4 RRCAs)
 $CA01 RRCA           ; Rotate A right one place (bit 0 goes to carry and bit
                      ; 7)
 $CA02 RRCA           ; Rotate A right one place (bit 0 goes to carry and bit
                      ; 7)
 $CA03 RRCA           ; Rotate A right one place (bit 0 goes to carry and bit
                      ; 7)
 $CA04 AND $0F        ; Low nibble only
 $CA06 LD L,A         ; Copy A into L
 $CA07 LD H,$00       ; Load H with $00
 $CA09 LD ($A01F),HL  ; Stored in #R$A01A($A01F) as a word
 $CA0C POP HL         ; HL = the record again; skip the two fixed bytes
 $CA0D LD DE,$0002    ; Load DE with $0002, the amount that is added next
 $CA10 ADD HL,DE      ; Add DE to HL
 $CA11 BIT 6,(IY+$00) ; Skip the pre-check address if there is one
 $CA15 JR Z,$CA18     ; If bit 6 of the first byte of the record at IY is
                      ; clear, skip ahead to #R$CA18
 $CA17 ADD HL,DE      ; Add DE to HL
*$CA18 LD DE,$0005    ; Skip the five extra bytes if there are any
 $CA1B BIT 4,(IY+$00) ; Test bit 4 of the first byte of the record at IY
 $CA1F JR Z,$CA22     ; If bit 4 of the first byte of the record at IY is
                      ; clear, skip ahead to #R$CA22
 $CA21 ADD HL,DE      ; Add DE to HL
*$CA22 LD A,($A00A)   ; Remember the player's and the target's rooms
 $CA25 LD ($C491),A   ; Save the actor's room as it was before the action
                      ; (#R$C491)
 $CA28 LD IX,($A013)  ; IX = the direct object's record (#R$A012($A013))
 $CA2C LD A,(IX+$0F)  ; Save its room (#R$C492)
 $CA2F LD ($C492),A   ; Store A in #R$C492 in "Rooms saved before an action"
 $CA32 PUSH HL        ; Save HL on the stack
 $CA33 PUSH IY        ; Save IY on the stack
 $CA35 LD A,$01       ; #R$A00A($A00C) = 1 while the action is narrated
 $CA37 LD ($A00C),A   ; Store A in #R$A00A($A00C) in "Game variables"
 $CA3A CALL $CA76     ; Narrate it (#R$CA76)
 $CA3D POP IY         ; Restore IY from the stack
 $CA3F POP HL         ; Restore HL from the stack
 $CA40 BIT 7,(IY+$00) ; Record flag bit 7 set: return carry
 $CA44 JR Z,$CA48     ; If bit 7 of the first byte of the record at IY is
                      ; clear, skip ahead to #R$CA48
 $CA46 SCF            ; Yes: report success without running the body
 $CA47 RET            ; Return to the caller
*$CA48 LD A,($9FD7)   ; Read the plan's direct object (#R$9FD7) into A - A
                      ; plan's direct object slot (#R$9FD7) still $FF: take
                      ; this action's (#R$A032($A034))
 $CA4B INC A          ; Add one to A
 $CA4C JR NZ,$CA54    ; If A is not zero, skip ahead to #R$CA54
 $CA4E LD A,($A034)   ; Read #R$A032($A034) in "Game variables" into A
 $CA51 LD ($9FD7),A   ; Store A in the plan's direct object (#R$9FD7)
*$CA54 LD A,($9FD8)   ; Read the plan's indirect (#R$9FD8) into A - Same for
                      ; the indirect object (#R$9FD8, #R$A032($A035))
 $CA57 INC A          ; Add one to A
 $CA58 JR NZ,$CA60    ; If A is not zero, skip ahead to the routine "Run the
                      ; action body, then report what the player..." (#R$CA60)
 $CA5A LD A,($A035)   ; Read #R$A032($A035) in "Game variables" into A
 $CA5D LD ($9FD8),A   ; Store A in the plan's indirect (#R$9FD8)

; Run the action body, then report what the player saw
;
; Clears #R$CAAE, runs the body through the dispatcher (#R$CB2C), then #R$CA7F
; (the player's own view changed?) and, unless the body set #R$CAAE, #R$CAAF
; (someone came into the player's room?).
;
; Output:HL, AF The result of the action's body
c$CA60 XOR A         ; Clear A to zero (and the carry flag) - #R$CAAE = 0 (see
                     ; EXAMINE: set to 1 when the action itself prints what is
                     ; seen)
 $CA61 LD ($CAAE),A  ; Store A in "Flag: the player's view has changed"
                     ; (#R$CAAE)
 $CA64 CALL $CB2C    ; Call the routine "Dispatch to a handler routine via a
                     ; computed jump" (#R$CB2C) - Run the action's body
                     ; (#R$CB2C), keeping its result
 $CA67 PUSH AF       ; Save AF on the stack
 $CA68 PUSH HL       ; Save HL on the stack
 $CA69 CALL $CA7F    ; Has the player's view changed? Describe the room if so
                     ; (#R$CA7F)
 $CA6C LD A,($CAAE)  ; Read "Flag: the player's view has changed" (#R$CAAE)
                     ; into A - Unless the action printed its own report
                     ; (#R$CAAE) ...
 $CA6F AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $CA70 CALL Z,$CAAF  ; If A is zero, call the routine "Announce a character
                     ; coming into the player's room" (#R$CAAF) - ...give the
                     ; standard report (#R$CAAF)
 $CA73 POP HL        ; Restore HL from the stack
 $CA74 POP AF        ; Restore AF from the stack
 $CA75 RET           ; Return to the caller

; Narrate the action, unless the verb is script-only
;
; Calls #R$A2E4 for verbs below 128, so script-only verbs are never narrated.
;
;  Input:$A033 The verb
; Output:The action narrated unless the verb is script-only
c$CA76 LD A,($A033)  ; Read #R$A032($A033) in "Game variables" into A - Print a
                     ; newline unless the verb has bit 7 set in #R$A032($A033)
                     ; (#R$A2E4)
 $CA79 AND $80       ; Isolate bit 7 of A (mask $80)
 $CA7B CALL Z,$A2E4  ; If bit 7 of A was clear, call the routine "Narrate a
                     ; command as a sentence ('You take the oil..." (#R$A2E4)
 $CA7E RET           ; Return to the caller

; If the player's own view changed, describe the room
;
; When the room seen by the player (#R$A002($A009)) is no longer the player's
; room, the room is described as if the player were the actor (#R$CA9E): in
; full the first time (#R$D102, which also sets bit 6 of the room record:
; visited), briefly after that (#R$D1B2). Read from the code.
;
; Output:The room described if the player's view has changed
c$CA7F LD A,($9860)  ; Read "The actor table: who acts, and where each is
                     ; in..." (#R$9860) into A - The player's room (+15)
                     ; against #R$A002($A009): equal, return
 $CA82 CALL $D237    ; Call the routine "Resolve an id (in A) to its full
                     ; entity record" (#R$D237)
 $CA85 LD A,($A009)  ; Read the room the player is in, which decides what is
                     ; shown (#R$A002($A009)) into A
 $CA88 CP (IX+$0F)   ; Compare A with byte +15 of the record at IX
 $CA8B RET Z         ; If A equals byte +15 of the record at IX, return
 $CA8C LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A -
                     ; Otherwise, as the player (the first actor, #R$9860),
                     ; describe the room (#R$CA9E)
 $CA8F PUSH AF       ; Save AF on the stack
 $CA90 LD A,($9860)  ; Read "The actor table: who acts, and where each is
                     ; in..." (#R$9860) into A
 $CA93 LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $CA96 CALL $CA9E    ; Call the routine "Describe the player's room: in full
                     ; the first time,..." (#R$CA9E)
 $CA99 POP AF        ; Restore AF from the stack
 $CA9A LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $CA9D RET           ; Return to the caller

; Describe the player's room: in full the first time, briefly after
;
; Bit 6 of the room record's first byte marks it as visited: clear, it is set
; and the room is described in full (#R$D102); set, briefly (#R$D1B2).
; Confirmed in the emulator: OPEN PLAIN DOOR, NORTH, SOUTH, NORTH, SOUTH gives
; the closet's and the sitting room's long texts the first time ('The sun
; streams in the two broad windows...') and 'You are in a small closet.' / 'You
; are in Your Room.' the second. (The sitting room's long text came again on
; the first return: the opening description does not go through here.)
;
;  Input:$DD01 The room number
;        $DCFF Its record
; Output:The room described in full the first time, briefly after
c$CA9E LD A,($DD01)  ; Read #R$DD01 in "Pre-check for moving in a direction
                     ; (verbs..." into A - A = the room number (#R$DD01); HL =
                     ; the room's record address (#R$DCFF)
 $CAA1 LD HL,($DCFF) ; Read #R$DCFF in "Pre-check for moving in a direction
                     ; (verbs..." into HL
 $CAA4 BIT 6,(HL)    ; Test bit 6 of the byte HL points at - Its +0 bit 6
                     ; (visited) set: describe it briefly (#R$D1B2)
 $CAA6 JP NZ,$D1B2   ; If bit 6 of the byte HL points at is set, jump on to the
                     ; routine "Describe room A briefly (a room seen before)"
                     ; (#R$D1B2)
 $CAA9 SET 6,(HL)    ; Set bit 6 of the byte HL points at - First visit: mark
                     ; it visited and describe it in full (#R$D102)
 $CAAB JP $D102      ; Jump on to the routine "Describe room A in full (the
                     ; first visit)" (#R$D102)

; Flag: the player's view has changed
;
; Set by #R$DF4B($DF4C), #R$E108($E109) and #R$E140($E141), read by
; #R$CA6C($CA6D) (which describes the room again) and cleared by
; #R$CA61($CA62). Read from the code.
b$CAAE DEFB $00      ; Flag: the player's view has changed

; Announce a character coming into the player's room
;
; For any actor but you (0), 1 and 100 (#R$DC6C): if it was not in the player's
; room before the action (#R$C491) and is now, prints #R$68ED, '<actor>
; ENTERS.' (#R$CBC2). Then, for actions whose direct object has to be here
; (requirement 7 or more), something similar for the object - not traced in
; detail. Read from the code.
; .
; .
; .
; Line comments added from reading the code; the branch at #R$CADC/#R$CAE0 (a
; direct object with no room of its own) is the least certain part and was not
; exercised.
; .
; Instruction coverage over the 15 stored routes (9 November,
; tools/experiments/insn_coverage.py): all 53 instructions were executed.
;
;  Input:$A036 The actor
; Output:An entrance announced, or the direct object's arrival noted
c$CAAF CALL $DC6C    ; Actor 0, 1 or 100 (#R$DC6C)?
 $CAB2 RET Z         ; Yes: nothing to announce
 $CAB3 LD A,($C491)  ; Read "Rooms saved before an action" (#R$C491) into A -
                     ; The actor's room before the action (#R$C491)...
 $CAB6 LD HL,$A009   ; Point HL at the room the player is in, which decides
                     ; what is shown (#R$A002($A009))
 $CAB9 CP (HL)       ; ...equal to the player's room (#R$A002($A009))?
 $CABA RET Z         ; Yes: was already here, no entrance
 $CABB LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Where
                     ; is the actor now (#R$D495)?
 $CABE CALL $D495    ; Call the routine "GET-ACTOR-ROOM: what room is actor A
                     ; currently in?" (#R$D495)
 $CAC1 LD HL,$A009   ; Point HL at the room the player is in, which decides
                     ; what is shown (#R$A002($A009))
 $CAC4 CP (HL)       ; ...the player's room?
 $CAC5 JR NZ,$CAD0   ; No: skip the announcement
 $CAC7 LD A,($A036)  ; Print '<actor> ENTERS.' (#R$68ED) via #R$CBC2
 $CACA LD DE,$68ED   ; Point DE at the message "THE ENTERS." (#R$68ED)
 $CACD CALL $CBC2    ; Call the routine "Print message DE about thing A, if it
                     ; is in the..." (#R$CBC2)
*$CAD0 LD A,($A00F)  ; Read #R$A00A($A00F) in "Game variables" into A - Direct
                     ; object has to be here (requirement code 7 or more)?
 $CAD3 CP $07        ; Compare A with $07
 $CAD5 RET C         ; No: finished
 $CAD6 LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - Where
                     ; is the direct object now (#R$D495)?
 $CAD9 CALL $D495    ; Call the routine "GET-ACTOR-ROOM: what room is actor A
                     ; currently in?" (#R$D495)
 $CADC CP $FF        ; Compare A with $FF - $FF: it has no room of its own
                     ; (#R$CAE0 onwards tries a different test)
 $CADE JR NZ,$CB12   ; If A differs from $FF, jump on to #R$CB12
 $CAE0 LD B,(IX+$00) ; Read the first byte of the record at IX into B - Scan
                     ; the bytes at IX+$0F onwards, up to the record's size,
                     ; for the player's room
 $CAE3 LD A,($A009)  ; Read the room the player is in, which decides what is
                     ; shown (#R$A002($A009)) into A
*$CAE6 CP (IX+$0F)   ; Compare A with byte +15 of the record at IX
 $CAE9 JR Z,$CAF0    ; If A equals byte +15 of the record at IX, skip ahead to
                     ; #R$CAF0
 $CAEB INC IX        ; Step IX on to the next byte
 $CAED DJNZ $CAE6    ; Count B down and, while it is not zero, go back to
                     ; #R$CAE6
 $CAEF RET           ; Not found: return
*$CAF0 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Found:
                     ; save the actor in B and blank #R$A032($A036)
 $CAF3 LD B,A        ; Copy A into B
 $CAF4 LD A,$FF      ; Load A with $FF
 $CAF6 LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $CAF9 LD A,$01      ; Load A with $01 - Switch output on
                     ; (#LINK(rom_symbols#a5C3C)($5C3C) = 1)
 $CAFB LD ($5C3C),A  ; Store A in the output-switch byte (TV_FLAG)
                     ; (#LINK(rom_symbols#a5C3C)($5C3C))
 $CAFE LD A,($A009)  ; Read the room the player is in, which decides what is
                     ; shown (#R$A002($A009)) into A - Look for an exit of the
                     ; player's room (#R$D471)...
 $CB01 CALL $D471    ; Call #R$D471 (inside "Find the exit from the actor's
                     ; room through...")
 $CB04 CP $FF        ; Compare A with $FF - ...and if there is one, narrate it
                     ; (#R$CA76)
 $CB06 CALL NZ,$CA76 ; If A differs from $FF, call the routine "Narrate the
                     ; action, unless the verb is script-only" (#R$CA76)
 $CB09 SUB A         ; Clear A to zero - Switch output off again
 $CB0A LD ($5C3C),A  ; Store A in the output-switch byte (TV_FLAG)
                     ; (#LINK(rom_symbols#a5C3C)($5C3C))
 $CB0D LD A,B        ; Copy B into A - Restore the actor
 $CB0E LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $CB11 RET           ; Return to the caller
*$CB12 LD A,($C492)  ; Read #R$C492 in "Rooms saved before an action" into A -
                     ; Direct object has a room: was it in the player's room
                     ; before the action (#R$C492)?
 $CB15 LD HL,$A009   ; Point HL at the room the player is in, which decides
                     ; what is shown (#R$A002($A009))
 $CB18 CP (HL)       ; Compare A with the byte at the room the player is in,
                     ; which decides what is shown (#R$A002($A009))
 $CB19 RET Z         ; Yes: no entrance
 $CB1A LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - Is the
                     ; object the actor itself (#R$A032($A036))?
 $CB1D LD HL,$A036   ; Point HL at #R$A032($A036) in "Game variables"
 $CB20 CP (HL)       ; Compare A with the byte at #R$A032($A036) in "Game
                     ; variables"
 $CB21 RET Z         ; Yes: already announced above
 $CB22 LD DE,$68ED   ; Point DE at the message "THE ENTERS." (#R$68ED) - Else
                     ; print '<thing> ENTERS.' (#R$68ED)
 $CB25 JP $CBC2      ; Jump on to the routine "Print message DE about thing A,
                     ; if it is in the..." (#R$CBC2)

; The saved IX and IY for $CB2C's calls
;
; Addresses named in the title: #R$CB2C.
; .
; #R$CB2C loads IX and IY from here, calls HL (#R$CB40) and stores them back:
; so a handler can keep its place between calls.
b$CB28 DEFW $0000    ; IX
 $CB2A DEFW $0000    ; IY

; Dispatch to a handler routine via a computed jump
;
; Loads IX and IY from a saved 'action context' (#R$CB28/#R$CB2A), calls
; through to a plain `JP (HL)` at #R$CB40, then stores whatever IX/IY the
; handler left behind back into #R$CB28/#R$CB2A. So IX/IY persist from one
; dispatched handler to the next, like a pair of global registers - the
; caller's own IX/IY are not protected. #R$CB34 is a second entry point that
; skips the load (used by the action-record interpreter at #R$C9EB to run a
; record's pre-check routine with the current IX/IY).
; .
; CORRECTED: an earlier version of this entry (and its line comments) said the
; routine 'saves the caller's IX/IY and restores them afterwards' - exactly
; backwards. `LD IX,(#R$CB28)` loads IX from memory; `LD (#R$CB28),IX` stores
; it. Caught on a re-read with a working disassembler, per verification.md item
; 5 ('re-derive register roles from a fresh trace').
; .
; Confirmed as a genuinely real, deliberate mechanism (not misdecoded data) by
; finding its one real caller (#R$CA64, via the literal bytes CD 2C CB) and by
; the coherence of what surrounds that call - it sits in what looks like the
; main per-turn command loop, immediately followed by a check for whether the
; player's room changed as a result of whatever just got dispatched to.
; .
; UPDATED: what loads HL before this call is now fully traced, correcting the
; guess in the previous paragraph (that it would be 'the verb/action dispatch
; table' - it isn't). #R$CA64 is itself called, once per candidate, from the
; same per-candidate walk this project found much earlier via #R$C9C0
; (CORRECTED: not a fixed table but the five RUN steps of the player's plan
; script at #R$9921, then the command itself); HL comes from that candidate's
; own record fields (the (IY+2)/(IY+3) pattern found at #R$C9E3), not from the
; #R$AA71 table. See source/world_model_notes.md's 'unifying several
; previously-separate threads' section for the full, now-closed trace.
;
;  Input:HL The handler
; Output:F, HL From the handler
;        $CB28, $ CB2A The IX and IY the handler left
c$CB2C LD IX,($CB28) ; Load the action context's IX...
 $CB30 LD IY,($CB2A) ; ...and IY
; This entry point is used by the routine at #R$C9BF.
*$CB34 CALL $CB40    ; Run the handler (second entry point: keep current IX/IY)
 $CB37 LD ($CB28),IX ; Save whatever IX the handler left as the new context...
 $CB3B LD ($CB2A),IY ; ...and IY
 $CB3F RET           ; Return to the caller

; Jump to HL
;
; The CALL #R$CB40 at #R$CB34 and #R$CB6E is a CALL (HL).
;
; Input:HL The address to jump to
c$CB40 JP (HL)       ; HL must already hold the real target address

; Return Z (does nothing)
;
; Used by the routines at #R$C4D1 and #R$C583.
;
; Output:A 0
;        F Z
c$CB41 XOR A         ; Set A to zero, which sets the zero flag for the caller
 $CB42 RET           ; Return to the caller

; End of an actor's go: hand the turn back to the player
;
; Reached from #R$C9A1($C9A2). Unless #R$DC6C says otherwise, makes the first
; actor in the table (#R$9860, the player) current again; when #R$A00A($A00B)
; is set, either clears #R$A00A($A00C) and narrates (#R$CA76) or - with HL not
; zero - calls HL with #R$A022($A027) set (#R$CB40). Read from the code in
; outline.
; .
; How it works:
; .
; 1. If the actor is the player, Watson or the police cab (actors 0, 1 or $64),
; do nothing.
; .
; 2. Otherwise note a failure (#R$A00A($A00B)): either call the failure routine
; given in HL or narrate that the action failed (#R$CA76).
; .
; 3. Make the player the current actor again.
;
;  Input:HL The failure routine to call, or 0
; Output:A 0
;        F Z
;        $A036 The player again
c$CB43 PUSH HL       ; Save HL on the stack - Is the current actor 0, 1 or $64
                     ; (#R$DC6C: Z if so)? NZ (anyone else): nothing to do
 $CB44 CALL $DC6C    ; Call #R$DC6C (inside "Action record: default for verb
                     ; #R$DC57(28) (GO...")
 $CB47 POP HL        ; Restore HL from the stack
 $CB48 JR NZ,$CB65   ; If the zero flag is clear, skip ahead to #R$CB65
 $CB4A XOR A         ; Clear A to zero (and the carry flag) - No current actor
                     ; for a moment
 $CB4B LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $CB4E LD A,($A00B)  ; Read #R$A00A($A00B) in "Game variables" into A - A
                     ; failure (#R$A00A($A00B)) to report? If not, skip to the
                     ; hand-back
 $CB51 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $CB52 JR Z,$CB5F    ; If A is zero, skip ahead to #R$CB5F
 $CB54 LD A,L        ; Copy L into A - HL = a routine to call: none, so narrate
                     ; the failure (#R$A00A($A00C) = 0, #R$CA76)
 $CB55 OR H          ; Set in A the bits that are set in H
 $CB56 JR NZ,$CB67   ; If the result is not zero, skip ahead to #R$CB67
; This entry point is used by the routine at #R$CB7B.
*$CB58 XOR A         ; Clear A to zero (and the carry flag)
 $CB59 LD ($A00C),A  ; Store A in #R$A00A($A00C) in "Game variables"
 $CB5C CALL $CA76    ; Call the routine "Narrate the action, unless the verb is
                     ; script-only" (#R$CA76)
*$CB5F LD A,($9860)  ; Read "The actor table: who acts, and where each is
                     ; in..." (#R$9860) into A - Make the first actor in the
                     ; table (#R$9860, the player) current again
 $CB62 LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
*$CB65 XOR A         ; Set A to zero, which sets the zero flag for the caller
 $CB66 RET           ; Return to the caller
*$CB67 LD A,$01      ; Load A with $01 - A routine to call: with #R$A022($A027)
                     ; = 1, call it (#R$CB40), then #R$A022($A027) = 0
 $CB69 LD ($A027),A  ; Store A in #R$A022($A027) in "Game variables"
 $CB6C PUSH IY       ; Save IY on the stack
 $CB6E CALL $CB40    ; Call the routine "Jump to HL" (#R$CB40)
 $CB71 POP IY        ; Restore IY from the stack
 $CB73 XOR A         ; Clear A to zero (and the carry flag)
 $CB74 LD ($A027),A  ; Store A in #R$A022($A027) in "Game variables"
 $CB77 JR $CB5F      ; Go back to #R$CB5F

; The flags $CB7B is to name
;
; Addresses named in the title: #R$CB7B.
; .
; Written by #R$C797($C798) (with bit 7 cleared); #R$CB7B prints the word for
; each set bit from #R$C471 or #R$C481. Read from the code.
b$CB79 DEFB $00,$00  ; The flags #R$CB7B is to name

; Refuse by naming the flag that failed: "THE ... IS <word>"
;
; Takes the lowest bit in #R$CB79 and prints #R$6817 ('THE <object> IS')
; followed by that bit's word: from #R$C471 when a needed bit was missing, from
; #R$C481 (bit 7 of #R$CB79 set) when a forbidden bit was present. The object
; is #R$CB79($CB7A), saved by #R$C685.
;
;  Input:$CB79 The flag bits that failed
;        $CB7A The object
; Output:A message like "THE ... IS <word>" printed
c$CB7B LD A,($CB79)  ; Read "The flags #R$CB7B is to name" (#R$CB79) into A -
                     ; #R$CB79 = the missing or forbidden flag bits; bit 7 says
                     ; which
 $CB7E BIT 7,A       ; Test bit 7 of A
 $CB80 LD HL,$C471   ; Point HL at "Words for a +5 flag that should be set but
                     ; is not" (#R$C471) - Needed bit missing: table at
                     ; #R$C471...
 $CB83 JR Z,$CB88    ; If bit 7 of A is clear, skip ahead to #R$CB88
 $CB85 LD HL,$C481   ; ...forbidden bit present: table at #R$C481
*$CB88 OR $80        ; Mark the end of the bits with bit 7
*$CB8A LD E,(HL)     ; Read the byte HL points at into E - Walk the table: DE =
                     ; the next word, shifting the flag byte right until the
                     ; lowest set bit falls out
 $CB8B INC HL        ; Step HL on to the next byte
 $CB8C LD D,(HL)     ; Read the byte HL points at into D
 $CB8D INC HL        ; Step HL on to the next byte
 $CB8E RRCA          ; Rotate A right one place (bit 0 goes to carry and bit 7)
 $CB8F JR NC,$CB8A   ; If the carry flag is clear, go back to #R$CB8A
 $CB91 LD A,D        ; Copy D into A - Word zero: nothing to say (#R$CB58)
 $CB92 OR E          ; Set in A the bits that are set in E
 $CB93 JR Z,$CB58    ; If the result is zero, go back to #R$CB58
 $CB95 LD A,($CB7A)  ; Read #R$CB79($CB7A) in "The flags #R$CB7B is to name"
                     ; into A - The object saved at #R$CB79($CB7A) becomes the
                     ; direct object
 $CB98 LD ($A034),A  ; Store A in #R$A032($A034) in "Game variables"
 $CB9B LD HL,$6817   ; Point HL at the message "THE OIL LAMP IS" (#R$6817) -
                     ; Print #R$6817 'THE <object> IS' (the word follows)
 $CB9E CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $CBA1 CALL $A887    ; Call #R$A887 (inside "Print the dictionary word that HL
                     ; refers to")
 $CBA4 JP $A2A2      ; Go back to the routine "Print a newline (A kept)"
                     ; (#R$A2A2)

; Refuse if the character is busy: 'SORRY, I CANNOT DO THAT NOW.'
;
; Called from both #R$E40A (SIT) and #R$E432 (GET OUT) before they do anything
; else. Checks bit 6 of a flag byte at #R$B934; if clear, returns immediately
; (continue normally). If set, discards the return address, prints a fixed
; message (#R$681A), and jumps to the shared failure point (#R$DC15) this
; project has seen several other entries use.
; .
; Not yet confirmed: what sets bit 6 of #R$B934, and therefore what specific
; condition this guards against - a reasonable guess (already engaged in some
; other action, or otherwise unable to sit/stand right now) is just a guess,
; not tested. #R$B934/#R$B935 are the same bytes this project's #R$B91F
; investigation touched a few rounds earlier, not yet tied into a complete
; account.
; .
; RESOLVED 2026-11-07: #R$B934 holds the first byte of the plan-script
; instruction the character was on when the player's request arrived (#R$B953;
; cleared each step at #R$CC89), and bit 6 of that byte marks the instruction
; as busy. Confirmed in the emulator: SAY TO WATSON "GET OUT" at the start gets
; 'Watson gets out of watsons armchair.'; with bit 6 poked into Watson's
; current instruction ($52 instead of $12) it gets 'Watson says " Sorry, I
; cannot do that now. "' and he stays in the chair.
;
;  Input:$B934 The guard flag
; Output:Returns if bit 6 is clear; otherwise the message is printed and the
; .              caller is abandoned through $DC15
c$CBA7 LD A,($B934)  ; Read the guard flag
 $CBAA BIT 6,A       ; Is the blocking bit set?
 $CBAC RET Z         ; No: continue normally
 $CBAD POP HL        ; Yes: discard our own return address
 $CBAE XOR A         ; Not in the 'quoted' print mode
 $CBAF LD ($A027),A  ; Store A in #R$A022($A027) in "Game variables"
 $CBB2 LD HL,$681A   ; A fixed message...
 $CBB5 CALL $A59F    ; ...print it
 $CBB8 JP $DC15      ; ...then bail out via the shared failure point

; Refusal: "SORRY IT IS TOO DARK."
;
; A pre-check that refuses returns HL = this address; the caller then runs it.
; Prints #R$68D1. CORRECTED: the automatic split had this as data.
;
; Output:HL The message printed
c$CBBB LD HL,$68D1   ; Point HL at the message "SORRY IT IS TOO DARK."
                     ; (#R$68D1)
 $CBBE CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $CBC1 RET           ; Return to the caller

; Print message DE about thing A, if it is in the player's room
;
; Does nothing for $FF or 0, or when the thing is somewhere else. Otherwise
; switches output on (#LINK(rom_symbols#a5C3C)($5C3C) = 1) and prints DE with
; the thing as its subject.
; .
; How it works:
; .
; 1. Do nothing if the thing is $FF or 0 (nobody).
; .
; 2. Find which room the thing is in (#R$D495). If it is not the room the
; player is looking at (#R$A002($A009)), do nothing.
; .
; 3. Otherwise switch printing on and climb from the thing to whatever holds it
; at the top, a cab for example, so that the message is about the outermost
; holder.
; .
; 4. Make the player the current actor for a moment and ask whether the player
; can see that holder (#R$C821). If not, return without printing.
; .
; 5. If so, put the real actor back and print message DE with the holder's name
; as its subject (#R$A59F).
;
;  Input:A The thing
;        DE The message
; Output:Nothing is printed unless the player can see the thing
c$CBC2 CP $FF        ; Compare A with $FF - Nothing for $FF or 0
 $CBC4 RET Z         ; If A equals $FF, return
 $CBC5 AND A         ; Clear the carry flag for the caller (A is unchanged)
 $CBC6 RET Z         ; If A is zero, return
 $CBC7 LD B,A        ; Copy A into B - B = the thing; is it in the room the
                     ; player is looking at (#R$A002($A009))?
 $CBC8 CALL $D495    ; Call the routine "GET-ACTOR-ROOM: what room is actor A
                     ; currently in?" (#R$D495)
 $CBCB LD C,A        ; Copy A into C
 $CBCC LD A,($A009)  ; Read the room the player is in, which decides what is
                     ; shown (#R$A002($A009)) into A
 $CBCF CP C          ; Compare A with C
 $CBD0 RET NZ        ; If A differs from C, return
 $CBD1 LD A,$01      ; Load A with $01 - Yes: output on
 $CBD3 LD ($5C3C),A  ; Store A in the output-switch byte (TV_FLAG)
                     ; (#LINK(rom_symbols#a5C3C)($5C3C))
 $CBD6 PUSH DE       ; Save DE on the stack
*$CBD7 LD A,B        ; Copy B into A - Climb to whatever holds it at the top (a
                     ; cab, say)
 $CBD8 CALL $D237    ; Call the routine "Resolve an id (in A) to its full
                     ; entity record" (#R$D237)
 $CBDB LD A,(IX+$01) ; Read the holder byte (+1) of the thing record at IX into
                     ; A
 $CBDE CP $FF        ; Compare A with $FF
 $CBE0 JR Z,$CBE5    ; If A equals $FF, skip ahead to #R$CBE5
 $CBE2 LD B,A        ; Copy A into B
 $CBE3 JR $CBD7      ; Go back to #R$CBD7
*$CBE5 LD A,B        ; Copy B into A - Its name is the message's subject
                     ; (record + 7, on the stack)
 $CBE6 CALL $A4BC    ; Call the routine "HL = thing A's record + 7" (#R$A4BC)
 $CBE9 EX (SP),HL    ; Swap HL with the word on top of the stack
 $CBEA LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - For a
                     ; moment make the player the current actor...
 $CBED PUSH AF       ; Save AF on the stack
 $CBEE LD A,($9860)  ; Read "The actor table: who acts, and where each is
                     ; in..." (#R$9860) into A
 $CBF1 LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $CBF4 CALL $CC29    ; Call the routine "Set up the current actor: its record
                     ; and room" (#R$CC29)
 $CBF7 LD A,B        ; Copy B into A - ...and ask whether he can see that
                     ; (#R$C821)
 $CBF8 CALL $C821    ; Call the routine "Can the current actor (#R$A032($A036))
                     ; see thing A?" (#R$C821)
 $CBFB JR NZ,$CC00   ; If the zero flag is clear, skip ahead to #R$CC00
 $CBFD POP AF        ; Restore AF from the stack - No: return (leaving
                     ; #R$A032($A036) as the player - it is not put back)
 $CBFE POP HL        ; Restore HL from the stack
 $CBFF RET           ; Return to the caller
*$CC00 POP AF        ; Restore AF from the stack - Yes: back to the real actor
                     ; and print message DE (#R$A59F)
 $CC01 LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $CC04 CALL $CC29    ; Call the routine "Set up the current actor: its record
                     ; and room" (#R$CC29)
 $CC07 CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $CC0A RET           ; Return to the caller

; Bytes for the actor's turn ($CC37)
;
; Addresses named in the title: #R$CC37.
; .
; Cleared by #R$CC38, read at #R$CC8C($CC8D), its address used at
; #R$CEB8($CEB9). Read from the code.
b$CC0B DEFB $00,$00,$00 ; Bytes for the actor's turn (#R$CC37)

; Find the actor record whose id matches C
;
; A plain linear search over the sentinel-terminated array of 8-byte
; actor/character records at #R$9860 (see the boot sequence in
; overlay_01_boot.py, where this table was first found): given an id in C,
; walks the table 8 bytes at a time until either field +0 matches (found - IY
; left pointing at that record) or field +0 is $FF (not found).
; .
; This is the routine that turns the loose 'we saw code walk a table shaped
; like this' observation from the boot sequence into a confirmed,
; general-purpose accessor: it's called from four separate places in the code
; (#R$CC3D, #R$DDA3, #R$E03E, #R$E300 - all genuine CALL instructions, found by
; searching for the literal bytes CD 0E CC), which is real cross-reference
; evidence this is a widely-used 'look up an actor' primitive, not a one-off.
;
;  Input:A An actor number
; Output:IY The actor's record, or the $FF end marker if there is none
;        BC, DE Kept
c$CC0E PUSH DE       ; Save DE on the stack - Record size is 8 bytes
 $CC0F PUSH BC       ; Save BC on the stack
 $CC10 LD C,A        ; Copy A into C
 $CC11 LD DE,$0008   ; Load DE with $0008
 $CC14 LD IY,$9860   ; IY -> first actor record
*$CC18 LD A,(IY+$00) ; This record's id byte...
 $CC1B CP C          ; ...is it the one we want?
 $CC1C JR Z,$CC26    ; If A equals C, skip ahead to #R$CC26
 $CC1E CP $FF        ; ...or have we hit the end-of-table sentinel?
 $CC20 JR Z,$CC26    ; If A equals $FF, skip ahead to #R$CC26
 $CC22 ADD IY,DE     ; Neither: move to the next record
 $CC24 JR $CC18      ; Go back to #R$CC18
*$CC26 POP BC        ; Restore BC, DE and return
 $CC27 POP DE        ; Restore DE from the stack
 $CC28 RET           ; Return to the caller

; Set up the current actor: its record and room
;
; #R$A012($A017) = the record of the actor in #R$A032($A036) and #R$A00A = its
; room (#R$D495). Read from the code.
;
;  Input:$A036 The actor
; Output:$A017 The actor's record
;        $A00A The actor's room
;        IX The record
c$CC29 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - The
                     ; current actor (#R$A032($A036)): its thing record
                     ; (#R$D495)
 $CC2C CALL $D495    ; Call the routine "GET-ACTOR-ROOM: what room is actor A
                     ; currently in?" (#R$D495)
 $CC2F LD ($A017),IX ; Store IX in #R$A012($A017) in "Game variables" - Keep
                     ; the record at #R$A012($A017) and the room (A) at #R$A00A
 $CC33 LD ($A00A),A  ; Store A in the current actor's room (#R$A00A)
 $CC36 RET           ; Return to the caller

; Start an actor's turn
;
; UPDATED 2026-11-07, from the main loop (#R$A064) and the plan interpreter:
; clears the failure count (#R$CC0B), finds the actor's record (IY, saved at
; #R$9FDB, id at #R$A032($A036)), sets #R$CC0B($CC0D) when an order or remark
; is waiting for it (#R$B91F), works out its room and the player's (#R$CC29,
; #R$D045), and switches output on (#LINK(rom_symbols#a5C3C)($5C3C) = 1) only
; if the player can see the actor (#R$C821) - which is why you only read what
; characters do when they are with you. #R$A01A($A01F) starts at 0 (1 if the
; actor is not found). Consistent with the emulator: Lestrade hailing a cab and
; giving the cabbie his orders appears in the output only in the runs where the
; player was moved to his room.
; .
; Given an actor id in A: clears a flag at #R$CC0B, resolves the id to its full
; state record via the already-confirmed #R$CC0E, stashes that record's pointer
; at #R$9FDB and the id itself at #R$A032($A036), calls #R$B91F (not yet
; examined), then gets this actor's current room (via the already-confirmed
; #R$CC29/#R$D495 chain) and the player's own current room (via the
; already-confirmed #R$D045). On failure to resolve the id, clears
; #R$A01A($A01F) and returns early instead.
; .
; Confirmed real and genuinely on the per-turn NPC-processing path: this is
; called (via #R$CC5A) from #R$CC78, which is itself called from inside the
; actor-table walk that overlay_01_boot.py originally described as boot-only -
; see world_model_notes.md for how that walk was shown to be reentrant, and the
; correction now recorded there and in this project's boot-sequence notes.
; .
; How it works:
; .
; 1. Clear the failure count (#R$CC0B). Find the actor's record (#R$CC0E); if
; there is none, make the action take 1 minute and stop.
; .
; 2. Keep the record address (#R$9FDB) and the actor (#R$A032($A036)), and note
; whether an order or remark is waiting (#R$B91F).
; .
; 3. Set up the actor (#R$CC29) and note the player's room (#R$D045).
; .
; 4. Switch output on only when the player can see the actor (#R$C821). Clear
; #R$A01A($A01F).
;
;  Input:A The actor number
; Output:$A01F 0 (or 1 if the actor is not in the table)
;        IY The actor's record
;        $A036 The actor
;        $5C3C Output on only when the actor is seen by the player
c$CC37 PUSH AF       ; Save AF on the stack - Clear the failure count (#R$CC0B)
 $CC38 XOR A         ; Clear A to zero (and the carry flag)
 $CC39 LD ($CC0B),A  ; Store A in "Bytes for the actor's turn (#R$CC37)"
                     ; (#R$CC0B)
 $CC3C POP AF        ; Restore AF from the stack
 $CC3D CALL $CC0E    ; Find the actor's record (#R$CC0E)
 $CC40 CP $FF        ; Compare A with $FF - Not found: #R$A01A($A01F) = 1 and
                     ; return
 $CC42 LD HL,$0001   ; Load HL with $0001
 $CC45 JP Z,$CC74    ; If A equals $FF, jump on to #R$CC74
 $CC48 LD ($9FDB),IY ; Store IY in the current actor's (#R$9FDB) - Save the
                     ; record address and the actor's id
 $CC4C LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $CC4F CALL $B91F    ; Call the routine "Is an order or a remark waiting for
                     ; the current actor?" (#R$B91F) - #R$CC0B($CC0D) = 1 if an
                     ; order or remark is waiting for it (#R$B91F), 0 if not
 $CC52 LD A,$00      ; Load A with $00
 $CC54 JR NZ,$CC57   ; If the zero flag is clear, skip ahead to #R$CC57
 $CC56 INC A         ; Add one to A
*$CC57 LD ($CC0D),A  ; Store A in #R$CC0B($CC0D) in "Bytes for the actor's turn
                     ; (#R$CC37)"
; This entry point is used by the routine at #R$CC78.
*$CC5A CALL $CC29    ; Call the routine "Set up the current actor: its record
                     ; and room" (#R$CC29) - Set the actor up as the subject
                     ; (#R$CC29, #R$D045)
 $CC5D CALL $D045    ; Call the routine "Note the room the player is in
                     ; (#R$A002($A009))" (#R$D045)
 $CC60 SUB A         ; Clear A to zero - Output off
                     ; (#LINK(rom_symbols#a5C3C)($5C3C) = 0)...
 $CC61 LD ($5C3C),A  ; Store A in the output-switch byte (TV_FLAG)
                     ; (#LINK(rom_symbols#a5C3C)($5C3C))
 $CC64 LD A,($9860)  ; Read "The actor table: who acts, and where each is
                     ; in..." (#R$9860) into A - ...unless the actor is where
                     ; the player is (#R$C821)
 $CC67 CALL $C821    ; Call the routine "Can the current actor (#R$A032($A036))
                     ; see thing A?" (#R$C821)
 $CC6A JR Z,$CC71    ; If the zero flag is set, skip ahead to #R$CC71
 $CC6C LD A,$01      ; Load A with $01
 $CC6E LD ($5C3C),A  ; Store A in the output-switch byte (TV_FLAG)
                     ; (#LINK(rom_symbols#a5C3C)($5C3C))
*$CC71 LD HL,$0000   ; Load HL with $0000 - #R$A01A($A01F) = 0
*$CC74 LD ($A01F),HL ; Store HL in #R$A01A($A01F) in "Game variables"
 $CC77 RET           ; Return to the caller

; Run one step of the current actor's plan script
;
; Each actor (the 8-byte records at #R$9860: +0 id, +1/+2 script position,
; +3/+4/+5 saved plan registers) runs a script in a small language. Each
; instruction starts with one byte: the low nibble is the opcode and the high
; nibble holds flags. Bit 7: a 2-byte success address follows the operands. Bit
; 4: a 2-byte failure address follows (after the success address, if both). Bit
; 5: one-shot - after it succeeds the instruction is overwritten with zeros
; (#R$CF43), and the fetch loop at #R$CC94 skips zero bytes, so it never runs
; again - though no script in the game sets bit 5 (all decoded instructions
; were checked), so this is never used. Bit 6: busy - while a character is on
; such an instruction it will not do what the player asks of it: #R$B936 copies
; the instruction's first byte to #R$B934, and #R$CBA7 (used by SIT, GET OUT
; and the move pre-check #R$DCD2) refuses with 'SORRY, I CANNOT DO THAT NOW.'
; Confirmed in the emulator (see #R$CBA7).
; .
; Opcodes (lengths from #R$CF03): 1 DO verb (2 bytes); 2 DO verb dobj iobj (4);
; 3 RUN record (3); 4 ASK person TO verb dobj iobj (5): an order to another
; character, queued on the list at #R$9FEE and announced with #R$682A; 5 SAY TO
; person message (4), via #R$6830; 6 PRINT message (3); 7 RUN record dobj iobj
; (5); 8 SIGNAL actor (2) and 9 AWAIT actor (2): one actor leaves a token on
; the #R$9FE7 list for another, which AWAIT consumes; A RETURN FAIL and B
; RETURN OK (1 each): leave a sub-script; D (2) and F (1) PASS: spend a minute
; doing nothing; E GOTO address (3). C is not used: #R$CD08 is JR Z,#R$CD08, a
; jump to itself with Z set, which would hang the game.
; .
; DO runs a command for the actor exactly as if it had been typed, through
; #R$C4D1: the verb's own default record, the object's own action list, the
; requirement codes and the pre-check all apply. Verbs 128-140 exist only for
; scripts and are looked up in the table at #R$9FAB. RUN skips the verb and
; runs one action record directly (#R$C591). Argument bytes $F5-$FF are not
; objects: $FA is the plan's verb (#R$9FD6), $FB the actor itself, $FC and $FD
; the plan's indirect and direct objects (#R$9FD8, #R$9FD7), $FE a number and
; $FF nothing (#R$CEDE).
; .
; Success (#R$CE8F) moves to the success address or the next instruction and
; returns to the main loop, which runs the next step at once if the action took
; no time and otherwise ends the actor's turn for as many minutes as it took.
; Failure (#R$CEB8) moves to the failure address or the next instruction and
; tries again at once, up to ten times in one turn (#R$CC0B); if the failure
; address is the instruction itself, the actor simply waits there. So 'DO verb
; #R$F1D6(136) / 23 [fail -> itself]' means 'wait here until 11pm'.
; .
; A RUN or DO that reaches a checks-only action record (flags bit 7) calls a
; sub-script: #R$C9A7 saves a call frame (#R$CF80: actor, return position,
; objects, plan verb) on the list at #R$9FE9 and points the actor at the script
; after the record's header. RETURN OK or RETURN FAIL (#R$CFCF) drops the frame
; and makes the calling instruction succeed or fail.
; .
; This routine fetches the actor's script position (+1/+2 of its record), skips
; spent one-shot bytes, and dispatches on the opcode. #R$CCA7-#R$CCC6 is a
; separate path for an actor who has been given an order (ASK) this turn
; (#R$CC0B($CC0D), set by #R$CC37 from #R$B91F): the order is carried out
; first, through #R$B936.
; .
; Confirmed in the emulator: a breakpoint at #R$CC9B over 106 turns saw 15,038
; fetches by 24 actors, every one at an instruction start that tools/plan.py
; decodes, and opcodes 1-11, 14 and 15 all occurred (12 and 13 never did).
; .
; Instruction coverage, 9 November: 73 of this routine's 75 instructions were
; executed over the 15 stored routes, including the order path #R$CCAE-#R$CCC6
; (an actor who has been given an ASK order). The two that never ran, #R$CC98
; and #R$CC99, skip a zero byte - a spent one-shot instruction - and no script
; in the game uses one-shot instructions.
; .
; How it works:
; .
; 1. Set up the actor (#R$CC5A) and load its plan registers (#R$D008). Take its
; script position from its record.
; .
; 2. If ten steps have failed this turn, give up until next turn (#R$CD8B).
; Skip any zero bytes (spent one-shot instructions).
; .
; 3. The opcode is the low nibble of the first byte. Codes of 10 and up are
; control flow (#R$CCF3); the others are actions. If an order was given this
; turn, turn it into a command (#R$B936) and carry it out first.
; .
; 4. Run the instruction. It succeeds (#R$CE8F), moving to its success address,
; or fails (#R$CEB8), moving to its failure address, and a one-shot instruction
; is erased (#R$CF43).
;
;  Input:A The actor number
; Output:$A01F The minutes the step took (0 if none)
c$CC78 CALL $CC5A      ; Set up this actor's room comparisons
 $CC7B LD IY,($9FDB)   ; IY = the actor's record in the actor table
 $CC7F CALL $D008      ; Load its plan registers
; This entry point is used by the routine at #R$CEB8.
*$CC82 LD L,(IY+$01)   ; Read byte +1 of the record at IY into L - HL = its
                       ; script position
 $CC85 LD H,(IY+$02)   ; Read byte +2 of the record at IY into H
 $CC88 XOR A           ; Clear A to zero (and the carry flag)
 $CC89 LD ($B934),A    ; Store A in "The actor an order is for (two copies)"
                       ; (#R$B934)
 $CC8C LD A,($CC0B)    ; Read "Bytes for the actor's turn (#R$CC37)" (#R$CC0B)
                       ; into A - Ten failures this turn already?
 $CC8F CP $0A          ; Compare A with $0A
 $CC91 JP Z,$CD8B      ; Then give up for this turn
*$CC94 LD A,(HL)       ; Read the byte HL points at into A - Skip zero bytes:
                       ; spent one-shot instructions
 $CC95 AND A           ; Test A for zero (this leaves A as it was and clears
                       ; carry)
 $CC96 JR NZ,$CC9B     ; If A is not zero, skip ahead to #R$CC9B
 $CC98 INC HL          ; Step HL on to the next byte
 $CC99 JR $CC94        ; Go back to #R$CC94
*$CC9B PUSH HL         ; Save HL on the stack - IX = the instruction; remember
                       ; where it is
 $CC9C POP IX          ; Restore IX from the stack
 $CC9E LD ($9FD9),HL   ; Store HL in the plan instruction (#R$9FD9)
 $CCA1 AND $0F         ; Keep only bits 0, 1, 2, 3 of A (mask $0F) - Opcodes 10
                       ; and up are control flow
 $CCA3 CP $0A          ; Compare A with $0A
 $CCA5 JR NC,$CCF3     ; If A is $0A or more, jump on to #R$CCF3
 $CCA7 LD A,($CC0D)    ; Read #R$CC0B($CC0D) in "Bytes for the actor's turn
                       ; (#R$CC37)" into A - Has the actor been given an order
                       ; this turn?
 $CCAA CP $01          ; Compare A with $01
 $CCAC JR NZ,$CCC7     ; If A differs from $01, skip ahead to #R$CCC7
 $CCAE SUB A           ; Clear A to zero - Yes: turn the order into a command
                       ; (#R$B936) and carry it out (#R$C4D1) before the
                       ; script's own instruction
 $CCAF LD ($CC0D),A    ; Store A in #R$CC0B($CC0D) in "Bytes for the actor's
                       ; turn (#R$CC37)"
 $CCB2 LD A,(HL)       ; Read the byte HL points at into A
 $CCB3 CALL $B936      ; Call the routine "Deal with an order or remark
                       ; addressed to the current..." (#R$B936)
 $CCB6 JP C,$CD91      ; If the carry flag is set, jump on to #R$CD91
 $CCB9 JR Z,$CCC7      ; If the zero flag is set, skip ahead to #R$CCC7
 $CCBB CALL $C4D1      ; Call the routine "Carry out the command in
                       ; #R$A032($A033)-#R$A032($A035) for the current..."
                       ; (#R$C4D1)
 $CCBE RET NC          ; If the carry flag is clear, return
 $CCBF CALL $CFB6      ; Call #R$CFB6 (inside "Save a sub-script call frame")
 $CCC2 LD (IX+$05),$02 ; Set byte +5 of the record at IX to $02
 $CCC6 RET             ; Return to the caller
*$CCC7 LD A,(HL)       ; Read the byte HL points at into A - Dispatch on the
                       ; opcode
 $CCC8 AND $0F         ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $CCCA CP $07          ; Compare A with $07
 $CCCC JP Z,$CE3B      ; If A equals $07, jump on to #R$CE3B - 7: RUN record
                       ; with objects
 $CCCF CP $06          ; Compare A with $06
 $CCD1 JP Z,$CD95      ; If A equals $06, jump on to the routine "Plan opcode
                       ; 6, PRINT: print a message" (#R$CD95)
 $CCD4 CP $05          ; Compare A with $05
 $CCD6 JP Z,$CDA1      ; If A equals $05, jump on to the routine "Plan opcode
                       ; 5, SAY TO: say something to someone" (#R$CDA1)
 $CCD9 CP $04          ; Compare A with $04
 $CCDB JP Z,$CDBF      ; If A equals $04, jump on to the routine "Plan opcode
                       ; 4, ASK: order another character to do..." (#R$CDBF) -
                       ; 4: ASK someone to do something
 $CCDE CP $01          ; Compare A with $01
 $CCE0 JP Z,$CE6A      ; If A equals $01, jump on to #R$CE6A - 1: DO verb
 $CCE3 CP $03          ; Compare A with $03
 $CCE5 JP Z,$CE4F      ; If A equals $03, jump on to #R$CE4F - 3: RUN record
 $CCE8 CP $08          ; Compare A with $08
 $CCEA JR Z,$CD24      ; If A equals $08, jump on to the routine "Plan opcode
                       ; 8, SIGNAL: leave a token for another..." (#R$CD24)
 $CCEC CP $09          ; Compare A with $09
 $CCEE JR Z,$CD47      ; 9: AWAIT
 $CCF0 JP $CE18        ; 2: DO verb dobj iobj
*$CCF3 CP $0E          ; Compare A with $0E - 14: GOTO...
 $CCF5 JR NZ,$CD06     ; If A differs from $0E, skip ahead to #R$CD06
 $CCF7 LD A,(IX+$01)   ; Read byte +1 of the record at IX into A - ...the
                       ; script position becomes the address
 $CCFA LD (IY+$01),A   ; Store A in byte +1 of the record at IY
 $CCFD LD A,(IX+$02)   ; Read byte +2 of the record at IX into A
 $CD00 LD (IY+$02),A   ; Store A in byte +2 of the record at IY
 $CD03 JP $CC82        ; ...and fetch again at once
*$CD06 CP $0C          ; Compare A with $0C - 12: unused - this jumps to itself
                       ; and would hang
*$CD08 JR Z,$CD08      ; If A equals $0C, go back to #R$CD08
 $CD0A CP $0B          ; Compare A with $0B - 11: RETURN OK
 $CD0C JR NZ,$CD17     ; If A differs from $0B, skip ahead to #R$CD17
 $CD0E CALL $CFCF      ; Leave the sub-script
 $CD11 CP $02          ; Compare A with $02
 $CD13 RET Z           ; If A equals $02, return
 $CD14 JP $CE8F        ; The calling instruction succeeds
*$CD17 CP $0A          ; Compare A with $0A - 10: RETURN FAIL
 $CD19 JR NZ,$CD82     ; If A differs from $0A, jump on to the routine "Plan
                       ; opcodes 13 and 15, PASS; and giving up for..."
                       ; (#R$CD82)
 $CD1B CALL $CFCF      ; Call #R$CFCF (inside "Save a sub-script call frame")
 $CD1E CP $02          ; Compare A with $02
 $CD20 RET Z           ; If A equals $02, return
 $CD21 JP $CEB8        ; The calling instruction fails

; Plan opcode 8, SIGNAL: leave a token for another actor
;
; Allocates a 2-byte node (this actor, the argument) on the list headed at
; #R$9FE7. AWAIT (opcode 9) in the other actor's script looks for it. Always
; succeeds. Read from the code.
;
;  Input:IX The instruction (+1 the actor signalled)
; Output:The token left on the list at $9FE7; the step succeeds
c$CD24 LD A,(IX+$01) ; Read byte +1 of the record at IX into A - The actor
                     ; being signalled
 $CD27 PUSH AF       ; Save AF on the stack
 $CD28 LD A,$02      ; Load A with $02 - Allocate a 2-byte node
 $CD2A CALL $A11C    ; Call the routine "Allocate A + 3 bytes from the free
                     ; list, cleared" (#R$A11C)
 $CD2D LD HL,($9FE7) ; Read SIGNAL tokens (#R$9FE7) into HL - Link it in at the
                     ; head of the #R$9FE7 list
 $CD30 LD ($9FE7),IX ; Store IX in SIGNAL tokens (#R$9FE7)
 $CD34 LD (IX-$02),L ; Store L in byte -2 of the record at IX
 $CD37 LD (IX-$01),H ; Store H in byte -1 of the record at IX
 $CD3A LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Node +0
                     ; = who signalled
 $CD3D LD (IX+$00),A ; Store A in the first byte of the record at IX
 $CD40 POP AF        ; Restore AF from the stack - Node +1 = who it is for
 $CD41 LD (IX+$01),A ; Store A in byte +1 of the record at IX
 $CD44 JP $CE8F      ; Succeed

; Plan opcode 9, AWAIT: wait for a token from another actor
;
; Looks along the #R$9FE7 list for a node left by the actor named in the
; argument for this actor. Fails if there is none (scripts give AWAIT a failure
; address pointing at itself, so the actor waits); otherwise unlinks the node,
; frees it and succeeds. Confirmed in the emulator that AWAIT runs (3,909 of
; the 15,038 fetches were AWAITs, mostly Phipps at #R$EE2B waiting for Chief
; Constable Straker); the hand-over itself was not watched.
;
;  Input:IX The instruction (+1 the actor the token must come from)
; Output:The step succeeds if the token was there (and is removed), otherwise
; .          it fails
c$CD47 LD B,(IX+$01) ; B = who the token must come from
 $CD4A LD IX,$9FE9   ; Point IX at sub-script call frames (#R$9FE9) - Walk the
                     ; token list
*$CD4E CALL $A0F7    ; Call the routine "Move IX to the next node of a list"
                     ; (#R$A0F7)
 $CD51 JP Z,$CEB8    ; None left: fail
 $CD54 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Is this
                     ; token for this actor...
 $CD57 CP (IX+$01)   ; Compare A with byte +1 of the record at IX
 $CD5A JR NZ,$CD4E   ; If A differs from byte +1 of the record at IX, go back
                     ; to #R$CD4E
 $CD5C LD A,B        ; Copy B into A - ...and from that actor?
 $CD5D CP (IX+$00)   ; Compare A with the first byte of the record at IX
 $CD60 JR NZ,$CD4E   ; If A differs from the first byte of the record at IX, go
                     ; back to #R$CD4E
 $CD62 PUSH IY       ; Save IY on the stack - Yes: unlink it...
 $CD64 PUSH IX       ; Save IX on the stack
 $CD66 POP DE        ; Restore DE from the stack
 $CD67 LD IY,$9FE7   ; Point IY at SIGNAL tokens (#R$9FE7)
 $CD6B CALL $A104    ; Call the routine "Find the node before node DE in the
                     ; list at IY" (#R$A104)
 $CD6E LD L,(IX-$02) ; Read byte -2 of the record at IX into L
 $CD71 LD H,(IX-$01) ; Read byte -1 of the record at IX into H
 $CD74 LD (IY-$02),L ; Store L in byte -2 of the record at IY
 $CD77 LD (IY-$01),H ; Store H in byte -1 of the record at IY
 $CD7A CALL $A1C7    ; Call the routine "Free node IX back to the heap"
                     ; (#R$A1C7) - ...and free it
 $CD7D POP IY        ; Restore IY from the stack
 $CD7F JP $CE8F      ; Succeed

; Plan opcodes 13 and 15, PASS; and giving up for the turn
;
; #R$CD82: PASS spends one minute (#R$A01A($A01F) = 1) and succeeds. #R$CD8B:
; after ten failures, or a failure address that loops straight back, the actor
; spends a minute and saves its plan registers (#R$D026).
;
; Output:$A01F 1
c$CD82 LD HL,$0001   ; Load HL with $0001 - This takes one minute
 $CD85 LD ($A01F),HL ; Store HL in #R$A01A($A01F) in "Game variables"
 $CD88 JP $CE8F      ; Succeed
; This entry point is used by the routines at #R$CC78 and #R$CEB8.
*$CD8B LD HL,$0001   ; Load HL with $0001 - Give up: one minute
 $CD8E LD ($A01F),HL ; Store HL in #R$A01A($A01F) in "Game variables"
; This entry point is used by the routines at #R$CC78 and #R$CE8F.
*$CD91 CALL $D026    ; Call #R$D026 (inside "Load the current actor's plan
                     ; registers") - Save the plan registers
 $CD94 RET           ; Return to the caller

; Plan opcode 6, PRINT: print a message
;
; The message address follows the opcode. Always succeeds.
;
;  Input:IX The instruction (+1/+2 the message)
; Output:The step succeeds
c$CD95 LD L,(IX+$01) ; Read byte +1 of the record at IX into L - HL = the
                     ; message
 $CD98 LD H,(IX+$02) ; Read byte +2 of the record at IX into H
 $CD9B CALL $A59F    ; Print it
 $CD9E JP $CE8F      ; Succeed

; Plan opcode 5, SAY TO: say something to someone
;
; Pushes the message address, makes the argument the direct object, and prints
; #R$6830 (actor SAYS TO object, then the pushed message in quotes). Always
; succeeds.
;
;  Input:IX The instruction (+1 the person, +2/+3 the message)
; Output:The step succeeds
c$CDA1 LD L,(IX+$02) ; Read byte +2 of the record at IX into L - The message to
                     ; say...
 $CDA4 LD H,(IX+$03) ; Read byte +3 of the record at IX into H
 $CDA7 PUSH HL       ; ...is a parameter for #R$6830
 $CDA8 LD A,(IX+$01) ; Read byte +1 of the record at IX into A - Who is spoken
                     ; to
 $CDAB CALL $CEDE    ; Call the routine "Resolve a plan argument byte"
                     ; (#R$CEDE)
 $CDAE LD ($A034),A  ; Store A in #R$A032($A034) in "Game variables"
 $CDB1 LD A,$07      ; Load A with $07
 $CDB3 LD ($A00F),A  ; Store A in #R$A00A($A00F) in "Game variables"
 $CDB6 LD HL,$6830   ; Point HL at the message "YOU SAY TO THE OIL LAMP" W"
                     ; (#R$6830) - "... SAYS TO ..."
 $CDB9 CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $CDBC JP $CE8F      ; Succeed

; Plan opcode 4, ASK: order another character to do something
;
; Verb #R$DD9E(46) (TALK TO) with the person as the direct object; queues an
; 8-byte node on the list at #R$9FEE (person, $FF, verb, dobj, iobj) and prints
; #R$682A, which quotes the order: the cabbie is told 'HAIL THE HANSOM CAB'
; this way, for example. The person carries the order out on its next turn
; (#R$CCA7). Read from the code; the message was rendered.
; .
; Confirmed in the emulator: with the player moved to Inspector Lestrade at the
; start, his script hails a hansom cab, climbs in, and at 8:04 runs ASK (bytes
; 44 FA 1D FC FF: the person is the plan's remembered thing, here the cabbie;
; verb #R$9AF4(29) GO TO; the plan's indirect object, a room); #R$CE10 then
; prints 'Inspector Lestrade remarks to the cabbie " Go to Kings Cross Road.
; "'. (Rendered with 'you' as the actor, #R$682A reads 'YOU SAY TO ...'.)
;
;  Input:IX The instruction (+1 the person, +2 verb, +3 and +4 objects)
; Output:The order queued at $9FEE; the step succeeds
c$CDBF LD A,$2E        ; Load A with $2E - Verb #R$DD9E(46), TALK TO
 $CDC1 LD ($A033),A    ; Store A in #R$A032($A033) in "Game variables"
 $CDC4 LD A,(IX+$01)   ; Read byte +1 of the record at IX into A - Who is
                       ; ordered
 $CDC7 CALL $CEDE      ; Call the routine "Resolve a plan argument byte"
                       ; (#R$CEDE)
 $CDCA LD ($A034),A    ; Store A in #R$A032($A034) in "Game variables"
 $CDCD LD A,(IX+$02)   ; Read byte +2 of the record at IX into A - The verb
                       ; ordered
 $CDD0 LD ($A35D),A    ; Store A in "A remembered command: verb, direct
                       ; object,..." (#R$A35D)
 $CDD3 LD A,(IX+$03)   ; Read byte +3 of the record at IX into A - Its direct
                       ; object
 $CDD6 CALL $CEDE      ; Call the routine "Resolve a plan argument byte"
                       ; (#R$CEDE)
 $CDD9 LD ($A35E),A    ; Store A in #R$A35E in "A remembered command: verb,
                       ; direct object,..."
 $CDDC LD A,(IX+$04)   ; Read byte +4 of the record at IX into A - Its indirect
                       ; object
 $CDDF CALL $CEDE      ; Call the routine "Resolve a plan argument byte"
                       ; (#R$CEDE)
 $CDE2 LD ($A35F),A    ; Store A in #R$A35F in "A remembered command: verb,
                       ; direct object,..."
 $CDE5 LD A,$08        ; Load A with $08 - Allocate an 8-byte order node
 $CDE7 CALL $A11C      ; Call the routine "Allocate A + 3 bytes from the free
                       ; list, cleared" (#R$A11C)
 $CDEA LD A,($A034)    ; Read #R$A032($A034) in "Game variables" into A - Fill
                       ; it in
 $CDED LD (IX+$00),A   ; Store A in the first byte of the record at IX
 $CDF0 LD (IX+$01),$FF ; Set byte +1 of the record at IX to $FF
 $CDF4 LD A,($A35D)    ; Read "A remembered command: verb, direct object,..."
                       ; (#R$A35D) into A
 $CDF7 LD (IX+$02),A   ; Store A in byte +2 of the record at IX
 $CDFA LD HL,($A35E)   ; Read #R$A35E in "A remembered command: verb, direct
                       ; object,..." into HL
 $CDFD LD (IX+$03),L   ; Store L in byte +3 of the record at IX
 $CE00 LD (IX+$04),H   ; Store H in byte +4 of the record at IX
 $CE03 LD HL,($9FEE)   ; Read orders and remarks (#R$9FEE) into HL - Link it in
                       ; at the head of the #R$9FEE list
 $CE06 LD ($9FEE),IX   ; Store IX in orders and remarks (#R$9FEE)
 $CE0A LD (IX-$02),L   ; Store L in byte -2 of the record at IX
 $CE0D LD (IX-$01),H   ; Store H in byte -1 of the record at IX
 $CE10 LD HL,$682A     ; Point HL at the message "YOU SAY TO THE OIL LAMP" HAIL
                       ; THE HANSOM CAB."." (#R$682A) - Quote the order
 $CE13 CALL $A59F      ; Call the routine "Print the message at HL" (#R$A59F)
 $CE16 JR $CE8F        ; Succeed

; Plan opcodes 1, 2, 3 and 7: DO a command or RUN a record
;
; #R$CE18 (opcode 2): verb, direct and indirect object from the instruction,
; through #R$CEDE, then #R$C4D1 runs the command. #R$CE3B (7) and #R$CE4F (3):
; run the action record named in the instruction directly (#R$C591), with or
; without objects. #R$CE6A (1): a verb alone. In each case carry back from the
; command means a sub-script was called (the script position has already
; moved), Z means it failed and NZ means it succeeded.
;
;  Input:IX The instruction
; Output:The command or record run; the step succeeds, fails or starts a
; .          sub-script
c$CE18 LD A,(IX+$01) ; Read byte +1 of the record at IX into A - The verb
 $CE1B CALL $CEDE    ; Call the routine "Resolve a plan argument byte"
                     ; (#R$CEDE)
 $CE1E LD ($A033),A  ; Store A in #R$A032($A033) in "Game variables"
 $CE21 LD A,(IX+$02) ; Read byte +2 of the record at IX into A - The direct
                     ; object
 $CE24 CALL $CEDE    ; Call the routine "Resolve a plan argument byte"
                     ; (#R$CEDE)
 $CE27 LD ($A034),A  ; Store A in #R$A032($A034) in "Game variables"
 $CE2A LD A,(IX+$03) ; Read byte +3 of the record at IX into A - The indirect
                     ; object
 $CE2D CALL $CEDE    ; Call the routine "Resolve a plan argument byte"
                     ; (#R$CEDE)
 $CE30 LD ($A035),A  ; Store A in #R$A032($A035) in "Game variables"
 $CE33 CALL $C4D1    ; Carry out the command
 $CE36 RET C         ; A sub-script was entered: done
 $CE37 JR Z,$CEB8    ; Refused: the instruction fails
 $CE39 JR $CE8F      ; Done: it succeeds
; This entry point is used by the routine at #R$CC78.
*$CE3B LD A,(IX+$03) ; Read byte +3 of the record at IX into A - RUN with
                     ; objects: the direct object...
 $CE3E CALL $CEDE    ; Call the routine "Resolve a plan argument byte"
                     ; (#R$CEDE)
 $CE41 LD ($A034),A  ; Store A in #R$A032($A034) in "Game variables"
 $CE44 LD A,(IX+$04) ; Read byte +4 of the record at IX into A - ...and the
                     ; indirect object
 $CE47 CALL $CEDE    ; Call the routine "Resolve a plan argument byte"
                     ; (#R$CEDE)
 $CE4A LD ($A035),A  ; Store A in #R$A032($A035) in "Game variables"
 $CE4D JR $CE57      ; Skip ahead to #R$CE57
; This entry point is used by the routine at #R$CC78.
*$CE4F LD A,$FF      ; Load A with $FF - RUN without objects
 $CE51 LD ($A034),A  ; Store A in #R$A032($A034) in "Game variables"
 $CE54 LD ($A035),A  ; Store A in #R$A032($A035) in "Game variables"
*$CE57 LD A,$FF      ; Load A with $FF - No verb
 $CE59 LD ($A033),A  ; Store A in #R$A032($A033) in "Game variables"
 $CE5C LD L,(IX+$01) ; Read byte +1 of the record at IX into L - HL = the
                     ; action record
 $CE5F LD H,(IX+$02) ; Read byte +2 of the record at IX into H
 $CE62 CALL $C591    ; Run it
 $CE65 RET C         ; A sub-script was entered: done
 $CE66 JR Z,$CEB8    ; Refused: fail
 $CE68 JR $CE8F      ; Done: succeed
; This entry point is used by the routine at #R$CC78.
*$CE6A LD A,(IX+$01) ; Read byte +1 of the record at IX into A - DO verb: the
                     ; verb
 $CE6D CALL $CEDE    ; Call the routine "Resolve a plan argument byte"
                     ; (#R$CEDE)
 $CE70 LD ($A033),A  ; Store A in #R$A032($A033) in "Game variables"
 $CE73 LD A,$FF      ; Load A with $FF - No objects
 $CE75 LD ($A034),A  ; Store A in #R$A032($A034) in "Game variables"
 $CE78 LD ($A035),A  ; Store A in #R$A032($A035) in "Game variables"
 $CE7B CALL $C4D1    ; Carry out the command
 $CE7E RET C         ; If the carry flag is set, return
 $CE7F JR Z,$CEB8    ; If the zero flag is set, jump on to the routine "A plan
                     ; instruction failed: move on and try again..." (#R$CEB8)
 $CE81 JR $CE8F      ; Skip ahead to the routine "A plan instruction succeeded:
                     ; move on" (#R$CE8F)

; Point IX and HL at the current plan instruction
;
; IY = the actor's record, HL = IX = the instruction just run (#R$9FD9), A =
; its first byte.
;
; Output:IY The actor's record
;        HL, IX The current instruction
;        A Its first byte
c$CE83 LD IY,($9FDB) ; Read the current actor's (#R$9FDB) into IY - IY = the
                     ; current plan's actor record (#R$9FDB); HL = IX = the
                     ; current plan instruction (#R$9FD9)
 $CE87 LD HL,($9FD9) ; Read the plan instruction (#R$9FD9) into HL
 $CE8A PUSH HL       ; Save HL on the stack
 $CE8B POP IX        ; Restore IX from the stack
 $CE8D LD A,(HL)     ; Read the byte HL points at into A - A = its first byte
 $CE8E RET           ; Return to the caller

; A plan instruction succeeded: move on
;
; Skips the instruction (#R$CF03). With bit 7 set, the script position becomes
; the success address; otherwise, with bit 4 set, the failure address is
; skipped. With bit 5 set the instruction is erased (#R$CF43). Then back to the
; main loop (#R$CD91 saves the plan registers), which ends the actor's turn if
; the action took time.
;
; Output:The script position moved on and the turn ended ($CD91)
c$CE8F CALL $CE83     ; The instruction just run
 $CE92 CALL $CF03     ; Skip it
 $CE95 BIT 7,(IX+$00) ; Test bit 7 of the first byte of the record at IX - Has
                      ; it a success address?
 $CE99 JR Z,$CEA1     ; If bit 7 of the first byte of the record at IX is
                      ; clear, skip ahead to #R$CEA1
 $CE9B LD E,(HL)      ; Read the byte HL points at into E - Yes: go there
 $CE9C INC HL         ; Step HL on to the next byte
 $CE9D LD D,(HL)      ; Read the byte HL points at into D
 $CE9E EX DE,HL       ; Swap DE and HL
 $CE9F JR $CEA8       ; Skip ahead to #R$CEA8
*$CEA1 BIT 4,(IX+$00) ; Test bit 4 of the first byte of the record at IX - No:
                      ; skip any failure address
 $CEA5 CALL NZ,$CF40  ; If bit 4 of the first byte of the record at IX is set,
                      ; call #R$CF40 (inside "Skip past a plan instruction")
*$CEA8 BIT 5,(IX+$00) ; One-shot?
 $CEAC CALL NZ,$CF43  ; Yes: erase it
 $CEAF LD (IY+$01),L  ; Store L in byte +1 of the record at IY - Store the new
                      ; script position
 $CEB2 LD (IY+$02),H  ; Store H in byte +2 of the record at IY
 $CEB5 JP $CD91       ; End the turn

; A plan instruction failed: move on and try again now
;
; Counts the failure (#R$CC0B), skips the instruction and any success address,
; and takes the failure address if bit 4 is set. If that leads straight back to
; the same instruction the actor gives up for this turn (#R$CD8B); otherwise
; the next instruction is tried at once (#R$CC82).
; .
; How it works:
; .
; 1. Count the failure in #R$CC0B.
; .
; 2. Skip the instruction and any success address. If the instruction has a
; failure address (bit 4), go there.
; .
; 3. If the new position is the same instruction, wait there until next turn
; (#R$CD8B); otherwise try the next one now.
;
; Output:The failure counted and the script position moved on
c$CEB8 LD HL,$CC0B    ; Point HL at "Bytes for the actor's turn (#R$CC37)"
                      ; (#R$CC0B) - Count the failure
 $CEBB INC (HL)       ; Add one to the byte at "Bytes for the actor's turn
                      ; (#R$CC37)" (#R$CC0B)
 $CEBC CALL $CE83     ; The instruction just run
 $CEBF CALL $CEFE     ; Skip it and any success address
 $CEC2 BIT 4,(IX+$00) ; Test bit 4 of the first byte of the record at IX - Has
                      ; it a failure address?
 $CEC6 JR Z,$CECC     ; If bit 4 of the first byte of the record at IX is
                      ; clear, skip ahead to #R$CECC
 $CEC8 LD E,(HL)      ; Read the byte HL points at into E - Yes: go there
 $CEC9 INC HL         ; Step HL on to the next byte
 $CECA LD D,(HL)      ; Read the byte HL points at into D
 $CECB EX DE,HL       ; Swap DE and HL
*$CECC LD (IY+$01),L  ; Store L in byte +1 of the record at IY - Store the new
                      ; script position
 $CECF LD (IY+$02),H  ; Store H in byte +2 of the record at IY
 $CED2 PUSH IX        ; Save IX on the stack - Back to the same instruction?
 $CED4 POP DE         ; Restore DE from the stack
 $CED5 AND A          ; Clear the carry flag, so that the subtraction that
                      ; follows is a plain one (a compare)
 $CED6 SBC HL,DE      ; Subtract DE from HL (a compare: carry = HL was smaller,
                      ; zero = equal)
 $CED8 JP Z,$CD8B     ; Then wait there until next turn
 $CEDB JP $CC82       ; Otherwise try the next one now

; Resolve a plan argument byte
;
; Values below $F5, and $FE/$FF, are used as they are. $FA = the plan's verb
; (#R$9FD6), $FB = the actor itself (#R$A032($A036)), $FC = the plan's indirect
; object (#R$9FD8); $FD and the unused $F5-$F9 = the plan's direct object
; (#R$9FD7).
;
;  Input:A An argument byte
; Output:A The value it stands for
c$CEDE CP $F5        ; Compare A with $F5 - An ordinary value?
 $CEE0 RET C         ; If A is below $F5, return
 $CEE1 CP $FE        ; Compare A with $FE - $FE or $FF: also as it is
 $CEE3 RET NC        ; If A is $FE or more, return
 $CEE4 CP $FA        ; Compare A with $FA - $FA: the plan's verb
 $CEE6 JR NZ,$CEEC   ; If A differs from $FA, skip ahead to #R$CEEC
 $CEE8 LD A,($9FD6)  ; Read the plan's verb (#R$9FD6) into A
 $CEEB RET           ; Return to the caller
*$CEEC CP $FB        ; Compare A with $FB - $FB: the actor itself
 $CEEE JR NZ,$CEF4   ; If A differs from $FB, skip ahead to #R$CEF4
 $CEF0 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A
 $CEF3 RET           ; Return to the caller
*$CEF4 CP $FC        ; Compare A with $FC - $FC: the plan's indirect object
 $CEF6 LD A,($9FD8)  ; Read the plan's indirect (#R$9FD8) into A
 $CEF9 RET Z         ; If A equals $FC, return
 $CEFA LD A,($9FD7)  ; Read the plan's direct object (#R$9FD7) into A -
                     ; Otherwise its direct object
 $CEFD RET           ; Return to the caller

; Skip past a plan instruction
;
; #R$CEFE also skips a success address (bit 7 set in A); #R$CF03 skips only the
; opcode and operands: 1 byte for opcodes 10, 11 and 15, 2 for 1, 8, 9 and 13,
; 3 for 3, 6 and 14, 4 for 2 and 5, and 5 for 4, 7 and 12. The INC HL chain at
; #R$CF3D-#R$CF41 is entered at the point that gives the right count.
;
;  Input:A The opcode byte
;        HL The instruction
; Output:HL Past the instruction (CF03 skips the opcode and operands only)
c$CEFE BIT 7,A       ; Bit 7 of the opcode byte: a success address (2 bytes)
                     ; follows...
 $CF00 CALL NZ,$CF40 ; ...skip it (enter the INC HL chain two from the end)
; This entry point is used by the routine at #R$CE8F.
*$CF03 AND $0F       ; The opcode alone
 $CF05 CP $0F        ; Compare A with $0F - Opcode 15: 1 byte
 $CF07 JR Z,$CF41    ; If A equals $0F, jump on to #R$CF41
 $CF09 CP $08        ; Compare A with $08 - Opcodes 8, 9, 1 and 13: 2 bytes
 $CF0B JR Z,$CF40    ; If A equals $08, jump on to #R$CF40
 $CF0D CP $09        ; Compare A with $09
 $CF0F JR Z,$CF40    ; If A equals $09, jump on to #R$CF40
 $CF11 CP $01        ; Compare A with $01
 $CF13 JR Z,$CF40    ; If A equals $01, jump on to #R$CF40
 $CF15 CP $02        ; Compare A with $02
 $CF17 JR Z,$CF3E    ; Opcode 2: 4 bytes
 $CF19 CP $03        ; Compare A with $03 - Opcodes 3 and 14: 3 bytes
 $CF1B JR Z,$CF3F    ; If A equals $03, skip ahead to #R$CF3F
 $CF1D CP $0D        ; Compare A with $0D
 $CF1F JR Z,$CF40    ; If A equals $0D, skip ahead to #R$CF40
 $CF21 CP $0E        ; Compare A with $0E
 $CF23 JR Z,$CF3F    ; If A equals $0E, skip ahead to #R$CF3F
 $CF25 CP $07        ; Compare A with $07 - Opcodes 7 and 12: 5 bytes
 $CF27 JR Z,$CF3D    ; If A equals $07, skip ahead to #R$CF3D
 $CF29 CP $0C        ; Compare A with $0C
 $CF2B JR Z,$CF3D    ; If A equals $0C, skip ahead to #R$CF3D
 $CF2D CP $0B        ; Compare A with $0B - Opcodes 11 and 10: 1 byte
 $CF2F JR Z,$CF41    ; If A equals $0B, skip ahead to #R$CF41
 $CF31 CP $0A        ; Compare A with $0A
 $CF33 JR Z,$CF41    ; If A equals $0A, skip ahead to #R$CF41
 $CF35 CP $05        ; Compare A with $05 - Opcode 5: 4 bytes
 $CF37 JR Z,$CF3E    ; If A equals $05, skip ahead to #R$CF3E
 $CF39 CP $04        ; Compare A with $04 - Opcode 4: 5 bytes; anything else
                     ; (6): 3
 $CF3B JR NZ,$CF3F   ; If A differs from $04, skip ahead to #R$CF3F
*$CF3D INC HL        ; HL is advanced by 5, 4, 3, 2 or 1 depending on where the
                     ; chain is entered
*$CF3E INC HL        ; Four
*$CF3F INC HL        ; Three
; This entry point is used by the routine at #R$CE8F.
*$CF40 INC HL        ; Two
*$CF41 INC HL        ; One
 $CF42 RET           ; Return with HL at the next instruction

; Erase a spent one-shot plan instruction
;
; Overwrites the instruction at IX, including its success and failure
; addresses, with zeros, so the fetch loop skips it from now on. Read from the
; code. Never used: no instruction in any script has bit 5 set, and no script
; byte had changed after 110 turns in the emulator.
;
;  Input:IX A spent one-shot instruction
; Output:The instruction and its addresses overwritten with zeros
c$CF43 LD A,(IX+$00)   ; Read the first byte of the record at IX into A - Bit
                       ; 7: two more bytes (an address) to clear
 $CF46 BIT 7,A         ; Test bit 7 of A
 $CF48 CALL NZ,$CF73   ; If bit 7 of A is set, call #R$CF73 (inside "Erase a
                       ; spent one-shot plan instruction")
 $CF4B BIT 4,A         ; Test bit 4 of A - Bit 4: two more
 $CF4D CALL NZ,$CF73   ; If bit 4 of A is set, call #R$CF73 (inside "Erase a
                       ; spent one-shot plan instruction")
 $CF50 AND $0F         ; Then by the instruction's code (bits 0-3):
 $CF52 CP $01          ; Compare A with $01 - code 1: two bytes in all
 $CF54 JR Z,$CF73      ; If A equals $01, skip ahead to #R$CF73
 $CF56 CP $02          ; Compare A with $02 - codes 2 and 5: four
 $CF58 JR Z,$CF6B      ; If A equals $02, skip ahead to #R$CF6B
 $CF5A CP $05          ; Compare A with $05
 $CF5C JR Z,$CF6B      ; If A equals $05, skip ahead to #R$CF6B
 $CF5E CP $07          ; Compare A with $07 - code 7: five
 $CF60 JR Z,$CF68      ; If A equals $07, skip ahead to #R$CF68
 $CF62 CP $06          ; Compare A with $06 - code 6: three
 $CF64 JR Z,$CF70      ; If A equals $06, skip ahead to #R$CF70
 $CF66 CP $04          ; Compare A with $04 - code 4: five
*$CF68 CALL Z,$CF79    ; If A equals $04, call #R$CF79 (inside "Erase a spent
                       ; one-shot plan instruction")
*$CF6B CALL Z,$CF73    ; If the zero flag is set, call #R$CF73 (inside "Erase a
                       ; spent one-shot plan instruction")
 $CF6E CP $03          ; Compare A with $03 - code 3: three; any other: two
*$CF70 CALL Z,$CF79    ; If A equals $03, call #R$CF79 (inside "Erase a spent
                       ; one-shot plan instruction")
*$CF73 LD (IX+$00),$00 ; Set the first byte of the record at IX to $00 - Clear
                       ; two bytes
 $CF77 INC IX          ; Step IX on to the next byte
*$CF79 LD (IX+$00),$00 ; Set the first byte of the record at IX to $00 - Clear
                       ; one byte
 $CF7D INC IX          ; Step IX on to the next byte
 $CF7F RET             ; Return to the caller

; Save a sub-script call frame
;
; Allocates a 7-byte node on the list at #R$9FE9: +0 the actor, +1/+2 HL (the
; calling instruction), +3/+4 the command's objects
; (#R$A032($A034)/#R$A032($A035)), +5 B, +6 the plan's verb (#R$9FD6). #R$CFB6
; finds the current actor's frame; #R$CFCF returns from the sub-script,
; restoring the script position and freeing the frame, and gives A = frame +5.
; .
; How it works:
; .
; 1. Allocate a seven-byte node from the heap (#R$A11C).
; .
; 2. Fill it in: the actor (#R$A032($A036)); HL, where the script should carry
; on after the sub-script; the command's two objects (#R$A032($A034),
; #R$A032($A035)); B; and the plan's verb (#R$9FD6).
; .
; 3. Link the node in at the head of the list of call frames at #R$9FE9.
; .
; 4. The same block has two more entry points. #R$CFB6 finds the current
; actor's frame by walking the list: NZ with IX at the frame, or Z if there is
; none. #R$CFCF is the return: it finds the frame, sets the actor's script
; position back to the calling instruction, unlinks and frees the frame
; (#R$A1C7), reloads the plan registers (#R$D008) and returns the saved byte in
; A.
;
; Input:HL Where to come back to
;       B A byte to keep (returned in A by $CFCF)
c$CF80 PUSH IX       ; Save IX on the stack
 $CF82 LD A,$07      ; Load A with $07 - Allocate a 7-byte node
 $CF84 CALL $A11C    ; Call the routine "Allocate A + 3 bytes from the free
                     ; list, cleared" (#R$A11C)
 $CF87 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - +0: the
                     ; actor
 $CF8A LD (IX+$00),A ; Store A in the first byte of the record at IX
 $CF8D LD (IX+$01),L ; Store L in byte +1 of the record at IX - +1/+2: where to
                     ; come back to
 $CF90 LD (IX+$02),H ; Store H in byte +2 of the record at IX
 $CF93 LD DE,($A034) ; Read #R$A032($A034) in "Game variables" into DE - +3/+4:
                     ; the objects
 $CF97 LD (IX+$03),E ; Store E in byte +3 of the record at IX
 $CF9A LD (IX+$04),D ; Store D in byte +4 of the record at IX
 $CF9D LD (IX+$05),B ; +5: B
 $CFA0 LD A,($9FD6)  ; Read the plan's verb (#R$9FD6) into A - +6: the plan's
                     ; verb
 $CFA3 LD (IX+$06),A ; Store A in byte +6 of the record at IX
 $CFA6 LD HL,($9FE9) ; Read sub-script call frames (#R$9FE9) into HL - Link it
                     ; in at the head of the list
 $CFA9 LD ($9FE9),IX ; Store IX in sub-script call frames (#R$9FE9)
 $CFAD LD (IX-$02),L ; Store L in byte -2 of the record at IX
 $CFB0 LD (IX-$01),H ; Store H in byte -1 of the record at IX
 $CFB3 POP IX        ; Restore IX from the stack
 $CFB5 RET           ; Return to the caller
; This entry point is used by the routines at #R$9B25, #R$CC78, #R$D008,
; #R$E03A, #R$E3B8, #R$E6E6 and #R$E70E.
*$CFB6 LD A,($A036)  ; Find this actor's call frame: Z if none
; This entry point is used by the routine at #R$E298.
*$CFB9 LD IX,$9FEB   ; Point IX at #R$9FEB in "Game variables" - Walk the
                     ; call-frame list
*$CFBD PUSH AF       ; Save AF on the stack
 $CFBE CALL $A0F7    ; Call the routine "Move IX to the next node of a list"
                     ; (#R$A0F7) - Next frame: Z at the end
 $CFC1 JR Z,$CFCC    ; If the zero flag is set, skip ahead to #R$CFCC
 $CFC3 POP AF        ; Restore AF from the stack
 $CFC4 CP (IX+$00)   ; Compare A with the first byte of the record at IX - This
                     ; actor's?
 $CFC7 JR NZ,$CFBD   ; If A differs from the first byte of the record at IX, go
                     ; back to #R$CFBD
 $CFC9 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Yes: NZ, IX = the frame
 $CFCB RET           ; Return to the caller
*$CFCC POP AF        ; Restore AF from the stack - None: Z
 $CFCD XOR A         ; Set A to zero, which sets the zero flag for the caller
 $CFCE RET           ; Return to the caller
; This entry point is used by the routine at #R$CC78.
*$CFCF CALL $CFB6    ; Return from a sub-script: find the frame
 $CFD2 LD E,(IX+$01) ; Read byte +1 of the record at IX into E - Back to the
                     ; calling instruction
 $CFD5 LD D,(IX+$02) ; Read byte +2 of the record at IX into D
 $CFD8 LD ($9FD9),DE ; The script continues from there
 $CFDC LD (IY+$01),E ; Store E in byte +1 of the record at IY
 $CFDF LD (IY+$02),D ; Store D in byte +2 of the record at IY
 $CFE2 PUSH IX       ; Save IX on the stack - Unlink the frame
 $CFE4 POP DE        ; Restore DE from the stack
 $CFE5 PUSH IY       ; Save IY on the stack
 $CFE7 LD IY,$9FE9   ; Point IY at sub-script call frames (#R$9FE9)
 $CFEB CALL $A104    ; Call the routine "Find the node before node DE in the
                     ; list at IY" (#R$A104)
 $CFEE LD L,(IX-$02) ; Read byte -2 of the record at IX into L - Copy the link
                     ; bytes (IX-2/-1) to IY-2/-1
 $CFF1 LD H,(IX-$01) ; Read byte -1 of the record at IX into H
 $CFF4 LD (IY-$02),L ; Store L in byte -2 of the record at IY
 $CFF7 LD (IY-$01),H ; Store H in byte -1 of the record at IY
 $CFFA LD A,(IX+$05) ; Read byte +5 of the record at IX into A - A = frame +5
                     ; for the caller
 $CFFD PUSH AF       ; Save AF on the stack
 $CFFE CALL $A1C7    ; Free the frame
 $D001 CALL $D008    ; Call the routine "Load the current actor's plan
                     ; registers" (#R$D008) - Reload the plan registers (the
                     ; caller's)
 $D004 POP AF        ; Restore AF from the stack
 $D005 POP IY        ; Restore IY from the stack
 $D007 RET           ; Return to the caller

; Load the current actor's plan registers
;
; IY = the actor's record in the table at #R$9860. Copies the actor's saved
; plan registers into #R$9FD6 (the plan's verb) and #R$9FD7/#R$9FD8 (its direct
; and indirect objects) - from the actor record's +3, +4 and +5, or, when the
; actor is inside a sub-script, from the call frame #R$CFB6 finds (+6, +3 and
; +4). Script arguments $FA, $FD and $FC read these registers (see #R$CEDE).
; #R$D026 is the matching save. Read from the code.
; .
; CORRECTED: this was titled 'Cache/sync an entity record's fields +3/+4/+6
; (get side)' before the plan-script language was found.
;
;  Input:IY The actor's record
; Output:$9FD6 The plan's verb
;        $9FD7 Its objects
c$D008 LD L,(IY+$04) ; Read byte +4 of the record at IY into L - HL = the
                     ; actor's own saved objects
 $D00B LD H,(IY+$05) ; Read byte +5 of the record at IY into H
 $D00E CALL $CFB6    ; Is it inside a sub-script?
 $D011 LD A,(IY+$03) ; A = its own saved verb
 $D014 JR Z,$D01F    ; No: use the actor record's
 $D016 LD L,(IX+$03) ; Read byte +3 of the record at IX into L - Yes: use the
                     ; call frame's objects...
 $D019 LD H,(IX+$04) ; Read byte +4 of the record at IX into H
 $D01C LD A,(IX+$06) ; ...and verb
*$D01F LD ($9FD6),A  ; The plan's verb
 $D022 LD ($9FD7),HL ; Store HL in the plan's direct object (#R$9FD7) - The
                     ; plan's direct and indirect objects
 $D025 RET           ; Return to the caller
; This entry point is used by the routine at #R$CD82.
*$D026 LD HL,($9FD7) ; Save side: the plan's objects
 $D029 CALL $CFB6    ; Inside a sub-script?
 $D02C LD A,($9FD6)  ; Read the plan's verb (#R$9FD6) into A
 $D02F JR Z,$D03B    ; No: save into the actor record
 $D031 LD (IX+$03),L ; Store L in byte +3 of the record at IX - Yes: save into
                     ; the call frame
 $D034 LD (IX+$04),H ; Store H in byte +4 of the record at IX
 $D037 LD (IX+$06),A ; Store A in byte +6 of the record at IX
 $D03A RET           ; Return to the caller
*$D03B LD (IY+$03),A ; Store A in byte +3 of the record at IY - Save into the
                     ; actor record
 $D03E LD (IY+$04),L ; Store L in byte +4 of the record at IY
 $D041 LD (IY+$05),H ; Store H in byte +5 of the record at IY
 $D044 RET           ; Return to the caller

; Note the room the player is in ($A009)
;
; Addresses named in the title: #R$A002($A009).
; .
; Called at the start of every actor's turn (#R$CC5D($CC5E)): the room
; everything shown is judged against.
;
; Output:$A009 The room the player is in
c$D045 LD A,($9860)  ; The player (first actor, #R$9860)...
 $D048 CALL $D495    ; ...its room (#R$D495)...
 $D04B LD ($A009),A  ; Store A in the room the player is in, which decides what
                     ; is shown (#R$A002($A009)) - ...stored as the room the
                     ; player sees (#R$A002($A009))
 $D04E RET           ; Return to the caller

; IX = just before the start of the thing index ($8B6F)
;
; Addresses named in the title: #R$8B6F.
;
; Output:IX One entry before the thing index at $8B6F
c$D04F LD IX,$8B6F   ; IX = the thing index #R$8B6F...
 $D053 DEC IX        ; Step IX back one byte - ...one 3-byte entry back (the
                     ; search step adds three first)
 $D055 DEC IX        ; Step IX back one byte
 $D057 DEC IX        ; Step IX back one byte
 $D059 RET           ; Return to the caller

; How a room is entered in words: 'You are ON Baker Street'
;
; Indexed by bits 1-3 of the room record's first byte (#R$D0DD): OUTSIDE,
; INSIDE, IN, ON, AT, NORTH, SOUTH, EAST. The word is written into the message
; 'YOU ARE IN' at #R$68DD itself (its second word, at #R$68DD($68DE)) before it
; is printed - self-modifying message data. Confirmed in the emulator in
; effect: Baker Street is described 'You are on Baker Street.' CORRECTED: the
; automatic split had this as code.
; .
; Kinds 5-7 are really the start of the next table: the direction words at
; #R$D064 (NORTH, SOUTH, EAST, then WEST to DOWN at #R$D06A), which #R$D5FB
; indexes by direction number. No room uses kinds 0, 1 or 5-7: 65 rooms are IN,
; 32 ON and 9 AT (counted from the room records).
w$D05A DEFW $0624    ; Room kind 0: OUTSIDE
 $D05C DEFW $0466    ; Room kind 1: INSIDE
 $D05E DEFW $0450    ; Room kind 2: IN
 $D060 DEFW $05FF    ; Room kind 3: ON
 $D062 DEFW $009A    ; Room kind 4: AT
 $D064 DEFW $05C3    ; Room kind 5: NORTH
 $D066 DEFW $081A    ; Room kind 6: SOUTH
 $D068 DEFW $0284    ; Room kind 7: EAST

; Direction words, continued: WEST to DOWN
;
; The direction-word table starts at #R$D064, overlapping the last three room
; kinds (NORTH, SOUTH, EAST); #R$D5FB reads entry n-1 for direction n.
; CORRECTED: was 'not identified'.
w$D06A DEFW $0992    ; Direction 4: WEST
 $D06C DEFW $05C7    ; Direction 5: NORTHEAST
 $D06E DEFW $05D0    ; Direction 6: NORTHWEST
 $D070 DEFW $081E    ; Direction 7: SOUTHEAST
 $D072 DEFW $0827    ; Direction 8: SOUTHWEST
 $D074 DEFW $093C    ; Direction 9: UP
 $D076 DEFW $0272    ; Direction 10: DOWN

; Is it too dark for the actor to see? (carry if so)
;
; Only for actors that need light: those with +4 bit 7 in their own record
; (#R$A012($A017)) - the player, the cabs and cabbies, the trains and a few
; others; everyone else sees in the dark. For them it is dark when inside
; something, or when the room's record has bit 7 of its first byte clear
; (outdoors, it seems) and #R$C00C says it is night (8pm to 6am) - unless a
; light is about: a thing that also has +4 bit 7, whose +5 flags masked with
; $5C give $14 (full and on, not a person: the oil lamp starts like this, +5 =
; $94), and that #R$C821 says is here.
; .
; Confirmed in the emulator (tools/experiments/dark_test.py): walking to Baker
; Street and setting the clock to 9pm, LOOK gets 'SORRY IT IS TOO DARK.'
; without the oil lamp and the normal description with it. Moving the player by
; poking memory instead leaves a carried lamp's own room behind and the test
; fails - a harness trap worth knowing.
; .
; How it works:
; .
; 1. Only actors with +4 bit 7 set (the player, and some others) can be in the
; dark.
; .
; 2. Follow the actor's containment chain (#R$C86E). A room with its light bit
; (+0 bit 7) is never dark; nor is anywhere by day (anything but night,
; #R$C00C).
; .
; 3. At night in an unlit room, look through all the things for a light: one
; that is in the actor's reach, alight (+5 passes the test) and shining (+4 bit
; 7). If one is found it is not dark.
; .
; 4. Otherwise return with carry set.
;
;  Input:$A017 The actor's record
; Output:F Carry when it is too dark for the actor to see; NC when not
;        Registers kept
c$D078 PUSH IX        ; Save IX on the stack
 $D07A PUSH IY        ; Save IY on the stack
 $D07C PUSH BC        ; Save BC on the stack
 $D07D LD IX,($A017)  ; Read #R$A012($A017) in "Game variables" into IX - Only
                      ; actors with +4 bit 7 can be in the dark
 $D081 LD A,(IX+$04)  ; Read byte +4 of the record at IX into A
 $D084 AND $80        ; Isolate bit 7 of A (mask $80)
 $D086 JR Z,$D0C6     ; If bit 7 of A was clear, jump on to #R$D0C6
 $D088 CALL $C86E     ; Call the routine "Follow an object's containment chain
                      ; to its root" (#R$C86E) - (#R$C86E, then the room and
                      ; the hour)
 $D08B INC A          ; Add one to A
 $D08C JR NZ,$D09E    ; If A is not zero, skip ahead to #R$D09E
 $D08E CALL $D33C     ; Call the routine "IX = record of the actor's room"
                      ; (#R$D33C) - A lit room (record byte 0 bit 7) is never
                      ; dark
 $D091 BIT 7,(IX+$00) ; Test bit 7 of the first byte of the record at IX
 $D095 JR NZ,$D0C6    ; If bit 7 of the first byte of the record at IX is set,
                      ; jump on to #R$D0C6
 $D097 CALL $C00C     ; Call the routine "What part of the day is it? (A =
                      ; 1-5)" (#R$C00C) - Nor is anywhere by day (#R$C00C: 1
                      ; means night, 8pm to 6am)
 $D09A CP $01         ; Compare A with $01
 $D09C JR NZ,$D0C6    ; If A differs from $01, jump on to #R$D0C6
*$D09E LD IX,$8B6F    ; Point IX at "Entity index: id -> record address"
                      ; (#R$8B6F) - Night, unlit room: look through the things
                      ; for a light
*$D0A2 CALL $D206     ; Call the routine "Step to the next 3-byte entry"
                      ; (#R$D206)
 $D0A5 JR Z,$D0C9     ; If the zero flag is set, skip ahead to #R$D0C9
 $D0A7 LD A,(IY+$00)  ; Read the first byte of the record at IY into A - One
                      ; with n = 1,
 $D0AA CP $01         ; Compare A with $01
 $D0AC JR NZ,$D0A2    ; If A differs from $01, go back to #R$D0A2
 $D0AE LD A,(IY+$05)  ; Read byte +5 of the record at IY into A - +5 & $5C =
                      ; $14 (lit: the oil lamp once lit),
 $D0B1 XOR $B7        ; Flip in A the bits that are set in $B7
 $D0B3 AND $5C        ; Keep only bits 2, 3, 4, 6 of A (mask $5C)
 $D0B5 JR NZ,$D0A2    ; If any of bits 2, 3, 4, 6 of A was set, go back to
                      ; #R$D0A2
 $D0B7 LD A,(IY+$04)  ; Read byte +4 of the record at IY into A - +4 bit 7,
 $D0BA AND $80        ; Isolate bit 7 of A (mask $80)
 $D0BC JR Z,$D0A2     ; If bit 7 of A was clear, go back to #R$D0A2
 $D0BE LD A,(IX+$00)  ; Read the first byte of the record at IX into A - and
                      ; here (#R$C821): not dark after all
 $D0C1 CALL $C821     ; Call the routine "Can the current actor
                      ; (#R$A032($A036)) see thing A?" (#R$C821)
 $D0C4 JR Z,$D0A2     ; If the zero flag is set, go back to #R$D0A2
*$D0C6 AND A          ; Test A for zero (this leaves A as it was and clears
                      ; carry) - NC: the actor can see
 $D0C7 JR $D0CA       ; Skip ahead to #R$D0CA
*$D0C9 SCF            ; Set the carry flag - Carry: too dark
*$D0CA POP BC         ; Restore BC from the stack
 $D0CB POP IY         ; Restore IY from the stack
 $D0CD POP IX         ; Restore IX from the stack
 $D0CF RET            ; Return to the caller

; Put word HL into the 'YOU ARE ...' message
;
; Writes it, as a word token (bit 7 set), at #R$68DD($68DE).
;
;  Input:HL A word reference
; Output:The word written into the YOU ARE message at $68DE
;        DE Kept
c$D0D0 PUSH DE       ; Save DE on the stack - Store word HL, with bit 7 of its
                     ; high byte set, big-endian at #R$68DD($68DE) in the YOU
                     ; ARE message
 $D0D1 LD DE,$68DE   ; Point DE at #R$68DD($68DE) in "Message: "YOU ARE IN""
 $D0D4 EX DE,HL      ; Swap DE and HL
 $D0D5 SET 7,D       ; Set bit 7 of D
 $D0D7 LD (HL),D     ; Store D at the address HL points to
 $D0D8 INC HL        ; Step HL on to the next byte
 $D0D9 LD (HL),E     ; Store E at the address HL points to
 $D0DA POP DE        ; Restore DE from the stack
 $D0DB RET           ; Return to the caller

; Set to use 'YOU CAN SEE' instead of 'YOU ARE ...'
b$D0DC DEFB $00      ; Flag

; Get the room's opening: 'YOU ARE ON/IN/AT ...' or 'YOU CAN SEE'
;
; HL = the message to start the description with; for 'YOU ARE' the preposition
; is chosen from #R$D05A by the room's kind.
;
;  Input:A A room number
; Output:HL The message to start the description with
;        AF Kept
c$D0DD PUSH AF       ; Save AF on the stack - Save A; room record (#R$D224)
 $D0DE CALL $D224    ; Call the routine "Find a room record" (#R$D224)
 $D0E1 LD A,($D0DC)  ; Read "Set to use 'YOU CAN SEE' instead of 'YOU ARE ...'"
                     ; (#R$D0DC) into A - Test the flag at #R$D0DC
 $D0E4 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $D0E5 LD HL,$68E4   ; Point HL at the message "YOU CAN SEE" (#R$68E4)
 $D0E8 JR NZ,$D100   ; If A is not zero, skip ahead to #R$D100
 $D0EA LD A,(IX+$00) ; Read the first byte of the record at IX into A
 $D0ED AND $0E       ; Keep only bits 1, 2, 3 of A (mask $0E)
 $D0EF LD E,A        ; Copy A into E
 $D0F0 LD D,$00      ; Load D with $00
 $D0F2 LD HL,$D05A   ; Point HL at "How a room is entered in words: 'You are ON
                     ; Baker..." (#R$D05A)
 $D0F5 ADD HL,DE     ; Add DE to HL
 $D0F6 LD E,(HL)     ; Read the byte HL points at into E
 $D0F7 INC HL        ; Step HL on to the next byte
 $D0F8 LD D,(HL)     ; Read the byte HL points at into D
 $D0F9 EX DE,HL      ; Swap DE and HL
 $D0FA CALL $D0D0    ; Call the routine "Put word HL into the 'YOU ARE ...'
                     ; message" (#R$D0D0)
 $D0FD LD HL,$68DD   ; Point HL at the message "YOU ARE IN" (#R$68DD)
*$D100 POP AF        ; Restore AF from the stack
 $D101 RET           ; Return to the caller

; Describe room A in full (the first visit)
;
; #R$D0DD, then #R$D113.
;
;  Input:A A room number
; Output:The room described in full; registers kept
c$D102 CALL $D0DD    ; Call the routine "Get the room's opening: 'YOU ARE
                     ; ON/IN/AT ...' or..." (#R$D0DD) - Save the registers
                     ; around the description proper (#R$D113)
 $D105 PUSH IX       ; Save IX on the stack
 $D107 PUSH IY       ; Save IY on the stack
 $D109 PUSH BC       ; Save BC on the stack
 $D10A CALL $D113    ; Call the routine "Describe room A in full" (#R$D113)
 $D10D POP BC        ; Restore BC from the stack
 $D10E POP IY        ; Restore IY from the stack
 $D110 POP IX        ; Restore IX from the stack
 $D112 RET           ; Return to the caller

; Describe room A in full
;
; The picture, if pictures are on and the room has one (#R$A277); 'YOU ARE IN
; <thing>' when the actor is inside something (#R$C863); the room's own text or
; 'YOU ARE ON/IN ... <name>' (#R$D182); the exits (#R$D60B); the things here
; (#R$D68C); the people here (#R$D4A7); end of line. Read from the code; the
; emulator's LOOK output follows this order ('You are on Baker Street. To the
; north there is the front door.').
; .
; .
; .
; Line comments added from reading the code; the order matches what LOOK prints
; in the emulator.
; .
; How it works:
; .
; 1. Draw the room's picture if pictures are on and the room has one (#R$A277).
; .
; 2. If the actor is inside something (a cab, say), print 'YOU ARE IN' and how
; it is held (#R$D5D3) and its name (#R$D3D5).
; .
; 3. Print the room's own description (#R$D182), then list what can be seen.
;
;  Input:A A room number
;        HL The opening message
; Output:The room described, with its picture if shown
c$D113 LD B,A        ; B = the room number
 $D114 CALL $D224    ; Room record into IX (#R$D224)
 $D117 LD A,B        ; Copy B into A - Draw the room's picture if pictures are
                     ; on (#R$A277)
 $D118 CALL $A277    ; Call the routine "Describe a room's picture" (#R$A277)
 $D11B PUSH IX       ; Save IX on the stack - Save the room record, B and HL
 $D11D PUSH BC       ; Save BC on the stack
 $D11E PUSH HL       ; Save HL on the stack
 $D11F LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Is the
                     ; actor inside something (#R$C863)? A' = the container, or
                     ; $FF
 $D122 CALL $C863    ; Call the routine "Is thing number A here? (#R$C86E)"
                     ; (#R$C863)
 $D125 EX AF,AF'     ; Swap AF with the shadow copy
 $D126 CP $FF        ; Compare A with $FF - $FF: not inside anything, skip
 $D128 JR Z,$D167    ; If A equals $FF, jump on to #R$D167
 $D12A PUSH AF       ; Inside something: build 'YOU ARE IN <thing>':
 $D12B LD HL,($68DE) ; Read #R$68DD($68DE) in "Message: "YOU ARE IN"" into HL -
                     ; save the word at #R$68DD($68DE)...
 $D12E PUSH HL       ; Save HL on the stack
 $D12F LD HL,$8000   ; Point HL at #R$7FF9($8000) in "Message: "AS YOU RUN YOUR
                     ; HANDS OVER THE..." - ...put the word for IN
                     ; (#R$7FF9($8000)) into the message (#R$D0D0)...
 $D132 CALL $D0D0    ; Call the routine "Put word HL into the 'YOU ARE ...'
                     ; message" (#R$D0D0)
 $D135 LD HL,$68DD   ; Point HL at the message "YOU ARE IN" (#R$68DD) - ...and
                     ; print #R$68DD
 $D138 CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $D13B POP HL        ; Restore HL from the stack - Put the old word back
 $D13C LD ($68DE),HL ; Store HL in #R$68DD($68DE) in "Message: "YOU ARE IN""
 $D13F POP AF        ; Restore AF from the stack
 $D140 PUSH AF       ; Save AF on the stack
 $D141 CALL $D237    ; Container's record (#R$D237)
 $D144 CALL $D5D3    ; Print how it is held (IN, ON, BEHIND...) (#R$D5D3)
 $D147 CALL $D3D5    ; Call the routine "Print thing IX's name" (#R$D3D5) -
                     ; Print its name (#R$D3D5)
 $D14A POP AF        ; Restore AF from the stack
 $D14B PUSH AF       ; Save AF on the stack
 $D14C CALL $D4CC    ; Call the routine "Count the things in place B that
                     ; should be listed (B)" (#R$D4CC) - Count the other things
                     ; in the container that should be listed (#R$D4CC)
 $D14F AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $D150 JR Z,$D163    ; If A is zero, skip ahead to #R$D163 - None: just end the
                     ; sentence (#R$A414)
 $D152 LD C,A        ; Copy A into C
 $D153 LD DE,$09BF   ; Load DE with $09BF - Some: print the lead-in $09BF
 $D156 CALL $A887    ; Call #R$A887 (inside "Print the dictionary word that HL
                     ; refers to")
 $D159 LD A,($A00A)  ; Read the current actor's room (#R$A00A) into A
 $D15C LD B,A        ; Copy A into B
 $D15D POP AF        ; Restore AF from the stack
 $D15E CALL $D51A    ; Call the routine "List the things in a place, with
                     ; commas and AND" (#R$D51A) - List them with commas and
                     ; AND (#R$D51A)
 $D161 JR $D167      ; Skip ahead to #R$D167
*$D163 CALL $A414    ; Call #R$A414 (inside "Print the rest of a narrated
                     ; command: verb...")
 $D166 POP AF        ; Restore AF from the stack
*$D167 POP DE        ; Restore DE from the stack - Back to the room record
 $D168 POP BC        ; Restore BC from the stack
 $D169 POP IX        ; Restore IX from the stack
 $D16B LD L,(IX+$07) ; Read byte +7 of the record at IX into L - HL = the
                     ; room's own description word
 $D16E LD H,(IX+$08) ; Read byte +8 of the record at IX into H
 $D171 CALL $D182    ; Call the routine "Print a room's description" (#R$D182)
                     ; - Print it, or 'YOU ARE ON/IN ... <name>' if it has none
                     ; (#R$D182)
 $D174 LD A,B        ; Copy B into A
 $D175 CALL $D60B    ; Call the routine "Describe the ways out through things:
                     ; 'TO THE NORTH..." (#R$D60B) - The exits (#R$D60B)
; This entry point is used by the routine at #R$D1B2.
*$D178 LD A,B        ; Copy B into A
 $D179 CALL $D68C    ; The things here (#R$D68C)
 $D17C CALL $D4A7    ; The people here (#R$D4A7)
 $D17F JP $A2A2      ; End the line (#R$A2A2)

; Print a room's description
;
; HL = the room's own description text (+7/+8 of its record); if it has none,
; the opening from #R$D0DD with the room's name (#R$D1C6) and a full stop.
; #R$D1B2 is the brief version for a room already visited, adding 'IT IS TOO
; DARK TO SEE MUCH ELSE.' (#R$68C1) when dark.
;
;  Input:HL The room's own text, or 0
;        DE The opening message
; Output:The description printed
c$D182 LD A,H        ; Copy H into A - The room has its own text: print that
                     ; (#R$A59F)
 $D183 OR L          ; Set in A the bits that are set in L
 $D184 JP NZ,$A59F   ; If the result is not zero, go back to the routine "Print
                     ; the message at HL" (#R$A59F)
; This entry point is used by the routine at #R$D1B2.
*$D187 EX DE,HL      ; Swap DE and HL - Otherwise the opening line (#R$D0DD's
                     ; message at DE)...
 $D188 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A
 $D18B PUSH AF       ; Save AF on the stack
 $D18C LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - ...as
                     ; seen from inside whatever the actor is in (#R$C863): a
                     ; cab, say
 $D18F CALL $C863    ; Call the routine "Is thing number A here? (#R$C86E)"
                     ; (#R$C863)
 $D192 EX AF,AF'     ; Swap AF with the shadow copy
 $D193 INC A         ; Add one to A
 $D194 JR Z,$D19F    ; If A has become zero, skip ahead to #R$D19F
 $D196 DEC A         ; Subtract one from A
 $D197 LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $D19A LD A,$01      ; Load A with $01 - (with THE for its name: #R$A2AA)
 $D19C LD ($A2AA),A  ; Store A in "Use THE: a flag for the article printer
                     ; (#R$A7F2)" (#R$A2AA)
*$D19F CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $D1A2 POP AF        ; Restore AF from the stack - Then the room's name
                     ; (#R$D1C6) and a full stop
 $D1A3 LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $D1A6 XOR A         ; Clear A to zero (and the carry flag)
 $D1A7 LD ($A2AA),A  ; Store A in "Use THE: a flag for the article printer
                     ; (#R$A7F2)" (#R$A2AA)
 $D1AA CALL $D1C6    ; Call the routine "Print room IX's name (its name words
                     ; at +1)" (#R$D1C6)
 $D1AD LD A,$2E      ; Load A with $2E
 $D1AF JP $A9B7      ; Go back to the routine "Print character A, a word at a
                     ; time (word wrap)" (#R$A9B7)

; Describe room A briefly (a room seen before)
;
; Its name line (#R$D0DD, #R$D187) and then, unless it is too dark (#R$D078,
; message #R$68C1), the rest (#R$D178). Read from the code.
;
;  Input:A A room number
; Output:The name line and, if it is not dark, the rest
c$D1B2 LD B,A        ; Keep A in B
 $D1B3 CALL $D0DD    ; (#R$D0DD)
 $D1B6 EX DE,HL      ; Swap DE and HL - (#R$D187)
 $D1B7 CALL $D187    ; Call #R$D187 (inside "Print a room's description")
 $D1BA CALL $D078    ; Call the routine "Is it too dark for the actor to see?
                     ; (carry if so)" (#R$D078) - Too dark to see (#R$D078)? No
                     ; carry: go to #R$D178
 $D1BD JR NC,$D178   ; If the carry flag is clear, go back to #R$D178
 $D1BF LD HL,$68C1   ; Point HL at the message "IT IS TOO DARK TO SEE MUCH
                     ; ELSE." (#R$68C1)
 $D1C2 CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $D1C5 RET           ; Return to the caller

; Print room IX's name (its name words at +1)
;
; With no article (#R$A022($A028) = 0), through #R$D405. Read from the code.
;
;  Input:IX A room's record
; Output:The room's name printed with no article
c$D1C6 LD DE,$0001   ; Load DE with $0001 - IY = the room record + 1 (its name
                     ; words)
 $D1C9 PUSH IY       ; Save IY on the stack
 $D1CB PUSH IX       ; Save IX on the stack
 $D1CD POP IY        ; Restore IY from the stack
 $D1CF ADD IY,DE     ; Add DE to IY
 $D1D1 XOR A         ; Clear A to zero (and the carry flag) - #R$A022($A028) =
                     ; 0
 $D1D2 LD ($A028),A  ; Store A in #R$A022($A028) in "Game variables"
 $D1D5 CALL $D405    ; Call the routine "Print a thing's name with its
                     ; adjectives (IY = its..." (#R$D405) - Print the name
                     ; (#R$D405)
 $D1D8 POP IY        ; Restore IY from the stack
 $D1DA RET           ; Return to the caller

; Jump to HL
;
; A CALL #R$D1DB is a CALL (HL). Read from the code.
;
; Input:HL The address to jump to
c$D1DB JP (HL)       ; Jump to the address in HL

; Does this object list verb A in its own action list?
;
; IX = an entity record, A = a verb number. Skips the record's fixed part (15
; bytes plus the n location bytes, n being byte 0) to reach its own action
; list: two-byte (verb, shared action index) pairs ended by $FF or $00. Returns
; carry set with IX on the matching pair, or carry clear if the verb is not
; listed.
; .
; The end test is a compact trick: INC (IX) leaves zero only if the byte was
; $FF, and a following DEC (IX) restores it and leaves zero only if it was $00
; - so one byte is tested for both terminators without loading it.
; .
; Confirmed by reading all 110 entity records with this layout (objects.py):
; every door lists OPEN->6 and CLOSE->7, both armchairs list CLIMB OUT OF->8,
; CLIMB INTO->9, GET OUT OF->8, GET INTO->9, SIT IN->9, matching the live hits.
;
;  Input:IX An entity record
;        A A verb number
; Output:F Carry set with IX on the verb's pair if listed; carry clear if not
c$D1DC PUSH DE       ; Skip the record's fixed part: 15 + n bytes
 $D1DD LD D,A        ; Keep A in D
 $D1DE LD A,(IX+$00) ; E = the record's size byte + 15
 $D1E1 ADD A,$0F     ; Add $0F to A
 $D1E3 LD E,A        ; Copy A into E
 $D1E4 LD A,D        ; Copy D into A
 $D1E5 LD D,$00      ; D = 0; IX = IX + DE
 $D1E7 ADD IX,DE     ; Add DE to IX
 $D1E9 POP DE        ; Restore DE
*$D1EA CP (IX+$00)   ; Is this pair for our verb?
 $D1ED JR Z,$D1FF    ; Yes: found
 $D1EF INC (IX+$00)  ; Is this byte the $FF terminator?
 $D1F2 JR Z,$D201    ; If the first byte of the record at IX has become zero,
                     ; skip ahead to #R$D201
 $D1F4 DEC (IX+$00)  ; ...or the $00 terminator?
 $D1F7 JR Z,$D204    ; If the first byte of the record at IX has become zero,
                     ; skip ahead to #R$D204
 $D1F9 INC IX        ; Neither: next pair
 $D1FB INC IX        ; Step IX on to the next byte
 $D1FD JR $D1EA      ; Go back to #R$D1EA
*$D1FF SCF           ; Found: carry set, IX on the pair
 $D200 RET           ; Return to the caller
*$D201 DEC (IX+$00)  ; Put the $FF back
*$D204 XOR A         ; Not listed: carry clear
 $D205 RET           ; Return to the caller

; Step to the next 3-byte entry
;
; Moves IX on 3 bytes (one exit) and tests for the $FF that ends a list. Also
; loads IY with the entry's bytes 1-2, which the exit walkers ignore.
;
;  Input:IX An entry
; Output:IX The next entry
;        F Z set at the end ($FF)
c$D206 EXX           ; Swap BC, DE and HL with their shadow copies
 $D207 LD DE,$0003   ; Load DE with $0003, the amount that is added next
 $D20A ADD IX,DE     ; Add DE to IX - Next entry
 $D20C LD D,(IX+$02) ; Read byte +2 of the record at IX into D
 $D20F LD E,(IX+$01) ; Read byte +1 of the record at IX into E
 $D212 PUSH DE       ; Save DE on the stack
 $D213 POP IY        ; Restore IY from the stack
 $D215 LD A,(IX+$00) ; Read the first byte of the record at IX into A - End of
                     ; the list?
 $D218 CP $FF        ; Compare A with $FF
 $D21A EXX           ; Swap BC, DE and HL with their shadow copies
 $D21B RET           ; Return to the caller

; Step to the next thing's record ($D206), keeping A
;
; Addresses named in the title: #R$D206.
;
;  Input:A Kept across the call
; Output:As $D206
c$D21C PUSH BC       ; Save BC on the stack - Keep A in B across the call
                     ; (#R$D206)
 $D21D LD B,A        ; Copy A into B
 $D21E CALL $D206    ; Call the routine "Step to the next 3-byte entry"
                     ; (#R$D206)
 $D221 LD A,B        ; Copy B into A - Restore A
 $D222 POP BC        ; Restore BC from the stack
 $D223 RET           ; Return to the caller

; Find a room record
;
; Looks the room number up in the table at #R$840B.
;
;  Input:A Room number
; Output:IX Address of its record
c$D224 PUSH DE       ; Save DE on the stack
 $D225 LD DE,$840B   ; Point DE at the room table (#R$840B)
 $D228 PUSH HL       ; Save HL on the stack
 $D229 LD L,A        ; Copy A into L - HL = room * 2
 $D22A LD H,$00      ; Load H with $00
 $D22C ADD HL,HL     ; Double HL (shift it left one bit)
 $D22D ADD HL,DE     ; ...+ the table
 $D22E LD E,(HL)     ; Read the byte HL points at into E - Read the record
                     ; address
 $D22F INC HL        ; Step HL on to the next byte
 $D230 LD D,(HL)     ; Read the byte HL points at into D
 $D231 PUSH DE       ; Save DE on the stack - ...into IX
 $D232 POP IX        ; Restore IX from the stack
 $D234 POP HL        ; Restore HL from the stack
 $D235 POP DE        ; Restore DE from the stack
 $D236 RET           ; Return to the caller

; Resolve an id (in A) to its full entity record
;
; Looks the id up in the 3-byte index table at #R$8B6F (via #R$D34E above),
; which gives back a *pointer* to the entity's real, full record - one level of
; indirection past the compact index. Some register-juggling here (push/EX
; (SP),HL/pop) nets IX = that stored pointer on return; it looks unnecessarily
; roundabout on the page, but running it and checking IX directly confirms
; that's exactly what it does.
; .
; Confirmed by calling this routine directly for ids 0-3 and dumping the
; records it resolves to: all four are 17 bytes long and laid out back-to-back
; in memory (0x8CBA, 0x8CCB, 0x8CDC, 0x8CED), all starting with the same tag
; byte ($01) that #R$D495 (below) checks for. See source/world_model_notes.md
; for the full record dumps and what's confirmed about their fields.
;
;  Input:A A thing number
; Output:IX The thing's record
c$D237 LD IX,$8B6F   ; The thing index at #R$8B6F: three-byte entries (id,
                     ; record address)
 $D23B CALL $D34E    ; Find id A in it (#R$D34E)
 $D23E PUSH HL       ; Save HL on the stack - IX = that entry's record address
                     ; (+1/+2)
 $D23F LD L,(IX+$01) ; Read byte +1 of the record at IX into L
 $D242 LD H,(IX+$02) ; Read byte +2 of the record at IX into H
 $D245 EX (SP),HL    ; Swap HL with the word on top of the stack
 $D246 POP IX        ; Restore IX from the stack
 $D248 RET           ; Return to the caller

; Move everything inside thing A, at any depth, to room B
;
; Walks the things (#R$D04F, #R$D21C) and, for each one whose container (+1) is
; A, sets its room (+15) to B and does the same for what it holds (calling
; itself). This is what keeps carried things with their carrier when the game
; moves someone - and what the harness skips when it pokes the player's room
; directly (see harness_notes.md). Callers: #R$DD2F($DD30), #R$DF1E($DF1F).
; Read from the code.
;
; Input:A the container
;       B the room
c$D249 PUSH IY       ; Save IY on the stack
 $D24B PUSH IX       ; Save IX on the stack
 $D24D CALL $D04F    ; Start at the first thing
*$D250 CALL $D21C    ; Call the routine "Step to the next thing's record
                     ; (#R$D206), keeping A" (#R$D21C) - Next thing (IX its
                     ; list entry, IY its record); Z at the end
 $D253 JR Z,$D267    ; If the zero flag is set, skip ahead to #R$D267
 $D255 CP (IY+$01)   ; Compare A with the holder byte (+1) of the thing record
                     ; at IY - Held by A?
 $D258 JR NZ,$D250   ; If A differs from the holder byte (+1) of the thing
                     ; record at IY, go back to #R$D250
 $D25A LD (IY+$0F),B ; Store B in the rooms byte (+15) of the thing record at
                     ; IY - Yes: it goes to room B
 $D25D PUSH AF       ; Save AF on the stack
 $D25E LD A,(IX+$00) ; Read the number byte (+0) of the thing record at IX into
                     ; A - and so does everything it holds
 $D261 CALL $D249    ; Call the routine "Move everything inside thing A, at any
                     ; depth, to room..." (#R$D249)
 $D264 POP AF        ; Restore AF from the stack
 $D265 JR $D250      ; Go back to #R$D250
*$D267 POP IX        ; Restore IX from the stack
 $D269 POP IY        ; Restore IY from the stack
 $D26B RET           ; Return to the caller

; Is the direct object carried by the actor? (carry = yes)
;
; #R$D275 for the thing in #R$A032($A034). Read from the code.
;
;  Input:$A034 The direct object
; Output:F Carry set if the actor carries it
c$D26C PUSH HL       ; Save HL on the stack - Save HL; the direct object
                     ; (#R$A032($A034))...
 $D26D LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A
 $D270 CALL $D275    ; Call the routine "Is thing A carried by the actor,
                     ; perhaps inside..." (#R$D275) - ...into the routine at
                     ; #R$D275
 $D273 POP HL        ; Restore HL from the stack
 $D274 RET           ; Return to the caller

; Is thing A carried by the actor, perhaps inside something? (carry = yes)
;
; Follows thing A's container (+1) upwards (#R$D288, through #R$D237) until it
; reaches the actor in #R$A032($A036) (carry set) or something not held by
; anything ($FF: carry clear). A = $FF or $FE (no thing, a number) also gives
; carry. Read from the code.
;
;  Input:A the thing
; Output:F carry if the actor has it
c$D275 LD HL,$A036   ; HL points at the actor
; This entry point is used by the routines at #R$D4EF, #R$DC8D and #R$E40A.
*$D278 CP $FF        ; Compare A with $FF - No thing ($FF) or a number ($FE):
                     ; carry
 $D27A SCF           ; Set the carry flag for the caller
 $D27B RET Z         ; If the zero flag is set, return
 $D27C CP $FE        ; Compare A with $FE
 $D27E SCF           ; Set the carry flag for the caller
 $D27F RET Z         ; If the zero flag is set, return
 $D280 PUSH IX       ; Save IX on the stack
 $D282 CALL $D288    ; Call #R$D288 (inside "Is thing A carried by the actor,
                     ; perhaps...")
 $D285 POP IX        ; Restore IX from the stack
 $D287 RET           ; Return to the caller
*$D288 CALL $D237    ; Call the routine "Resolve an id (in A) to its full
                     ; entity record" (#R$D237) - Find thing A's record
 $D28B PUSH AF       ; Save AF on the stack
 $D28C LD A,(IX+$01) ; Read the holder byte (+1) of the thing record at IX into
                     ; A - Its container; $FF = held by nothing: not carried
                     ; (NC)
 $D28F CP $FF        ; Compare A with $FF
 $D291 JR Z,$D29A    ; If A equals $FF, skip ahead to #R$D29A
 $D293 POP IX        ; Restore IX from the stack - Is the container the actor?
                     ; If not, go up a level
 $D295 CP (HL)       ; Compare A with the byte HL points at
 $D296 JR NZ,$D288   ; If A differs from the byte HL points at, go back to
                     ; #R$D288
 $D298 SCF           ; Set the carry flag for the caller - Carry: the actor has
                     ; it
 $D299 RET           ; Return to the caller
*$D29A POP AF        ; Restore AF from the stack
 $D29B AND A         ; Clear the carry flag for the caller (A is unchanged)
 $D29C RET           ; Return to the caller

; A random number from 1 to 100
;
; #R$D2A4 with A = 99 (0 to 99), plus one: a percentage roll. Seven callers
; (#R$BA92($BA93), #R$BA9D($BA9E), #R$BB1D($BB1E), #R$E686($E687), ...). Read
; from the code.
;
; Output:A 1-100
c$D29D LD A,$63      ; Load A with $63 - Random number 0 to 99 (#R$D2A4)...
 $D29F CALL $D2A4    ; Call the routine "A random number from 0 to A" (#R$D2A4)
 $D2A2 INC A         ; Add one to A - ...plus one: 1 to 100
 $D2A3 RET           ; Return to the caller

; A random number from 0 to A
;
; The size of #R$D2AD's result (it can be negative): |x - A|, where x is a
; pseudo-random byte halved until it is no more than 2A. So 0 to A inclusive,
; not 'below A'. Read from the code.
;
;  Input:A The limit
; Output:A A random number from 0 to the limit
c$D2A4 CALL $D2AD    ; Call the routine "The random number generator" (#R$D2AD)
 $D2A7 BIT 7,A       ; Test bit 7 of A - Make it positive
 $D2A9 RET Z         ; If bit 7 of A is clear, return
 $D2AA NEG           ; Negate A
 $D2AC RET           ; Return to the caller

; The random number generator
;
; Steps a pointer (#R$A032($A039)) through memory and mixes the byte it finds
; with #R$A032($A037). Used for chances, countdowns and greeting delays. Read
; from the code.
; .
; How it works:
; .
; 1. Set the limit C to A and work out B, twice the limit (255 if that
; overflows).
; .
; 2. Step the pointer at #R$A032($A039) on through memory and fetch the byte it
; points at.
; .
; 3. Mix that byte, and the byte after it, into the last result at
; #R$A032($A037). If the answer equals the last result, step on and try again,
; so the same number never comes up twice running.
; .
; 4. Halve the answer until it is no larger than B, then subtract C. The result
; is a signed number from -C to +C.
;
;  Input:A The limit
; Output:A A pseudo-random number from -limit to +limit (as a signed byte)
c$D2AD PUSH IX        ; Save IX on the stack
 $D2AF PUSH BC        ; Save BC on the stack
 $D2B0 LD C,A         ; Copy A into C - C = the limit; B = twice it (255 if
                      ; that overflows)
 $D2B1 SLA A          ; Shift A left (double it)
 $D2B3 JR NC,$D2B7    ; If the carry flag is clear, skip ahead to #R$D2B7
 $D2B5 LD A,$FF       ; Load A with $FF
*$D2B7 LD B,A         ; Copy A into B
*$D2B8 LD IX,$A039    ; Point IX at #R$A032($A039) in "Game variables" - Step
                      ; the pointer at #R$A032($A039) on through memory
 $D2BC INC (IX+$01)   ; Add one to byte +1 of the record at IX
 $D2BF JR NZ,$D2C4    ; If byte +1 of the record at IX is not zero, skip ahead
                      ; to #R$D2C4
 $D2C1 INC (IX+$00)   ; Add one to the first byte of the record at IX
*$D2C4 LD IX,($A039)  ; Read #R$A032($A039) in "Game variables" into IX
 $D2C8 LD A,($A037)   ; Read #R$A032($A037) in "Game variables" into A - Mix
                      ; the bytes it points at into the last result
                      ; (#R$A032($A037))
 $D2CB ADC A,(IX+$00) ; Add (IX+$00) and the carry to A
 $D2CE ADD IX,DE      ; Add DE to IX
 $D2D0 XOR (IX+$01)   ; Flip in A the bits that are set in byte +1 of the
                      ; record at IX
 $D2D3 PUSH HL        ; Save HL on the stack
 $D2D4 LD HL,$A037    ; Point HL at #R$A032($A037) in "Game variables"
 $D2D7 CP (HL)        ; Compare A with the byte at #R$A032($A037) in "Game
                      ; variables" - Never the same number twice running
 $D2D8 POP HL         ; Restore HL from the stack
 $D2D9 JR Z,$D2B8     ; If the zero flag is set, go back to #R$D2B8
 $D2DB LD ($A037),A   ; Store A in #R$A032($A037) in "Game variables"
*$D2DE CP B           ; Compare A with B - Halve it until it is no more than B
 $D2DF JR C,$D2E8     ; If A is below B, skip ahead to #R$D2E8
 $D2E1 JR Z,$D2E8     ; If A equals B, skip ahead to #R$D2E8
 $D2E3 SRL A          ; Shift A right (halve it)
 $D2E5 JP $D2DE       ; Go back to #R$D2DE
*$D2E8 SUB C          ; Subtract C from A - minus C
 $D2E9 POP BC         ; Restore BC from the stack
 $D2EA POP IX         ; Restore IX from the stack
 $D2EC RET            ; Return to the caller

; Total size (+2) of the things directly in thing A
;
; #R$D305 with B = 1: adds the size byte (+2) of every thing whose container
; (+1) is A; C = $FF if it goes over 127. The fit check at #R$DEE4 compares
; this with the container's capacity (#R$DEF7($DEF8)). Read from the code.
;
;  Input:A the container
; Output:A the total
c$D2ED PUSH BC       ; Save BC on the stack
 $D2EE LD B,$01      ; Load B with $01
 $D2F0 JR $D2F5      ; Skip ahead to #R$D2F5

; Total weight (+3) of everything in thing A, at any depth
;
; #R$D305 with B = 0: adds the +3 byte of every thing inside A, and of what is
; inside those; $FF if it goes over 127. Used by #R$C8C6 (can the actor carry
; it as well as what it holds?) at #R$C8CD($C8CE) and #R$C8DE($C8DF). Read from
; the code.
;
;  Input:A the container
; Output:A the total
c$D2F2 PUSH BC       ; Save BC on the stack
 $D2F3 LD B,$00      ; Load B with $00 - B = 0; C = 0, the running total
; This entry point is used by the routine at #R$D2ED.
*$D2F5 PUSH IX       ; Save IX on the stack
 $D2F7 PUSH IY       ; Save IY on the stack
 $D2F9 LD C,$00      ; Load C with $00
 $D2FB CALL $D305    ; Add up everything in thing A, to any depth (#R$D305)
 $D2FE LD A,C        ; Copy C into A - Return the total in A
 $D2FF POP IY        ; Restore IY from the stack
 $D301 POP IX        ; Restore IX from the stack
 $D303 POP BC        ; Restore BC from the stack
 $D304 RET           ; Return to the caller

; Add up a byte of the things in thing A (the work of $D2ED/$D2F2)
;
; Addresses named in the title: #R$D2ED, #R$D2F2.
; .
; Walks the things from #R$8B6F (#R$D21C); B selects +2 (and no recursion) or
; +3 (and recursion into each thing's own contents). Read from the code.
;
;  Input:A A thing
;        B 0 for weights (all the way down); non-zero for sizes (one level)
;        C The running total
; Output:C The total, $FF if it overflows
c$D305 PUSH IX        ; Save IX on the stack
 $D307 LD IX,$8B6F    ; Start at the first thing
*$D30B CALL $D21C     ; Call the routine "Step to the next thing's record
                      ; (#R$D206), keeping A" (#R$D21C) - Next thing; Z at the
                      ; end
 $D30E JR Z,$D334     ; If the zero flag is set, skip ahead to #R$D334
 $D310 CP (IY+$01)    ; Compare A with the holder byte (+1) of the thing record
                      ; at IY - Is it in A?
 $D313 JR NZ,$D30B    ; If A differs from the holder byte (+1) of the thing
                      ; record at IY, go back to #R$D30B
 $D315 PUSH AF        ; Save AF on the stack
 $D316 SUB A          ; Clear A to zero - B = 0: weights (+3), all the way
                      ; down; B <> 0: sizes (+2), this level only
 $D317 CP B           ; Compare A with B
 $D318 LD A,C         ; Copy C into A
 $D319 JR Z,$D324     ; If A equals B, skip ahead to #R$D324
 $D31B ADD A,(IY+$02) ; Add the size byte (+2) of the thing record at IY to A -
                      ; Add its size; over 127 gives $FF
 $D31E JP PE,$D337    ; If the parity/overflow flag is set, skip ahead to
                      ; #R$D337
 $D321 LD C,A         ; Copy A into C
 $D322 JR $D331       ; Skip ahead to #R$D331
*$D324 ADD A,(IY+$03) ; Add the weight byte (+3) of the thing record at IY to A
                      ; - Add its weight; over 127 gives $FF
 $D327 JP PE,$D337    ; If the parity/overflow flag is set, skip ahead to
                      ; #R$D337
 $D32A LD C,A         ; Copy A into C
 $D32B LD A,(IX+$00)  ; Read the number byte (+0) of the thing record at IX
                      ; into A - and the weight of what it holds
 $D32E CALL $D305     ; Call the routine "Add up a byte of the things in thing
                      ; A (the work of..." (#R$D305)
*$D331 POP AF         ; Restore AF from the stack
 $D332 JR $D30B       ; Go back to #R$D30B
*$D334 POP IX         ; Restore IX from the stack
 $D336 RET            ; Return to the caller
*$D337 POP AF         ; Restore AF from the stack - Overflow: C = $FF
 $D338 LD C,$FF       ; Load C with $FF
 $D33A JR $D334       ; Go back to #R$D334

; IX = record of the actor's room
;
; The actor's record is at #R$A012($A017); its location byte (+$0F) is the
; room, looked up by #R$D224.
;
; Output:IX Room record
c$D33C PUSH AF       ; Save AF on the stack
 $D33D LD IX,($A017) ; The current actor
 $D341 LD A,(IX+$0F) ; Its room
 $D344 CALL $D224    ; Call the routine "Find a room record" (#R$D224)
 $D347 POP AF        ; Restore AF from the stack
 $D348 RET           ; Return to the caller

; Search a table of two-byte entries for A
;
; As #R$D34E (three-byte entries) with an entry size of 2.
;
;  Input:IX A table of two-byte entries
;        A The id
; Output:IX The entry found
;        F Z if found; NZ if the $FF end marker was reached
c$D349 EXX           ; Swap BC, DE and HL with their shadow copies
 $D34A LD E,$02      ; Load E with $02
 $D34C JR $D351      ; Skip ahead to #R$D351

; Find a 3-byte record by id, in a sentinel-terminated table
;
; Same shape as #R$CC0E's actor-table search, but for 3-byte records (1 id byte
; + a 16-bit value) instead of 8-byte ones: given a base in IX and an id in A
; (via B), walks the table until a record's id matches (found) or reads $FF
; (end of table). Uses the shadow register set (EXX) internally so it doesn't
; disturb the caller's own BC/DE/HL while searching.
;
;  Input:IX A table of three-byte entries
;        A The id
; Output:IX The entry found
;        A The id, or $FF at the end marker
;        F Z if found
c$D34E EXX           ; Switch to the shadow registers to work in
 $D34F LD E,$03      ; Record size is 3 bytes
; This entry point is used by the routine at #R$D349.
*$D351 PUSH IX       ; HL -> the table base the caller passed in IX
 $D353 POP HL        ; Restore HL from the stack
 $D354 LD B,A        ; B = the id we are looking for
 $D355 LD D,$00      ; Load D with $00
*$D357 LD A,(HL)     ; This record's id byte...
 $D358 CP B          ; ...does it match?
 $D359 JR Z,$D363    ; If A equals B, skip ahead to #R$D363
 $D35B CP $FF        ; ...or is it the end-of-table sentinel?
 $D35D JR Z,$D363    ; If A equals $FF, skip ahead to #R$D363
 $D35F ADD HL,DE     ; Neither: move to the next 3-byte record
 $D360 JP $D357      ; Go back to #R$D357
*$D363 PUSH HL       ; Found (or ran off the end): IX -> this record
 $D364 POP IX        ; Restore IX from the stack
 $D366 CP $FF        ; Set Z if we actually found it (vs. hit the sentinel)
 $D368 EXX           ; Back to the normal registers
 $D369 RET           ; Return to the caller

; Find the next thing that matches a word slot of the parse
;
; HL = the slot (#R$B16D($B172) or #R$B175($B178)); matches names through
; #R$A4E0. Read from the code.
; .
; How it works:
; .
; 1. Take the next thing from the index (#R$D206); when there are none left,
; return $FF.
; .
; 2. See whether the slot's words name it (#R$A4E0 against its name words at
; +7); if not, take the next.
; .
; 3. With #R$A032($A038) set any match will do; otherwise it must also be
; visible to the actor (#R$C821).
;
;  Input:HL A word slot of the parse
;        IX The last thing found
; Output:A The next matching thing, $FF if none
;        IX Its list entry
c$D36A PUSH BC       ; Save BC on the stack
 $D36B PUSH DE       ; Save DE on the stack
 $D36C PUSH IY       ; Save IY on the stack
*$D36E CALL $D206    ; Call the routine "Step to the next 3-byte entry"
                     ; (#R$D206) - Next thing (#R$D206: IX its list entry, IY
                     ; its record); none left: A = $FF
 $D371 JR Z,$D393    ; If the zero flag is set, skip ahead to #R$D393
 $D373 LD BC,$0007   ; Load BC with $0007 - Do the slot's words name it? (its
                     ; name words at +7, #R$A4E0)
 $D376 PUSH IY       ; Save IY on the stack
 $D378 ADD IY,BC     ; Add BC to IY
 $D37A CALL $A4E0    ; Call #R$A4E0 (inside "Do the pattern words at IY name
                     ; the words...")
 $D37D POP IY        ; Restore IY from the stack
 $D37F JR NZ,$D36E   ; If the zero flag is clear, go back to #R$D36E
 $D381 LD A,($A038)  ; Read #R$A032($A038) in "Game variables" into A - With
                     ; #R$A032($A038) set any match will do;
 $D384 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $D385 JR NZ,$D393   ; If A is not zero, skip ahead to #R$D393
 $D387 LD A,(IX+$00) ; Read the first byte of the record at IX into A -
                     ; otherwise it must also be here (#R$C821)
 $D38A PUSH IX       ; Save IX on the stack
 $D38C CALL $C821    ; Call the routine "Can the current actor (#R$A032($A036))
                     ; see thing A?" (#R$C821)
 $D38F POP IX        ; Restore IX from the stack
 $D391 JR Z,$D36E    ; If the zero flag is set, go back to #R$D36E
*$D393 LD A,(IX+$00) ; Read the first byte of the record at IX into A - A = the
                     ; thing
 $D396 POP IY        ; Restore IY from the stack
 $D398 POP DE        ; Restore DE from the stack
 $D399 POP BC        ; Restore BC from the stack
 $D39A RET           ; Return to the caller

; Find the next room that matches a word slot of the parse
;
; The room counterpart of #R$D36A: B counts on through the rooms (up to 105,
; then A = $FF for none), each room's record (#R$D224) has its name words
; matched against the slot (#R$A4E0), and - unless #R$A032($A038) is set - only
; rooms that pass #R$D471 count. Returns the room in A and IX. Its address is
; handed to the parser's search at #R$B4E7($B4E9) and #R$B58E($B590) (LD
; IY,#R$D39B), as #R$D36A's is for things. CORRECTED: the automatic split had
; it as data and text. Read from the code.
;
;  Input:HL A word slot of the parse
;        IX The search position (a room number in B)
; Output:A The next matching room, $FF if none
;        IX The search position
c$D39B PUSH IY       ; Save IY on the stack - BC = where the last search
                     ; stopped (a room number in B)
 $D39D PUSH DE       ; Save DE on the stack
 $D39E PUSH BC       ; Save BC on the stack
 $D39F PUSH IX       ; Save IX on the stack
 $D3A1 POP BC        ; Restore BC from the stack
 $D3A2 LD DE,$0001   ; Load DE with $0001
*$D3A5 INC B         ; Add one to B - Next room
 $D3A6 LD A,B        ; Copy B into A
 $D3A7 CP $6A        ; Compare A with $6A - $6A rooms: the end (A = $FF)
 $D3A9 LD A,$FF      ; Load A with $FF
 $D3AB JR Z,$D3CD    ; If A equals $6A, skip ahead to #R$D3CD
 $D3AD LD A,B        ; Copy B into A
 $D3AE CALL $D224    ; Call the routine "Find a room record" (#R$D224) - That
                     ; room's record (#R$D224)...
 $D3B1 PUSH IX       ; Save IX on the stack
 $D3B3 POP IY        ; Restore IY from the stack
 $D3B5 ADD IY,DE     ; Add DE to IY - ...and its words (+1): do they name the
                     ; slot's words? (#R$A4E0)
 $D3B7 CALL $A4E0    ; Call #R$A4E0 (inside "Do the pattern words at IY name
                     ; the words...")
 $D3BA JR NZ,$D3A5   ; If the zero flag is clear, go back to #R$D3A5
 $D3BC LD A,($A038)  ; Read #R$A032($A038) in "Game variables" into A - A
                     ; match: if the room need not be next door
                     ; (#R$A032($A038)), take it
 $D3BF AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $D3C0 JR NZ,$D3CC   ; If A is not zero, skip ahead to #R$D3CC
 $D3C2 PUSH BC       ; Save BC on the stack - Otherwise only if it is next to
                     ; the actor's room (#R$D471)
 $D3C3 LD A,B        ; Copy B into A
 $D3C4 CALL $D471    ; Call #R$D471 (inside "Find the exit from the actor's
                     ; room through...")
 $D3C7 POP BC        ; Restore BC from the stack
 $D3C8 CP $FF        ; Compare A with $FF
 $D3CA JR Z,$D3A5    ; If A equals $FF, go back to #R$D3A5
*$D3CC LD A,B        ; Copy B into A - Return it in A, and the search position
                     ; in IX
*$D3CD PUSH BC       ; Save BC on the stack
 $D3CE POP IX        ; Restore IX from the stack
 $D3D0 POP BC        ; Restore BC from the stack
 $D3D1 POP DE        ; Restore DE from the stack
 $D3D2 POP IY        ; Restore IY from the stack
 $D3D4 RET           ; Return to the caller

; Print thing IX's name
;
; IY = IX + 7, its name words, then #R$D3E8. Callers: #R$D147($D148),
; #R$D5B7($D5B8), #R$D658($D659), #R$DF76($DF77). Read from the code.
;
;  Input:IX A thing's record
; Output:The thing's name printed; IY kept
c$D3D5 PUSH IX       ; Save IX on the stack - IY = the thing's record + 7: its
                     ; name words
 $D3D7 POP IY        ; Restore IY from the stack
; This entry point is used by the routine at #R$D526.
*$D3D9 PUSH IY       ; Save IY on the stack
 $D3DB PUSH DE       ; Save DE on the stack
 $D3DC LD DE,$0007   ; Load DE with $0007, the amount that is added next
 $D3DF ADD IY,DE     ; Add DE to IY
 $D3E1 CALL $D3E8    ; Call the routine "Print the name words at IY" (#R$D3E8)
                     ; - Print them (#R$D3E8)
 $D3E4 POP DE        ; Restore DE from the stack
 $D3E5 POP IY        ; Restore IY from the stack
 $D3E7 RET           ; Return to the caller

; Print the name words at IY
;
; Checks for YOU (#R$A7D0) and, by the record's flag bits just before IY, joins
; #R$D405's printing with or without its adjectives. Used by the message code
; that names things (#R$A7C5) and by the statement printer #R$BF1C. Read from
; the code.
;
;  Input:IY A thing's name words
; Output:The name printed; A and DE kept
c$D3E8 PUSH AF        ; Save AF on the stack - Save A and DE
 $D3E9 PUSH DE        ; Save DE on the stack
 $D3EA LD D,(IY+$01)  ; Read byte +1 of the record at IY into D - DE = the
                      ; first name word at IY
 $D3ED LD E,(IY+$00)  ; Read the first byte of the record at IY into E
 $D3F0 CALL $A7D0     ; Print it (#R$A7D0)
 $D3F3 BIT 6,(IY-$02) ; Test bit 6 of byte -2 of the record at IY - Flag in
                      ; IY-2 bit 6 clear: reset #R$A7EA
 $D3F7 JR NZ,$D3FD    ; If bit 6 of byte -2 of the record at IY is set, skip
                      ; ahead to #R$D3FD
 $D3F9 XOR A          ; Clear A to zero (and the carry flag)
 $D3FA LD ($A7EA),A   ; Store A in "#R$A7D0: set when the word was not YOU"
                      ; (#R$A7EA)
*$D3FD BIT 5,(IY-$01) ; Test bit 5 of byte -1 of the record at IY - Flag in
                      ; IY-1 bit 5 set: continue at #R$D427, otherwise at
                      ; #R$D416
 $D401 JR NZ,$D427    ; If bit 5 of byte -1 of the record at IY is set, skip
                      ; ahead to #R$D427
 $D403 JR $D416       ; Skip ahead to #R$D416

; Print a thing's name with its adjectives (IY = its name words)
;
; Used by the routines at #R$A7BA and #R$D1C6.
;
;  Input:IY A thing's name words
; Output:The name printed with its adjectives; A and DE kept
c$D405 PUSH AF        ; Save AF on the stack
 $D406 PUSH DE        ; Save DE on the stack
 $D407 LD D,(IY+$01)  ; Read byte +1 of the record at IY into D - The noun
                      ; (+0/+1): an article first, or note it is YOU (#R$A7D0)
 $D40A LD E,(IY+$00)  ; Read the first byte of the record at IY into E
 $D40D CALL $A7D0     ; Call the routine "Print an article, or note whether the
                      ; word is YOU" (#R$A7D0)
 $D410 LD A,($A028)   ; Read #R$A022($A028) in "Game variables" into A -
                      ; #R$A022($A028) set: the noun alone
 $D413 AND A          ; Test A for zero (this leaves A as it was and clears
                      ; carry)
 $D414 JR NZ,$D438    ; If A is not zero, skip ahead to #R$D438
; This entry point is used by the routine at #R$D3E8.
*$D416 LD E,(IY+$02)  ; Read byte +2 of the record at IY into E - First
                      ; adjective (+2/+3), unless bit 7 marks it as not to be
                      ; printed
 $D419 LD D,(IY+$03)  ; Read byte +3 of the record at IY into D
 $D41C RES 7,D        ; Clear bit 7 of D
 $D41E BIT 7,(IY+$03) ; Test bit 7 of byte +3 of the record at IY
 $D422 LD A,$40       ; Load A with $40
 $D424 CALL Z,$A815   ; If bit 7 of byte +3 of the record at IY is clear, call
                      ; #R$A815 (inside "Print word reference DE (code $04's
                      ; printer)")
; This entry point is used by the routine at #R$D3E8.
*$D427 LD E,(IY+$04)  ; Read byte +4 of the record at IY into E - Second
                      ; adjective (+4/+5), likewise
 $D42A LD D,(IY+$05)  ; Read byte +5 of the record at IY into D
 $D42D RES 7,D        ; Clear bit 7 of D
 $D42F BIT 7,(IY+$05) ; Test bit 7 of byte +5 of the record at IY
 $D433 LD A,$40       ; Load A with $40
 $D435 CALL Z,$A815   ; If bit 7 of byte +5 of the record at IY is clear, call
                      ; #R$A815 (inside "Print word reference DE (code $04's
                      ; printer)")
*$D438 LD E,(IY+$00)  ; Read the first byte of the record at IY into E - Then
                      ; the noun
 $D43B LD D,(IY+$01)  ; Read byte +1 of the record at IY into D
 $D43E LD A,D         ; Copy D into A
 $D43F OR E           ; Set in A the bits that are set in E
 $D440 LD A,$50       ; Load A with $50
 $D442 CALL NZ,$A815  ; If the result is not zero, call #R$A815 (inside "Print
                      ; word reference DE (code $04's printer)")
 $D445 POP DE         ; Restore DE from the stack
 $D446 POP AF         ; Restore AF from the stack
 $D447 RET            ; Return to the caller

; Find the actor's exit in a direction
;
; Walks the exits of the actor's room, skipping any whose destination is 0
; (scenery exits - described, never usable). Used by the move pre-check #R$DCD2
; with the verb number as the direction.
;
;  Input:A Direction (1-10, the verb number)
; Output:IX The exit (direction, thing in the way, destination)
;        A $FF if there is no usable exit that way
c$D448 PUSH DE       ; Save DE on the stack
 $D449 PUSH BC       ; Save BC on the stack
 $D44A PUSH IY       ; Save IY on the stack
 $D44C LD B,A        ; B = direction
 $D44D CALL $D33C    ; The actor's room record...
 $D450 LD DE,$0006   ; Load DE with $0006, the amount that is added next
 $D453 ADD IX,DE     ; ...+6, so the first step lands on the exits at +9
*$D455 CALL $D206    ; Call the routine "Step to the next 3-byte entry"
                     ; (#R$D206) - Next exit (Z: no more)
 $D458 JR Z,$D467    ; If the zero flag is set, skip ahead to #R$D467
 $D45A LD A,(IX+$02) ; Read byte +2 of the record at IX into A - Destination 0?
 $D45D AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $D45E JR Z,$D455    ; ...a scenery exit: skip it
 $D460 LD A,(IX+$00) ; Read the first byte of the record at IX into A - The
                     ; right direction?
 $D463 CP B          ; Compare A with B
 $D464 JP NZ,$D455   ; If A differs from B, go back to #R$D455
*$D467 POP IY        ; Restore IY from the stack
 $D469 POP BC        ; Restore BC from the stack
 $D46A POP DE        ; Restore DE from the stack
 $D46B RET           ; Return to the caller

; Find the exit from the actor's room through door A ($D46C) or to room A
; ($D471)
;
; Addresses named in the title: #R$D471.
; .
; Walks the exits of the actor's room (#R$D33C; three-byte entries: direction,
; door, room, stepped by #R$D206) comparing byte 1 (the door, entry #R$D46C) or
; byte 2 (the room beyond, entry #R$D471) with A. The offset is written into
; the instruction at #R$D48B (its displacement byte #R$D48B($D48D)) -
; self-modifying code. Returns IX on the exit, or A = $FF if there is none.
; #R$D471 is why a room can only be named in a command when it is next door:
; the room search #R$D39B lets through only rooms it finds. Read from the code.
;
;  Input:A A door number (entry $D46C) or a room number (entry $D471)
; Output:F NZ with IX the exit if there is one; Z if not
;        BC, IY Kept
c$D46C PUSH AF       ; Save AF on the stack - Entry for a door: patch the
                     ; offset in the LD A,(IX+n) at #R$D48B to 1
 $D46D LD A,$01      ; Load A with $01
 $D46F JR $D474      ; Skip ahead to #R$D474
; This entry point is used by the routines at #R$C628, #R$C6BE, #R$CAAF,
; #R$D39B and #R$DD61.
*$D471 PUSH AF       ; Save AF on the stack - Entry for a room: patch it to 2
 $D472 LD A,$02      ; Load A with $02
*$D474 LD ($D48D),A  ; Store A in #R$D48B($D48D) in "Find the exit from the
                     ; actor's room through..."
 $D477 POP AF        ; Restore AF from the stack
 $D478 PUSH BC       ; Save BC on the stack
 $D479 PUSH IY       ; Save IY on the stack
 $D47B LD B,A        ; Copy A into B - B = the door or room number
 $D47C PUSH DE       ; Save DE on the stack
 $D47D CALL $D33C    ; Call the routine "IX = record of the actor's room"
                     ; (#R$D33C) - IX = the actor's room record (#R$D33C), past
                     ; its six header bytes, at its exits
 $D480 LD DE,$0006   ; Load DE with $0006, the amount that is added next
 $D483 ADD IX,DE     ; Add DE to IX
 $D485 POP DE        ; Restore DE from the stack
*$D486 CALL $D206    ; Call the routine "Step to the next 3-byte entry"
                     ; (#R$D206) - Next exit (#R$D206): Z at the end of the
                     ; list
 $D489 JR Z,$D491    ; If the zero flag is set, skip ahead to #R$D491
 $D48B LD A,(IX+$02) ; Read byte +2 of the record at IX into A - Its byte 1
                     ; (the door) or byte 2 (the room beyond) against B
 $D48E CP B          ; Compare A with B
 $D48F JR NZ,$D486   ; If A differs from B, go back to #R$D486
*$D491 POP IY        ; Restore IY from the stack - Z: no such exit; NZ: IX =
                     ; the exit
 $D493 POP BC        ; Restore BC from the stack
 $D494 RET           ; Return to the caller

; GET-ACTOR-ROOM: what room is actor A currently in?
;
; Resolves the id via #R$D237, confirms the resolved record's own type tag is
; $1 (i.e. it really is this kind of record, not something else living at the
; same id), and returns the byte at offset +15 of it. Returns $FF for an
; invalid id, or if the resolved record isn't type 1.
; .
; Confirmed empirically, not just by reading the code: called this directly
; with A=0 while the player was in the sitting room and got $08 back; moved the
; player north into the small closet in the real game and called it again - got
; $09; moved back south - got $08 again. This is genuinely 'what room is this
; actor in', not a guess from the byte offset alone.
;
;  Input:A An actor number
; Output:A The actor's room, or $FF if it is not an actor
;        IX The actor's record
c$D495 CP $FF        ; Invalid id ($FF)?
 $D497 RET Z         ; ...then just say so
 $D498 CALL $D237    ; Resolve the id to its full record
 $D49B LD A,$01      ; Is this really an actor/character record (tag $01)?
 $D49D CP (IX+$00)   ; Compare A with the first byte of the record at IX
 $D4A0 LD A,$FF      ; ...no: fail
 $D4A2 RET NZ        ; If A differs from the first byte of the record at IX,
                     ; return
 $D4A3 LD A,(IX+$0F) ; Yes: the room number lives at offset +15
 $D4A6 RET           ; Return to the caller

; List the people here: 'YOU CAN SEE ...'
;
; #R$D4CC counts them, #R$68E4 starts the sentence, #R$D51A lists them.
;
; Output:"YOU CAN SEE" and the people here listed; registers kept
c$D4A7 PUSH IY       ; Save IY on the stack - Save the registers
 $D4A9 PUSH AF       ; Save AF on the stack
 $D4AA PUSH BC       ; Save BC on the stack
 $D4AB LD A,$FF      ; Load A with $FF - Count the people here: place $FF
                     ; (#R$D4CC)
 $D4AD CALL $D4CC    ; Call the routine "Count the things in place B that
                     ; should be listed (B)" (#R$D4CC)
 $D4B0 JR Z,$D4C7    ; If the zero flag is set, skip ahead to #R$D4C7 - None:
                     ; finish
 $D4B2 PUSH AF       ; Save AF on the stack
 $D4B3 LD HL,$68E4   ; Point HL at the message "YOU CAN SEE" (#R$68E4)
 $D4B6 CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $D4B9 POP BC        ; Restore BC from the stack
 $D4BA LD C,B        ; Copy B into C
 $D4BB LD A,$FF      ; Load A with $FF
 $D4BD LD IY,($A017) ; Read #R$A012($A017) in "Game variables" into IY
 $D4C1 LD B,(IY+$0F) ; Read byte +15 of the record at IY into B
 $D4C4 CALL $D51A    ; Call the routine "List the things in a place, with
                     ; commas and AND" (#R$D51A)
*$D4C7 POP BC        ; Restore BC from the stack
 $D4C8 POP AF        ; Restore AF from the stack
 $D4C9 POP IY        ; Restore IY from the stack
 $D4CB RET           ; Return to the caller

; Count the things in place B that should be listed (B)
;
; Each through #R$D4EF.
;
;  Input:A A place
; Output:A, B The number of things there to be listed
;        F Z if none
c$D4CC PUSH IX       ; Save IX on the stack - Save IX, IY, HL, BC
 $D4CE PUSH IY       ; Save IY on the stack
 $D4D0 PUSH HL       ; Save HL on the stack
 $D4D1 PUSH BC       ; Save BC on the stack
 $D4D2 CALL $D04F    ; Call the routine "IX = just before the start of the
                     ; thing index (#R$8B6F)" (#R$D04F) - From the first thing,
                     ; count (B) those in place A that should be listed
                     ; (#R$D4EF)
 $D4D5 LD B,$00      ; Load B with $00
 $D4D7 LD C,A        ; Copy A into C
*$D4D8 CALL $D206    ; Call the routine "Step to the next 3-byte entry"
                     ; (#R$D206)
 $D4DB JR Z,$D4E6    ; If the zero flag is set, skip ahead to #R$D4E6
 $D4DD LD A,C        ; Copy C into A
 $D4DE CALL $D4EF    ; Call the routine "Should this thing be listed here?"
                     ; (#R$D4EF)
 $D4E1 JR NC,$D4D8   ; If the carry flag is clear, go back to #R$D4D8
 $D4E3 INC B         ; Add one to B
 $D4E4 JR $D4D8      ; Go back to #R$D4D8
*$D4E6 LD A,B        ; Copy B into A - A = B; Z if none
 $D4E7 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $D4E8 POP BC        ; Restore BC from the stack
 $D4E9 POP HL        ; Restore HL from the stack
 $D4EA POP IY        ; Restore IY from the stack
 $D4EC POP IX        ; Restore IX from the stack
 $D4EE RET           ; Return to the caller

; Should this thing be listed here?
;
; In the place, not the actor itself, visible to the player (#R$C821), and in
; exactly one location (so not a door). Read from the code.
;
;  Input:A A place
;        IX A thing's list entry
;        IY Its record
; Output:F Carry set if it should be listed
c$D4EF CP (IY+$01)   ; Compare A with the holder byte (+1) of the thing record
                     ; at IY - Is the thing's holder (IX+1) the one this
                     ; listing is for?
 $D4F2 JR NZ,$D518   ; If A differs from the holder byte (+1) of the thing
                     ; record at IY, skip ahead to #R$D518
 $D4F4 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Not the
                     ; actor's own record
 $D4F7 CP (IX+$00)   ; Compare A with the number byte (+0) of the thing record
                     ; at IX
 $D4FA JR Z,$D518    ; If A equals the number byte (+0) of the thing record at
                     ; IX, skip ahead to #R$D518
 $D4FC LD A,(IX+$00) ; Read the number byte (+0) of the thing record at IX into
                     ; A - And the actor can see it (#R$C821)
 $D4FF CALL $C821    ; Call the routine "Can the current actor (#R$A032($A036))
                     ; see thing A?" (#R$C821)
 $D502 JR Z,$D518    ; If the zero flag is set, skip ahead to #R$D518
 $D504 LD A,(IY+$00) ; Read the number byte (+0) of the thing record at IY into
                     ; A - Its room count (+0) below 2: only a thing in one or
                     ; no room
 $D507 CP $02        ; Compare A with $02
 $D509 JR NC,$D518   ; If A is $02 or more, skip ahead to #R$D518
 $D50B LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Is the
                     ; actor inside the thing, at any depth? (#R$D278: carry if
                     ; so)
 $D50E PUSH IX       ; Save IX on the stack
 $D510 POP HL        ; Restore HL from the stack
 $D511 CALL $D278    ; Call #R$D278 (inside "Is thing A carried by the actor,
                     ; perhaps...")
 $D514 JR C,$D518    ; If the carry flag is set, skip ahead to #R$D518
 $D516 SCF           ; Set the carry flag for the caller - Not inside it: list
                     ; it (carry set)
 $D517 RET           ; Return to the caller
*$D518 AND A         ; Clear the carry flag for the caller (A is unchanged) -
                     ; No (carry clear)
 $D519 RET           ; Return to the caller

; List the things in a place, with commas and AND
;
; #R$D526 does the work: it also marks each thing listed as seen by the player
; (+6 bit 7), which is what the case's evidence tests (see #R$9965).
;
;  Input:A A place
;        B, C As for $D526
; Output:The things in the place listed; IY, DE, BC kept
c$D51A PUSH IY       ; Save IY on the stack - Keep IY, DE and BC around the
                     ; list (#R$D526)
 $D51C PUSH DE       ; Save DE on the stack
 $D51D PUSH BC       ; Save BC on the stack
 $D51E CALL $D526    ; Call the routine "List the things in place A, then what
                     ; each of them..." (#R$D526)
 $D521 POP BC        ; Restore BC from the stack
 $D522 POP DE        ; Restore DE from the stack
 $D523 POP IY        ; Restore IY from the stack
 $D525 RET           ; Return to the caller

; List the things in place A, then what each of them holds
;
; Names each listable thing (#R$D57D) with commas and a final AND (#R$D3D9,
; #R$A414), marking each as seen (+6 bit 7); then, for each that has things of
; its own to list (#R$D4CC), says how they are held (#R$D590) and lists those
; too (calling itself). Read from the code; it produces 'In watsons armchair
; there is Watson. Watson is carrying the daily chronicle.'
; .
; How it works:
; .
; 1. First pass: name each listable thing in the place (#R$D57D), marking it as
; seen (+6 bit 7).
; .
; 2. After each name put a comma, but AND before the last two and a full stop
; after the last.
; .
; 3. Second pass: for each thing that holds others, say how it holds them
; (#R$D590) and list what it holds in the same way, going down the levels.
;
;  Input:A A place
;        C The number of things to name
; Output:The things named with commas and AND, each marked seen (+6 bit 7)
c$D526 PUSH IX        ; Save IX on the stack
 $D528 CALL $D04F     ; Call the routine "IX = just before the start of the
                      ; thing index (#R$8B6F)" (#R$D04F) - First pass: name
                      ; everything listable in A
*$D52B PUSH AF        ; Save AF on the stack
 $D52C CALL $D57D     ; Call #R$D57D (inside "The next listable thing in place
                      ; A (carry...") - Next one (#R$D57D); carry: no more
 $D52F JR C,$D55A     ; If the carry flag is set, jump on to #R$D55A
 $D531 SET 7,(IY+$06) ; Mark it as seen (+6 bit 7)
 $D535 SUB A          ; Clear A to zero - Its name with an article (#R$D3D9)
 $D536 LD ($A028),A   ; Store A in #R$A022($A028) in "Game variables"
 $D539 CALL $D3D9     ; Call #R$D3D9 (inside "Print thing IX's name")
 $D53C DEC C          ; Subtract one from C - C counts down the things still to
                      ; name: the last gets a full stop (#R$A414),
 $D53D LD A,C         ; Copy C into A
 $D53E AND A          ; Test A for zero (this leaves A as it was and clears
                      ; carry)
 $D53F JR NZ,$D546    ; If A is not zero, skip ahead to #R$D546
 $D541 CALL $A414     ; Call #R$A414 (inside "Print the rest of a narrated
                      ; command: verb...")
 $D544 JR $D557       ; Skip ahead to #R$D557
*$D546 CP $01         ; Compare A with $01 - the one before it AND ($005D), the
                      ; rest a comma
 $D548 JR Z,$D551     ; If A equals $01, skip ahead to #R$D551
 $D54A LD A,$2C       ; Load A with $2C - ...and the rest a comma
 $D54C CALL $A9B7     ; Call the routine "Print character A, a word at a time
                      ; (word wrap)" (#R$A9B7)
 $D54F JR $D557       ; Skip ahead to #R$D557
*$D551 LD DE,$005D    ; Load DE with $005D
 $D554 CALL $A887     ; Call #R$A887 (inside "Print the dictionary word that HL
                      ; refers to")
*$D557 POP AF         ; Restore AF from the stack
 $D558 JR $D52B       ; Go back to #R$D52B
*$D55A POP AF         ; Second pass: for each listed thing that holds things
                      ; itself (#R$D4CC)...
 $D55B CALL $D04F     ; Call the routine "IX = just before the start of the
                      ; thing index (#R$8B6F)" (#R$D04F) - Second pass: for
                      ; each thing that holds others (#R$D4CC), say how
                      ; (#R$D590) and list what it holds (recursively, #R$D526)
*$D55E PUSH AF        ; Save AF on the stack
 $D55F CALL $D57D     ; Call #R$D57D (inside "The next listable thing in place
                      ; A (carry...")
 $D562 JR C,$D578     ; If the carry flag is set, skip ahead to #R$D578
 $D564 PUSH AF        ; Save AF on the stack
 $D565 CALL $D4CC     ; Call the routine "Count the things in place B that
                      ; should be listed (B)" (#R$D4CC)
 $D568 JR Z,$D574     ; If the zero flag is set, skip ahead to #R$D574
 $D56A LD C,A         ; Copy A into C
 $D56B POP AF         ; Restore AF from the stack
 $D56C CALL $D590     ; Call the routine "Say what a person is carrying, or
                      ; what is on or in a..." (#R$D590) - ...say how they are
                      ; held (#R$D590) and list them too (recursion)
 $D56F CALL $D526     ; Call the routine "List the things in place A, then what
                      ; each of them..." (#R$D526)
 $D572 JR $D575       ; Skip ahead to #R$D575
*$D574 POP AF         ; Restore AF from the stack
*$D575 POP AF         ; Restore AF from the stack
 $D576 JR $D55E       ; Go back to #R$D55E
*$D578 POP AF         ; Restore AF from the stack
 $D579 POP IX         ; Restore IX from the stack
 $D57B RET            ; Return to the caller

; The next listable thing in place A (carry at the end)
;
; Steps through the things (#R$D21C) and returns the next for which #R$D4EF
; says yes. Read from the code.
;
;  Input:A A place
; Output:A The next thing's id
;        F Carry set at the end; Z if it is thing 0
c$D57C POP AF        ; Restore AF from the stack - Next thing in the place
                     ; (#R$D21C); Z at the end: return with carry set
; This entry point is used by the routine at #R$D526.
*$D57D CALL $D21C    ; Call the routine "Step to the next thing's record
                     ; (#R$D206), keeping A" (#R$D21C)
 $D580 JR NZ,$D584   ; If the zero flag is clear, skip ahead to #R$D584
 $D582 SCF           ; Set the carry flag for the caller
 $D583 RET           ; Return to the caller
*$D584 PUSH AF       ; Save AF on the stack
 $D585 CALL $D4EF    ; Call the routine "Should this thing be listed here?"
                     ; (#R$D4EF) - Is it listable (#R$D4EF)? Carry: no, try the
                     ; next
 $D588 JR NC,$D57C   ; If the carry flag is clear, go back to the routine "The
                     ; next listable thing in place A (carry at the..."
                     ; (#R$D57C)
 $D58A POP AF        ; Restore AF from the stack
 $D58B LD A,(IX+$00) ; Read the number byte (+0) of the thing record at IX into
                     ; A - Found: A = its id; Z if it is thing 0
 $D58E AND A         ; Clear the carry flag for the caller (A is unchanged)
 $D58F RET           ; Return to the caller

; Say what a person is carrying, or what is on or in a thing
;
; '<thing> IS CARRYING' (#R$68B1) for a person (+5 bit 6), otherwise IS or ARE
; and the relation word (#R$D5D3).
;
;  Input:A A thing
;        C How many things it holds
; Output:"IS CARRYING" or IS/ARE with how it holds them printed
c$D590 PUSH IX        ; Save IX on the stack - Save the registers; A = a thing
 $D592 PUSH BC        ; Save BC on the stack
 $D593 PUSH AF        ; Save AF on the stack
 $D594 CALL $D237     ; Its record (#R$D237)
 $D597 BIT 6,(IX+$05) ; Test bit 6 of the flags byte (+5) of the thing record
                      ; at IX (person) - Bit 6 of +5 (a person)?
 $D59B JR Z,$D5A5     ; If bit 6 of the flags byte (+5) of the thing record at
                      ; IX is clear, skip ahead to #R$D5A5
 $D59D POP AF         ; Restore AF from the stack
 $D59E PUSH AF        ; Save AF on the stack
 $D59F PUSH AF        ; Save AF on the stack
 $D5A0 LD HL,$68B1    ; Point HL at the message "THE TRASH PILE IS CARRYING"
                      ; (#R$68B1)
 $D5A3 JR $D5C1       ; Skip ahead to #R$D5C1
*$D5A5 LD HL,$0485    ; Load HL with $0485
 $D5A8 DEC C          ; Subtract one from C
 $D5A9 JR Z,$D5AE     ; If C has become zero, skip ahead to #R$D5AE
 $D5AB LD HL,$007A    ; Load HL with $007A
*$D5AE PUSH HL        ; Save HL on the stack
 $D5AF CALL $D5D3     ; Call the routine "Print how a thing is held: IN, ON,
                      ; BEHIND, UNDER or..." (#R$D5D3)
 $D5B2 LD A,$01       ; Load A with $01
 $D5B4 LD ($A2AA),A   ; Store A in "Use THE: a flag for the article printer
                      ; (#R$A7F2)" (#R$A2AA)
 $D5B7 CALL $D3D5     ; Call the routine "Print thing IX's name" (#R$D3D5)
 $D5BA XOR A          ; Clear A to zero (and the carry flag)
 $D5BB LD ($A2AA),A   ; Store A in "Use THE: a flag for the article printer
                      ; (#R$A7F2)" (#R$A2AA)
 $D5BE LD HL,$68D9    ; Point HL at the message "THERE ‹word›" (#R$68D9)
*$D5C1 CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $D5C4 POP AF         ; Restore AF from the stack
 $D5C5 POP BC         ; Restore BC from the stack
 $D5C6 POP IX         ; Restore IX from the stack
 $D5C8 RET            ; Return to the caller

; Where a thing is: IN, ON, BEHIND, UNDER, TIED
;
; Indexed by bits 0-2 of a thing's +4 (1-5) by #R$D5D3, which adds TO after
; TIED. Words looked up with source/dictionary.py. CORRECTED: the automatic
; split had it as code.
w$D5C9 DEFW $0450    ; 1: IN
 $D5CB DEFW $05FF    ; 2: ON
 $D5CD DEFW $00DC    ; 3: BEHIND
 $D5CF DEFW $0919    ; 4: UNDER
 $D5D1 DEFW $08D3    ; 5: TIED

; Print how a thing is held: IN, ON, BEHIND, UNDER or TIED TO
;
; From bits 0-2 of the container's +4 and the word table at #R$D5C9.
;
;  Input:IX The container's record
; Output:The word IN, ON, BEHIND, UNDER or TIED TO printed
;        F Z if TIED
c$D5D3 LD HL,$D5C9   ; Table #R$D5C9: IN, ON, BEHIND, UNDER, TIED
 $D5D6 LD A,(IX+$04) ; Read the type byte (+4) of the thing record at IX into A
                     ; - The thing's +4 bits 0-2: how it is held (1-5)
 $D5D9 AND $07       ; Keep only bits 0, 1, 2 of A (mask $07)
 $D5DB CP $05        ; Compare A with $05 - Z when it is 5, TIED
 $D5DD PUSH AF       ; Save AF on the stack
 $D5DE DEC A         ; Subtract one from A - Print the word for it (#R$A880)
 $D5DF LD E,A        ; Copy A into E
 $D5E0 LD D,$00      ; Load D with $00
 $D5E2 ADD HL,DE     ; Add DE to HL
 $D5E3 ADD HL,DE     ; Add DE to HL
 $D5E4 CALL $A880    ; Call the routine "Print the dictionary word that HL
                     ; refers to" (#R$A880)
 $D5E7 POP AF        ; Restore AF from the stack
 $D5E8 RET NZ        ; Not TIED: done
 $D5E9 LD DE,$08DB   ; Load DE with $08DB - TIED is followed by TO ($08DB)
 $D5EC JP $A887      ; Go back to #R$A887

; IX = room A's exits (record + 6), BC = 3 (their size)
;
; Read from the code.
;
;  Input:A A room number
; Output:IX The room's exits
;        BC 3, the size of an exit
c$D5EF CALL $D224    ; Room A's record (#R$D224)
 $D5F2 LD BC,$0006   ; Load BC with $0006, the amount that is added next - IX +
                     ; 6 = its exits
 $D5F5 ADD IX,BC     ; Add BC to IX
 $D5F7 LD BC,$0003   ; Load BC with $0003 - BC = 3, the size of an exit
 $D5FA RET           ; Return to the caller

; DE = the word for direction A (NORTH ... DOWN)
;
; From the table at #R$D064 (bit 7 of A ignored). Read from the code.
;
;  Input:A A direction number (bit 7 ignored)
; Output:DE The direction's word
c$D5FB LD HL,$D064   ; Point HL at #R$D064 - Table #R$D062: the words for the
                     ; directions, two bytes each
 $D5FE DEC HL        ; Step HL back one byte
 $D5FF DEC HL        ; Step HL back one byte
 $D600 LD E,A        ; Copy A into E
 $D601 RES 7,E       ; Clear bit 7 of E - A with bit 7 cleared is the direction
                     ; number (1 = NORTH...)
 $D603 LD D,$00      ; Load D with $00
 $D605 ADD HL,DE     ; Add DE to HL
 $D606 ADD HL,DE     ; Add DE to HL
 $D607 LD E,(HL)     ; Read the byte HL points at into E - DE = the word
 $D608 INC HL        ; Step HL on to the next byte
 $D609 LD D,(HL)     ; Read the byte HL points at into D
 $D60A RET           ; Return to the caller

; Describe the ways out through things: 'TO THE NORTH THERE IS THE FRONT DOOR'
;
; For each exit that passes through a thing (a door) that has been revealed (+5
; bit 7). Confirmed in the emulator in effect: 'To the north there is the front
; door.' on Baker Street.
; .
; .
; .
; Line comments added from reading the code; the exit entries are read as
; direction, door thing, destination, and the two non-compass directions (9,
; 10) were not checked by play.
;
; Output:The exits through revealed things described; registers kept
c$D60B PUSH BC        ; Save BC on the stack - Save the registers
 $D60C PUSH DE        ; Save DE on the stack
 $D60D PUSH IY        ; Save IY on the stack
 $D60F PUSH IX        ; Save IX on the stack
 $D611 CALL $D5EF     ; IX = this room's exit list, BC = 3 bytes an exit
                      ; (#R$D5EF)
 $D614 PUSH IX        ; Save IX on the stack - IY = the first exit (direction,
                      ; thing, destination)
 $D616 POP IY         ; Restore IY from the stack
 $D618 JR $D660       ; Go to the end test
*$D61A LD A,(IY+$01)  ; Read the holder byte (+1) of the thing record at IY
                      ; into A - Does the exit pass through a thing (+1
                      ; non-zero)?
 $D61D AND A          ; Test A for zero (this leaves A as it was and clears
                      ; carry)
 $D61E JR Z,$D660     ; If A is zero, jump on to #R$D660
 $D620 LD A,(IY+$00)  ; Read the number byte (+0) of the thing record at IY
                      ; into A - Direction above 10: skip
 $D623 CP $0B         ; Compare A with $0B
 $D625 JR NC,$D660    ; If A is $0B or more, jump on to #R$D660
 $D627 LD A,(IY+$01)  ; Read the holder byte (+1) of the thing record at IY
                      ; into A - Find the thing's record (#R$D237)
 $D62A CALL $D237     ; Call the routine "Resolve an id (in A) to its full
                      ; entity record" (#R$D237)
 $D62D BIT 7,(IX+$05) ; Test bit 7 of the flags byte (+5) of the thing record
                      ; at IX (revealed) - Not revealed yet (+5 bit 7 clear):
                      ; skip
 $D631 JR Z,$D660     ; If bit 7 of the flags byte (+5) of the thing record at
                      ; IX is clear, jump on to #R$D660
 $D633 LD A,(IY+$00)  ; Read the number byte (+0) of the thing record at IY
                      ; into A - The direction's word (#R$D5FB) in DE
 $D636 CALL $D5FB     ; Call the routine "DE = the word for direction A (NORTH
                      ; ... DOWN)" (#R$D5FB)
 $D639 CP $09         ; Compare A with $09 - Directions 1-8 (compass)
 $D63B JR C,$D647     ; If A is below $09, skip ahead to #R$D647
 $D63D LD DE,$000A    ; Load DE with $000A - 9: the word $000A
 $D640 JR Z,$D64D     ; If A equals $09, skip ahead to #R$D64D
 $D642 LD DE,$00E7    ; Load DE with $00E7 - 10: the word $00E7
 $D645 JR $D64D       ; Skip ahead to #R$D64D
*$D647 LD HL,$68BC    ; Point HL at the message "TO THE" (#R$68BC) - Print the
                      ; lead-in #R$68BC ('TO THE')
 $D64A CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
*$D64D CALL $A887     ; Print the direction word (#R$A887)
 $D650 LD HL,$68E9    ; Point HL at the message "THERE IS" (#R$68E9) - Print
                      ; #R$68E9 ('THERE IS')
 $D653 CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $D656 PUSH IY        ; Save IY on the stack - Print the door's name (#R$D3D5)
                      ; and end the sentence (#R$A414)
 $D658 CALL $D3D5     ; Call the routine "Print thing IX's name" (#R$D3D5)
 $D65B CALL $A414     ; Call #R$A414 (inside "Print the rest of a narrated
                      ; command: verb...")
 $D65E POP IY         ; Restore IY from the stack
*$D660 ADD IY,BC      ; Add BC to IY - Next exit
 $D662 LD A,$FF       ; Load A with $FF
 $D664 CP (IY+$00)    ; Compare A with the number byte (+0) of the thing record
                      ; at IY - $FF ends the list
 $D667 JP NZ,$D61A    ; If A differs from the number byte (+0) of the thing
                      ; record at IY, go back to #R$D61A
 $D66A POP IX         ; Restore IX from the stack - Restore the registers and
                      ; return
 $D66C POP IY         ; Restore IY from the stack
 $D66E POP DE         ; Restore DE from the stack
 $D66F POP BC         ; Restore BC from the stack
 $D670 RET            ; Return to the caller

; Step IX to the room's next plain exit (Z at the end)
;
; Skips exits through a door (+1 not 0) and anything that is not a direction
; 1-10; Z at the $FF end marker. Read from the code.
;
;  Input:IX An exit
;        BC 3
; Output:IX The next plain exit
;        F Z at the end; NZ if found
c$D671 ADD IX,BC     ; Add BC to IX - (Separate routine) walk the exits from
                     ; IX: stop with Z at the $FF end...
 $D673 LD A,$FF      ; Load A with $FF
 $D675 CP (IX+$00)   ; Compare A with the first byte of the record at IX
 $D678 RET Z         ; If A equals the first byte of the record at IX, return
 $D679 XOR A         ; Clear A to zero (and the carry flag) - ...or return NZ
                     ; at the first plain exit (no thing, a direction 1-10)
 $D67A CP (IX+$01)   ; Compare A with byte +1 of the record at IX
 $D67D JR NZ,$D671   ; If A differs from byte +1 of the record at IX, go back
                     ; to the routine "Step IX to the room's next plain exit (Z
                     ; at the..." (#R$D671)
 $D67F LD A,(IX+$00) ; Read the first byte of the record at IX into A
 $D682 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $D683 JR Z,$D671    ; If A is zero, go back to the routine "Step IX to the
                     ; room's next plain exit (Z at the..." (#R$D671)
 $D685 CP $0B        ; Compare A with $0B
 $D687 JR NC,$D671   ; If A is $0B or more, go back to the routine "Step IX to
                     ; the room's next plain exit (Z at the..." (#R$D671)
 $D689 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller
 $D68B RET           ; Return to the caller

; List the plain exits: 'VISIBLE EXITS ARE ...'
;
; #R$68F1, then the direction names (#R$D5FB).
;
;  Input:A A room number
; Output:"VISIBLE EXITS ARE" and the plain exits listed; registers kept
c$D68C PUSH IX       ; Save IX on the stack - Save the registers
 $D68E PUSH IY       ; Save IY on the stack
 $D690 PUSH DE       ; Save DE on the stack
 $D691 PUSH BC       ; Save BC on the stack
 $D692 CALL $D5EF    ; IX = room A's exits (#R$D5EF)
 $D695 CALL $D671    ; Call the routine "Step IX to the room's next plain exit
                     ; (Z at the end)" (#R$D671) - Find the first plain exit
                     ; (#R$D671); none: finish
 $D698 JR Z,$D6B1    ; If the zero flag is set, skip ahead to #R$D6B1
 $D69A LD HL,$68F1   ; Point HL at the message "VISIBLE EXITS ARE" (#R$68F1)
 $D69D CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
*$D6A0 LD A,(IX+$00) ; Read the first byte of the record at IX into A
 $D6A3 CALL $D5FB    ; Call the routine "DE = the word for direction A (NORTH
                     ; ... DOWN)" (#R$D5FB)
 $D6A6 CALL $A887    ; Call #R$A887 (inside "Print the dictionary word that HL
                     ; refers to")
 $D6A9 CALL $D671    ; Call the routine "Step IX to the room's next plain exit
                     ; (Z at the end)" (#R$D671)
 $D6AC JR NZ,$D6A0   ; If the zero flag is clear, go back to #R$D6A0
 $D6AE CALL $A414    ; Call #R$A414 (inside "Print the rest of a narrated
                     ; command: verb...")
*$D6B1 POP BC        ; Restore BC from the stack
 $D6B2 POP DE        ; Restore DE from the stack
 $D6B3 POP IY        ; Restore IY from the stack
 $D6B5 POP IX        ; Restore IX from the stack
 $D6B7 RET           ; Return to the caller

; A flag of the player's script step, and spare bytes
;
; #R$D6B8 is written at #R$A041($A042) (the start of the game), #R$D7AC($D7AD),
; #R$D81B($D81C) and #R$D85C($D85D) and read at #R$D7FD($D7FE) and
; #R$D835($D836) - the player's script step - and the word at #R$D6BB is saved
; at #R$D832($D833) and reloaded at #R$D807($D808) by the same code. Read from
; the code; what they hold was not traced.
b$D6B8 DEFB $00      ; Flag
 $D6B9 DEFB $00,$00  ; Zeros
 $D6BB DEFW $0000    ; A saved pointer
 $D6BD DEFB $00,$00  ; Zeros

; Player's turn: read a line from the keyboard (RUN at $9923)
;
; Addresses named in the title: #R$9923.
; .
; The body reads a line with the line editor (#R$D898, with a fresh key time
; limit), fails (#R$DC15) if nothing came, and clears #R$D714. Part of the
; player's own plan script. Read from the code.
; .
; This record is one step of the loop in the player's own plan script at
; #R$9921: DO LOOK once, then read a line (#R$D6BF), split it into words
; (#R$D715), check there is a word (#R$D769), parse a sentence (#R$D77E), check
; there is a sentence (#R$D7D9), turn it into a command (#R$D7FA) and DO it.
; When you wear the china man's disguise the same script runs for him; the
; counts below include both.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 15,319 times in 14 of them, run by you,
; china man. Every one of its 6 instructions was executed
; (tools/experiments/insn_coverage.py).
;
; Output:F NZ if a line was typed; the turn fails if nothing was
c$D6BF DEFB $00,$00  ; Action record header: flags $00; byte 1 $00
 $D6C1 CALL $D898    ; Call the routine "Read a line from the keyboard, with a
                     ; time limit" (#R$D898) - Read the player's line
                     ; (#R$D898); nothing typed: fail
 $D6C4 JP Z,$DC15    ; If the zero flag is set, jump on to the routine "Fail: A
                     ; = 0, HL = 0, Z set" (#R$DC15)
 $D6C7 XOR A         ; Clear A to zero (and the carry flag) - #R$D714 = 0,
                     ; return NZ
 $D6C8 LD ($D714),A  ; Store A in "Flag: repeat the last command ('@')"
                     ; (#R$D714)
 $D6CB OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller
 $D6CD RET           ; Return to the caller

; Read one word and classify it as noun or verb
;
; Calls the tokenizer (#R$D9C5) and checks its class-byte result: $D0 means
; noun (jumps to #R$D6E0 to handle that), $C0 means verb (falls through to
; accept it); anything else retries by calling the tokenizer again.
; .
; Confirmed real by tracing a genuine word (TAKE) through this exact loop:
; three tokenizer calls happened in sequence, returning class bytes $30, then
; $B0 (the punctuation class this project found much earlier), then $C0 -
; accepted on the third attempt - with the OTHER half of the result (word
; index, held in E) staying fixed at 5 throughout all three. Read as: the
; tokenizer resolves the word immediately, but offers it under a sequence of
; candidate classes until one matches what the caller is looking for. Exactly
; why $30 and $B0 are tried first, before $C0, isn't confirmed.
;
; Output:A The class byte
;        F NZ for a verb; Z with HL = $D6E5 for an unknown word
c$D6CE LD HL,$5B00   ; Always start reading from the input buffer
*$D6D1 CALL $D9C5    ; Ask the tokenizer for the next word
 $D6D4 CP $D0        ; Is it a noun?
 $D6D6 JP Z,$D6E0    ; If A equals $D0, skip ahead to #R$D6E0
 $D6D9 CP $C0        ; ...or a verb?
 $D6DB JR NZ,$D6D1   ; Neither: try again
 $D6DD OR $01        ; Verb accepted
 $D6DF RET           ; Return to the caller
*$D6E0 LD HL,$D6E5   ; Point HL at "Say 'I DO NOT KNOW THE WORD "..."'"
                     ; (#R$D6E5) - Unknown word: HL = #R$D6E5 (the routine that
                     ; says so), Z
 $D6E3 XOR A         ; Set A to zero, which sets the zero flag for the caller
 $D6E4 RET           ; Return to the caller

; Say 'I DO NOT KNOW THE WORD "..."'
;
; Quotes the unknown word from the typed line (#R$6859). Confirmed in the
; emulator: an old harness glitch produced 'I DO NOT KNOW THE WORD AIT'.
;
; Output:The message "I DO NOT KNOW THE WORD" printed with the word
c$D6E5 LD A,$01      ; Load A with $01 - Quoted printing on (#R$A022($A027) =
                     ; 1)
 $D6E7 LD ($A027),A  ; Store A in #R$A022($A027) in "Game variables"
 $D6EA LD HL,$6859   ; "I DO NOT KNOW THE WORD""
 $D6ED CALL $A59F    ; Print the message 'I DO NOT KNOW THE WORD' (#R$6859)
 $D6F0 LD HL,($D6BD) ; Read #R$D6BD in "A flag of the player's script step,
                     ; and..." into HL - Mark the word's token (#R$D6BD) as
                     ; class $C0
 $D6F3 LD (HL),$C0   ; Store $C0 at the address HL points to
 $D6F5 LD HL,($A029) ; HL = the unknown word in the typed line (#R$A022($A029))
*$D6F8 LD A,(HL)     ; Read the byte HL points at into A - Print it a character
                     ; at a time, a '.' as a space...
 $D6F9 CP $2E        ; Compare A with $2E
 $D6FB JR NZ,$D6FF   ; If A differs from $2E, skip ahead to #R$D6FF
 $D6FD LD A,$20      ; Load A with $20
*$D6FF CALL $A9B7    ; Call the routine "Print character A, a word at a time
                     ; (word wrap)" (#R$A9B7)
 $D702 INC HL        ; Step HL on to the next byte
 $D703 CP $20        ; Compare A with $20 - ...up to the next space
 $D705 JR NZ,$D6F8   ; If A differs from $20, go back to #R$D6F8
 $D707 LD A,$22      ; Load A with $22 - Closing quote
 $D709 CALL $A9B7    ; Call the routine "Print character A, a word at a time
                     ; (word wrap)" (#R$A9B7)
 $D70C CALL $A2A2    ; End the line (#R$A2A2)
 $D70F XOR A         ; Clear A to zero (and the carry flag) - Quoted printing
                     ; off (#R$A022($A027) = 0)
 $D710 LD ($A027),A  ; Store A in #R$A022($A027) in "Game variables"
 $D713 RET           ; Return to the caller

; Flag: repeat the last command ('@')
;
; Set by the '@' key on an empty line (#R$D99E); the word-list builder at
; #R$D720 then reuses the previous tokens; cleared by #R$D6C8($D6C9). Read from
; the code; confirmed in the emulator.
b$D714 DEFB $00      ; A flag for the unknown-word message

; Player's turn: split the typed line into words (RUN at $9928)
;
; Addresses named in the title: #R$9928.
; .
; The player's turn starts here: the page line count (#R$A012($A019)) is
; cleared and the text lines go back to full width (#R$C142). Then, unless '@'
; asked for the last command again (#R$D714), the typed line at
; #LINK(rom_symbols#a5B00)($5B00) is run through the tokenizer (#R$D9C5) word
; by word into the list at #LINK(rom_symbols#a5B81)($5B81): one class byte per
; token, followed by its two-byte value for words of class $E0, $F0 or $90 and
; for anything below $80; the list ends at class $C0. #R$D6BD is pointed at the
; list and the record succeeds. Read from the code.
; .
; This record is one step of the loop in the player's own plan script at
; #R$9921: DO LOOK once, then read a line (#R$D6BF), split it into words
; (#R$D715), check there is a word (#R$D769), parse a sentence (#R$D77E), check
; there is a sentence (#R$D7D9), turn it into a command (#R$D7FA) and DO it.
; When you wear the china man's disguise the same script runs for him; the
; counts below include both.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 15,331 times in 14 of them, run by you,
; china man. Every one of its 34 instructions was executed
; (tools/experiments/insn_coverage.py).
; .
; How it works:
; .
; 1. Clear the page line count and put the text at full width (#R$C142). If '@'
; was typed, use the last word list again.
; .
; 2. Otherwise clear the 96-byte word list at #LINK(rom_symbols#a5B81)($5B81)
; and read tokens from the typed line (#R$D9C5).
; .
; 3. Store each token's class; classes $E0, $F0, $90 and those below $80 are
; followed by a two-byte value.
; .
; 4. Continue until the end marker.
;
; Output:The typed line split into a word list at $5B81
c$D715 DEFB $40,$00,$CE,$D6 ; Action record header: flags $40; bit 6: pre-check
                            ; at #R$D6CE; byte 1 $00
 $D719 XOR A                ; Clear A to zero (and the carry flag) - A fresh
                            ; page count, and full-width text lines
 $D71A LD ($A019),A         ; Store A in #R$A012($A019) in "Game variables"
 $D71D CALL $C142           ; Call the routine "Text lines full width again (36
                            ; characters)" (#R$C142)
 $D720 LD A,($D714)         ; Read "Flag: repeat the last command ('@')"
                            ; (#R$D714) into A - '@': use the last word list
                            ; again
 $D723 AND A                ; Test A for zero (this leaves A as it was and
                            ; clears carry)
 $D724 JR NZ,$D760          ; If A is not zero, jump on to #R$D760
 $D726 LD HL,$5B81          ; Load HL with #LINK(rom_symbols#a5B81)($5B81) -
                            ; Clear the 96-byte word list
 $D729 LD B,$60             ; Load B with $60
 $D72B CALL $A2AB           ; Call the routine "Fill B bytes at HL with zero
                            ; (or, from #R$A2AC, with A)" (#R$A2AB)
 $D72E LD HL,$5B00          ; Load HL with #LINK(rom_symbols#a5B00)($5B00) - HL
                            ; = the typed line, IY = the word list
 $D731 LD IY,$5B81          ; Load IY with #LINK(rom_symbols#a5B81)($5B81)
*$D735 LD (IY+$00),$C0      ; Set the first byte of the record at IY to $C0 -
                            ; Mark the end, then read the next token
 $D739 CALL $D9C5           ; Call the routine "Tokenizer: read and classify
                            ; the next word from input" (#R$D9C5)
 $D73C LD (IY+$00),D        ; Store D in the first byte of the record at IY -
                            ; Store its class
 $D73F INC IY               ; Step IY on to the next byte
 $D741 CP $E0               ; Compare A with $E0 - Classes $E0, $F0, $90 and
                            ; those below $80...
 $D743 JR Z,$D751           ; If A equals $E0, skip ahead to #R$D751
 $D745 CP $F0               ; Compare A with $F0
 $D747 JR Z,$D751           ; If A equals $F0, skip ahead to #R$D751
 $D749 CP $90               ; Compare A with $90
 $D74B JR Z,$D751           ; If A equals $90, skip ahead to #R$D751
 $D74D CP $80               ; Compare A with $80
 $D74F JR NC,$D75B          ; If A is $80 or more, skip ahead to #R$D75B
*$D751 LD (IY+$00),B        ; Store B in the first byte of the record at IY -
                            ; ...are followed by their two-byte value
 $D754 LD (IY+$01),C        ; Store C in byte +1 of the record at IY
 $D757 INC IY               ; Step IY on to the next byte
 $D759 INC IY               ; Step IY on to the next byte
*$D75B LD A,D               ; Copy D into A - Until the end of the line (class
                            ; $C0)
 $D75C CP $C0               ; Compare A with $C0
 $D75E JR NZ,$D735          ; If A differs from $C0, go back to #R$D735
*$D760 LD HL,$5B81          ; Load HL with #LINK(rom_symbols#a5B81)($5B81) -
                            ; The parser starts at the list
 $D763 LD ($D6BD),HL        ; Store HL in #R$D6BD in "A flag of the player's
                            ; script step, and..."
 $D766 OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller - Succeed
 $D768 RET                  ; Return to the caller

; Player's turn: stop when the line has no more words (RUN at $992D)
;
; Addresses named in the title: #R$992D.
; .
; Its body just succeeds; the work is its pre-check (#R$D770), which fails when
; the next token is the end of the line (class $C0). This record is one step of
; the loop in the player's own plan script at #R$9921: DO LOOK once, then read
; a line (#R$D6BF), split it into words (#R$D715), check there is a word
; (#R$D769), parse a sentence (#R$D77E), check there is a sentence (#R$D7D9),
; turn it into a command (#R$D7FA) and DO it. When you wear the china man's
; disguise the same script runs for him; the counts below include both.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 15,331 times in 14 of them, run by you,
; china man. Every one of its 2 instructions was executed
; (tools/experiments/insn_coverage.py).
;
; Output:F NZ
c$D769 DEFB $40,$00,$70,$D7 ; Action record header: flags $40; bit 6: pre-check
                            ; at #R$D770; byte 1 $00
 $D76D OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller
 $D76F RET                  ; Return to the caller

; Fail if the next token is of class $C0
;
; The pre-check named in the header of the record at #R$D769 (flags $40, part
; of the player's own script): looks at the token at (#R$D6BD). Read from the
; code.
;
;  Input:$D6BD The next token
; Output:F NZ if it is not the end of the line; otherwise the turn fails
; .        through $DC15
c$D770 LD HL,($D6BD) ; Read #R$D6BD in "A flag of the player's script step,
                     ; and..." into HL - The next token's class (the word list
                     ; pointer #R$D6BD)...
 $D773 LD A,(HL)     ; Read the byte HL points at into A
 $D774 AND $F0       ; Keep only bits 4, 5, 6, 7 of A (mask $F0)
 $D776 CP $C0        ; Compare A with $C0 - ...is $C0 (the end of the line):
                     ; fail (#R$DC15)
 $D778 JP Z,$DC15    ; If A equals $C0, jump on to the routine "Fail: A = 0, HL
                     ; = 0, Z set" (#R$DC15)
 $D77B OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Otherwise pass
 $D77D RET           ; Return to the caller

; Player's turn: parse the next sentence (RUN at $9932)
;
; Addresses named in the title: #R$9932.
; .
; The body runs the sentence parser (#R$AAB2) from the token at (#R$D6BD). On
; success the rest of the line (#R$9FF0) is kept at #R$9FF2 for next time and
; #R$D6B8 cleared. On failure both word lists are freed (#R$D87D, #R$D88A) and
; - unless the parser's result was 2 and an action time was set - the game says
; 'WHAT ?' (#R$6866) and fails. Part of the player's own plan script. Read from
; the code; 'WHAT ?' seen in play.
; .
; This record is one step of the loop in the player's own plan script at
; #R$9921: DO LOOK once, then read a line (#R$D6BF), split it into words
; (#R$D715), check there is a word (#R$D769), parse a sentence (#R$D77E), check
; there is a sentence (#R$D7D9), turn it into a command (#R$D7FA) and DO it.
; When you wear the china man's disguise the same script runs for him; the
; counts below include both.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 15,331 times in 14 of them, run by you,
; china man. 35 of its 40 instructions were executed; the rest (#R$D7D0 #R$D7D3
; #R$D7D4 #R$D7D5 #R$D7D6) never ran in any stored route, and were therefore
; read from the code only.
; .
; The 'parser result 2' tail (#R$D7D0-#R$D7D6) was not reached by any stored
; route or by the keyboard tests (TAKE alone, BLAH, GO BLAH); BLAH and GO BLAH
; give I DO NOT KNOW THE WORD before this record is run, and TAKE alone gives
; TAKE WHAT ?.
;
; Output:F NZ if a sentence parsed; Z if not
;        $9FF2 The rest of the line
c$D77E DEFB $00,$00  ; Action record header: flags $00; byte 1 $00
 $D780 XOR A         ; Clear A to zero (and the carry flag) - Action-record
                     ; body: #R$9FEB = 0
 $D781 LD ($9FEB),A  ; Store A in #R$9FEB in "Game variables"
 $D784 INC A         ; Add one to A - #R$A022($A024) = 1
 $D785 LD ($A024),A  ; Store A in #R$A022($A024) in "Game variables"
 $D788 LD HL,($D6BD) ; Read #R$D6BD in "A flag of the player's script step,
                     ; and..." into HL - Keep the parser's token pointer
                     ; (#R$D6BD) in #R$A02A($A02B) across the parse
 $D78B LD ($A02B),HL ; Store HL in #R$A02A($A02B) in "Game variables"
 $D78E CALL $AAB2    ; Call the routine "Parse the next sentence from the word
                     ; list" (#R$AAB2) - Parse a sentence (#R$AAB2)
 $D791 PUSH AF       ; Save AF on the stack
 $D792 XOR A         ; Clear A to zero (and the carry flag) - #R$A01A($A01B) =
                     ; 0 (flags preserved)
 $D793 LD ($A01B),A  ; Store A in #R$A01A($A01B) in "Game variables"
 $D796 POP AF        ; Restore AF from the stack
 $D797 LD HL,($A02B) ; Read #R$A02A($A02B) in "Game variables" into HL - Put
                     ; the token pointer back
 $D79A LD ($D6BD),HL ; Store HL in #R$D6BD in "A flag of the player's script
                     ; step, and..."
 $D79D JR NZ,$D7B2   ; NZ: the parse failed
 $D79F LD HL,($9FF0) ; Read words the player has (#R$9FF0) into HL - Parsed:
                     ; keep the rest of the line (#R$9FF0) as #R$9FF2...
 $D7A2 LD ($9FF2),HL ; Store HL in #R$9FF2 in "Game variables"
 $D7A5 LD HL,$0000   ; Load HL with $0000 - ...and empty #R$9FF0
 $D7A8 LD ($9FF0),HL ; Store HL in words the player has (#R$9FF0)
 $D7AB XOR A         ; Clear A to zero (and the carry flag)
 $D7AC LD ($D6B8),A  ; #R$D6B8 = 0
 $D7AF OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Return NZ: success
 $D7B1 RET           ; Return to the caller
*$D7B2 PUSH AF       ; Save AF on the stack - Failed: free both word lists
                     ; (#R$D87D, #R$D88A)
 $D7B3 CALL $D87D    ; Call the routine "Free the current sentence's word list
                     ; (#R$9FF0)" (#R$D87D)
 $D7B6 CALL $D88A    ; Call the routine "Free the rest of the typed line's word
                     ; list (#R$9FF2)" (#R$D88A)
 $D7B9 POP AF        ; Restore AF from the stack
 $D7BA CP $02        ; Compare A with $02 - Parser result 2 (an action time was
                     ; set)?
 $D7BC JR Z,$D7D0    ; If A equals $02, skip ahead to #R$D7D0
 $D7BE LD A,$01      ; Load A with $01 - Otherwise print 'WHAT ?' (#R$6866)
                     ; with quoted printing on...
 $D7C0 LD ($A027),A  ; Store A in #R$A022($A027) in "Game variables"
 $D7C3 LD HL,$6866   ; Point HL at the message "WHAT ?" (#R$6866)
 $D7C6 CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $D7C9 XOR A         ; Clear A to zero (and the carry flag) - ...then off
 $D7CA LD ($A027),A  ; Store A in #R$A022($A027) in "Game variables"
 $D7CD JP $DC15      ; and fail (#R$DC15)
*$D7D0 LD HL,($A01F) ; Read #R$A01A($A01F) in "Game variables" into HL - Result
                     ; 2: fail if #R$A01A($A01F) is zero, else return NZ
 $D7D3 LD A,H        ; Copy H into A
 $D7D4 OR L          ; Set in A the bits that are set in L
 $D7D5 RET NZ        ; If the result is not zero, return
 $D7D6 JP $DC15      ; Jump on to the routine "Fail: A = 0, HL = 0, Z set"
                     ; (#R$DC15)

