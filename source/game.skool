 $BBE1 CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $BBE4 RET            ; Return to the caller
; This entry point is used by the routine at #R$9DD8.
*$BBE5 PUSH AF        ; Print #R$67FF, then #R$72D6 unless exactly one...
 $BBE6 LD HL,$67FF    ; Point HL at the message "YOU SAY"" (#R$67FF)
 $BBE9 CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $BBEC POP AF         ; Restore AF from the stack
 $BBED CP $01         ; Compare A with $01
