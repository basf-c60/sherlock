; Read a sentence's verb words into the node at IY
;
; Tokens (#R$AE7F) of class $30 (a verb, see #R$AE7F) go to IY+0/+1, class $00
; to IY+2/+3, $40 and $20 to one or the other by the flags in E; $E0 tokens are
; skipped; anything else ends the verb (carry when a slot was wanted twice). In
; statement mode (#R$A022($A024) = 2, while a case statement is being said) the
; verb must instead be one of the eleven relation words at #R$994D - KILLED,
; HAD, ... - and NZ means it is not. Read from the code; classes $00, $20, $40
; and $E0 were not seen in the emulator.
; .
; .
; .
; Line comments added from reading the code; the meaning of the E register bits
; is inferred from how they are tested.
; .
; How it works:
; .
; 1. In statement mode (#R$A022($A024) = 2) the words are matched against the
; relation words at #R$994D instead (#R$ABF3).
; .
; 2. Otherwise take tokens (#R$AE7F). A class $30 token goes in the verb slot
; (IY+0/+1), a class $00 token in the second word slot (IY+2/+3).
; .
; 3. A class $40 token clears E bit 0 and is treated as a verb; a class $20
; token goes to whichever slot is free.
; .
; 4. A word for a slot already taken returns carry set. Any other class ends
; the verb: return Z if the verb slot has been filled.
;
;  Input:IY The sentence node
;        E Slot flags (bit 0, 1, 2)
; Output:F Z if the verb slot was filled; NZ if not; carry set for a second
; .        word in a slot already taken
;        E Updated
c$AB91 LD A,($A024)  ; Read #R$A022($A024) in "Game variables" into A -
                     ; Statement mode (#R$A022($A024) = 2)?
 $AB94 CP $02        ; Compare A with $02
 $AB96 JR Z,$ABF3    ; Yes: the relation-word check at #R$ABF3
 $AB98 LD A,E        ; Copy E into A - E bits 0-2 set: ready for a verb slot
                     ; (bit 1), an object-word slot (bit 2), and the
                     ; direct-or-indirect choice (bit 0)
 $AB99 OR $07        ; Set bits 0, 1, 2 of A (mask $07)
 $AB9B LD E,A        ; Copy A into E
*$AB9C CALL $AE7F    ; Next token (#R$AE7F): class in A, word reference in BC
 $AB9F CP $E0        ; Compare A with $E0 - Class $E0: skipped
 $ABA1 JR Z,$AB9C    ; If A equals $E0, go back to #R$AB9C
 $ABA3 CP $30        ; Compare A with $30 - Class $30 (verb word)?
 $ABA5 JR NZ,$ABB7   ; If A differs from $30, skip ahead to #R$ABB7
*$ABA7 BIT 1,E       ; Verb slot still free (E bit 1)?
 $ABA9 JR Z,$ABB5    ; No: wanted twice, carry (#R$ABB5)
*$ABAB RES 1,E       ; Fill the verb slot: mark it taken...
 $ABAD LD (IY+$00),C ; Store C in the first byte of the record at IY - ...and
                     ; store the word reference at IY+0/+1
 $ABB0 LD (IY+$01),B ; Store B in byte +1 of the record at IY
 $ABB3 JR $AB9C      ; Go back to #R$AB9C
*$ABB5 SCF           ; Set the carry flag for the caller - Carry: a second word
                     ; for a slot already taken
 $ABB6 RET           ; Return to the caller
*$ABB7 CP $00        ; Compare A with $00 - Class $00 (second word)?
 $ABB9 JR NZ,$ABC9   ; If A differs from $00, skip ahead to #R$ABC9
*$ABBB BIT 2,E       ; Test bit 2 of E - Its slot (E bit 2) free?
 $ABBD JR Z,$ABB5    ; If bit 2 of E is clear, go back to #R$ABB5
 $ABBF RES 2,E       ; Clear bit 2 of E - Mark taken and store at IY+2/+3
 $ABC1 LD (IY+$02),C ; Store C in byte +2 of the record at IY
 $ABC4 LD (IY+$03),B ; Store B in byte +3 of the record at IY
 $ABC7 JR $AB9C      ; Go back to #R$AB9C
*$ABC9 CP $40        ; Compare A with $40 - Class $40: clear E bit 0, then
                     ; treat as a verb word
 $ABCB JR NZ,$ABD1   ; If A differs from $40, skip ahead to #R$ABD1
 $ABCD RES 0,E       ; Clear bit 0 of E
 $ABCF JR $ABA7      ; Go back to #R$ABA7
*$ABD1 CP $20        ; Compare A with $20 - Class $20: goes to whichever slot
                     ; is free:
 $ABD3 JR NZ,$ABEF   ; If A differs from $20, skip ahead to #R$ABEF
 $ABD5 BIT 1,E       ; Test bit 1 of E - verb slot free: use it
 $ABD7 JR NZ,$ABA7   ; If bit 1 of E is set, go back to #R$ABA7
 $ABD9 BIT 0,E       ; Test bit 0 of E - bit 0 still set: use the second slot
 $ABDB JR NZ,$ABBB   ; If bit 0 of E is set, go back to #R$ABBB
 $ABDD RES 2,E       ; Clear bit 2 of E - else copy the verb word into the
                     ; second slot and take the verb slot
 $ABDF SET 0,E       ; Set bit 0 of E
 $ABE1 LD A,(IY+$00) ; Read the first byte of the record at IY into A
 $ABE4 LD (IY+$02),A ; Store A in byte +2 of the record at IY
 $ABE7 LD A,(IY+$01) ; Read byte +1 of the record at IY into A
 $ABEA LD (IY+$03),A ; Store A in byte +3 of the record at IY
 $ABED JR $ABAB      ; Go back to #R$ABAB
*$ABEF OR A          ; Test A for zero (this leaves A as it was and clears
                     ; carry) - Any other class ends the verb: Z if the verb
                     ; slot has been filled (E bit 1 clear), NZ if not
 $ABF0 BIT 1,E       ; Test bit 1 of E
 $ABF2 RET           ; Return to the caller
; This entry point is used by the routine at #R$AAB2.
*$ABF3 CALL $AE7F    ; Statement mode: next token...
 $ABF6 CP $80        ; Compare A with $80 - ...skipping a class $80 one
 $ABF8 CALL Z,$AE7F  ; If A equals $80, call the routine "Read the next token
                     ; of the typed line" (#R$AE7F)
 $ABFB LD A,B        ; Copy B into A - Keep the dictionary offset's high nibble
                     ; out of the way
 $ABFC AND $0F       ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $ABFE LD B,A        ; Copy A into B
 $ABFF LD HL,$994D   ; Point HL at "The case's relation words" (#R$994D) -
                     ; Search the relation words at #R$994D (2 bytes each, 0
                     ; ends)
*$AC02 LD A,(HL)     ; Read the byte HL points at into A
 $AC03 INC HL        ; Step HL on to the next byte
 $AC04 OR (HL)       ; Set in A the bits that are set in the byte HL points at
 $AC05 JR Z,$AC14    ; If the result is zero, skip ahead to #R$AC14
 $AC07 LD A,B        ; Copy B into A
 $AC08 CP (HL)       ; Compare A with the byte HL points at
 $AC09 JR NZ,$AC11   ; If A differs from the byte HL points at, skip ahead to
                     ; #R$AC11
 $AC0B DEC HL        ; Step HL back one byte
 $AC0C LD A,C        ; Copy C into A
 $AC0D CP (HL)       ; Compare A with the byte HL points at
 $AC0E JR Z,$AC17    ; If A equals the byte HL points at, skip ahead to #R$AC17
 $AC10 INC HL        ; Step HL on to the next byte
*$AC11 INC HL        ; Step HL on to the next byte
 $AC12 JR $AC02      ; Go back to #R$AC02
*$AC14 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Not one of them: NZ
 $AC16 RET           ; Return to the caller
*$AC17 LD (IY+$00),C ; Store C in the first byte of the record at IY - Found:
                     ; store its reference as the verb, take the slot, read on,
                     ; return Z
 $AC1A LD (IY+$01),B ; Store B in byte +1 of the record at IY
 $AC1D RES 1,E       ; Clear bit 1 of E
 $AC1F CALL $AE7F    ; Call the routine "Read the next token of the typed line"
                     ; (#R$AE7F)
 $AC22 XOR A         ; Set A to zero, which sets the zero flag for the caller
 $AC23 RET           ; Return to the caller

; Read a noun phrase into the pattern at $AAA8
;
; Addresses named in the title: #R$AAA3($AAA8).
; .
; Clears ten bytes at #R$AAA3($AAA8), then takes tokens: an article ($80) once;
; up to three of class $10 or $70 (prepositions; counted in #R$AAA3($AAA7),
; stored by #R$AC8F); adjectives ($60, by #R$AC94); and ends on the noun ($50)
; or a number ($F0), whose reference goes to #R$AAAB($AAAC). Carry when a word
; comes in the wrong place; on return NZ if bit 5 of E is set. Read from the
; code; the meaning of each E flag bit was not traced.
; .
; Instruction coverage over the 15 stored routes (9 November,
; tools/experiments/insn_coverage.py): all 53 instructions were executed.
; .
; How it works:
; .
; 1. Clear the ten bytes of the noun-phrase pattern at #R$AAA3($AAA8) and set E
; bits 2, 4 and 5.
; .
; 2. Take tokens. An article ($80) is allowed once, at the start; a second one
; returns carry.
; .
; 3. Up to three words of class $10 or $70 (adjectives and prepositions) are
; counted in #R$AAA3($AAA7) and stored by #R$AC8F or #R$AC94.
; .
; 4. A noun ends the phrase. The pattern is then copied into the node as the
; first or second object (#R$ACA6).
;
;  Input:E Flags for the kinds of word still allowed (bits 2, 4, 5)
; Output:F Carry set for a word out of place
;        E Updated
;        The ten-byte pattern at $AAA8
c$AC24 LD HL,$AAA8   ; Point HL at #R$AAA3($AAA8) - Clear the ten-byte pattern
 $AC27 LD B,$0A      ; Load B with $0A
 $AC29 CALL $A2AB    ; Call the routine "Fill B bytes at HL with zero (or, from
                     ; #R$A2AC, with A)" (#R$A2AB)
 $AC2C LD A,E        ; Copy E into A - E bits 2, 4 and 5: each kind of word
                     ; still allowed
 $AC2D OR $34        ; Set bits 2, 4, 5 of A (mask $34)
 $AC2F LD E,A        ; Copy A into E
*$AC30 CALL $AE7F    ; Next token
 $AC33 CP $80        ; Compare A with $80 - An article ($80): once only, at the
                     ; start
 $AC35 JR NZ,$AC41   ; If A differs from $80, skip ahead to #R$AC41
 $AC37 BIT 4,E       ; Test bit 4 of E
 $AC39 JR Z,$AC3F    ; If bit 4 of E is clear, skip ahead to #R$AC3F
 $AC3B RES 4,E       ; Clear bit 4 of E
 $AC3D JR $AC30      ; Go back to #R$AC30
*$AC3F SCF           ; Set the carry flag for the caller - Carry: a word out of
                     ; place
 $AC40 RET           ; Return to the caller
*$AC41 CP $10        ; Compare A with $10 - Class $10 or $70: only before any
                     ; adjective (#R$AAA3($AAA7) counts them, up to three)
 $AC43 JR Z,$AC49    ; If A equals $10, skip ahead to #R$AC49
 $AC45 CP $70        ; Compare A with $70
 $AC47 JR NZ,$AC65   ; If A differs from $70, skip ahead to #R$AC65
*$AC49 BIT 4,E       ; Test bit 4 of E
 $AC4B JR Z,$AC3F    ; If bit 4 of E is clear, go back to #R$AC3F
 $AC4D BIT 2,E       ; Test bit 2 of E
 $AC4F JR Z,$AC3F    ; If bit 2 of E is clear, go back to #R$AC3F
 $AC51 LD A,($AAA7)  ; Read #R$AAA3($AAA7) into A
 $AC54 CP $03        ; Compare A with $03
 $AC56 JR NC,$AC3F   ; If A is $03 or more, go back to #R$AC3F
 $AC58 INC A         ; Add one to A
 $AC59 LD ($AAA7),A  ; Store A in #R$AAA3($AAA7)
 $AC5C CALL $AC8F    ; Call the routine "Put word BC in the first empty pair at
                     ; #R$AAA3($AAA8) (NZ if..." (#R$AC8F) - Store it in one of
                     ; the two slots at #R$AAA3($AAA8) (#R$AC8F; a third is out
                     ; of place)
 $AC5F JR NZ,$AC3F   ; If the zero flag is clear, go back to #R$AC3F
 $AC61 RES 5,E       ; Clear bit 5 of E
 $AC63 JR $AC30      ; Go back to #R$AC30
*$AC65 CP $60        ; Compare A with $60 - An adjective ($60): in one of the
                     ; two slots at #R$AAAB($AAAE) (#R$AC94); no more articles
                     ; or class $10/$70 words
 $AC67 JR NZ,$AC78   ; If A differs from $60, skip ahead to #R$AC78
 $AC69 BIT 2,E       ; Test bit 2 of E
 $AC6B JR Z,$AC3F    ; If bit 2 of E is clear, go back to #R$AC3F
 $AC6D RES 4,E       ; Clear bit 4 of E
 $AC6F RES 5,E       ; Clear bit 5 of E
 $AC71 CALL $AC94    ; Call the routine "Put word BC in the first empty pair at
                     ; #R$AAAB($AAAE) (NZ if..." (#R$AC94)
 $AC74 JR NZ,$AC3F   ; If the zero flag is clear, go back to #R$AC3F
 $AC76 JR $AC30      ; Go back to #R$AC30
*$AC78 CP $F0        ; Compare A with $F0 - The noun ($50) or a number ($F0)
                     ; ends the phrase: its reference to #R$AAAB($AAAC)
 $AC7A JR Z,$AC80    ; If A equals $F0, skip ahead to #R$AC80
 $AC7C CP $50        ; Compare A with $50
 $AC7E JR NZ,$AC8B   ; If A differs from $50, skip ahead to #R$AC8B
*$AC80 LD A,E        ; Copy E into A
 $AC81 AND $CB       ; Keep only bits 0, 1, 3, 6, 7 of A (mask $CB)
 $AC83 LD E,A        ; Copy A into E
 $AC84 LD ($AAAC),BC ; Store BC in #R$AAAB($AAAC)
 $AC88 CALL $AE7F    ; and the token after it is read
*$AC8B AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry) - No carry; NZ if the phrase was empty (bit 5
                     ; still set)
 $AC8C BIT 5,E       ; Test bit 5 of E
 $AC8E RET           ; Return to the caller

