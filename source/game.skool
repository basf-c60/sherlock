                      ; again' flag)
 $E108 LD ($CAAE),A   ; Store A in "Flag: the player's view has changed"
                      ; (#R$CAAE)
 $E10B LD A,($A036)   ; Read #R$A032($A036) in "Game variables" into A - Only
                      ; the player (#R$A032($A036) = 0) goes on
 $E10E AND A          ; Clear the carry flag for the caller (A is unchanged)
