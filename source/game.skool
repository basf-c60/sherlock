                     ; ...Z: done
 $ACA5 RET           ; Return to the caller

; Copy the noun-phrase pattern into the node: first or second object
;
; Ten bytes from #R$AAA3($AAA8) to IY+4 (if E bit 6, which it clears) or to
; IY+$0E (if E bit 7); returns NZ, or Z if neither bit was set. Read from the
; code.
;
;  Input:E Bit 6: first object waiting; bit 7: second object
;        IY The sentence node
; Output:F NZ when stored; Z when neither was waiting
;        E The bit cleared
c$ACA6 BIT 6,E       ; Test bit 6 of E - E bit 6 (a first object is waiting to
                     ; be stored)?
 $ACA8 JR Z,$ACB2    ; If bit 6 of E is clear, skip ahead to #R$ACB2
 $ACAA RES 6,E       ; Clear bit 6 of E - Yes: clear it; the pattern goes to
                     ; the node's +4 (first object)
 $ACAC PUSH DE       ; Save DE on the stack
 $ACAD LD DE,$0004   ; Load DE with $0004
 $ACB0 JR $ACBB      ; Skip ahead to #R$ACBB
*$ACB2 BIT 7,E       ; Test bit 7 of E - Otherwise E bit 7 (a second object)?
                     ; If neither, return
 $ACB4 RET Z         ; If bit 7 of E is clear, return
 $ACB5 RES 7,E       ; Clear bit 7 of E - Clear it; the pattern goes to the
                     ; node's +14
 $ACB7 PUSH DE       ; Save DE on the stack
 $ACB8 LD DE,$000E   ; Load DE with $000E
*$ACBB PUSH IY       ; Save IY on the stack - HL = node + offset; copy the
                     ; ten-byte pattern from #R$AAA3($AAA8)
 $ACBD POP HL        ; Restore HL from the stack
 $ACBE ADD HL,DE     ; Add DE to HL
 $ACBF LD DE,$AAA8   ; Point DE at #R$AAA3($AAA8)
 $ACC2 EX DE,HL      ; Swap DE and HL
 $ACC3 LD BC,$000A   ; Load BC with $000A
 $ACC6 LDIR          ; Copy BC bytes from where HL points to where DE points,
                     ; counting up
 $ACC8 POP DE        ; Restore DE from the stack
 $ACC9 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - NZ: stored
 $ACCB RET           ; Return to the caller

; Note where this sentence started, so it can be read again
;
; Skips commas ($A0), then keeps the token position (#R$A022($A029), also in
; #R$A02A($A02B)), E, IY and #R$A012 at #R$AAA1-#R$AAA3($AAA6); when #R$A01A is
; 2 it marks the node with bit 6 of +1. Read from the code.
;
;  Input:E Flags
;        IY The sentence node
; Output:The start of the sentence saved at $AAA1 to $AAA6
c$ACCC RES 3,E        ; Clear bit 3 of E - E bit 3 clear: no clause finished
                      ; yet
 $ACCE PUSH DE        ; Save DE on the stack
*$ACCF CALL $AE7F     ; Call the routine "Read the next token of the typed
                      ; line" (#R$AE7F) - Skip commas (class $A0)
 $ACD2 CP $A0         ; Compare A with $A0
 $ACD4 JR Z,$ACCF     ; If A equals $A0, go back to #R$ACCF
 $ACD6 LD HL,($A029)  ; Read #R$A022($A029) in "Game variables" into HL -
                      ; Remember where this sentence starts: the token position
                      ; (#R$A022($A029))...
 $ACD9 LD ($AAA1),HL  ; Store HL in #R$AAA1
 $ACDC LD ($A02B),HL  ; Store HL in #R$A02A($A02B) in "Game variables"
 $ACDF POP DE         ; Restore DE from the stack
 $ACE0 LD A,E         ; Copy E into A - ...the flags in E, the node (IY) and
                      ; the sentence count (#R$A012)
 $ACE1 LD ($AAA3),A   ; Store A in #R$AAA3
 $ACE4 LD ($AAA4),IY  ; Store IY in #R$AAA3($AAA4)
 $ACE8 LD A,($A012)   ; Read #R$A012 in "Game variables" into A
 $ACEB LD ($AAA6),A   ; Store A in #R$AAA3($AAA6)
 $ACEE LD A,($A01A)   ; Read #R$A01A in "Game variables" into A - 'All but'
                      ; (#R$A01A = 2): mark the node with bit 6 of +1
 $ACF1 CP $02         ; Compare A with $02
 $ACF3 JR NZ,$AD57    ; If A differs from $02, jump on to the routine "Count
                      ; the sentence, then on to the next or finish" (#R$AD57)
 $ACF5 SET 6,(IY+$01) ; Set bit 6 of byte +1 of the record at IY
 $ACF9 JR $AD57       ; Jump on to the routine "Count the sentence, then on to
                      ; the next or finish" (#R$AD57)

; After a sentence: copy the objects on, or rewind to read it again
;
; In statement mode (#R$A022($A024) = 2) copies the node's six bytes from +8 to
; +$18 and parses on (#R$AB4C). Otherwise, unless #R$A01A($A01B) is set, goes
; back to the position saved by #R$ACCC and frees the nodes after it (#R$A1AF).
; Read from the code; what makes the parser re-read a sentence was not traced.
; .
; How it works:
; .
; 1. In statement mode (#R$A022($A024) = 2), do this once only: copy the node's
; first group of six bytes (+8) to the third group (+24), so the subject can be
; shared, and read on for the object (#R$AB4C).
; .
; 2. In command mode, if #R$A01A($A01B) is set (a line of sentences is being
; worked through), just read on.
; .
; 3. Otherwise go back to the start of the sentence, whose position, flags,
; sentence count and node were saved by #R$ACCC, free the nodes that were made
; after it (#R$A1AF) and unhook them, ready to read the sentence again.
;
; Input:E The flags for what may come next
;       IY The parse node
c$ACFB LD A,($A024)  ; Read #R$A022($A024) in "Game variables" into A - A
                     ; statement (#R$A022($A024) = 2)?
 $ACFE CP $02        ; Compare A with $02
 $AD00 JR NZ,$AD23   ; If A differs from $02, skip ahead to #R$AD23
 $AD02 BIT 6,E       ; Test bit 6 of E - Only once (E bit 6)
 $AD04 JP NZ,$AB4C   ; If bit 6 of E is set, go back to #R$AB4C
 $AD07 SET 6,E       ; Set bit 6 of E
 $AD09 SET 3,E       ; Set bit 3 of E
 $AD0B PUSH IY       ; Save IY on the stack - Copy the first group (+8) to the
                     ; third (+24)
 $AD0D EXX           ; Swap BC, DE and HL with their shadow copies
 $AD0E POP HL        ; Restore HL from the stack
 $AD0F LD DE,$0008   ; Load DE with $0008, the amount that is added next
 $AD12 ADD HL,DE     ; Add DE to HL
 $AD13 PUSH HL       ; Save HL on the stack
 $AD14 LD DE,$0010   ; Load DE with $0010, the amount that is added next
 $AD17 ADD HL,DE     ; Add DE to HL
 $AD18 POP DE        ; Restore DE from the stack
 $AD19 EX DE,HL      ; Swap DE and HL
 $AD1A LD BC,$0006   ; Load BC with $0006
 $AD1D LDIR          ; Copy BC bytes from where HL points to where DE points,
                     ; counting up
 $AD1F EXX           ; Swap BC, DE and HL with their shadow copies
 $AD20 JP $AB4C      ; and parse on
*$AD23 LD A,($A01B)  ; Read #R$A01A($A01B) in "Game variables" into A - A
                     ; command: with #R$A01A($A01B) set, just parse on
 $AD26 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $AD27 JR Z,$AD2E    ; If A is zero, skip ahead to #R$AD2E
 $AD29 SET 3,E       ; Set bit 3 of E
 $AD2B JP $AB4C      ; Go back to #R$AB4C
*$AD2E LD HL,($AAA1) ; Read #R$AAA1 into HL - Otherwise go back to the start of
                     ; the sentence (saved by #R$ACCC): its token position...
 $AD31 LD ($A02B),HL ; Store HL in #R$A02A($A02B) in "Game variables"
 $AD34 LD D,$B0      ; Load D with $B0 - ...the flags in E (D = $B0)...
 $AD36 LD A,($AAA3)  ; Read #R$AAA3 into A
 $AD39 LD E,A        ; Copy A into E
 $AD3A LD A,($AAA6)  ; Read #R$AAA3($AAA6) into A - ...the sentence count...
 $AD3D LD ($A012),A  ; Store A in #R$A012 in "Game variables"
 $AD40 LD IY,($AAA4) ; ...and its node
 $AD44 LD L,(IY-$02) ; Read byte -2 of the record at IY into L - Free the nodes
                     ; after it (#R$A1AF) and unhook them
 $AD47 LD H,(IY-$01) ; Read byte -1 of the record at IY into H
 $AD4A PUSH HL       ; Save HL on the stack
 $AD4B POP IX        ; Restore IX from the stack
 $AD4D CALL $A1AF    ; Call the routine "Free every node of the list starting
                     ; at IX" (#R$A1AF)
 $AD50 XOR A         ; Clear A to zero (and the carry flag)
 $AD51 LD (IY-$02),A ; Store A in byte -2 of the record at IY
 $AD54 LD (IY-$01),A ; Store A in byte -1 of the record at IY

; Count the sentence, then on to the next or finish
;
; Bumps the sentence counter #R$A012 (not for a comma in mode 2 of #R$A01A); a
; comma ($A0) goes back to read another sentence (#R$AABD). Read from the code
; in outline.
; .
; Tried in the emulator 2026-11-08: EXAMINE LAMP AND YOUR ARMCHAIR and DROP
; LAMP AND YOUR MONEY each run as two commands, the verb carried to the second;
; but GIVE LAMP AND YOUR MONEY TO WATSON (and with a comma for AND) gets I SEE
; NOTHING THAT YOU CAN GIVE, and PUT LAMP AND YOUR MONEY IN YOUR ARMCHAIR gets
; WHAT ?, though GIVE YOUR MONEY TO WATSON on its own works. The backward pass
; at #R$AE1E, which copies words from a later sentence into an earlier one with
; the same verb, never compares the last pair - see the Bugs page ('and-to').
; .
; How it works:
; .
; 1. Count the sentence in #R$A012, except for a comma in statement mode.
; .
; 2. A comma ($A0) goes back to read another sentence (#R$AABD).
; .
; 3. If a line of several sentences is being worked through (#R$A01A($A01B)
; set): if the second node has no verb of its own, carry its verb flag into the
; first node and fill the first node's empty word slots from the second
; (#R$AE59). Then drop the first node of the list.
; .
; 4. Go through the sentences from the start. In a statement whose third group
; is empty, take the previous sentence's group. A sentence with no verb is
; merged into the previous one (#R$AEF1).
; .
; 5. Then go backwards from the last sentence: where an earlier sentence has
; the same verb as a later one and no second group of its own, copy the later
; sentence's second group into it (#R$AF27). So EXAMINE LAMP AND YOUR ARMCHAIR
; is understood as two commands with the same verb. The loop never compares the
; last pair; see the Bugs page.
; .
; 6. Return Z: done.
;
;  Input:D The token class last read
;        E Flags
; Output:F Z when the sentences have been tidied
c$AD57 LD A,($A01A)  ; Read #R$A01A in "Game variables" into A - Count the
                     ; sentence (#R$A012) - but not a comma in mode 2 (#R$A01A)
 $AD5A DEC A         ; Subtract one from A
 $AD5B LD HL,$A012   ; Point HL at #R$A012 in "Game variables"
 $AD5E DEC A         ; Subtract one from A
 $AD5F LD A,D        ; Copy D into A
 $AD60 JR NZ,$AD66   ; If A is not zero, skip ahead to #R$AD66
 $AD62 CP $A0        ; Compare A with $A0
 $AD64 JR Z,$AD67    ; If A equals $A0, skip ahead to #R$AD67
*$AD66 INC (HL)      ; Add one to the byte HL points at
*$AD67 CP $A0        ; Compare A with $A0 - A comma: back to read another
                     ; sentence (#R$AABD)
 $AD69 JP Z,$AABD    ; If A equals $A0, go back to #R$AABD
 $AD6C LD A,($A01B)  ; Read #R$A01A($A01B) in "Game variables" into A -
                     ; #R$A01A($A01B) set (the line had sentences waiting)?
 $AD6F AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $AD70 JR Z,$ADD4    ; If A is zero, jump on to #R$ADD4
 $AD72 LD IY,($9FF0) ; Read words the player has (#R$9FF0) into IY - Then look
                     ; at the second node of the sentence list
 $AD76 CALL $AEA9    ; Call the routine "IY = the next node in the list (Z at
                     ; the end)" (#R$AEA9)
 $AD79 LD A,(IY+$01) ; Read byte +1 of the record at IY into A - Has it a verb
                     ; of its own?
 $AD7C AND $7F       ; Keep only bits 0, 1, 2, 3, 4, 5, 6 of A (mask $7F)
 $AD7E OR (IY+$00)   ; Set in A the bits that are set in the first byte of the
                     ; record at IY
 $AD81 JR NZ,$ADB8   ; If the result is not zero, jump on to #R$ADB8
 $AD83 LD A,($A01B)  ; Read #R$A01A($A01B) in "Game variables" into A - No:
                     ; carry the verb's bit 7 into the first node...
 $AD86 LD E,A        ; Copy A into E
 $AD87 LD D,$00      ; Load D with $00
 $AD89 LD HL,($9FF0) ; Read words the player has (#R$9FF0) into HL
 $AD8C LD A,(IY+$01) ; Read byte +1 of the record at IY into A
 $AD8F AND $80       ; Isolate bit 7 of A (mask $80)
 $AD91 INC HL        ; Step HL on to the next byte
 $AD92 OR (HL)       ; Set in A the bits that are set in the byte HL points at
 $AD93 LD (HL),A     ; Store A at the address HL points to
 $AD94 DEC HL        ; Step HL back one byte
 $AD95 ADD HL,DE     ; Add DE to HL - ...and fill in the empty word slots at
                     ; the first node + #R$A01A($A01B) from the second node's
                     ; words (#R$AE59)
 $AD96 LD DE,$0008   ; Load DE with $0008, the amount that is added next
 $AD99 ADD IY,DE     ; Add DE to IY - IY + DE: the slot
 $AD9B PUSH IY       ; Save IY on the stack
 $AD9D POP DE        ; Restore DE from the stack
 $AD9E CALL $AE59    ; Fill the first word from DE unless it already has one
                     ; (#R$AE59)
 $ADA1 CALL $AE59    ; ...and the second
 $ADA4 JR Z,$ADAF    ; Nothing to add: skip
 $ADA6 PUSH DE       ; Save DE on the stack - Else fill the pair two bytes back
                     ; too
 $ADA7 PUSH HL       ; Save HL on the stack
 $ADA8 DEC DE        ; Step DE back one byte
 $ADA9 DEC DE        ; Step DE back one byte
 $ADAA CALL $AE59    ; Call the routine "Fill in a word reference at HL from
                     ; DE, unless HL..." (#R$AE59)
 $ADAD POP HL        ; Restore HL from the stack
 $ADAE POP DE        ; Restore DE from the stack
*$ADAF CALL $AE59    ; Call the routine "Fill in a word reference at HL from
                     ; DE, unless HL..." (#R$AE59)
 $ADB2 LD IY,($9FF0) ; Read words the player has (#R$9FF0) into IY - Then drop
                     ; the first node of the list
 $ADB6 JR $ADBC      ; Skip ahead to #R$ADBC
*$ADB8 LD IY,$9FF2   ; (with a verb: drop the first node of the rest of the
                     ; line, #R$9FF2)
*$ADBC LD L,(IY-$02) ; Read byte -2 of the record at IY into L - IX = the
                     ; list's first node; unhook it...
 $ADBF LD H,(IY-$01) ; Read byte -1 of the record at IY into H
 $ADC2 PUSH HL       ; Save HL on the stack
 $ADC3 POP IX        ; Restore IX from the stack
 $ADC5 LD L,(IX-$02) ; Read byte -2 of the record at IX into L
 $ADC8 LD H,(IX-$01) ; Read byte -1 of the record at IX into H
 $ADCB LD (IY-$02),L ; Store L in byte -2 of the record at IY
 $ADCE LD (IY-$01),H ; Store H in byte -1 of the record at IY
 $ADD1 CALL $A1C7    ; ...and free it (#R$A1C7)
*$ADD4 LD IY,$9FF2   ; Point IY at #R$9FF2 in "Game variables" - Now go through
                     ; the sentences (#R$A012 of them) from the start
 $ADD8 LD A,($A012)  ; Read #R$A012 in "Game variables" into A
 $ADDB LD B,A        ; Copy A into B
 $ADDC PUSH BC       ; Save BC on the stack
 $ADDD CALL $AEB6    ; Call the routine "Step forward over nodes marked with
                     ; bit 6 of +1" (#R$AEB6)
*$ADE0 LD A,B        ; Copy B into A
 $ADE1 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $ADE2 JR Z,$AE1E    ; If A is zero, jump on to #R$AE1E
 $ADE4 CALL $AEB6    ; Next sentence's node (skipping those marked by bit 6 of
                     ; +1)
 $ADE7 LD A,($A024)  ; Read #R$A022($A024) in "Game variables" into A - A
                     ; statement (#R$A022($A024) = 2) whose third group (+24)
                     ; is empty...
 $ADEA CP $02        ; Compare A with $02
 $ADEC JR NZ,$AE11   ; If A differs from $02, skip ahead to #R$AE11
 $ADEE PUSH IY       ; Save IY on the stack - HL = the node at IY + $18...
 $ADF0 POP HL        ; Restore HL from the stack
 $ADF1 LD DE,$0018   ; Load DE with $0018, the amount that is added next
 $ADF4 ADD HL,DE     ; Add DE to HL
 $ADF5 PUSH HL       ; Save HL on the stack
 $ADF6 LD D,$06      ; Load D with $06 - ...OR together its 6 bytes
 $ADF8 XOR A         ; Clear A to zero (and the carry flag)
*$ADF9 OR (HL)       ; Set in A the bits that are set in the byte HL points at
 $ADFA INC HL        ; Step HL on to the next byte
 $ADFB DEC D         ; Subtract one from D
 $ADFC JR NZ,$ADF9   ; If D is not zero, go back to #R$ADF9
 $ADFE POP HL        ; Restore HL from the stack
 $ADFF AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry) - Z if all of them are zero (the slot is empty)
 $AE00 JR NZ,$AE11   ; If A is not zero, skip ahead to #R$AE11
 $AE02 EX DE,HL      ; Swap DE and HL - ...takes the previous sentence's
 $AE03 PUSH IX       ; Save IX on the stack
 $AE05 POP HL        ; Restore HL from the stack
 $AE06 PUSH BC       ; Save BC on the stack
 $AE07 LD BC,$0018   ; Load BC with $0018, the amount that is added next
 $AE0A ADD HL,BC     ; Add BC to HL
 $AE0B LD BC,$0006   ; Load BC with $0006
 $AE0E LDIR          ; Copy BC bytes from where HL points to where DE points,
                     ; counting up
 $AE10 POP BC        ; Restore BC from the stack
*$AE11 LD A,(IY+$01) ; Read byte +1 of the record at IY into A - A sentence
                     ; with no verb is merged with the previous one (#R$AEF1)
 $AE14 AND $7F       ; Keep only bits 0, 1, 2, 3, 4, 5, 6 of A (mask $7F)
 $AE16 OR (IY+$00)   ; Set in A the bits that are set in the first byte of the
                     ; record at IY
 $AE19 CALL Z,$AEF1  ; If the result is zero, call the routine "Merge parse
                     ; node IX into node IY" (#R$AEF1)
 $AE1C JR $ADE0      ; Go back to #R$ADE0
*$AE1E POP BC        ; Restore BC from the stack - Then backwards from the last
                     ; node
 $AE1F CALL $AEEA    ; Call the routine "IY = the last node of the sentence
                     ; list" (#R$AEEA)
 $AE22 CALL $AEC5    ; Call the routine "IY = the node before IY in the
                     ; sentence list (#R$9FF0)" (#R$AEC5) - One step back
                     ; already - so the loop below never compares the last pair
                     ; (see Bugs)
*$AE25 LD A,B        ; Copy B into A
 $AE26 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $AE27 JP Z,$AE57    ; If A is zero, jump on to #R$AE57
 $AE2A CALL $AEC5    ; Call the routine "IY = the node before IY in the
                     ; sentence list (#R$9FF0)" (#R$AEC5) - Each earlier
                     ; sentence with no second group (+18),
 $AE2D LD A,(IY+$12) ; Read byte +18 of the record at IY into A
 $AE30 OR (IY+$13)   ; Set in A the bits that are set in byte +19 of the record
                     ; at IY
 $AE33 JR NZ,$AE25   ; If the result is not zero, go back to #R$AE25
 $AE35 LD A,(IY+$00) ; Read the first byte of the record at IY into A - the
                     ; same verb as the later one,
 $AE38 CP (IX+$00)   ; Compare A with the first byte of the record at IX
 $AE3B JR NZ,$AE25   ; If A differs from the first byte of the record at IX, go
                     ; back to #R$AE25
 $AE3D LD A,(IY+$01) ; Read byte +1 of the record at IY into A
 $AE40 CP (IX+$01)   ; Compare A with byte +1 of the record at IX
 $AE43 JR NZ,$AE25   ; If A differs from byte +1 of the record at IX, go back
                     ; to #R$AE25
 $AE45 LD A,(IX+$0E) ; Read byte +14 of the record at IX into A - where the
                     ; later one has words at +14...
 $AE48 OR (IX+$0F)   ; Set in A the bits that are set in byte +15 of the record
                     ; at IX
 $AE4B JR Z,$AE25    ; If the result is zero, go back to #R$AE25
 $AE4D EXX           ; Swap BC, DE and HL with their shadow copies - ...has
                     ; words copied from it (#R$AF27, from +14)
 $AE4E LD DE,$000E   ; Load DE with $000E
 $AE51 CALL $AF27    ; Call #R$AF27 (inside "Merge parse node IX into node IY")
 $AE54 JP $AE25      ; Go back to #R$AE25
*$AE57 XOR A         ; Set A to zero, which sets the zero flag for the caller -
                     ; Done: Z
 $AE58 RET           ; Return to the caller

; Fill in a word reference at HL from DE, unless HL already has one
;
; Byte by byte; HL and DE both move on two. Read from the code.
;
;  Input:HL A word reference slot
;        DE The word to copy in
; Output:HL, DE Both moved on two bytes
c$AE59 LD A,(HL)     ; Read the byte HL points at into A - Copy the word at DE
                     ; to HL unless HL already holds one (Z if it was empty)
 $AE5A INC HL        ; Step HL on to the next byte
 $AE5B OR (HL)       ; Set in A the bits that are set in the byte HL points at
 $AE5C DEC HL        ; Step HL back one byte
 $AE5D JR NZ,$AE61   ; If the result is not zero, skip ahead to #R$AE61
 $AE5F LD A,(DE)     ; Read the byte DE points at into A
 $AE60 LD (HL),A     ; Store A at the address HL points to
*$AE61 INC HL        ; Step HL on to the next byte
 $AE62 INC DE        ; Step DE on to the next byte
 $AE63 JR NZ,$AE67   ; If the result is not zero, skip ahead to #R$AE67
 $AE65 LD A,(DE)     ; Read the byte DE points at into A
 $AE66 LD (HL),A     ; Store A at the address HL points to
*$AE67 INC HL        ; Step HL on to the next byte
 $AE68 INC DE        ; Step DE on to the next byte
 $AE69 RET           ; Return to the caller

; Add a new node to the end of the sentence list
;
; Finds the last node (#R$AEEA), allocates 30 bytes (#R$A11C) and links the new
; block in after it; IY = the new node. Read from the code.
;
; Output:IY The new 30-byte node, linked after the last
c$AE6A CALL $AEEA    ; Go to the last node of the list (#R$AEEA)
 $AE6D LD A,$1E      ; Load A with $1E - Allocate a node of $1E bytes (#R$A11C)
 $AE6F CALL $A11C    ; Call the routine "Allocate A + 3 bytes from the free
                     ; list, cleared" (#R$A11C)
 $AE72 PUSH IX       ; Save IX on the stack - Link it after the last: the old
                     ; last node's link (IY-2)...
 $AE74 POP HL        ; Restore HL from the stack
 $AE75 LD (IY-$02),L ; Store L in byte -2 of the record at IY
 $AE78 LD (IY-$01),H ; Store H in byte -1 of the record at IY
 $AE7B PUSH HL       ; Save HL on the stack - ...points to it; IY = the new
                     ; node
 $AE7C POP IY        ; Restore IY from the stack
 $AE7E RET           ; Return to the caller

; Read the next token of the typed line
;
; The word list built by #R$D715 (#LINK(rom_symbols#a5B81)($5B81) on) is a run
; of tokens: a class byte, then - for classes below $80 and for $90, $E0 and
; $F0 - a 2-byte word reference (high byte first) or value. Returns the class
; in A and D and the reference in BC, keeps the previous class at
; #R$A02A($A02D) and the token's address at #R$A022($A029).
; .
; Confirmed in the emulator (tools/experiments/tokens_test.py): 'TAKE THE LAMP,
; EXAMINE IT. PAY 2/6 TO WATSON' becomes $30 TAKE, $80 (THE, no reference), $50
; LAMP, $A0 (comma), $30 EXAMINE, $90 IT, $B0 (full stop), $30 PAY, $F0
; #R$809A($809E) (2/6, 30 pence), $70 TO, $50 WATSON, $B0, $C0 (end). So $30 is
; a verb, $50 a noun, $70 a preposition, $80 a word with no meaning to the
; parser, $90 a special word (the table at #R$AF6B: IT, HE, QUIT, a quote
; mark...), $F0 a number or money, $A0 a comma, $B0 a full stop, $C0 the end.
; Other classes ($00, $20, $40, $E0, read by #R$AB91) were not seen in this
; line.
; .
; How it works:
; .
; 1. Remember where the token starts (#R$A022($A029)) and the class of the one
; before (#R$A02A($A02D)).
; .
; 2. The class is the first byte. Classes $E0, $F0, $90 and those below $80
; have a two-byte word after them, which is returned in BC.
; .
; 3. Save the position after the token and return the class in A.
;
;  Input:D The previous class
; Output:A, D The class of the token
;        BC The word reference (for classes with one)
;        $A029 Where this token started
;        $A02B The position after it
c$AE7F LD HL,($A02B) ; Read #R$A02A($A02B) in "Game variables" into HL - Where
                     ; this token starts
 $AE82 LD ($A029),HL ; Store HL in #R$A022($A029) in "Game variables"
 $AE85 LD A,D        ; Copy D into A - Remember the previous class
 $AE86 LD ($A02D),A  ; Store A in #R$A02A($A02D) in "Game variables"
 $AE89 LD A,(HL)     ; Read the byte HL points at into A - The class
 $AE8A LD D,A        ; Copy A into D
 $AE8B LD BC,$0000   ; Load BC with $0000
 $AE8E INC HL        ; Step HL on to the next byte
 $AE8F CP $E0        ; Compare A with $E0 - Classes with a word after them...
 $AE91 JR Z,$AE9F    ; If A equals $E0, skip ahead to #R$AE9F
 $AE93 CP $F0        ; Compare A with $F0
 $AE95 JR Z,$AE9F    ; If A equals $F0, skip ahead to #R$AE9F
 $AE97 CP $90        ; Compare A with $90
 $AE99 JR Z,$AE9F    ; If A equals $90, skip ahead to #R$AE9F
 $AE9B CP $80        ; Compare A with $80
 $AE9D JR NC,$AEA4   ; If A is $80 or more, skip ahead to #R$AEA4
*$AE9F LD A,(HL)     ; Read the byte HL points at into A - ...BC = the word
 $AEA0 LD B,A        ; Copy A into B
 $AEA1 INC HL        ; Step HL on to the next byte
 $AEA2 LD C,(HL)     ; Read the byte HL points at into C
 $AEA3 INC HL        ; Step HL on to the next byte
*$AEA4 LD ($A02B),HL ; Store HL in #R$A02A($A02B) in "Game variables" - Step
                     ; past the token
 $AEA7 LD A,D        ; Copy D into A
 $AEA8 RET           ; Return to the caller

; IY = the next node in the list (Z at the end)
;
; The link is the two bytes before the node (IY-2, IY-1), as in every heap
; block (#R$A11C). Read from the code.
; .
; Checked 9 November over the first 120 commands of the winning route: 320
; runs, every one met its stated postcondition (IY = the link word before the
; node).
;
;  Input:IY A node
; Output:IY The next node
;        F Z at the end of the list
c$AEA9 PUSH HL       ; Save HL on the stack - As #R$A0F7 but for IY: IY = the
                     ; next node, Z at the end
 $AEAA LD L,(IY-$02) ; Read byte -2 of the record at IY into L
 $AEAD LD H,(IY-$01) ; Read byte -1 of the record at IY into H
 $AEB0 LD A,H        ; Copy H into A
 $AEB1 OR L          ; Set in A the bits that are set in L
 $AEB2 EX (SP),HL    ; Swap HL with the word on top of the stack
 $AEB3 POP IY        ; Restore IY from the stack
 $AEB5 RET           ; Return to the caller

; Step forward over nodes marked with bit 6 of +1
;
; IX = the node before. Read from the code.
;
;  Input:IY A node
;        B The sentence count
; Output:IY The next node not marked BUT
;        IX The node before
;        B One fewer
c$AEB6 DEC B          ; Subtract one from B - Step on over nodes marked with
                      ; bit 6 of +1 (BUT nodes); B is one fewer
*$AEB7 PUSH IY        ; Save IY on the stack
 $AEB9 POP IX         ; Restore IX from the stack
 $AEBB CALL $AEA9     ; Call the routine "IY = the next node in the list (Z at
                      ; the end)" (#R$AEA9)
 $AEBE BIT 6,(IY+$01) ; Test bit 6 of byte +1 of the record at IY
 $AEC2 JR NZ,$AEB7    ; If bit 6 of byte +1 of the record at IY is set, go back
                      ; to #R$AEB7
 $AEC4 RET            ; Return to the caller

; IY = the node before IY in the sentence list ($9FF0)
;
; Addresses named in the title: #R$9FF0.
; .
; Through #R$A104, stepping back over nodes marked with bit 6 of +1 and
; stopping at the head (#R$9FF2). Read from the code.
;
;  Input:IY A node
;        B The sentence count
; Output:IY The node before it, skipping nodes marked BUT
;        IX The node given
;        B One fewer
c$AEC5 DEC B          ; One sentence fewer (#R$A012 is kept in B)
; This entry point is used by the routines at #R$AEEA and #R$B0FD.
*$AEC6 PUSH IY        ; Save IY on the stack - IX = the node, then IY = the
                      ; node before it in the list at #R$9FF0 (#R$A104)
 $AEC8 POP IX         ; Restore IX from the stack
 $AECA PUSH HL        ; Save HL on the stack
 $AECB PUSH DE        ; Save DE on the stack
*$AECC PUSH IY        ; Save IY on the stack
 $AECE POP DE         ; Restore DE from the stack
 $AECF LD IY,$9FF0    ; Point IY at words the player has (#R$9FF0)
 $AED3 CALL $A104     ; Call the routine "Find the node before node DE in the
                      ; list at IY" (#R$A104)
 $AED6 PUSH IY        ; Save IY on the stack - At the head of the list
                      ; (#R$9FF2)? Then stop
 $AED8 POP HL         ; Restore HL from the stack
 $AED9 LD DE,$9FF2    ; Point DE at #R$9FF2 in "Game variables"
 $AEDC AND A          ; Clear the carry flag, so that the subtraction that
                      ; follows is a plain one (a compare)
 $AEDD SBC HL,DE      ; Subtract DE from HL (a compare: carry = HL was smaller,
                      ; zero = equal)
 $AEDF JR Z,$AEE7     ; If the two values are equal, skip ahead to #R$AEE7
 $AEE1 BIT 6,(IY+$01) ; Test bit 6 of byte +1 of the record at IY - Skip nodes
                      ; marked with bit 6 of +1 (BUT nodes)
 $AEE5 JR NZ,$AECC    ; If bit 6 of byte +1 of the record at IY is set, go back
                      ; to #R$AECC
*$AEE7 POP DE         ; Restore DE from the stack
 $AEE8 POP HL         ; Restore HL from the stack
 $AEE9 RET            ; Return to the caller

; IY = the last node of the sentence list
;
; #R$AEC6 with IY = 0: the node before 'none' is the last.
;
; Output:IY The last node of the sentence list
c$AEEA LD IY,$0000   ; Load IY with $0000 - Entry for the first node: IY = 0,
                     ; then as above
 $AEEE JP $AEC6      ; Go back to #R$AEC6

; Merge parse node IX into node IY
;
; ORs in IX's flag byte (bit 7 dropped) and takes its first byte; if IX has
; words at +4/+5 and IY's ten bytes from +$0E are empty (#R$AF38), moves IY's
; six bytes from +8 up to +$12 and copies IX's words in (#R$AF52, and #R$AF56
; for the +2 pair if IY has none). Read from the code; what each field holds
; was not traced.
; .
; How it works:
; .
; 1. IY takes IX's verb: the low byte at +0 and the other flag bits from +1
; (without bit 7).
; .
; 2. If IX has no words at +4 and +5 there is nothing more to do.
; .
; 3. If IY already has words at +14 to +23 stop. Otherwise move IY's first
; group up to the second group and copy IX's words from +4.
; .
; 4. Copy IX's second word in as well if IY has none.
;
;  Input:IX The node to merge
;        IY The node to merge it into
; Output:IY Updated
c$AEF1 EXX           ; Swap BC, DE and HL with their shadow copies
 $AEF2 LD A,(IX+$01) ; Read byte +1 of the record at IX into A - Node IY takes
                     ; IX's verb (+0, and +1 without bit 7 but keeping its own
                     ; bits)
 $AEF5 AND $7F       ; Keep only bits 0, 1, 2, 3, 4, 5, 6 of A (mask $7F)
 $AEF7 OR (IY+$01)   ; Set in A the bits that are set in byte +1 of the record
                     ; at IY
 $AEFA LD (IY+$01),A ; Store A in byte +1 of the record at IY
 $AEFD LD A,(IX+$00) ; Read the first byte of the record at IX into A
 $AF00 LD (IY+$00),A ; Store A in the first byte of the record at IY
 $AF03 EXX           ; Swap BC, DE and HL with their shadow copies
 $AF04 LD A,(IX+$04) ; Read byte +4 of the record at IX into A - Nothing at
                     ; IX's +4: done
 $AF07 OR (IX+$05)   ; Set in A the bits that are set in byte +5 of the record
                     ; at IX
 $AF0A RET Z         ; If the result is zero, return
 $AF0B LD A,$0E      ; Load A with $0E - IY's +14 to +23 not all empty
                     ; (#R$AF38): done
 $AF0D CALL $AF38    ; Call the routine "Z if the ten bytes at IY + A are all
                     ; zero" (#R$AF38)
 $AF10 RET NZ        ; If the zero flag is clear, return
 $AF11 EXX           ; Swap BC, DE and HL with their shadow copies - Otherwise
                     ; IY's first group (+8) moves to its second (+18)...
 $AF12 PUSH IY       ; Save IY on the stack
 $AF14 POP HL        ; Restore HL from the stack
 $AF15 LD DE,$0012   ; Load DE with $0012, the amount that is added next
 $AF18 ADD HL,DE     ; Add DE to HL
 $AF19 PUSH HL       ; Save HL on the stack
 $AF1A LD DE,$FFF6   ; Load DE with #R$FFEF($FFF6) (-10 as a signed offset),
                     ; the amount that is added next
 $AF1D ADD HL,DE     ; Add DE to HL
 $AF1E POP DE        ; Restore DE from the stack
 $AF1F LD BC,$0006   ; Load BC with $0006
 $AF22 LDIR          ; Copy BC bytes from where HL points to where DE points,
                     ; counting up
 $AF24 LD DE,$0004   ; Load DE with $0004 - ...and IY takes IX's words from +4
                     ; to +13 (#R$AF52)
; This entry point is used by the routine at #R$AD57.
*$AF27 CALL $AF52    ; Call #R$AF52 (inside "Copy 6, 10 or 2 bytes from IX + DE
                     ; to IY +...")
 $AF2A LD A,(IY+$02) ; Read byte +2 of the record at IY into A - and IX's +2
                     ; too if IY has none (#R$AF56)
 $AF2D OR (IY+$03)   ; Set in A the bits that are set in byte +3 of the record
                     ; at IY
 $AF30 LD DE,$0002   ; Load DE with $0002
 $AF33 CALL Z,$AF56  ; If the result is zero, call #R$AF56 (inside "Copy 6, 10
                     ; or 2 bytes from IX + DE to IY +...")
 $AF36 EXX           ; Swap BC, DE and HL with their shadow copies
 $AF37 RET           ; Return to the caller

; Z if the ten bytes at IY + A are all zero
;
; Read from the code.
;
;  Input:IY A node
;        A The offset into it
; Output:F Z if the ten bytes at IY + A are all zero
;        Registers kept
c$AF38 PUSH DE       ; Save DE on the stack - Save registers
 $AF39 PUSH BC       ; Save BC on the stack
 $AF3A PUSH HL       ; Save HL on the stack
 $AF3B LD B,$0A      ; Load B with $0A - 10 bytes at IY + A...
 $AF3D PUSH IY       ; Save IY on the stack
 $AF3F POP HL        ; Restore HL from the stack
 $AF40 LD E,A        ; Copy A into E
 $AF41 LD D,$00      ; Load D with $00
 $AF43 ADD HL,DE     ; Add DE to HL
 $AF44 XOR A         ; Clear A to zero (and the carry flag) - ...ORed together
*$AF45 OR (HL)       ; Set in A the bits that are set in the byte HL points at
 $AF46 INC HL        ; Step HL on to the next byte
 $AF47 DJNZ $AF45    ; Count B down and, while it is not zero, go back to
                     ; #R$AF45
 $AF49 POP HL        ; Restore HL from the stack - Restore; Z if all ten were
                     ; zero (AND A also clears carry)
 $AF4A POP BC        ; Restore BC from the stack
 $AF4B POP DE        ; Restore DE from the stack
 $AF4C AND A         ; Clear the carry flag for the caller (A is unchanged)
 $AF4D RET           ; Return to the caller

; Copy 6, 10 or 2 bytes from IX + DE to IY + DE
;
; Entries #R$AF4E (6), #R$AF52 (10) and #R$AF56 (2). Read from the code.
;
;  Input:DE The offset
;        IX, IY The two nodes
; Output:6 bytes copied (entry $AF52 copies 10, $AF56 copies 2)
c$AF4E LD C,$06      ; Load C with $06 - Copy 6 bytes (#R$AF4E), 10 (#R$AF52)
                     ; or 2 (#R$AF56) - entry points set the count in C
 $AF50 JR $AF58      ; Skip ahead to #R$AF58
; This entry point is used by the routine at #R$AEF1.
*$AF52 LD C,$0A      ; Load C with $0A - ...10...
 $AF54 JR $AF58      ; Skip ahead to #R$AF58
; This entry point is used by the routine at #R$AEF1.
*$AF56 LD C,$02      ; ...or 2
*$AF58 PUSH IY       ; Save IY on the stack - Source = IY + DE, destination =
                     ; IX + DE
 $AF5A POP HL        ; Restore HL from the stack
 $AF5B ADD HL,DE     ; Add DE to HL
 $AF5C PUSH HL       ; Save HL on the stack
 $AF5D PUSH IX       ; Save IX on the stack
 $AF5F POP HL        ; Restore HL from the stack
 $AF60 ADD HL,DE     ; Add DE to HL
 $AF61 POP DE        ; Restore DE from the stack
 $AF62 LD B,$00      ; Load B with $00 - BC = the count; block copy
 $AF64 LDIR          ; Copy BC bytes from where HL points to where DE points,
                     ; counting up
 $AF66 RET           ; Return to the caller

; Not a special word: NZ
;
; Used by the routines at #R$AAB2, #R$AFB3, #R$AFE1 and #R$B01C.
;
; Output:F NZ
;        A 1
c$AF67 LD A,$01      ; Load A with $01
 $AF69 AND A         ; Clear the carry flag for the caller (A is unchanged)
 $AF6A RET           ; Return to the caller

; Special words and their handlers
;
; Four-byte entries (word reference, handler). #R$AFB3 searches the first
; twelve for an ordinary sentence, and only the last six - THATS, HE, IT, THEY,
; BECAUSE, THEREFORE - inside something said to a character (#R$A022($A024) =
; 2). HE, IT and THEY appear twice with different handlers, one per search.
; CORRECTED: the automatic split had this as code.
b$AF6B DEFB $00,$00,$49,$B0 ; a quote mark -> #R$B049
 $AF6F DEFB $40,$00,$33,$B0 ; ALL -> #R$B033
 $AF73 DEFB $5E,$01,$1C,$B0 ; BUT -> #R$B01C
 $AF77 DEFB $D5,$06,$FF,$AF ; PRINT -> #R$AFFF
 $AF7B DEFB $BD,$05,$0B,$B0 ; NOPRINT -> #R$B00B
 $AF7F DEFB $07,$05,$A3,$B0 ; LOAD -> #R$B0A3
 $AF83 DEFB $75,$07,$C6,$B0 ; SAVE -> #R$B0C6
 $AF87 DEFB $60,$06,$9A,$B0 ; PAUSE -> #R$B09A
 $AF8B DEFB $E3,$03,$35,$B1 ; HE -> #R$B135
 $AF8F DEFB $88,$04,$51,$B1 ; IT -> #R$B151
 $AF93 DEFB $F6,$06,$A3,$B0 ; QUIT -> #R$B0A3
 $AF97 DEFB $B3,$08,$51,$B1 ; THEY -> #R$B151
 $AF9B DEFB $99,$08,$FD,$B0 ; THATS -> #R$B0FD
 $AF9F DEFB $E3,$03,$3F,$B1 ; HE -> #R$B13F
 $AFA3 DEFB $88,$04,$5B,$B1 ; IT -> #R$B15B
 $AFA7 DEFB $B3,$08,$5B,$B1 ; THEY -> #R$B15B
 $AFAB DEFB $C5,$00,$FA,$AF ; BECAUSE -> #R$AFFA
 $AFAF DEFB $AE,$08,$FA,$AF ; THEREFORE -> #R$AFFA

; Is word BC a special word? Then run its handler
;
; Searches the table at #R$AF6B (see there for which part) and jumps to the
; handler; otherwise NZ (#R$AF67). Read from the code.
; .
; How it works:
; .
; 1. Pick the table: the twelve special words at #R$AF6B, or - when the parser
; is reading speech (#R$A022($A024) = 2) - only the last six, from #R$AF9B.
; .
; 2. Each entry is four bytes: a dictionary word reference followed by the
; address of a handler. Compare the word in BC with each entry in turn.
; .
; 3. No match: return NZ, and the word is an ordinary one.
; .
; 4. A match: take the handler's address and jump to it. The handler does the
; work and returns to the parser's caller.
;
;  Input:BC The word reference
; Output:F NZ if the word is not special (otherwise the handler runs)
c$AFB3 LD HL,$AF6B   ; The ordinary words...
 $AFB6 LD A,($A024)  ; Read #R$A022($A024) in "Game variables" into A -
                     ; ...unless this is speech
 $AFB9 CP $02        ; Compare A with $02
 $AFBB JR NZ,$AFC0   ; If A differs from $02, skip ahead to #R$AFC0
 $AFBD LD HL,$AF9B   ; Point HL at #R$AF9B in "Special words and their
                     ; handlers" - Speech: the last six
*$AFC0 PUSH DE       ; Save DE on the stack
 $AFC1 LD E,$0C      ; Load E with $0C - Twelve entries...
 $AFC3 JR NZ,$AFC7   ; If A differs from $02, skip ahead to #R$AFC7
 $AFC5 LD E,$06      ; ...or six
*$AFC7 LD A,(HL)     ; Read the byte HL points at into A - This word?
 $AFC8 INC HL        ; Step HL on to the next byte
 $AFC9 CP C          ; Compare A with C
 $AFCA JR NZ,$AFD0   ; If A differs from C, skip ahead to #R$AFD0
 $AFCC LD A,(HL)     ; Read the byte HL points at into A
 $AFCD CP B          ; Compare A with B
 $AFCE JR Z,$AFDA    ; If A equals B, skip ahead to #R$AFDA
*$AFD0 INC HL        ; Step HL on to the next byte - No: next entry
 $AFD1 INC HL        ; Step HL on to the next byte
 $AFD2 INC HL        ; Step HL on to the next byte
 $AFD3 DEC E         ; Subtract one from E
 $AFD4 JR NZ,$AFC7   ; If E is not zero, go back to #R$AFC7
 $AFD6 POP DE        ; Restore DE from the stack - Not special
 $AFD7 JP $AF67      ; Go back to the routine "Not a special word: NZ"
                     ; (#R$AF67)
*$AFDA INC HL        ; Step HL on to the next byte - Yes: its handler
 $AFDB LD E,(HL)     ; Read the byte HL points at into E
 $AFDC INC HL        ; Step HL on to the next byte
 $AFDD LD D,(HL)     ; Read the byte HL points at into D
 $AFDE EX DE,HL      ; Swap DE and HL
 $AFDF POP DE        ; Restore DE from the stack
 $AFE0 JP (HL)       ; Run it

; Handler guards: only at the start of a sentence (not traced)
;
; #R$AFE1 and #R$AFE8 throw the word back as ordinary (#R$AF67) when the parse
; so far (#R$A012, #R$A01A($A01B), flags in E) says it is not where a command
; word belongs.
;
;  Input:E Parse flags
; Output:F Returns if E bit 1 is set; otherwise the caller is abandoned with NZ
c$AFE1 BIT 1,E       ; Test bit 1 of E - Guard: E bit 1 set (start of a
                     ; sentence)? Then return
 $AFE3 RET NZ        ; If bit 1 of E is set, return
 $AFE4 POP HL        ; Restore HL from the stack - Otherwise drop the caller's
                     ; return address and refuse: NZ, 'not a special word'
                     ; (#R$AF67)
 $AFE5 JP $AF67      ; Go back to the routine "Not a special word: NZ"
                     ; (#R$AF67)
; This entry point is used by the routine at #R$B01C.
*$AFE8 BIT 1,E       ; Test bit 1 of E - (Second guard) E bit 1 clear: return
 $AFEA RET Z         ; If bit 1 of E is clear, return
 $AFEB LD A,($A012)  ; Read #R$A012 in "Game variables" into A - Otherwise
                     ; refuse unless nothing has been read yet in this sentence
                     ; (#R$A012, #R$A01A($A01B) both zero)
 $AFEE AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $AFEF JR NZ,$AFF6   ; If A is not zero, skip ahead to #R$AFF6
 $AFF1 LD A,($A01B)  ; Read #R$A01A($A01B) in "Game variables" into A
 $AFF4 AND A         ; Clear the carry flag for the caller (A is unchanged)
 $AFF5 RET NZ        ; If A is not zero, return
*$AFF6 POP HL        ; Restore HL from the stack - Refuse (#R$AF67)
 $AFF7 JP $AF67      ; Go back to the routine "Not a special word: NZ"
                     ; (#R$AF67)

; Handlers for BECAUSE / THEREFORE, PRINT and NOPRINT
;
; #R$AFFA (BECAUSE, THEREFORE): carry on as a sentence break (#R$ACCC) - not
; traced. #R$AFFF (PRINT) and #R$B00B (NOPRINT) switch the copy of the text to
; the ZX printer on or off (#R$A002($A008); PRINT first reads the printer's
; status, #R$C03B). Confirmed only that NOPRINT is accepted quietly.
; .
; Tried in the emulator: TAKE LAMP BECAUSE EXAMINE LAMP and DROP LAMP THEREFORE
; INVENTORY both give 'WHAT ?' - the guards at #R$AFE1/#R$AFE8 turn them away
; in a command - while TAKE LAMP, EXAMINE LAMP does both commands, the comma
; being the sentence break (#R$ACCC).
;
;  Input:E Parse flags
; Output:Carries on in the parser
c$AFFA LD D,$A0      ; Load D with $A0 - BECAUSE / THEREFORE: D = $A0 (the
                     ; comma class), continue as a comma (#R$ACCC)
 $AFFC JP $ACCC      ; Go back to the routine "Note where this sentence
                     ; started, so it can be..." (#R$ACCC)
 $AFFF CALL $AFE1    ; PRINT: the sentence-start guard (#R$AFE1)
 $B002 CALL $C03B    ; Read the printer status (#R$C03B)
 $B005 JR NZ,$B015   ; NZ: leave #R$A002($A008) alone
 $B007 LD A,$01      ; Load A with $01 - Printer there: #R$A002($A008) = 1
                     ; (printing on)
 $B009 JR $B012      ; Skip ahead to #R$B012
 $B00B CALL $AFE1    ; NOPRINT: the same guard
 $B00E CALL $A296    ; Clear the text window (#R$A296)
 $B011 XOR A         ; Clear A to zero (and the carry flag) - #R$A002($A008) =
                     ; 0 (printing off)
*$B012 LD ($A008),A  ; Store A in #R$A002($A008) in "Game variables"
; This entry point is used by the routines at #R$B01C and #R$B0C6.
*$B015 LD A,($A02D)  ; Read #R$A02A($A02D) in "Game variables" into A - Carry
                     ; on with the sentence: D = #R$A02A($A02D), back into the
                     ; parser (#R$AAC4)
 $B018 LD D,A        ; Copy A into D
 $B019 JP $AAC4      ; Go back to #R$AAC4

; Handlers for BUT, ALL and a quote mark
;
; #R$B01C (BUT, after ALL) and #R$B033 (ALL) set #R$A01A to 2 and 1 for 'all
; but' and 'all'. #R$B049 (a quote mark): the words that follow are speech;
; their position is added to the list at #R$9FEC and the parser skips to the
; closing quote, marking it as the end of a sentence. #R$B86A hands them on
; when SAY TO / TALK TO runs. #R$B09A (PAUSE) waits (#R$C415). #R$B0A3 (LOAD,
; and QUIT too) goes to #R$B0AC: the game asks for a saved-game tape. Read from
; the code.
; .
; Confirmed in the emulator: QUIT and LOAD both print 'PLAY SAVED GAME TAPE TO
; BE LOADED' and set #R$A0D9($A0DA) to 1; PAUSE and NOPRINT are accepted with
; no message.
; .
; Tried in the emulator 2026-11-08: a line that is only a quotation, "HELLO",
; is taken as TALK (the word at $088B): 'You talk to Watson.' and Watson's good
; morning, the same as SAY "HELLO". TO WATSON "HELLO" gets WHAT ?.
; .
; Played: each quotation in a SAY TO / TALK TO is added to the list at #R$9FEC
; (#R$B049) whether or not the command later succeeds; #R$B86A hands on the
; first node. A SAY that failed (I SEE NO ... THAT YOU CAN TALK TO, no answer)
; therefore leaves a stale quotation in front of the next one, and the next
; person spoken to hears the old words. TALK TO <person> with no quotation
; empties the list (2 nodes to 0 in the emulator).
;
;  Input:E Parse flags
;        IY The sentence node
; Output:Carries on in the parser, or NZ if out of place
c$B01C LD A,($A01A)   ; Read #R$A01A in "Game variables" into A - BUT: only
                      ; straight after ALL (#R$A01A = 1)
 $B01F CP $01         ; Compare A with $01
 $B021 JP NZ,$AF67    ; If A differs from $01, go back to the routine "Not a
                      ; special word: NZ" (#R$AF67)
 $B024 LD A,$02       ; Load A with $02 - 'All but' (#R$A01A = 2)
 $B026 LD ($A01A),A   ; Store A in #R$A01A in "Game variables"
 $B029 CALL $AE6A     ; Call the routine "Add a new node to the end of the
                      ; sentence list" (#R$AE6A) - A new sentence node for the
                      ; things after BUT, marked with bit 6 of +1
 $B02C SET 6,(IY+$01) ; Set bit 6 of byte +1 of the record at IY
 $B030 JP $AB52       ; Go on parsing
 $B033 CALL $AFE8     ; Call #R$AFE8 (inside "Handler guards: only at the start
                      ; of a...") - ALL: only at the start of a sentence, and
                      ; only once
 $B036 LD A,($A01A)   ; Read #R$A01A in "Game variables" into A
 $B039 AND A          ; Test A for zero (this leaves A as it was and clears
                      ; carry)
 $B03A JP NZ,$AF67    ; If A is not zero, go back to the routine "Not a special
                      ; word: NZ" (#R$AF67)
 $B03D LD A,$01       ; Load A with $01 - 'All' (#R$A01A = 1), and bit 7 of +1
                      ; on the node
 $B03F LD ($A01A),A   ; Store A in #R$A01A in "Game variables"
 $B042 SET 7,(IY+$01) ; Set bit 7 of byte +1 of the record at IY
 $B046 JP $AB52       ; Go back to #R$AB52
 $B049 BIT 1,E        ; Test bit 1 of E - A quote mark with no verb yet (E bit
                      ; 1)? Then it becomes TALK ($088B)
 $B04B JR Z,$B058     ; If bit 1 of E is clear, skip ahead to #R$B058
 $B04D LD HL,$088B    ; Load HL with $088B
 $B050 LD (IY+$00),L  ; Store L in the first byte of the record at IY
 $B053 LD (IY+$01),H  ; Store H in byte +1 of the record at IY
 $B056 RES 1,E        ; Clear bit 1 of E
*$B058 PUSH HL        ; Save HL on the stack - Add the quote's position in the
                      ; word list (#R$A02A($A02B)) to the list at #R$9FEC
 $B059 PUSH DE        ; Save DE on the stack
 $B05A PUSH IY        ; Save IY on the stack - Save IY, IX
 $B05C PUSH IX        ; Save IX on the stack
 $B05E LD IY,$9FEC    ; The list headed at #R$9FEC...
 $B062 LD DE,$0000    ; Load DE with $0000 - ...find its last node: the one
                      ; whose link is 0 (#R$A104)
 $B065 CALL $A104     ; Call the routine "Find the node before node DE in the
                      ; list at IY" (#R$A104)
 $B068 LD A,$02       ; Load A with $02 - Get a 2-byte heap node (#R$A11C)
 $B06A CALL $A11C     ; Call the routine "Allocate A + 3 bytes from the free
                      ; list, cleared" (#R$A11C)
 $B06D LD HL,($A02B)  ; Read #R$A02A($A02B) in "Game variables" into HL - Store
                      ; the token position #R$A02A($A02B) in it
 $B070 LD (IX+$00),L  ; Store L in the first byte of the record at IX
 $B073 LD (IX+$01),H  ; Store H in byte +1 of the record at IX
 $B076 PUSH IX        ; Save IX on the stack - Link it after the last node
 $B078 POP HL         ; Restore HL from the stack
 $B079 LD (IY-$02),L  ; Store L in byte -2 of the record at IY
 $B07C LD (IY-$01),H  ; Store H in byte -1 of the record at IY
 $B07F POP IX         ; Restore IX from the stack - Restore the registers
 $B081 POP IY         ; Restore IY from the stack
 $B083 POP DE         ; Restore DE from the stack - (and DE, HL)
 $B084 POP HL         ; Restore HL from the stack
*$B085 CALL $AE7F     ; Call the routine "Read the next token of the typed
                      ; line" (#R$AE7F) - Skip tokens up to the closing quote
                      ; (class $90, no value)
 $B088 CP $90         ; Compare A with $90
 $B08A JR NZ,$B085    ; If A differs from $90, go back to #R$B085
 $B08C LD A,B         ; Copy B into A
 $B08D AND $0F        ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $B08F OR C           ; Set in A the bits that are set in C
 $B090 JR NZ,$B085    ; If the result is not zero, go back to #R$B085
 $B092 LD HL,($A029)  ; Read #R$A022($A029) in "Game variables" into HL - Mark
                      ; it as the end of a sentence (class $C0)
 $B095 LD (HL),$C0    ; Store $C0 at the address HL points to
 $B097 JP $AB52       ; Go back to #R$AB52
 $B09A CALL $AFE1     ; Call the routine "Handler guards: only at the start of
                      ; a sentence (not..." (#R$AFE1) - PAUSE: wait for a key
                      ; (#R$C415)
 $B09D CALL $C415     ; Call the routine "GET-KEY, but block until a key is
                      ; actually pressed" (#R$C415)
 $B0A0 JP $B015       ; Go back to #R$B015
 $B0A3 CALL $AFE1     ; Call the routine "Handler guards: only at the start of
                      ; a sentence (not..." (#R$AFE1) - LOAD (and QUIT): load a
                      ; saved game (#R$B0AC)
 $B0A6 CALL $B0AC     ; Call the routine "After a game-over message: get ready
                      ; to load a saved..." (#R$B0AC)
 $B0A9 JP $B015       ; Go back to #R$B015

; After a game-over message: get ready to load a saved game
;
; Resets the minute counter and the player's next-turn time to 0 and sets
; #R$A0D9($A0DA) = 1, so the main loop (#R$A064) goes to #R$B0D7 at the end of
; the minute. #R$B0C6 is the other way out: #R$A0D9($A0DA) = 2 (save, then
; carry on). Read from the code.
;
; Output:F NZ
;        HL 1
c$B0AC LD HL,$0000   ; Load HL with $0000 - The clock (#R$9FDD, minutes
                     ; elapsed) back to 0...
 $B0AF LD ($9FDD),HL ; Store HL in minutes since the start (#R$9FDD)
 $B0B2 LD IX,$9860   ; Point IX at "The actor table: who acts, and where each
                     ; is in..." (#R$9860) - ...and the player's turn time
                     ; (record at #R$9860, +6/+7) to 0
 $B0B6 LD (IX+$06),L ; Store L in byte +6 of the record at IX
 $B0B9 LD (IX+$07),H ; Store H in byte +7 of the record at IX
 $B0BC INC HL        ; Step HL on to the next byte - The action takes 1 minute
                     ; (#R$A01A($A01F))
 $B0BD LD ($A01F),HL ; Store HL in #R$A01A($A01F) in "Game variables"
 $B0C0 LD A,L        ; Copy L into A - #R$A0D9($A0DA) = 1 (a saved game is to
                     ; be loaded); NZ
 $B0C1 LD ($A0DA),A  ; Store A in #R$A0D9($A0DA) in "The main loop: one minute
                     ; of game time per..."
 $B0C4 AND A         ; Clear the carry flag for the caller (A is unchanged)
 $B0C5 RET           ; Return to the caller

; Handler for SAVE
;
; #R$A0D9($A0DA) = 2: at the end of the minute the main loop saves the game
; (#R$B0E4) and carries on.
;
; Output:Carries on in the parser at $B015
c$B0C6 CALL $AFE1    ; Only at the start of a sentence (#R$AFE1)
 $B0C9 LD HL,$0001   ; Load HL with $0001 - The action takes 1 minute
 $B0CC LD ($A01F),HL ; Store HL in #R$A01A($A01F) in "Game variables"
 $B0CF LD A,$02      ; Load A with $02 - #R$A0D9($A0DA) = 2: save the game at
                     ; the end of the minute's walk
 $B0D1 LD ($A0DA),A  ; Store A in #R$A0D9($A0DA) in "The main loop: one minute
                     ; of game time per..."
 $B0D4 JP $B015      ; Carry on parsing (#R$B015)

; Load a saved game from tape
;
; Loads the game state (#R$B0EE: from #R$840B, 7,188 bytes, up to
; #R$A01A($A01F)) with the ROM's LD-BYTES (#R$C0DF), asking again until it
; loads, then restores IY from #R$9FD4 and returns to the main loop's restart
; at #R$A040. #R$B0E4 is the save: it keeps IY at #R$9FD4 and saves the same
; block (#R$C040). Read from the code; the harness cannot run the ROM's tape
; routines. Confirmed in the emulator only that a game over ends with 'PLAY
; SAVED GAME TAPE TO BE LOADED'.
;
; Output:IY Restored as saved
;        The saved game loaded over $840B onwards
c$B0D7 CALL $B0EE    ; Which block
 $B0DA CALL $C0DF    ; Load it...
 $B0DD JR NC,$B0D7   ; ...until it works
 $B0DF LD IY,($9FD4) ; Read "Unused" (#R$9FD4) into IY - IY as saved
 $B0E3 RET           ; Return to the caller
; This entry point is used by the routine at #R$A064.
*$B0E4 LD ($9FD4),IY ; Save: remember IY
 $B0E8 CALL $B0EE    ; Which block
 $B0EB JP $C040      ; Save it (and verify)

; The block a saved game holds: $840B up to $A01F
;
; Addresses named in the title: #R$840B, #R$A01A($A01F).
; .
; IX = #R$840B (the room table), DE = #R$A01A($A01F) - #R$840B. So a saved game
; is the rooms, the entities, the case table, the actor table, the heap and the
; variables - but not the plan scripts, which never change (no script uses
; one-shot instructions).
;
; Output:IX $840B, the start of the saved block
;        DE Its length ($A01F - $840B)
;        HL $A01F - $840B before the swap
c$B0EE LD IX,$840B   ; IX = the start of the saved-game block (#R$840B)
 $B0F2 LD HL,$A01F   ; Point HL at #R$A01A($A01F) in "Game variables" - DE = HL
                     ; - #R$840B... with HL = #R$A01A($A01F), the end
 $B0F5 LD DE,$840B   ; Point DE at the room table (#R$840B)
 $B0F8 AND A         ; Clear the carry flag, so that the subtraction that
                     ; follows is a plain one (a compare)
 $B0F9 SBC HL,DE     ; Subtract DE from HL (a compare: carry = HL was smaller,
                     ; zero = equal)
 $B0FB EX DE,HL      ; Swap DE and HL - DE = its length
 $B0FC RET           ; Return to the caller

; Handlers for THATS, HE, IT and THEY
;
; Pronouns: HE sets bit 7 and IT/THEY bit 6 of the current parse record's +$19
; (used only when Watson or Lestrade weigh a statement: #R$BD7E then takes the
; statement's subject from #R$9FF2($9FF6), the last person a statement named,
; for HE, or from #R$9FFA($9FFC), the last thing, for IT/THEY); the first-word
; versions (#R$B135, #R$B151) also mark the sentence as a statement to a
; character (#R$A022($A024) = 2). THATS (#R$B0FD) rearranges the parse record's
; object slots (not traced). Read from the code. CORRECTED: the automatic split
; had #R$B0FD-#R$B16B($B16C) as data.
; .
; So pronouns are for statements, not commands. In the emulator TAKE IT and
; DROP IT after EXAMINE LAMP, and TAKE LAMP AND EXAMINE IT, all gave 'WHAT ?';
; HIM and THEM are not in the dictionary at all.
;
;  Input:E Parse flags (bit 3: a clause has finished)
;        IY The sentence node
; Output:E Bits 0 to 2, 6 and 7 set
;        IY The node that took the pronoun's words
c$B0FD LD BC,$0008    ; Load BC with $0008 - THATS: E bit 3 clear - the noun
                      ; phrase before it belongs to the last node
 $B100 BIT 3,E        ; Test bit 3 of E
 $B102 JR NZ,$B107    ; If bit 3 of E is set, skip ahead to #R$B107
 $B104 CALL $AEC6     ; (step back to it, #R$AEC6)
*$B107 PUSH IY        ; Save IY on the stack - HL = that node's first group
                      ; (+8)
 $B109 POP HL         ; Restore HL from the stack
 $B10A ADD HL,BC      ; Add BC to HL
 $B10B PUSH DE        ; Save DE on the stack
 $B10C PUSH HL        ; Save HL on the stack
 $B10D BIT 3,E        ; Test bit 3 of E - Then move on to the next node, and
                      ; set E bit 3
 $B10F JR NZ,$B118    ; If bit 3 of E is set, skip ahead to #R$B118
 $B111 SET 3,E        ; Set bit 3 of E
 $B113 CALL $AEA9     ; Call the routine "IY = the next node in the list (Z at
                      ; the end)" (#R$AEA9)
 $B116 JR $B11F       ; Skip ahead to #R$B11F
*$B118 LD HL,$A012    ; Point HL at #R$A012 in "Game variables" - E bit 3 set:
                      ; count a sentence and start a new node (#R$AE6A)
 $B11B INC (HL)       ; Add one to the byte at #R$A012 in "Game variables"
 $B11C CALL $AE6A     ; Call the routine "Add a new node to the end of the
                      ; sentence list" (#R$AE6A)
*$B11F PUSH IY        ; Save IY on the stack - Copy the first group into the
                      ; new node's third group (+24)
 $B121 POP HL         ; Restore HL from the stack
 $B122 LD BC,$0018    ; Load BC with $0018, the amount that is added next
 $B125 ADD HL,BC      ; Add BC to HL
 $B126 POP DE         ; Restore DE from the stack
 $B127 EX DE,HL       ; Swap DE and HL
 $B128 LD BC,$0006    ; Load BC with $0006
 $B12B LDIR           ; Copy BC bytes from where HL points to where DE points,
                      ; counting up
 $B12D POP DE         ; Restore DE from the stack
*$B12E LD A,E         ; Copy E into A - Back to the parser with E bits 0-2, 6
                      ; and 7 set
 $B12F OR $C7         ; Set bits 0, 1, 2, 6, 7 of A (mask $C7)
 $B131 LD E,A         ; Copy A into E
 $B132 JP $AAD1       ; Go back to #R$AAD1
 $B135 CALL $AFE1     ; Call the routine "Handler guards: only at the start of
                      ; a sentence (not..." (#R$AFE1) - HE as the first word: a
                      ; statement (#R$A022($A024) = 2)
 $B138 LD A,$02       ; Load A with $02
 $B13A LD ($A024),A   ; Store A in #R$A022($A024) in "Game variables"
 $B13D JR $B14B       ; Skip ahead to #R$B14B
 $B13F BIT 3,E        ; Test bit 3 of E - HE later on: after a finished clause
                      ; (E bit 3), a new node
 $B141 JR Z,$B14B     ; If bit 3 of E is clear, skip ahead to #R$B14B
 $B143 PUSH DE        ; Save DE on the stack
 $B144 CALL $AEA9     ; Call the routine "IY = the next node in the list (Z at
                      ; the end)" (#R$AEA9)
 $B147 CALL $AE6A     ; Call the routine "Add a new node to the end of the
                      ; sentence list" (#R$AE6A)
 $B14A POP DE         ; Restore DE from the stack
*$B14B SET 7,(IY+$19) ; Set bit 7 of byte +25 of the record at IY - Mark the
                      ; node: HE (+25 bit 7)
 $B14F JR $B12E       ; Go back to #R$B12E
 $B151 CALL $AFE1     ; Call the routine "Handler guards: only at the start of
                      ; a sentence (not..." (#R$AFE1) - IT or THEY as the first
                      ; word: a statement
 $B154 LD A,$02       ; Load A with $02
 $B156 LD ($A024),A   ; Store A in #R$A022($A024) in "Game variables"
 $B159 JR $B167       ; Skip ahead to #R$B167
 $B15B BIT 3,E        ; Test bit 3 of E - Later on: a new node after a finished
                      ; clause
 $B15D JR Z,$B167     ; If bit 3 of E is clear, skip ahead to #R$B167
 $B15F PUSH DE        ; Save DE on the stack
 $B160 CALL $AEA9     ; Call the routine "IY = the next node in the list (Z at
                      ; the end)" (#R$AEA9)
 $B163 CALL $AE6A     ; Call the routine "Add a new node to the end of the
                      ; sentence list" (#R$AE6A)
 $B166 POP DE         ; Restore DE from the stack
*$B167 SET 6,(IY+$19) ; Set bit 6 of byte +25 of the record at IY - Mark the
                      ; node: IT or THEY (+25 bit 6)
 $B16B JR $B12E       ; Go back to #R$B12E

; Parser variables
;
; Work space for the parser: #R$B16D/#R$B16D($B16E) counters, the object slots
; at #R$B16D($B172) and #R$B175($B178) (6 bytes each; #R$BDC2 reads them as the
; statement's things), #R$B17D($B182)-#R$B185($B186), and the saved verb
; pattern at #R$B18D($B18E) that the questions at #R$B5D3 quote from.
; CORRECTED: the automatic split had this as code.
b$B16D DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B175 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B17D DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B185 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B18D DEFB $00,$00,$00,$00

; Match the typed command against the verb patterns
;
; Clears the object ids (#R$A032($A034), #R$A032($A035)), then asks #R$B39D to
; match the parsed words against the verb patterns at #R$8259. On no match it
; returns Z with HL = #R$B84C (the 'I do not know the verb' message, not yet
; rendered). On a match, IX points at the matching 8-byte pattern; the loop at
; #R$B1BA turns that into the verb number by counting 8-byte steps back to
; #R$8259, and stores it in #R$A032($A033).
; .
; Verb #R$DD9E(46) (TALK TO) gets special treatment straight afterwards (six
; bytes copied between #R$A002 and #R$B16D($B172), direction chosen by bit 0 of
; #R$B16D) - not yet traced, but presumably saving or restoring who is being
; spoken to.
; .
; .
; .
; The line comments were written from reading the code and the descriptions of
; the routines it calls; the counters (#R$B16D($B170) direct, #R$B16D($B171)
; indirect) and the saves at #R$B17D($B184)/#R$B185 are clear, but which
; message each failure path finally prints was not run for every path.
; .
; How it works:
; .
; 1. Set both object numbers (#R$A032($A034), #R$A032($A035)) to $FF and clear
; the 17 bytes of the parser's work space at #R$B16D.
; .
; 2. Match the parsed words against the verb patterns (#R$B39D). If none
; matches, return Z with HL = #R$B84C, the routine that says the verb is not
; known.
; .
; 3. Turn the matching record's address into a verb number (records are 8 bytes
; from #R$8259, counting from 1) and keep it in #R$A032($A033), with the
; record's address at #R$B18D($B18E).
; .
; 4. For verb #R$DD9E(46) (TALK TO) swap the six bytes between #R$A002 and the
; object slot, as bit 0 of #R$B16D says.
; .
; 5. Copy the typed objects into the two slots in the verb's order (#R$B405),
; and count the candidates for each (#R$B308, #R$B32D).
; .
; 6. Ask which one is meant (#R$B6AE) if there are too many, or none if there
; are too few; otherwise choose the direct and indirect objects and return NZ.
;
;  Input:IY The first parse node
; Output:F Z with HL = $B84C when no verb matches; NZ when one does
;        $A033 The verb number
;        $A034 The direct object, $ A035 the indirect object
;        IX The verb record that matched
c$B191 LD A,$FF      ; Load A with $FF - No direct object and no indirect
                     ; object yet ($FF)
 $B193 LD ($A035),A  ; Store A in #R$A032($A035) in "Game variables"
 $B196 LD ($A034),A  ; (#R$A032($A034) = direct, #R$A032($A035) = indirect)
 $B199 LD HL,$B16D   ; HL = the parser's work space (#R$B16D)
 $B19C LD B,$11      ; 17 bytes of it
 $B19E CALL $A2AB    ; Clear them (#R$A2AB)
 $B1A1 CALL $B39D    ; Match the words against the verb patterns (#R$B39D)
 $B1A4 JR NZ,$B1AB   ; Matched: carry on
 $B1A6 LD HL,$B84C   ; No match: the 'I do not know the verb' routine
                     ; (#R$B84C)...
 $B1A9 XOR A         ; ...and Z to say so
 $B1AA RET           ; Return to the caller
*$B1AB LD A,$01      ; Matched: work out the verb number from IX
 $B1AD PUSH IX       ; Offset of the matching pattern from #R$8259 (HL = IX)...
 $B1AF POP HL        ; Restore HL from the stack
 $B1B0 LD DE,$8259   ; ...
 $B1B3 SBC HL,DE     ; ...
 $B1B5 JR Z,$B1BF    ; First record: verb #R$DD03(1)
 $B1B7 LD DE,$0008   ; Otherwise count 8-byte steps
*$B1BA INC A         ; One more verb number
 $B1BB SBC HL,DE     ; Subtract DE and the carry from HL
 $B1BD JR NZ,$B1BA   ; If the two values differ, go back to #R$B1BA
*$B1BF LD ($A033),A  ; Save the verb number in #R$A032($A033)
 $B1C2 LD ($B18E),IX ; And the pattern's address, for the questions at #R$B5D3
 $B1C6 CP $2E        ; Compare A with $2E - Verb #R$DD9E(46) (TALK TO)?
 $B1C8 JR NZ,$B1DD   ; If A differs from $2E, skip ahead to #R$B1DD
 $B1CA LD HL,$B16D   ; Point HL at "Parser variables" (#R$B16D) - If so, copy
                     ; six bytes between #R$A002 and the object slot
                     ; #R$B16D($B172); bit 0 of #R$B16D picks the direction
 $B1CD BIT 0,(HL)    ; Test bit 0 of the byte at "Parser variables" (#R$B16D)
 $B1CF LD HL,$A002   ; Point HL at #R$A002 in "Game variables"
 $B1D2 LD DE,$B172   ; Point DE at #R$B16D($B172) in "Parser variables"
 $B1D5 LD BC,$0006   ; Load BC with $0006
 $B1D8 JR Z,$B1DB    ; If bit 0 of the byte at #R$A002 in "Game variables" is
                     ; clear, skip ahead to #R$B1DB
 $B1DA EX DE,HL      ; Swap DE and HL
*$B1DB LDIR          ; Copy BC bytes from where HL points to where DE points,
                     ; counting up
*$B1DD CALL $C493    ; Call the routine "Set the direct object's requirement
                     ; from the parsed..." (#R$C493) - Set the requirement
                     ; codes for the direct and indirect object from the verb's
                     ; flags (#R$C493, #R$C4B2)
 $B1E0 CALL $C4B2    ; Call the routine "Set the indirect object's requirement
                     ; from the parsed..." (#R$C4B2)
 $B1E3 LD A,($A01C)  ; Read #R$A01A($A01C) in "Game variables" into A - Did the
                     ; first word carry the flag in bit 7?
 $B1E6 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $B1E7 JR NZ,$B1F2   ; If A is not zero, skip ahead to #R$B1F2
 $B1E9 LD A,($B39C)  ; Read "#R$B39D: bit 7 of the verb's first word reference"
                     ; (#R$B39C) into A - If not, take it from the saved copy
                     ; at #R$B39C...
 $B1EC LD ($A01C),A  ; Store A in #R$A01A($A01C) in "Game variables"
 $B1EF CALL $B34F    ; ...and restart the direct-object search (#R$B34F)
*$B1F2 LD A,($A01E)  ; Read #R$A01A($A01E) in "Game variables" into A - Verb
                     ; flag #R$A01A($A01E) bit 4 kept in #R$B18D($B190) (lets
                     ; the search stop at the first candidate)
 $B1F5 AND $10       ; Isolate bit 4 of A (mask $10)
 $B1F7 LD ($B190),A  ; Store A in #R$B18D($B190) in "Parser variables"
 $B1FA JR Z,$B200    ; If bit 4 of A was clear, skip ahead to #R$B200 - Set:
                     ; forget the #R$A01A($A01C) flag
 $B1FC XOR A         ; Clear A to zero (and the carry flag)
 $B1FD LD ($A01C),A  ; Store A in #R$A01A($A01C) in "Game variables"
*$B200 XOR A         ; Clear A to zero (and the carry flag) - Clear
                     ; #R$A00A($A00B)
 $B201 LD ($A00B),A  ; Store A in #R$A00A($A00B) in "Game variables"
 $B204 LD A,($A01D)  ; Read #R$A01A($A01D) in "Game variables" into A - Does
                     ; the verb take a direct or indirect object
                     ; (#R$A01A($A01D) bits 2-3)?
 $B207 AND $0C       ; Keep only bits 2, 3 of A (mask $0C)
 $B209 JR NZ,$B213   ; Yes: go and find them
*$B20B CALL $C929    ; No objects needed (or all found): check the record
                     ; (#R$C929)
 $B20E RET NZ        ; Passed: return NZ
 $B20F LD HL,$B863   ; Point HL at "JP #R$C929 (check the record)" (#R$B863) -
                     ; Failed: hand back the 'check the record' stub (#R$B863)
 $B212 RET           ; Return to the caller
*$B213 CALL $B387    ; Does the verb take an indirect object, and was one given
                     ; (#R$B387)?
 $B216 JR NZ,$B280   ; NZ: go and deal with it (#R$B280)
 $B218 LD A,($A01C)  ; Read #R$A01A($A01C) in "Game variables" into A - Was the
                     ; direct object marked?
 $B21B AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $B21C JR NZ,$B224   ; If A is not zero, skip ahead to #R$B224
 $B21E CALL $B308    ; If not, run the direct-object search to the end
                     ; (#R$B308)
 $B221 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry) - Found none: look at the fallbacks at #R$B259
 $B222 JR Z,$B259    ; If A is zero, jump on to #R$B259
*$B224 CALL $B4C1    ; Next direct-object candidate (#R$B4C1)
 $B227 JR Z,$B244    ; No more: finish
 $B229 CALL $C929    ; Is it here and fit to use (#R$C929)?
 $B22C JR Z,$B224    ; No: try the next
 $B22E LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - Yes:
                     ; remember it as the one so far (#R$B17D($B184))
 $B231 LD ($B184),A  ; Store A in #R$B17D($B184) in "Parser variables"
 $B234 LD HL,$B170   ; Point HL at #R$B16D($B170) in "Parser variables" - Count
