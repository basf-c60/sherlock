; Every one of its 1 instructions was executed
; (tools/experiments/insn_coverage.py plus the targeted tests described above).
;
; Output:F From $E007
c$DFEA DEFB $47,$10,$E3,$DF ; Action record header: flags $47; bit 6: pre-check
                            ; at #R$DFE3; byte 1 $10
 $DFEE JR $E007             ; Skip ahead to #R$E007

; Action record: shared 23 (WEAR (used by the old man's disguise))
;
; Shared action 23: WEAR the old man's disguise: A = $64 (the old man, thing
; 100) and on to the common tail at #R$E028. Tested 9 November in the closet:
; 'You wear the old mans disguise.' After it INVENTORY says 'An old man is
; carrying nothing' and LOOK 'An old man is in a small closet'; TAKE OFF and
; WEAR again both worked.
; .
; Every one of its 7 instructions was executed
; (tools/experiments/insn_coverage.py plus the targeted tests described above).
;
; Output:F From $E028
c$DFF0 DEFB $48,$10,$1C,$E0 ; Action record header: flags $48; bit 6: pre-check
                            ; at #R$E01C; byte 1 $10
 $DFF4 LD A,$64             ; Load A with $64 - A = $64 and on to #R$E028
 $DFF6 JR $E028             ; Jump on to #R$E028
 $DFF8 LD A,($A036)         ; Read #R$A032($A036) in "Game variables" into A -
                            ; The actor must be thing 1, else fail
 $DFFB CP $01               ; Compare A with $01
; This entry point is used by the routines at #R$DFCA and #R$E003.
*$DFFD JP NZ,$DC15          ; If A differs from $01, go back to the routine
                            ; "Fail: A = 0, HL = 0, Z set" (#R$DC15)
; This entry point is used by the routines at #R$DF8B and #R$DFB6.
*$E000 OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller - Return NZ
 $E002 RET                  ; Return to the caller

; Shared TAKE OFF action ($AA71 entry #5)
;
; Addresses named in the title: #R$AA71.
; .
; Used by the China man's disguise (object 14). The body calls #R$E03A with A =
; 0, then clears the disguise's container and sets its room to #R$A00A.
; .
; CORRECTED HISTORY: this record was once claimed to be TAKE's handler (wrong -
; nothing reached it during TAKE LAMP), then marked 'not confirmed reachable'.
; The object records show how it is reached: through the disguise's own TAKE
; OFF entry.
;
; Output:F NZ; the actor is itself again and the disguise lies in the player's
; .        room
c$E003 DEFB $47,$10,$F8,$DF ; Action record header: flags $47; bit 6: pre-check
                            ; at #R$DFF8; byte 1 $10
; This entry point is used by the routine at #R$DFEA.
*$E007 XOR A                ; Clear A to zero (and the carry flag) - A = 0: the
                            ; actor turns back into thing 0 (#R$E03A)
 $E008 CALL $E03A           ; Call the routine "Set the worn state of the actor
                            ; (A = 1 wear, 0 take..." (#R$E03A)
 $E00B LD IX,($A013)        ; Read #R$A012($A013) in "Game variables" into IX -
                            ; The disguise (the direct object) is no longer
                            ; held by anyone (+1 = 0)...
 $E00F LD (IX+$01),$00      ; Set byte +1 of the record at IX to $00
 $E013 LD A,($A00A)         ; Read the current actor's room (#R$A00A) into A -
                            ; ...and lies in the room the player is in (+15)
 $E016 LD (IX+$0F),A        ; Store A in byte +15 of the record at IX
 $E019 OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller
 $E01B RET                  ; Return to the caller
 $E01C LD A,($A036)         ; Read #R$A032($A036) in "Game variables" into A -
                            ; Pre-check for TAKE OFF: the actor must be the
                            ; player (A = 0)
 $E01F AND A                ; Test A for zero (this leaves A as it was and
                            ; clears carry)
 $E020 JR $DFFD             ; Go back to #R$DFFD

; Shared WEAR action ($AA71 entry #4)
;
; Addresses named in the title: #R$AA71.
; .
; Used by the China man's disguise (object 14), whose own list maps WEAR to 4
; and TAKE OFF to 5. The body calls #R$E03A with A = 1. Not yet tried in the
