                      ; THE WALL REVEALING A... (#R$7BF7)
 $E123 LD (IX+$0D),L  ; Store L in byte +13 of the record at IX
 $E126 LD (IX+$0E),H  ; Store H in byte +14 of the record at IX
 $E129 LD HL,$7C13    ; Point HL at the message "AS YOU RUN YOUR HANDS OVER THE
                      ; BOOKS YOU TOUCH A... (#R$7C13)
 $E12C CALL $A59F     ; Call the routine "Print the message at HL" (#R$A59F)
 $E12F CALL $A2A2     ; Call the routine "Print a newline (A kept)" (#R$A2A2)
 $E132 OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller
 $E134 RET            ; Return to the caller

; Action record: RUN at $E0A7; RUN at $E0E2; RUN at $E0F4; default for verb 20
; (EXAMINE CLOSELY)
;
; Addresses named in the title: #R$E0A7, #R$E0E2, #R$E0F4.
; .
; EXAMINE CLOSELY. The body, for the player only (actor 0), prints the
; description (#R$DF5B) and then looks the thing up in #R$E16B, a table of
; three-byte entries (thing, message address) ended by $FF: the bed (76), the
; window (102), the bridge (57), the drawer (62) and the corpse (46) each have
; a longer text of their own. Read from the code.
; .
; Confirmed in the emulator 2026-11-08, each in its own room: EXAMINE CLOSELY
; BED (room 61) -> 'The bed is unmade and one sheet is crumpled up on top. In
; one corner of the sheet is a very small tear.'; CORPSE (room 88) -> dried
; blood on the face and 'dark speckled markings that resemble powder burns' on
; the right hand; BRIDGE (room 88) -> 'a small chip in the stone work that is
; evidently quite new. It looks like a heavy metallic object has struck it.';
; DRAWER (room 72, the Browns' study) -> 'the drawer has a false bottom.' These
; are clues the plain EXAMINE does not give.
; .
; Seen: the thing is marked as seen (+6 bit 6) when examined closely - the
; sandstone bridge, the crumpled note, the body, the bloodstained clothes. The
; table at #R$E16B is data (thing, message pairs) that the disassembler listed
; as code, which is why the last 12 'instructions' were not executed.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 177 times in 11 of them, run by you. 19
; of its 31 instructions were executed; the rest (#R$E16B #R$E16C #R$E16F
; #R$E170 #R$E171 #R$E172 #R$E173 #R$E174 #R$E176 #R$E177 ...) never ran in any
; stored route, and were therefore read from the code only.
;
;  Input:$A034 The direct object
; Output:F NZ; its description and any extra text printed
c$E135 DEFB $78,$50,$2E,$DF,$80,$40,$00,$00 ; {Action record header: flags $78;
 $E13D DEFB $00                             ; bit 5: test #R$D078 first; bit 6:
                                            ; pre-check at #R$DF2E; bit 4: five
                                            ; extra bytes; byte 1 $50}
 $E13E LD A,$01                             ; Load A with $01 - #R$CAAE = 1
 $E140 LD ($CAAE),A                         ; Store A in "Flag: the player's
                                            ; view has changed" (#R$CAAE)
 $E143 LD A,($A036)                         ; Read #R$A032($A036) in "Game
                                            ; variables" into A - Only the
                                            ; player examines closely: anyone
                                            ; else passes
 $E146 AND A                                ; Clear the carry flag for the
                                            ; caller (A is unchanged)
 $E147 RET NZ                               ; If A is not zero, return
 $E148 CALL $E151                           ; Print the description and the
                                            ; extra text (#R$E151)
 $E14B CALL $A2A2                           ; Call the routine "Print a newline
                                            ; (A kept)" (#R$A2A2) - Newline
                                            ; (#R$A2A2)
 $E14E OR $01                               ; Make A non-zero, which clears the
                                            ; zero flag, and hand that back to
                                            ; the caller
 $E150 RET                                  ; Return to the caller
*$E151 CALL $DF5B                           ; The thing's own description
                                            ; (#R$DF5B)...
 $E154 LD A,($A034)                         ; Read #R$A032($A034) in "Game
                                            ; variables" into A - ...then look
                                            ; for it in the table at #R$E16B
                                            ; (#R$D34E)
 $E157 LD IX,$E16B                          ; Point IX at #R$E16B in "Action
                                            ; record: RUN at #R$E0A7; RUN at
                                            ; #R$E0E2;..."
 $E15B CALL $D34E                           ; Call the routine "Find a 3-byte
                                            ; record by id, in a
                                            ; sentinel-terminated..." (#R$D34E)
 $E15E CP $FF                               ; Compare A with $FF - Not there
                                            ; ($FF): done
 $E160 RET Z                                ; If A equals $FF, return
 $E161 LD L,(IX+$01)                        ; Read byte +1 of the record at IX
                                            ; into L - Found: print its extra
                                            ; text
 $E164 LD H,(IX+$02)                        ; Read byte +2 of the record at IX
                                            ; into H
 $E167 CALL $A59F                           ; Call the routine "Print the
                                            ; message at HL" (#R$A59F)
 $E16A RET                                  ; Return to the caller
 $E16B LD C,H                               ; Copy H into C
 $E16C JP NZ,$667B                          ; If the zero flag is clear, go
                                            ; back to #R$6678($667B)
 $E16F RST $10                              ; Call the ROM routine at $10
 $E170 LD A,E                               ; Copy E into A
 $E171 ADD HL,SP                            ; Add SP to HL
 $E172 SBC A,(HL)                           ; Subtract the byte HL points at
                                            ; and the carry from A
 $E173 LD A,H                               ; Copy H into A
 $E174 LD A,$E7                             ; Load A with $E7
 $E176 LD A,H                               ; Copy H into A
 $E177 LD L,$4A                             ; Load L with $4A
 $E179 LD A,H                               ; Copy H into A
 $E17A RST $38                              ; Call the ROM routine at $38

; Sub-script: shared 22 (no object uses it)
;
; Entry points: #R$E17D = body of record #R$E17B.
; .
; Decoded by tools/plan.py; see #R$CC78 for the language. Each sub-block is one
; instruction. Room and object numbers are as the game uses them (the reference
; pages list both). Labels for verbs 128-140 and for the common helper records
; (#R$E52F, #R$E57A, #R$E588, #R$E5A8, #R$DDBE, #R$F198) were read from those
; records' code, not tried one by one in the emulator.
; .
; In an instruction, 'plan dobj' and 'plan iobj' are not fixed objects: they
; mean the direct and indirect object currently held in the actor's plan
; registers (bytes +4 and +5 of its actor record), so the same step works on
; whatever the actor is dealing with - for the player, the objects of the
; command just typed. 'plan verb' is the verb register (+3), 'self' is the
; acting character, and '-' means none.
b$E17B DEFB $8D,$07             ; Action record header: flags $8D; bit 7:
                                ; checks only; byte 1 $07 - checks-only: the
                                ; script follows
 $E17D DEFB $07,$88,$E1,$FD,$FC ; RUN #R$E188 (plan dobj, plan iobj)
 $E182 DEFB $07,$D6,$E1,$FD,$FC ; RUN #R$E1D6 (plan dobj, plan iobj)
 $E187 DEFB $0B                 ; RETURN OK

; Action record: Mrs Jones is asked what happened or about her alibi (RUN at
; $E17D)
;
; Addresses named in the title: #R$E17D.
; .
; If the topic (indirect object) is thing 16 (WHAT HAPPENED), 67 (BLOODSTAINED
; CLOTHES) or 17 (YOUR ALIBI), bit 1 of the statement at #R$9993 is set; Mrs
; Jones (Tricia Fender in disguise) has then been asked. Seen: #R$9993($9996)
; went from 8 to 10 when Mrs Jones was asked about her alibi.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 30 times in 10 of them, run by mrs jones.
; Every one of its 10 instructions was executed
; (tools/experiments/insn_coverage.py).
;
;  Input:$A035 The topic
; Output:The statement at $9993 marked when the topic is the right one
c$E188 DEFB $0D,$07   ; Action record header: flags $0D; byte 1 $07
 $E18A LD A,($A035)   ; Read #R$A032($A035) in "Game variables" into A - The
                      ; indirect object (#R$A032($A035)): thing 16 (WHAT
                      ; HAPPENED), 67 (BLOODSTAINED CLOTHES) or 17 (YOUR
                      ; ALIBI)?
 $E18D CP $10         ; Compare A with $10
 $E18F JR Z,$E199     ; If A equals $10, skip ahead to #R$E199
 $E191 CP $43         ; Compare A with $43
 $E193 JR Z,$E199     ; If A equals $43, skip ahead to #R$E199
 $E195 CP $11         ; Compare A with $11
 $E197 JR NZ,$E1D3    ; No: skip to #R$E1D3
*$E199 LD IX,$9993    ; Point IX at #R$9993 in "The case: statements about the
                      ; crime, and..." - Yes: set bit 1 of the empty statement
                      ; at #R$9993 - set once Mrs Jones (Tricia Fender in
                      ; disguise) has been asked what happened or about her
                      ; alibi
 $E19D SET 1,(IX+$03) ; Set bit 1 of byte +3 of the record at IX
 $E1A1 JR $E1D3       ; Jump on to #R$E1D3

; Sub-script: shared 3 (no object uses it)
;
; Entry points: #R$E1A5 = body of record #R$E1A3.
; .
; Decoded by tools/plan.py; see #R$CC78 for the language. Each sub-block is one
; instruction. Room and object numbers are as the game uses them (the reference
; pages list both). Labels for verbs 128-140 and for the common helper records
; (#R$E52F, #R$E57A, #R$E588, #R$E5A8, #R$DDBE, #R$F198) were read from those
; records' code, not tried one by one in the emulator.
; .
; In an instruction, 'plan dobj' and 'plan iobj' are not fixed objects: they
; mean the direct and indirect object currently held in the actor's plan
; registers (bytes +4 and +5 of its actor record), so the same step works on
; whatever the actor is dealing with - for the player, the objects of the
; command just typed. 'plan verb' is the verb register (+3), 'self' is the
; acting character, and '-' means none.
b$E1A3 DEFB $8D,$07                     ; Action record header: flags $8D; bit
                                        ; 7: checks only; byte 1 $07 -
                                        ; checks-only: the script follows
 $E1A5 DEFB $17,$B2,$E1,$FF,$FC,$B1,$E1 ; RUN #R$E1B2 (-, plan iobj) [fail
                                        ; #R$E1B1]
 $E1AC DEFB $07,$D6,$E1,$FD,$FC         ; RUN #R$E1D6 (plan dobj, plan iobj)
 $E1B1 DEFB $0B                         ; RETURN OK

; Action record: asked about the bloodstained clothes, Tricia Fender becomes
; Mrs Jones (RUN at $E1A5)
;
; Addresses named in the title: #R$E1A5.
; .
; If the topic is thing 67 (BLOODSTAINED CLOTHES) and the actor can see them
; (#R$C821), the actor is renamed thing $5F (Mrs Jones) and bit 1 of the case
; record at #R$998F is set (Tricia Fender turns out to be Mrs Jones). If she
; cannot see them the refusal at #R$E1FC is printed. Seen (3 runs): Tricia's id
; 13 was replaced by 95 in the actor table, #R$998F($9992) went from 0 to 2,
; and the two things swapped places (thing 13's room from 47 to 0, thing 95's
; from 0 to 47). The 'cannot see them' branch (#R$E1C0, #R$E1C3) was not
; reached.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 10 times in 10 of them, run by tricia
; fender. 11 of its 13 instructions were executed; the rest (#R$E1C0 #R$E1C3)
; never ran in any stored route, and were therefore read from the code only.
;
;  Input:$A035 The topic
; Output:F NZ; Tricia Fender becomes Mrs Jones if the topic is the clothes and
; .        they can be seen; otherwise $DC15
c$E1B2 DEFB $00,$07   ; Action record header: flags $00; byte 1 $07
 $E1B4 LD A,($A035)   ; Read #R$A032($A035) in "Game variables" into A - Is the
                      ; indirect object (#R$A032($A035)) the bloodstained
                      ; clothes ($43)?
 $E1B7 CP $43         ; Compare A with $43
 $E1B9 JR NZ,$E1D3    ; If A differs from $43, skip ahead to #R$E1D3
 $E1BB CALL $C821     ; Call the routine "Can the current actor
                      ; (#R$A032($A036)) see thing A?" (#R$C821) - Can the
                      ; actor see them (#R$C821)?
 $E1BE JR NZ,$E1C6    ; If the zero flag is clear, skip ahead to #R$E1C6
 $E1C0 CALL $E1FC     ; Call #R$E1FC (inside "Action record: default for TELL
                      ; and TELL...") - No: print the refusal (#R$E1FC) and
                      ; fail (#R$DC15)
 $E1C3 JP $DC15       ; Go back to the routine "Fail: A = 0, HL = 0, Z set"
                      ; (#R$DC15)
*$E1C6 LD A,$5F       ; Load A with $5F - Yes: the actor's identity becomes
                      ; thing $5F, Mrs Jones (#R$E03A)...
 $E1C8 CALL $E03A     ; Call the routine "Set the worn state of the actor (A =
                      ; 1 wear, 0 take..." (#R$E03A)
 $E1CB LD IX,$998F    ; Point IX at #R$998F in "The case: statements about the
                      ; crime, and..." - ...and the case record at #R$998F gets
                      ; bit 1 of its +3 (Tricia Fender turns out to be Mrs
                      ; Jones)
 $E1CF SET 1,(IX+$03) ; Set bit 1 of byte +3 of the record at IX
; This entry point is used by the routine at #R$E188.
*$E1D3 OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller - Succeed (also when it was not
                      ; the clothes)
 $E1D5 RET            ; Return to the caller

; Action record: default for TELL and TELL ABOUT (verbs 47 and 48)
;
; The interview table at #R$E22A: the actor is looked up (#R$E207), then the
; topic (#R$E201); a match prints that entry's reply (#R$6830 with the entry's
; message as its parameter), otherwise 'I AM SORRY I CANNOT HELP YOU WITH THAT'
; (#R$761D). Seen both in the player's questions (Mrs Jones's confession,
; Tricia's) and in the characters' own scripts: Strachan, Phipps, the gardener,
; the maid and the cook each answer Lestrade's TELL ABOUT WHAT HAPPENED / YOUR
; ALIBI, and Straker answers about the case.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 188 times in 14 of them, run by mrs
; jones, cook, gardener, strachan and others. 36 of its 39 instructions were
; executed; the rest (#R$E227 #R$E228 #R$E229) never ran in any stored route,
; and were therefore read from the code only.
;
;  Input:$A036 The actor
;        $A035 The topic
; Output:F NZ; the answer printed, or the refusal if there is none
c$E1D6 DEFB $0D,$17  ; Action record header: flags $0D; byte 1 $17
 $E1D8 LD A,($A036)  ; The actor (#R$A032($A036))...
 $E1DB CALL $E207    ; ...looked up in the list at #R$E22A (#R$E207)
 $E1DE JR Z,$E1FC    ; Not there: message #R$761D
 $E1E0 INC IX        ; Step IX on to the next byte - Next entry: the indirect
                     ; object (#R$A032($A035)) is searched for (#R$E201)
 $E1E2 LD A,($A035)  ; Read #R$A032($A035) in "Game variables" into A
 $E1E5 CALL $E201    ; Call #R$E201 (inside "Action record: default for TELL
                     ; and TELL...")
 $E1E8 JR Z,$E1FC    ; Not there: message #R$761D
 $E1EA LD L,(IX+$01) ; Read byte +1 of the record at IX into L - HL = the
                     ; entry's word at +1/+2
 $E1ED LD H,(IX+$02) ; Read byte +2 of the record at IX into H
*$E1F0 PUSH AF       ; Save AF on the stack
 $E1F1 PUSH HL       ; Save HL on the stack
 $E1F2 LD HL,$6830   ; Point HL at the message "YOU SAY TO THE OIL LAMP" W"
                     ; (#R$6830) - Print #R$6830 with it as a parameter
 $E1F5 CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
*$E1F8 POP AF        ; Restore AF from the stack
*$E1F9 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Return NZ
 $E1FB RET           ; Return to the caller
; This entry point is used by the routine at #R$E1B2.
*$E1FC LD HL,$761D   ; Point HL at the message "I AM SORRY I CANNOT HELP YOU
                     ; WITH THAT." (#R$761D)
 $E1FF JR $E1F0      ; Go back to #R$E1F0
*$E201 CALL $D34E    ; Call the routine "Find a 3-byte record by id, in a
                     ; sentinel-terminated..." (#R$D34E) - Search the thing
                     ; table (#R$D34E) and test the result against $FF
 $E204 CP $FF        ; Compare A with $FF
 $E206 RET           ; Return to the caller
*$E207 LD IX,$E22A   ; IX = the id list at #R$E22A
*$E20B CP (IX+$00)   ; Compare A with the first byte of the record at IX -
                     ; Compare A with each id; a match goes to #R$E1F9
 $E20E JR Z,$E1F9    ; If A equals the first byte of the record at IX, go back
                     ; to #R$E1F9
 $E210 PUSH AF       ; Save AF on the stack
 $E211 LD A,(IX+$00) ; Read the first byte of the record at IX into A
 $E214 CP $FE        ; Compare A with $FE - $FE entry: go to #R$E1F8
 $E216 JR Z,$E1F8    ; If A equals $FE, go back to #R$E1F8
 $E218 INC A         ; Add one to A
 $E219 JR Z,$E227    ; $FF entry (the end): none matched, return A = 0
 $E21B INC IX        ; Step IX on to the next byte - Otherwise step on and
                     ; search the table for the entry (#R$D34E)
 $E21D LD A,$FF      ; Load A with $FF
 $E21F CALL $D34E    ; Call the routine "Find a 3-byte record by id, in a
                     ; sentinel-terminated..." (#R$D34E)
 $E222 INC IX        ; Step IX on to the next byte
 $E224 POP AF        ; Restore AF from the stack
 $E225 JR $E20B      ; Go back to #R$E20B
*$E227 POP AF        ; Restore AF from the stack
 $E228 XOR A         ; Set A to zero, which sets the zero flag for the caller
 $E229 RET           ; Return to the caller

; A table searched by $E207 (part of TELL)
;
; Addresses named in the title: #R$E207.
; .
; Decoded 9 November. The table is a list of groups, one per person: the
; person's id, then pairs of (topic id, message address) until $FF. The loop at
; #R$E207 finds the person, then #R$E201 finds the topic in that group; the
; message is printed through #R$6830 as the person's reply. A group that starts
; with $FE matches any person (the fallback), and a second $FF ends the table.
; Topic ids are things: $10 what happened, $11 your alibi, $12 your address,
; $0F the case, $43 the bloodstained clothes, and the people $05 Strachan, $06
; Phipps, $07 the Major, $0D Tricia Fender.
; .
; Gardener ($08): what happened and alibi share one reply (a gun shot woke him,
; he found Mrs Brown), and the Major gets another ('such a nice fellow...
; fighting'). Cook ($09): what happened/alibi (one reply), Phipps (overheard
; Basil and Daphne arguing about the will). Maid ($0A): what happened/alibi
; (Basil must have something to do with it). Phipps ($06): what happened/alibi
; (playing Chopin), address (Camden Street in London, Cobden Lane at
; Leatherhead). Strachan ($05): what happened/alibi (knows nothing), Tricia
; (she was Mr Brown's secretary), the Major (a friend of Mrs Jones). Straker
; ($04): the case (#R$7371, his report). The Major ($07): alibi (not at liberty
; to say; in London), address (Sidmouth Street). Tricia ($0D) and Mrs Jones
; ($5F): the bloodstained clothes (the confession 'you found out, I am really
; Mrs Jones'); Mrs Jones also gives the confession for what happened/alibi and
; a short reply about Tricia ('blackmailing Mrs Brown'). The $FE fallback
; answers your address, what happened and your alibi with 'DON'T BE SILLY.'
; (#R$6845). Message texts rendered with the game's own printer
; (source/render_messages.py).
b$E22A DEFB $08,$10,$46,$78,$11,$46,$78,$07
 $E232 DEFB $F8,$78,$FF,$09,$10,$4F,$79,$11
 $E23A DEFB $4F,$79,$06,$C4,$79,$FF,$0A,$10
 $E242 DEFB $35,$7A,$11,$35,$7A,$FF,$06,$10
 $E24A DEFB $B9,$7A,$11,$B9,$7A,$12,$2C,$77
 $E252 DEFB $FF,$05,$10,$F6,$7A,$11,$F6,$7A
 $E25A DEFB $0D,$A4,$76,$07,$D4,$78,$FF,$04
 $E262 DEFB $0F,$71,$73,$FF,$07,$11,$0C,$78
 $E26A DEFB $12,$22,$77,$FF,$0D,$43,$87,$76
 $E272 DEFB $FF,$5F,$43,$87,$76,$10,$44,$76
 $E27A DEFB $11,$44,$76,$0D,$2D,$76,$FF,$FE
 $E282 DEFB $12,$45,$68,$10,$45,$68,$11,$45
 $E28A DEFB $68,$FF,$FF

; Refuse if the actor is the direct object
;
; Fails (#R$DC15) when #R$A032($A036) = #R$A032($A034) - doing the thing to
; yourself. Reached by the JP at #R$E44F. CORRECTED: was the tail of the table
; above. Read from the code.
;
; Output:F Fails ($DC15) when the actor is the direct object
c$E28D LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - The
                     ; actor (#R$A032($A036)) against the direct object
                     ; (#R$A032($A034))
 $E290 LD HL,$A034   ; Point HL at #R$A032($A034) in "Game variables"
 $E293 CP (HL)       ; Compare A with the byte at #R$A032($A034) in "Game
                     ; variables"
 $E294 JP Z,$DC15    ; If A equals the byte at #R$A032($A034) in "Game
                     ; variables", go back to the routine "Fail: A = 0, HL = 0,
                     ; Z set" (#R$DC15) - Same: fail (#R$DC15)
 $E297 RET           ; Return to the caller

; Can this hansom cab be hailed here?
;
; The direct object must be one of the two hansom cabs (30 or 33); the room
; (#R$A00A) must be one of the cab stands (#R$9C07 with C = 0: any journey from
; here); the cab (#R$A012($A013)) must be off stage (room 0), i.e. not already
; on a job; and #R$CFB9 must agree. Otherwise it refuses (#R$DC15). The HAIL
; action (#R$E2C7) runs it. CORRECTED: was data. Read from the code.
;
;  Input:$A034 The cab
; Output:F NZ if the cab can be hailed here; otherwise refused ($DC15)
c$E298 LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - Must be
                     ; one of the two hansom cabs, 30 or 33
 $E29B CP $1E        ; Compare A with $1E
 $E29D JR Z,$E2A4    ; If A equals $1E, skip ahead to #R$E2A4
 $E29F CP $21        ; Compare A with $21
 $E2A1 JP NZ,$DC15   ; If A differs from $21, go back to the routine "Fail: A =
                     ; 0, HL = 0, Z set" (#R$DC15)
*$E2A4 LD A,($A00A)  ; Read the current actor's room (#R$A00A) into A - Must be
                     ; at a cab stand: any journey from here (#R$9C07, C = 0)
 $E2A7 LD C,$00      ; Load C with $00
 $E2A9 CALL $9C07    ; Call the routine "Find the cab journey between two
                     ; rooms" (#R$9C07)
 $E2AC JP NZ,$DC15   ; If the zero flag is clear, go back to the routine "Fail:
                     ; A = 0, HL = 0, Z set" (#R$DC15)
 $E2AF LD IX,($A013) ; Read #R$A012($A013) in "Game variables" into IX - The
                     ; cab must be in room 0 - free, not on a job
 $E2B3 LD A,(IX+$0F) ; Read byte +15 of the record at IX into A
 $E2B6 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $E2B7 JP NZ,$DC15   ; If A is not zero, go back to the routine "Fail: A = 0,
                     ; HL = 0, Z set" (#R$DC15)
 $E2BA LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - And
                     ; #R$CFB9 must agree
 $E2BD CALL $CFB9    ; Call #R$CFB9 (inside "Save a sub-script call frame")
 $E2C0 JP NZ,$DC15   ; If the zero flag is clear, go back to the routine "Fail:
                     ; A = 0, HL = 0, Z set" (#R$DC15)
 $E2C3 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - NZ: it can be hailed
 $E2C5 RET           ; Return to the caller

; HAIL: the cab hailed, plus one
;
; Written by #R$E2D3.
b$E2C6 DEFB $00      ; Cab + 1

; Shared HAIL action ($AA71 entry #11)
;
; Addresses named in the title: #R$AA71.
; .
; CORRECTED - this entry previously called this 'a shared generic
; message/fallback handler reached by INVENTORY, WAIT and STAND UP'. Logging
; the actor and verb at each hit showed every one of those hits was actor 2
; doing HAIL (verb #R$E2C7(31)) on object 30, which simply happened to run on
; the same turns as the player's commands. The player's INVENTORY/WAIT/STAND UP
; never reach it. It is reached through object action lists that map HAIL (and,
; for the same object, GET) to shared action 11 - see #R$8F06.
; .
; Also CORRECTED: this entry previously described a 'self-modifying-code trick'
; storing into #R$E2C6. #R$E2C6 follows a RET at #R$E2C5 and is never executed
; - it is an ordinary one-byte variable kept just in front of the record, not
; code.
; .
; Record header: flags $47 (bit 6: pre-check routine at #R$E298), byte 1 $10;
; body at #R$E2CB. The body remembers the player's room (#R$A00A) and the
; hailed cab's id + 1 (the cabbie) in #R$E2C6, calls #R$DD0E to move the cab
; into the player's room, then calls #R$E2EE to start the cabbie on the script
; at #R$F2B6 with the hailer and the cab as objects. Confirmed in the emulator
; (tools/experiments/cab_test.py): HAIL CAB in Baker Street prints 'You hail
; the hansom cab.', the cabbie says 'Hello guv'nor.' and the next LOOK shows
; the cab with the cabbie in the street.
;
;  Input:$A034 The cab hailed
; Output:F NZ; the cab moved to the player and the cabbie started on its fare
; .        script
c$E2C7 DEFB $47,$10,$98,$E2 ; Action record header: flags $47; bit 6: pre-check
                            ; at #R$E298; byte 1 $10
 $E2CB LD A,($A00A)         ; Read the current actor's room (#R$A00A) into A -
                            ; Remember the player's room...
 $E2CE LD B,A               ; Copy A into B
 $E2CF LD A,($A034)         ; Read #R$A032($A034) in "Game variables" into A -
                            ; ...and the target's id + 1, in the variable at
                            ; #R$E2C6
 $E2D2 INC A                ; Add one to A
 $E2D3 LD ($E2C6),A         ; Store A in "HAIL: the cab hailed, plus one"
                            ; (#R$E2C6)
 $E2D6 DEC A                ; Subtract one from A
 $E2D7 CALL $DD0E           ; Move the cab (thing A = the hailed cab, id in
                            ; #R$A032($A034)) into the player's room (B):
                            ; #R$DD0E sets its +15
 $E2DA LD A,($A036)         ; Read #R$A032($A036) in "Game variables" into A -
                            ; B = the actor doing the hailing
 $E2DD LD B,A               ; Copy A into B
 $E2DE LD A,($A034)         ; Read #R$A032($A034) in "Game variables" into A -
                            ; C = the thing being hailed
 $E2E1 LD C,A               ; Copy A into C
 $E2E2 LD DE,$F2B6          ; DE = #R$F2B6, the cabbie's fare script
 $E2E5 LD A,($E2C6)         ; Read "HAIL: the cab hailed, plus one" (#R$E2C6)
                            ; into A
 $E2E8 CALL $E2EE           ; Start the cabbie (the cab's id + 1) on that
                            ; script, with the hailer and the cab as its
                            ; objects (#R$E2EE)
 $E2EB OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller - Succeed
 $E2ED RET                  ; Return to the caller

; Start actor A on the script at DE, with objects B and C
;
; #R$A032($A034) = B and #R$A032($A035) = C; with A as the current actor
; (#R$CC0E) the script is pushed as its plan (#R$CF80, B = 2) and its script
; position (+1/+2 of its actor-table entry) set to DE. The HAIL action
; (#R$E2C7) uses it with DE = #R$F2B6 to set the cab and cabbie off. Read from
; the code.
;
;  Input:A The actor
;        DE The script
;        B, C The two objects
; Output:F NZ; the actor's old script is kept as a sub-script and the new one
; .        started
c$E2EE PUSH DE       ; Save DE on the stack - A = the actor, DE = the script, B
                     ; and C = the objects
 $E2EF LD D,A        ; Copy A into D
 $E2F0 LD A,B        ; Copy B into A
 $E2F1 LD ($A034),A  ; Store A in #R$A032($A034) in "Game variables" - Direct
                     ; and indirect objects (#R$A032($A034), #R$A032($A035))
 $E2F4 LD A,C        ; Copy C into A
 $E2F5 LD ($A035),A  ; Store A in #R$A032($A035) in "Game variables"
 $E2F8 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Keep
                     ; the current actor and make A the actor
 $E2FB PUSH AF       ; Save AF on the stack
 $E2FC LD A,D        ; Copy D into A
 $E2FD LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $E300 CALL $CC0E    ; Find its record (#R$CC0E, IY)
 $E303 LD L,(IY+$01) ; Read byte +1 of the record at IY into L - HL = its
                     ; current script address (+1/+2)
 $E306 LD H,(IY+$02) ; Read byte +2 of the record at IY into H
 $E309 LD B,$02      ; Load B with $02 - Push it as a sub-script call frame
                     ; (#R$CF80), so the actor returns to it afterwards
 $E30B CALL $CF80    ; Call the routine "Save a sub-script call frame"
                     ; (#R$CF80)
 $E30E POP AF        ; Restore AF from the stack - Actor back as it was
 $E30F LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $E312 POP DE        ; Restore DE from the stack
 $E313 LD (IY+$01),E ; Store E in byte +1 of the record at IY - Point the
                     ; actor's record at DE: its new script
 $E316 LD (IY+$02),D ; Store D in byte +2 of the record at IY
 $E319 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Succeed
 $E31B RET           ; Return to the caller

; COUNT's pre-check: is the thing countable?
;
; The pre-check named in the header of shared action 10 (COUNT, the money
; objects, #R$E328): refuses (#R$DC15) unless the direct object
; (#R$A012($A013)) has bit 5 of its +6 flags set. CORRECTED: was data. Read
; from the code.
;
;  Input:$A013 The direct object's record
; Output:F NZ if it can be counted (+6 bit 5); otherwise refused ($DC15)
c$E31C LD IX,($A013)  ; The direct object's record (#R$A012($A013))
 $E320 BIT 5,(IX+$06) ; Test bit 5 of the flags 2 byte (+6) of the thing record
                      ; at IX (countable) - +6 bit 5 clear: fail (#R$DC15)
 $E324 JP Z,$DC15     ; If bit 5 of the flags 2 byte (+6) of the thing record
                      ; at IX is clear, go back to the routine "Fail: A = 0, HL
                      ; = 0, Z set" (#R$DC15)
 $E327 RET            ; Return to the caller

; Action record: shared 10 (COUNT the money)
;
; COUNT: prints 'It totals' and the sum held in the money thing (+9/+10), in
; pounds, shillings and pence. Tested 9 November from the start: COUNT MONEY
; and COUNT YOUR MONEY both print 'You count your money. It totals £5 4/-' (the
; game's pound sign is character $60, which my capture shows as a backquote).
; No stored route counts money.
; .
; Every one of its 27 instructions was executed
; (tools/experiments/insn_coverage.py plus the targeted tests described above).
;
;  Input:$A013 The money thing's record
; Output:F NZ; "IT TOTALS" and the sum printed
c$E328 DEFB $6A,$10,$1C,$E3 ; Action record header: flags $6A; bit 5: test
                            ; #R$D078 first; bit 6: pre-check at #R$E31C; byte
                            ; 1 $10
 $E32C LD HL,$6836          ; Point HL at the message "IT TOTALS" (#R$6836)
 $E32F CALL $A59F           ; Call the routine "Print the message at HL"
                            ; (#R$A59F)
 $E332 LD IX,($A013)        ; Read #R$A012($A013) in "Game variables" into IX
 $E336 LD L,(IX+$09)        ; Read byte +9 of the record at IX into L
 $E339 LD H,(IX+$0A)        ; Read byte +10 of the record at IX into H
 $E33C CALL $A419           ; Call the routine "Print an amount of money"
                            ; (#R$A419)
 $E33F CALL $A2A2           ; Call the routine "Print a newline (A kept)"
                            ; (#R$A2A2)
 $E342 OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller
 $E344 RET                  ; Return to the caller
 $E345 CALL $E34F           ; Call #R$E34F (inside "Action record: shared 10
                            ; (COUNT the money)")
 $E348 RET Z                ; If the zero flag is set, return
 $E349 LD A,$25             ; Load A with $25
 $E34B LD ($A033),A         ; Store A in #R$A032($A033) in "Game variables"
 $E34E RET                  ; Return to the caller
; This entry point is used by the routine at #R$E370.
*$E34F LD A,($A036)         ; Read #R$A032($A036) in "Game variables" into A -
                            ; The current actor's purse (#R$E619); none (Z):
                            ; cannot pay
 $E352 CALL $E619           ; Call #R$E619 (inside "Action record: RUN at
                            ; #R$E08F; RUN at #R$E46B;...")
 $E355 JR Z,$E365           ; If the zero flag is set, skip ahead to #R$E365
 $E357 CALL $E39C           ; Call the routine "HL = the money a thing holds
                            ; (+9/+10)" (#R$E39C) - HL = its money, DE = the
                            ; sum in the command
 $E35A CALL $E3A9           ; Call the routine "DE = the sum of money in the
                            ; command (#R$A02A($A02F))" (#R$E3A9)
 $E35D AND A                ; Clear the carry flag, so that the subtraction
                            ; that follows is a plain one (a compare)
 $E35E SBC HL,DE            ; Subtract DE from HL (a compare: carry = HL was
                            ; smaller, zero = equal) - HL - DE: less than
                            ; nothing? (carry): cannot pay
 $E360 JR C,$E365           ; If it went below zero (carry), skip ahead to
                            ; #R$E365
 $E362 OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller
 $E364 RET                  ; Return to the caller
*$E365 LD HL,$E36A          ; Point HL at "Refusal: "YOU DO NOT HAVE ENOUGH.""
                            ; (#R$E36A) - Message #R$683F and fail
 $E368 XOR A                ; Set A to zero, which sets the zero flag for the
                            ; caller
 $E369 RET                  ; Return to the caller

; Refusal: "YOU DO NOT HAVE ENOUGH."
;
; A pre-check that refuses returns HL = this address; the caller then runs it.
; Prints #R$683F. CORRECTED: the automatic split had this as data.
;
; Output:HL The message printed ($A59F)
c$E36A LD HL,$683F   ; Point HL at the message "YOU DO NOT HAVE ENOUGH."
                     ; (#R$683F)
 $E36D JP $A59F      ; Go back to the routine "Print the message at HL"
                     ; (#R$A59F)

; Action record: RUN at $E510; default for verb 37 (PAY TO)
;
; Addresses named in the title: #R$E510.
; .
; Played: PAY 10D TO CABBIE takes 10d from the purse (thing 27) and the cabbie
; pays the change back ('You pay 10d. To the cabbie. The cabbie pays 8d. To
; you.'); a paid cab then leaves, an unpaid one waits. The default GIVE TO
; (#R$DF02) moves the whole purse instead.
; .
; Tested 9 November: PAY 100D TO WATSON gets 'DON'T BE SILLY.' (the
; cannot-afford branch, #R$E365). In the stored routes it runs for the player
; paying the cabbie, for Lestrade paying the cabbie, and for the cabbie paying
; change back.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 263 times in 14 of them, run by cabbie,
; you, inspector lestrade. Every one of its 11 instructions was executed
; (tools/experiments/insn_coverage.py).
;
;  Input:$A036 The payer
;        $A035 The payee
; Output:F NZ; the payer's money reduced and the payee's increased by the sum
c$E370 DEFB $66,$1D,$45,$E3 ; Action record header: flags $66; bit 5: test
                            ; #R$D078 first; bit 6: pre-check at #R$E345; byte
                            ; 1 $1D
 $E374 CALL $E34F           ; Can the actor afford it? (#R$E34F; if not,
                            ; message #R$683F and fail) HL = what is left
 $E377 CALL $E38F           ; Store it as the actor's money (#R$E38F)
 $E37A LD A,($A035)         ; The indirect object (#R$A032($A035)), the
                            ; payee...
 $E37D CALL $E619           ; Call #R$E619 (inside "Action record: RUN at
                            ; #R$E08F; RUN at #R$E46B;...") - ...does it hold
                            ; money? (#R$E619, IX = its purse; Z: no, nothing
                            ; to add)
 $E380 JR Z,$E38C           ; If the zero flag is set, skip ahead to #R$E38C
 $E382 CALL $E39C           ; Call the routine "HL = the money a thing holds
                            ; (+9/+10)" (#R$E39C) - HL = its money (#R$E39C),
                            ; DE = the sum (#R$E3A9)
 $E385 CALL $E3A9           ; Call the routine "DE = the sum of money in the
                            ; command (#R$A02A($A02F))" (#R$E3A9)
 $E388 ADD HL,DE            ; Add DE to HL - Add and store (#R$E38F)
 $E389 CALL $E38F           ; Call the routine "Store HL as the money a thing
                            ; holds (+9/+10)" (#R$E38F)
*$E38C OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller
 $E38E RET                  ; Return to the caller

; Store HL as the money a thing holds (+9/+10)
;
; Packs HL seven bits to a byte (the 'pounds, shillings and pence' fact has the
; format) into IX+9 and IX+10. With #R$E39C and #R$E3A9 it is how PAY TO
; (#R$E370) and a cab fare (#R$9B25) move money. Read from the code.
;
; Input:HL total in pence
;       IX the thing
c$E38F RL L          ; Rotate L left through the carry - Shift HL's bit 7 up
                     ; into H...
 $E391 RL H          ; Rotate H left through the carry
 $E393 SRL L         ; Shift L right (halve it) - ...and clear it in L: L =
                     ; pence & $7F, H = pence >> 7
 $E395 LD (IX+$09),L ; Store L in the adjective low byte (+9) of the thing
                     ; record at IX
 $E398 LD (IX+$0A),H ; Store H in the adjective high byte (+10) of the thing
                     ; record at IX
 $E39B RET           ; Return to the caller

; HL = the money a thing holds (+9/+10)
;
; Unpacks IX+9/+10, seven bits a byte, keeping the sign. Read from the code.
;
;  Input:IX the thing
; Output:HL total in pence
c$E39C LD L,(IX+$09) ; Read the adjective low byte (+9) of the thing record at
                     ; IX into L
 $E39F LD H,(IX+$0A) ; Read the adjective high byte (+10) of the thing record
                     ; at IX into H
 $E3A2 RL L          ; Rotate L left through the carry - Put them back
                     ; together: HL = H x 128 + L, H's sign kept by SRA
 $E3A4 SRA H         ; Shift H right keeping its sign
 $E3A6 RR L          ; Rotate L right through the carry
 $E3A8 RET           ; Return to the caller

; DE = the sum of money in the command ($A02F)
;
; Addresses named in the title: #R$A02A($A02F).
; .
; Unpacks the number the parser stored at #R$A02A($A02F) (set by #R$DB67 from
; '2/6', '3S' and the like) the same way, bit 7 of the high byte dropped.
; Returns NZ. CORRECTED: the automatic split had it as data. Read from the
; code.
;
; Output:DE total in pence
c$E3A9 LD DE,($A02F) ; Read #R$A02A($A02F) in "Game variables" into DE
 $E3AD RES 7,D       ; Clear bit 7 of D - Drop the number marker bit, then
                     ; unpack as #R$E39C
 $E3AF RL E          ; Rotate E left through the carry
 $E3B1 SRA D         ; Shift D right keeping its sign
 $E3B3 RR E          ; Rotate E right through the carry
 $E3B5 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller
 $E3B7 RET           ; Return to the caller

; Pre-check for getting into a cab
;
; Named in the header of the shared GET INTO action at #R$E3EA. Runs #R$E3F5
; first (busy? already there? will you fit?); then, for a moment taking the
; next number after the cab (its driver) as the actor, asks #R$CFB6, and if
; that says yes requires the thing at the cab's +3 and the actor to share one
; of bits 4-6 of +4, refusing (#R$DC15) otherwise. Read from the code in
; outline.
; .
; How it works:
; .
; 1. Run the checks for sitting on or getting into things (#R$E3F5: not busy,
; not already in it, will it fit).
; .
; 2. With the actor temporarily the thing after the cab (its driver), see
; whether the driver has a step in progress (#R$CFB6).
; .
; 3. If so, the thing at the cab's +3 and the actor must share one of bits 4 to
; 6 of +4, or the move is refused.
;
;  Input:$A034 The cab
; Output:F NZ if the actor may get in; Z or $DC15 if not
c$E3B8 CALL $E3F5    ; Call the routine "Pre-check for sitting on or getting
                     ; into something" (#R$E3F5) - The common checks (#R$E3F5):
                     ; busy, already there, will it fit?
 $E3BB RET Z         ; If the zero flag is set, return
 $E3BC LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Keep
                     ; the actor, and take the thing after the cab (its driver)
                     ; as the actor...
 $E3BF PUSH AF       ; Save AF on the stack
 $E3C0 LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A
 $E3C3 INC A         ; Add one to A
 $E3C4 LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables"
 $E3C7 CALL $CFB6    ; Call #R$CFB6 (inside "Save a sub-script call frame") -
                     ; ...and ask #R$CFB6 (Z: no)
 $E3CA EX AF,AF'     ; Swap AF with the shadow copy
 $E3CB POP AF        ; Restore AF from the stack
 $E3CC LD ($A036),A  ; Store A in #R$A032($A036) in "Game variables" - Actor
                     ; restored
 $E3CF EX AF,AF'     ; Swap AF with the shadow copy
 $E3D0 JR Z,$E3E7    ; No driver step: allowed
 $E3D2 LD A,(IX+$03) ; Read byte +3 of the record at IX into A - The thing at
                     ; the cab's +3 (#R$D237)...
 $E3D5 CALL $D237    ; Call the routine "Resolve an id (in A) to its full
                     ; entity record" (#R$D237)
 $E3D8 LD IY,($A017) ; Read #R$A012($A017) in "Game variables" into IY
 $E3DC LD A,(IX+$04) ; Read byte +4 of the record at IX into A - ...must share
                     ; one of bits 4-6 with the actor's +4 (the AND with $70)
 $E3DF AND (IY+$04)  ; Keep only the bits of A that are set in byte +4 of the
                     ; record at IY
 $E3E2 AND $70       ; Keep only bits 4, 5, 6 of A (mask $70)
 $E3E4 JP Z,$DC15    ; Otherwise refuse (#R$DC15)
*$E3E7 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Succeed
 $E3E9 RET           ; Return to the caller

; Shared GET INTO a cab ($AA71 entry #12)
;
; Addresses named in the title: #R$AA71.
; .
; Has its own pre-check (#R$E3B8) but no body of its own: the body is a single
; JR into the SIT IN body at #R$E413 - a shared tail, reused because getting
; into a cab and sitting in a chair both just set the actor's container.
; Confirmed live: Inspector Lestrade (actor 2) reaches it when he climbs into
; the hansom cab (object 30).
;
; Output:F NZ; the actor is held by the thing as for SIT IN
c$E3EA DEFB $78,$20,$B8,$E3,$90,$40,$28,$00 ; {Action record header: flags $78;
 $E3F2 DEFB $00                             ; bit 5: test #R$D078 first; bit 6:
                                            ; pre-check at #R$E3B8; bit 4: five
                                            ; extra bytes; byte 1 $20}
 $E3F3 JR $E413                             ; Reuse the SIT IN body (the
                                            ; actor's container = the cab)

; Pre-check for sitting on or getting into something
;
; Named in the header of the shared SIT action at #R$E40A. Refuses if the actor
; is busy (#R$CBA7) or already in or on the thing (#R$DCA7: is the actor held
; by it, #R$D278), then the size check: will the actor fit in or on it
; (#R$DEE4)? Read from the code.
;
;  Input:$A034 The thing
; Output:F NZ if the actor can sit on or get into it; Z if not
c$E3F5 CALL $CBA7    ; Is the actor busy? (#R$CBA7)
 $E3F8 CALL $DCA7    ; Call #R$DCA7 (inside "Action record: default for verb
                     ; #R$DC8D(16) (DROP)") - Already in or on the thing?
                     ; (#R$DCA7)
 $E3FB RET Z         ; If the zero flag is set, return
 $E3FC LD IX,($A017) ; Read #R$A012($A017) in "Game variables" into IX - IX =
                     ; the indirect object's record (#R$A012($A017)), IY = the
                     ; direct's (#R$A012($A013))
 $E400 LD IY,($A013) ; Read #R$A012($A013) in "Game variables" into IY
 $E404 LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - Will it
                     ; fit in or on it? (#R$DEE4)
 $E407 JP $DEE4      ; Go back to #R$DEE4

; Shared SIT implementation ($AA71 entry #9)
;
; Addresses named in the title: #R$AA71.
; .
; Confirmed real by breakpointing #R$C960 during a real `SIT` command and
; seeing it reliably look up index 9 - this address.
; .
; `LD IY,(#R$A012($A017)); LD A,(#R$A032($A034)); LD (IY+1),A` - sets the
; current actor's own record field +1 (the same field the confirmed
; containment-chain walker, #R$C86E, follows as 'what contains me') to the
; target furniture's id. Sitting in something is implemented as 'you are now
; contained by it' - the same mechanism used for an item being inside a box,
; reused here for a person sitting in a chair.
; .
; Record header (decoded with the format from #R$C9BF, see
; overlay_04_actions.py): flags $78, pre-check routine #R$E3F5 (the shared
; guard #R$CBA7, then #R$DCA7, then the 'will it fit' tail at #R$DEE4), body at
; #R$E413.
; .
; CORRECTED: an earlier version said a 'second sub-entry' follows at #R$E420.
; It isn't part of this entry: #R$E420 is entry #8 (GET OUT)'s pre-check
; routine, which entry #8's own header points at.
;
;  Input:$A034 The thing
; Output:F NZ; the thing is now the actor's holder
c$E40A DEFB $78,$20,$F5,$E3,$90,$40,$28,$00 ; {Action record header: flags $78;
 $E412 DEFB $00                             ; bit 5: test #R$D078 first; bit 6:
                                            ; pre-check at #R$E3F5; bit 4: five
                                            ; extra bytes; byte 1 $20}
; This entry point is used by the routine at #R$E3EA.
*$E413 LD IY,($A017)                        ; IY = the record at #R$A012($A017)
 $E417 LD A,($A034)                         ; The direct object
                                            ; (#R$A032($A034))...
 $E41A LD (IY+$01),A                        ; ...becomes its holder (+1):
                                            ; sitting is being contained by the
                                            ; furniture
 $E41D OR $01                               ; Make A non-zero, which clears the
                                            ; zero flag, and hand that back to
                                            ; the caller - Succeed
 $E41F RET                                  ; Return to the caller
 $E420 CALL $CBA7                           ; (GET OUT's pre-check, header at
                                            ; #R$E432) Is the actor busy?
                                            ; (#R$CBA7)
 $E423 LD A,($A036)                         ; Read #R$A032($A036) in "Game
                                            ; variables" into A - Is the actor
                                            ; inside the thing
                                            ; (#R$A032($A034)), at any depth?
                                            ; (#R$D278)
 $E426 LD HL,$A034                          ; Point HL at #R$A032($A034) in
                                            ; "Game variables"
 $E429 CALL $D278                           ; Call #R$D278 (inside "Is thing A
                                            ; carried by the actor,
                                            ; perhaps...")
 $E42C JP NC,$DC15                          ; No: refuse (#R$DC15)
 $E42F OR $01                               ; Make A non-zero, which clears the
                                            ; zero flag, and hand that back to
                                            ; the caller - Yes: pass
 $E431 RET                                  ; Return to the caller

; Shared GET-OUT implementation ($AA71 entry #8)
;
; Addresses named in the title: #R$AA71.
; .
; Confirmed real the same way, via a real `GET OUT` command reliably producing
; index 8.
; .
; `LD IY,(#R$A012($A013)); LD A,(IY+1); LD IY,(#R$A012($A017)); LD (IY+1),A` -
; reads the *target* furniture's own field +1 (whatever contains the furniture
; - the room it's in) and copies that into the current actor's field +1.
; Getting out of a chair is 'you are now contained by whatever contains the
; chair' - the natural inverse of SIT (#R$E40A above), built from the same
; containment field.
;
;  Input:$A013 The thing the actor is in
; Output:F NZ; the actor is held by what held the thing
c$E432 DEFB $78,$20,$20,$E4,$10,$80,$28,$00 ; {Action record header: flags $78;
 $E43A DEFB $00                             ; bit 5: test #R$D078 first; bit 6:
                                            ; pre-check at #R$E420; bit 4: five
                                            ; extra bytes; byte 1 $20}
 $E43B LD IY,($A013)                        ; Read #R$A012($A013) in "Game
                                            ; variables" into IY - The thing
                                            ; the direct object is in (its
                                            ; +1)...
 $E43F LD A,(IY+$01)                        ; Read byte +1 of the record at IY
                                            ; into A
 $E442 LD IY,($A017)                        ; Read #R$A012($A017) in "Game
                                            ; variables" into IY - ...becomes
                                            ; the holder of the record at
                                            ; #R$A012($A017) (the
 $E446 LD (IY+$01),A                        ; Store A in byte +1 of the record
                                            ; at IY
 $E449 OR $01                               ; Make A non-zero, which clears the
                                            ; zero flag, and hand that back to
                                            ; the caller - Succeed
 $E44B RET                                  ; Return to the caller
 $E44C CALL $CBA7                           ; Call the routine "Refuse if the
                                            ; character is busy: 'SORRY, I
                                            ; CANNOT DO..." (#R$CBA7)
 $E44F JP $E28D                             ; Go back to the routine "Refuse if
                                            ; the actor is the direct object"
                                            ; (#R$E28D)

; Sub-script: default for verb 21 (FOLLOW); default for verb 22 (COME WITH)
;
; Entry points: #R$E456 = body of record #R$E452.
; .
; Decoded by tools/plan.py; see #R$CC78 for the language. Each sub-block is one
; instruction. Room and object numbers are as the game uses them (the reference
; pages list both). Labels for verbs 128-140 and for the common helper records
; (#R$E52F, #R$E57A, #R$E588, #R$E5A8, #R$DDBE, #R$F198) were read from those
; records' code, not tried one by one in the emulator.
; .
; In an instruction, 'plan dobj' and 'plan iobj' are not fixed objects: they
; mean the direct and indirect object currently held in the actor's plan
; registers (bytes +4 and +5 of its actor record), so the same step works on
; whatever the actor is dealing with - for the player, the objects of the
; command just typed. 'plan verb' is the verb register (+3), 'self' is the
; acting character, and '-' means none.
b$E452 DEFB $EC,$00,$4C,$E4             ; Action record header: flags $EC; bit
                                        ; 5: test #R$D078 first; bit 6:
                                        ; pre-check at #R$E44C; bit 7: checks
                                        ; only; byte 1 $00 - checks-only: the
                                        ; script follows
 $E456 DEFB $07,$2F,$E5,$0A,$FF         ; RUN #R$E52F START COUNTDOWN of (dobj)
                                        ; plus a random number up to (iobj)
                                        ; (10, -)
 $E45B DEFB $47,$88,$E4,$FD,$FF         ; RUN #R$E488 (plan dobj, -) [busy]
 $E460 DEFB $57,$52,$DD,$FA,$FF,$6B,$E4 ; RUN #R$DD52 ENTER / GO INTO (dobj)
                                        ; (plan verb, -) [busy; fail #R$E46B]
 $E467 DEFB $43,$88,$E5                 ; RUN #R$E588 CANCEL the countdown
                                        ; [busy]
 $E46A DEFB $0B                         ; RETURN OK
 $E46B DEFB $C7,$FD,$E5,$FD,$FF,$81,$E4 ; RUN #R$E5FD (plan dobj, -) [busy; ok
                                        ; #R$E481]
 $E472 DEFB $C1,$0D,$81,$E4             ; DO 13 #R$E432(CLIMB OUT OF) [busy; ok
                                        ; #R$E481]
 $E476 DEFB $57,$84,$DD,$FD,$FF,$81,$E4 ; RUN #R$DD84 (plan dobj, -) [busy;
                                        ; fail #R$E481]
 $E47D DEFB $42,$0C,$FA,$FF             ; DO 12 #R$E40A(CLIMB INTO): plan verb,
                                        ; - [busy]
 $E481 DEFB $0F                         ; PASS
 $E482 DEFB $C3,$7A,$E5,$5B,$E4         ; RUN #R$E57A TICK the countdown
                                        ; (fails, and deletes it, when it runs
                                        ; out) [busy; ok #R$E45B]
 $E487 DEFB $0A                         ; RETURN FAIL

; Action record: where is the person I follow? (RUN at $E45B, $E7B9)
;
; Addresses named in the title: #R$E45B, #R$E7B9.
; .
; Puts the direct object's room (+15) into plan register #R$9FD6. The follow
; loops of Watson, Lestrade and Straker use it to know where to walk next.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 193,118 times in 14 of them, run by
; watson, chief constable straker, inspector lestrade, major percival ffoulkes.
; Every one of its 5 instructions was executed
; (tools/experiments/insn_coverage.py).
;
;  Input:$A013 The direct object's record
; Output:$9FD6 The direct object's room
;        F NZ
c$E488 DEFB $27,$00  ; Action record header: flags $27; bit 5: test #R$D078
                     ; first; byte 1 $00
 $E48A LD IX,($A013) ; Read #R$A012($A013) in "Game variables" into IX - The
                     ; direct object's room (+15)...
 $E48E LD A,(IX+$0F) ; Read byte +15 of the record at IX into A
 $E491 LD ($9FD6),A  ; ...goes into plan register #R$9FD6
 $E494 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Succeed
 $E496 RET           ; Return to the caller

; Verb 128 (scripts only): put a thing in a room
;
; Takes the direct object out of whatever holds it and puts it in the room
; given as the indirect object (#R$DD0E); room 0 is off stage. Confirmed in the
; emulator: each of the 4 times it ran in 84 turns, the thing ended up in that
; room.
; .
; Used by: internal verb #R$E497(128) (PUT: move the direct object into room
; (indirect object); room 0 is off stage).
;
;  Input:$A034 The thing
;        $A035 The room
; Output:F NZ; the thing is in the room, held by nothing
c$E497 DEFB $47,$24,$B0,$E4 ; Action record header: flags $47; bit 6: pre-check
                            ; at #R$E4B0; byte 1 $24
 $E49B LD A,($A035)         ; Read #R$A032($A035) in "Game variables" into A -
                            ; The room
 $E49E LD B,A               ; Copy A into B
 $E49F LD A,($A034)         ; The thing
 $E4A2 LD IX,($A013)        ; Read #R$A012($A013) in "Game variables" into IX
 $E4A6 LD (IX+$01),$FF      ; Out of any container
 $E4AA CALL $DD0E           ; Into the room
 $E4AD OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller - Done
 $E4AF RET                  ; Return to the caller
 $E4B0 LD IX,($A013)        ; Read #R$A012($A013) in "Game variables" into IX
 $E4B4 BIT 6,(IX+$05)       ; Test bit 6 of byte +5 of the record at IX
 $E4B8 JR Z,$E4C6           ; If bit 6 of byte +5 of the record at IX is clear,
                            ; skip ahead to #R$E4C6
 $E4BA LD A,(IX+$0F)        ; Read byte +15 of the record at IX into A
 $E4BD CALL $D224           ; Call the routine "Find a room record" (#R$D224)
 $E4C0 LD A,(IX+$09)        ; Read byte +9 of the record at IX into A
 $E4C3 LD ($A033),A         ; Store A in #R$A032($A033) in "Game variables"
*$E4C6 OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller
 $E4C8 RET                  ; Return to the caller

; Action record: put a train in a room (internal verb 140, RUN at $F2A7)
;
; Addresses named in the title: #R$F2A7, verb 140: #R$F2A5.
; .
; The direct object is a room number. The train (the actor) is moved there
; (#R$DD0E) and the room record at #R$DCFF gets bit 6 cleared. If the room is
; 2, 3 or 4 (the stretch between stations) 'THE TRAIN PULLS OUT OF THE
; STATION.' is printed first. In the sampled runs (the first three of each
; kind) each of the train things 37 to 41 went from room 2 to a room of its own
; (30, 26, 21, 27 and 31) with its +5 bit 7 set; the timetable's later moves
; (#R$F278, #R$F28D) were not sampled.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 69,693 times in 14 of them, run by steam
; train. Every one of its 27 instructions was executed
; (tools/experiments/insn_coverage.py).
; .
; How it works:
; .
; 1. The direct object is a room number. If it is Lestrade, Watson or Straker
; (things 2, 3, 4), print 'THE TRAIN PULLS OUT OF THE STATION.' and use the
; routine that clears the revealed flag (#R$9C60); otherwise the one that sets
; it (#R$9C56).
; .
; 2. Run that routine on the train, move the train to the room (#R$DD0E) and
; clear the visited bit of the room's record.
;
;  Input:$A034 The room number
; Output:F NZ; the train moved there and the room's visited bit cleared
c$E4C9 DEFB $04,$00  ; Action record header: flags $04; byte 1 $00
 $E4CB LD HL,$9C56   ; HL = #R$9C56
 $E4CE LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - The
                     ; direct object (#R$A032($A034))
 $E4D1 PUSH AF       ; Save AF on the stack
 $E4D2 CP $02        ; Compare A with $02 - Thing 2, 3 or 4 (Lestrade, Watson,
                     ; Straker)? Otherwise #R$E4E7
 $E4D4 JR Z,$E4DE    ; If A equals $02, skip ahead to #R$E4DE
 $E4D6 CP $03        ; Compare A with $03
 $E4D8 JR Z,$E4DE    ; If A equals $03, skip ahead to #R$E4DE
 $E4DA CP $04        ; Compare A with $04
 $E4DC JR NZ,$E4E7   ; If A differs from $04, skip ahead to #R$E4E7
*$E4DE LD HL,$7611   ; "THE TRAIN PULLS OUT OF THE STATION."
 $E4E1 CALL $A59F    ; Print the message in HL (#R$A59F)
 $E4E4 LD HL,$9C60   ; HL = #R$9C60, a routine to run
*$E4E7 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Keep
                     ; the current actor
 $E4EA PUSH AF       ; Save AF on the stack
 $E4EB CALL $E4FB    ; Call (HL) (#R$E4FB)
 $E4EE POP AF        ; Restore AF from the stack - Restore the actor
 $E4EF POP BC        ; Restore BC from the stack
 $E4F0 CALL $DD0E    ; Reset the actor's state (#R$DD0E)
 $E4F3 LD HL,($DCFF) ; Read #R$DCFF in "Pre-check for moving in a direction
                     ; (verbs..." into HL - Clear bit 6 of the record at
                     ; (#R$DCFF)
 $E4F6 RES 6,(HL)    ; Clear bit 6 of the byte HL points at
 $E4F8 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Return NZ
 $E4FA RET           ; Return to the caller
*$E4FB JP (HL)       ; Jump to the address in HL
 $E4FC LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - (Next
                     ; record) the direct object (#R$A032($A034)): is anything
                     ; held by it (#R$E619)?
 $E4FF CALL $E619    ; Call #R$E619 (inside "Action record: RUN at #R$E08F; RUN
                     ; at #R$E46B;...")
 $E502 JP Z,$DC15    ; If the zero flag is set, go back to the routine "Fail: A
                     ; = 0, HL = 0, Z set" (#R$DC15) - None: fail
 $E505 RET           ; Return to the caller

; Sub-script: pay the cab fare
;
; If #R$E518 allows it, PAY TO (#R$E370) with the plan's objects; run by the
; cab sub-script at #R$EBA4 (#R$EBCB). Read from the script.
; .
; Entry points: #R$E508 = body of record #R$E506.
; .
; Decoded by tools/plan.py; see #R$CC78 for the language. Each sub-block is one
; instruction. Room and object numbers are as the game uses them (the reference
; pages list both). Labels for verbs 128-140 and for the common helper records
; (#R$E52F, #R$E57A, #R$E588, #R$E5A8, #R$DDBE, #R$F198) were read from those
; records' code, not tried one by one in the emulator.
; .
; In an instruction, 'plan dobj' and 'plan iobj' are not fixed objects: they
; mean the direct and indirect object currently held in the actor's plan
; registers (bytes +4 and +5 of its actor record), so the same step works on
; whatever the actor is dealing with - for the player, the objects of the
; command just typed. 'plan verb' is the verb register (+3), 'self' is the
; acting character, and '-' means none.
b$E506 DEFB $AD,$0D                     ; Action record header: flags $AD; bit
                                        ; 5: test #R$D078 first; bit 7: checks
                                        ; only; byte 1 $0D - checks-only: the
                                        ; script follows
 $E508 DEFB $C7,$18,$E5,$FD,$FC,$10,$E5 ; RUN #R$E518 (plan dobj, plan iobj)
                                        ; [busy; ok #R$E510]
 $E50F DEFB $0A                         ; RETURN FAIL
 $E510 DEFB $57,$70,$E3,$FD,$FC,$0F,$E5 ; RUN #R$E370 (plan dobj, plan iobj)
                                        ; [busy; fail #R$E50F]
 $E517 DEFB $0B                         ; RETURN OK

; Action record: pay everything in the purse (RUN at $E508)
;
; Addresses named in the title: #R$E508.
; .
; Prepares the payment step of the sub-script at #R$E506. The direct object
; becomes the number $FE, and the sum to pay (#R$A02A($A02F)) is the whole
; balance held by the payer's purse (+9/+10) with bit 7 set; the next step, PAY
; TO (#R$E370), then hands it over. The cabbie's purse balance is negative
; while a fare is owed, so paying 'everything' from the cabbie's purse pays the
; change. Seen: Lestrade paid the cabbie his whole purse (2,400d, ten pounds)
; and the cabbie paid the change back; the cabbie did the same for you.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 187 times in 14 of them, run by cabbie,
; inspector lestrade. Every one of its 8 instructions was executed
; (tools/experiments/insn_coverage.py).
;
;  Input:IX The purse
; Output:$9FD7 $FE
;        $A02F The amount in the number form
;        F NZ
c$E518 DEFB $6D,$0D,$FC,$E4 ; Action record header: flags $6D; bit 5: test
                            ; #R$D078 first; bit 6: pre-check at #R$E4FC; byte
                            ; 1 $0D
 $E51C LD A,$FE             ; Load A with $FE - The plan's direct object
                            ; (#R$9FD7) = $FE (a number)
 $E51E LD ($9FD7),A         ; Store A in the plan's direct object (#R$9FD7)
 $E521 LD L,(IX+$09)        ; Read byte +9 of the record at IX into L - HL =
                            ; the word at IX+9/+10 (an amount)
 $E524 LD H,(IX+$0A)        ; Read byte +10 of the record at IX into H
 $E527 SET 7,L              ; Bit 7 set: the number form
 $E529 LD ($A02F),HL        ; Store it at #R$A02A($A02F)
 $E52C OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller - Return NZ
 $E52E RET                  ; Return to the caller

; Script helper: start a countdown for the actor
;
; RUN #R$E52F / n / m: puts a 2-byte node (the actor, n plus a random number
; from 0 to m) on the countdown list at #R$9FE5. #R$E57A ticks it and #R$E588
; cancels it. Read from the code.
; .
; Used by: RUN at #R$E456; RUN at #R$E732; RUN at #R$E745; RUN at #R$E751; RUN
; at #R$EEAA; RUN at #R$EF34; RUN at #R$F004; RUN at #R$F080; RUN at #R$F2BA;
; RUN at #R$F2D3; RUN at #R$F2FF; RUN at #R$F334.
;
;  Input:$A034 The fixed part
;        $A035 The random part ($ FF for none)
; Output:F NZ; a countdown node (actor, n plus random) on the list at $9FE5
c$E52F DEFB $07,$07  ; Action record header: flags $07; byte 1 $07
 $E531 LD A,$02      ; Load A with $02 - A 2-byte node
 $E533 CALL $A11C    ; Call the routine "Allocate A + 3 bytes from the free
                     ; list, cleared" (#R$A11C)
 $E536 LD HL,($9FE5) ; Read countdowns (#R$9FE5) into HL - Link it in at the
                     ; head of the countdown list
 $E539 LD ($9FE5),IX ; Store IX in countdowns (#R$9FE5)
 $E53D LD (IX-$02),L ; Store L in byte -2 of the record at IX
 $E540 LD (IX-$01),H ; Store H in byte -1 of the record at IX
 $E543 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - +0:
                     ; whose countdown
 $E546 LD (IX+$00),A ; Store A in the first byte of the record at IX
 $E549 LD A,($A035)  ; Read #R$A032($A035) in "Game variables" into A - The
                     ; random part, if any...
 $E54C LD B,$00      ; Load B with $00
 $E54E CP $FF        ; Compare A with $FF
 $E550 JR Z,$E556    ; If A equals $FF, skip ahead to #R$E556
 $E552 CALL $D2A4    ; Call the routine "A random number from 0 to A" (#R$D2A4)
                     ; - ...a random number from 0 to it
 $E555 LD B,A        ; Copy A into B
*$E556 LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - Plus
                     ; the fixed part
 $E559 ADD A,B       ; Add B to A
 $E55A LD (IX+$01),A ; +1: the count
 $E55D OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Done
 $E55F RET           ; Return to the caller
*$E560 LD IX,$9FE7   ; Point IX at SIGNAL tokens (#R$9FE7) - Find the actor's
                     ; countdown: Z if none
*$E564 CALL $A0F7    ; Call the routine "Move IX to the next node of a list"
                     ; (#R$A0F7)
 $E567 RET Z         ; If the zero flag is set, return
 $E568 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A
 $E56B CP (IX+$00)   ; Compare A with the first byte of the record at IX
 $E56E JR NZ,$E564   ; If A differs from the first byte of the record at IX, go
                     ; back to #R$E564
 $E570 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller
 $E572 RET           ; Return to the caller
 $E573 CALL $E560    ; Call #R$E560 (inside "Script helper: start a countdown
                     ; for the...") - Refuse if there is none
 $E576 JP Z,$DC15    ; If the zero flag is set, go back to the routine "Fail: A
                     ; = 0, HL = 0, Z set" (#R$DC15)
 $E579 RET           ; Return to the caller

; Script helper: tick the countdown (fail when it runs out)
;
; Its pre-check (#R$E573) refuses when the actor has no countdown. The body
; counts it down: still running, the instruction succeeds - taking no time, so
; the script goes straight on (scripts pair it with IDLE, #R$E5A8, which takes
; a minute); at zero the countdown is removed and the instruction fails, so a
; script can 'do X until the time is up' with a success branch back to X. Read
; from the code.
; .
; Used by: RUN at #R$E482; RUN at #R$E76C; RUN at #R$E7AC; RUN at #R$EEB6; RUN
; at #R$EF40; RUN at #R$F010; RUN at #R$F088; RUN at #R$F2C6; RUN at #R$F2E0;
; RUN at #R$F317; RUN at #R$F352.
;
; Output:F NZ while the countdown runs; $DC15 when it runs out and is removed
c$E57A DEFB $40,$00,$73,$E5 ; Action record header: flags $40; bit 6: pre-check
                            ; at #R$E573; byte 1 $00
 $E57E DEC (IX+$01)         ; Count down
 $E581 RET NZ               ; Still running: succeed
 $E582 CALL $E58C           ; Run out: remove it...
 $E585 JP $DC15             ; ...and fail

; Script helper: cancel the actor's countdown
;
; Unlinks the actor's countdown node from #R$9FE5 and frees it; the pre-check
; refuses when there is none. #R$E58C is the shared tail also used by #R$E57A.
; Read from the code.
; .
; Used by: RUN at #R$E467; RUN at #R$E7B2; RUN at #R$E7B6; RUN at #R$EF96; RUN
; at #R$F2D0; RUN at #R$F2FC; RUN at #R$F32E; RUN at #R$F359; RUN at #R$F366;
; RUN at #R$F3A2.
;
;  Input:IX The actor's countdown node
; Output:F NZ; the node unlinked and freed
c$E588 DEFB $40,$00,$73,$E5 ; Action record header: flags $40; bit 6: pre-check
                            ; at #R$E573; byte 1 $00
; This entry point is used by the routine at #R$E57A.
*$E58C PUSH IX              ; Save IX on the stack - DE = the node
 $E58E POP DE               ; Restore DE from the stack
 $E58F LD IY,$9FE5          ; Point IY at countdowns (#R$9FE5) - Find the node
                            ; before it
 $E593 CALL $A104           ; Call the routine "Find the node before node DE in
                            ; the list at IY" (#R$A104)
 $E596 LD L,(IX-$02)        ; Read byte -2 of the record at IX into L - Unlink
                            ; it
 $E599 LD H,(IX-$01)        ; Read byte -1 of the record at IX into H
 $E59C LD (IY-$02),L        ; Store L in byte -2 of the record at IY
 $E59F LD (IY-$01),H        ; Store H in byte -1 of the record at IY
 $E5A2 CALL $A1C7           ; Free it
 $E5A5 OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller - Done
 $E5A7 RET                  ; Return to the caller

; Script helper: idle for a minute
;
; No checks; byte 1's high nibble makes it take one minute, and the body just
; succeeds. Read from the code.
; .
; Used by: RUN at #R$E756; RUN at #R$E786; RUN at #R$E794; RUN at #R$E79C; RUN
; at #R$E7DC; RUN at #R$ECD0; RUN at #R$EF90; RUN at #R$F085; RUN at #R$F13F;
; RUN at #R$F192; RUN at #R$F2BF; RUN at #R$F2DD; RUN at #R$F314; RUN at
; #R$F34F.
;
; Output:F NZ
c$E5A8 DEFB $00,$10  ; Action record header: flags $00; byte 1 $10
 $E5AA OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller
 $E5AC RET           ; Return to the caller

; Verb 131 (scripts only): is the direct object in room n?
;
; Confirmed in the emulator: 864 successes in 84 turns, each with the thing
; really in that room.
; .
; Used by: internal verb #R$E5AD(131) (IS IN: is the direct object in room
; (indirect object)?).
;
;  Input:$A034 The thing
;        $A035 The room
; Output:F NZ if the thing is in that room; otherwise $DC15
c$E5AD DEFB $4C,$04,$B1,$E5 ; Action record header: flags $4C; bit 6: pre-check
                            ; at #R$E5B1; byte 1 $04
 $E5B1 LD IX,($A013)        ; The direct object's record
 $E5B5 LD A,($A035)         ; The room asked about...
 $E5B8 CP (IX+$0F)          ; ...is that where it is?
 $E5BB JP NZ,$DC15          ; No: refuse
 $E5BE OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller - Yes: succeed
 $E5C0 RET                  ; Return to the caller

; Action record: is the player in my room? (RUN at $E781)
;
; Addresses named in the title: #R$E781.
; .
; Compares the room of the first actor in the table (the player, #R$9860) with
; the current actor's and goes on to #R$E5F0, which refuses if they differ (and
; if the actor is the direct object). It is used in Watson's script (actor 3,
; #R$E72F, at #R$E781).
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 385 times in 1 of them, run by watson.
; Every one of its 7 instructions was executed
; (tools/experiments/insn_coverage.py).
;
;  Input:$A017 The thing to compare with
; Output:F From $E5F0: NZ if the player is in the same room
c$E5C1 DEFB $00,$00  ; Action record header: flags $00; byte 1 $00
 $E5C3 LD A,($9860)  ; The first actor in the table (#R$9860, the player)...
 $E5C6 CALL $D237    ; Call the routine "Resolve an id (in A) to its full
                     ; entity record" (#R$D237) - ...its record (#R$D237): its
                     ; room (+15)
 $E5C9 LD A,(IX+$0F) ; Read byte +15 of the record at IX into A
 $E5CC LD IX,($A017) ; Read #R$A012($A017) in "Game variables" into IX -
                     ; Compare with the room of the thing at (#R$A012($A017))
 $E5D0 CP (IX+$0F)   ; Compare A with byte +15 of the record at IX
 $E5D3 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - The
                     ; current actor into A; on to #R$E5F0
 $E5D6 JR $E5F0      ; Skip ahead to #R$E5F0

; Verb 129 (scripts only): are two things in the same room?
;
; Refuses if the direct and indirect objects are in different rooms, or are the
; same thing. Confirmed in the emulator: 482 tests, equal exactly when the
; rooms were.
; .
; Used by: internal verb #R$E5D8(129) (IS WITH: are the direct and indirect
; objects in the same room?).
;
;  Input:$A034, $A035 Two things
; Output:F NZ if they are in the same room and are different; otherwise $DC15
c$E5D8 DEFB $47,$07,$DF,$E5 ; Action record header: flags $47; bit 6: pre-check
                            ; at #R$E5DF; byte 1 $07
 $E5DC OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller
 $E5DE RET                  ; Return to the caller
 $E5DF LD IX,($A013)        ; Read #R$A012($A013) in "Game variables" into IX -
                            ; The direct object's room...
 $E5E3 LD A,(IX+$0F)        ; Read byte +15 of the record at IX into A
 $E5E6 LD IX,($A015)        ; ...and the indirect object's
 $E5EA CP (IX+$0F)          ; Compare A with byte +15 of the record at IX - The
                            ; same?
 $E5ED LD A,($A035)         ; Read #R$A032($A035) in "Game variables" into A
; This entry point is used by the routines at #R$E5C1 and #R$E5FD.
*$E5F0 JP NZ,$DC15          ; No: refuse
 $E5F3 LD HL,$A034          ; Nor may it be the actor itself
 $E5F6 CP (HL)              ; Compare A with the byte at #R$A032($A034) in
                            ; "Game variables"
 $E5F7 JP Z,$DC15           ; It is: refuse
 $E5FA OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller - Succeed
 $E5FC RET                  ; Return to the caller

; Action record: RUN at $E08F; RUN at $E46B; internal verb 130 (IS HERE: is the
; direct object with the actor ($C863)?)
;
; Addresses named in the title: #R$E08F, #R$E46B, #R$C863.
; .
; Internal verb #R$E5FD(130), IS HERE. The header (flags $47) names a pre-check
; at #R$E604, which is the whole test: where the actor is (#R$C863) and where
; the direct object is (#R$C863) - each being the place found by climbing out
; through open containers (#R$C86E), handed back in the alternate A register,
; hence the EX AF,AF' - must be the same, and the direct object must not be the
; actor itself (#R$E5F3); otherwise the record refuses (#R$DC15). So a person
; in a cab IS HERE for someone in the same cab, and Lestrade's 'is the player
; in the police cab with me' (#R$EA78) works the same way. Read from the code;
; the cab case behaved so in the chase runs (tools/experiments/chase.py).
;
;  Input:$A034 The direct object
; Output:F NZ if it is with the actor; otherwise $DC15
c$E5FD DEFB $47,$00,$04,$E6 ; Action record header: flags $47; bit 6: pre-check
                            ; at #R$E604; byte 1 $00
 $E601 OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller
 $E603 RET                  ; Return to the caller
 $E604 LD A,($A036)         ; Read #R$A032($A036) in "Game variables" into A -
                            ; The actor's place (#R$C863), from A'
 $E607 CALL $C863           ; Call the routine "Is thing number A here?
                            ; (#R$C86E)" (#R$C863)
 $E60A EX AF,AF'            ; Swap AF with the shadow copy
 $E60B LD B,A               ; Copy A into B
 $E60C LD A,($A034)         ; Read #R$A032($A034) in "Game variables" into A -
                            ; The direct object's place
 $E60F CALL $C863           ; Call the routine "Is thing number A here?
                            ; (#R$C86E)" (#R$C863)
 $E612 EX AF,AF'            ; Swap AF with the shadow copy
 $E613 CP B                 ; Compare A with B - Not the same place: refuse
                            ; (#R$E5F0)
 $E614 LD A,($A036)         ; Read #R$A032($A036) in "Game variables" into A
 $E617 JR $E5F0             ; Go back to #R$E5F0
; This entry point is used by the routines at #R$9B25, #R$E328, #R$E370,
; #R$E4C9, #R$E63E, #R$E654, #R$E66F and #R$E6BC.
*$E619 LD C,A               ; Copy A into C - A = a holder. Look through things
                            ; 1 to $6D...
 $E61A LD B,$FF             ; Load B with $FF
*$E61C INC B                ; Add one to B
 $E61D LD A,B               ; Copy B into A
 $E61E CP $6E               ; Compare A with $6E - None: Z
 $E620 RET Z                ; If A equals $6E, return
 $E621 CALL $D237           ; Call the routine "Resolve an id (in A) to its
                            ; full entity record" (#R$D237)
 $E624 LD A,(IX+$01)        ; Read byte +1 of the record at IX into A - ...for
                            ; one that this holder holds (+1)...
 $E627 CP C                 ; Compare A with C
 $E628 JR NZ,$E61C          ; If A differs from C, go back to #R$E61C
 $E62A LD HL,$0575          ; Load HL with $0575 - ...and whose name is MONEY
                            ; ($0575): found with IX = the purse (NZ)
 $E62D LD A,(IX+$07)        ; Read byte +7 of the record at IX into A
 $E630 CP L                 ; Compare A with L
 $E631 JR NZ,$E61C          ; If A differs from L, go back to #R$E61C
 $E633 LD A,(IX+$08)        ; Read byte +8 of the record at IX into A
 $E636 AND $0F              ; Keep only bits 0, 1, 2, 3 of A (mask $0F)
 $E638 CP H                 ; Compare A with H
 $E639 JR NZ,$E61C          ; If A differs from H, go back to #R$E61C
 $E63B OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller
 $E63D RET                  ; Return to the caller

; Action record: is a fare owed? (RUN at $F2D8)
;
; Addresses named in the title: #R$F2D8.
; .
; No body; the pre-check passes only if the cabbie holds a purse and its
; balance is negative (bit 7 of the sum set) - a fare is owed (my reading of
; how #R$F2D8 uses it: the script waits until the record passes). The cabbie's
; script at #R$F2B6 reads the balance of his purse (+9/+10 of the money he
; holds): negative while a fare is owed, positive when change is due, zero when
; settled.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 711 times in 14 of them, run by cabbie.
; Every one of its 7 instructions was executed
; (tools/experiments/insn_coverage.py).
;
; Output:F NZ if the cabbie holds a purse with a negative balance (a fare is
; .        owed); otherwise $DC15
c$E63E DEFB $40,$00,$42,$E6 ; Action record header: flags $40; bit 6: pre-check
                            ; at #R$E642; byte 1 $00
 $E642 LD A,($A036)         ; Read #R$A032($A036) in "Game variables" into A -
                            ; Is anything held by the actor (#R$E619)? No: fail
 $E645 CALL $E619           ; Call #R$E619 (inside "Action record: RUN at
                            ; #R$E08F; RUN at #R$E46B;...")
 $E648 JP Z,$DC15           ; If the zero flag is set, go back to the routine
                            ; "Fail: A = 0, HL = 0, Z set" (#R$DC15)
 $E64B CALL $E39C           ; Call the routine "HL = the money a thing holds
                            ; (+9/+10)" (#R$E39C) - Test the result (#R$E39C):
                            ; bit 7 of HL clear: fail
 $E64E BIT 7,H              ; Test bit 7 of H
 $E650 JP Z,$DC15           ; If bit 7 of H is clear, go back to the routine
                            ; "Fail: A = 0, HL = 0, Z set" (#R$DC15)
 $E653 RET                  ; Return to the caller

; Action record: is change due? (RUN at $F304, $F31C, $F339)
;
; Addresses named in the title: #R$F304, #R$F31C, #R$F339.
; .
; No body; the pre-check passes only if the cabbie's purse holds a positive sum
; - change is due to the passenger. The cabbie's script at #R$F2B6 reads the
; balance of his purse (+9/+10 of the money he holds): negative while a fare is
; owed, positive when change is due, zero when settled.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 2,034 times in 14 of them, run by cabbie,
; local police man. Every one of its 10 instructions was executed
; (tools/experiments/insn_coverage.py).
;
; Output:F NZ if the cabbie's purse holds a positive sum; otherwise $DC15
c$E654 DEFB $40,$00,$58,$E6 ; Action record header: flags $40; bit 6: pre-check
                            ; at #R$E658; byte 1 $00
 $E658 LD A,($A036)         ; Read #R$A032($A036) in "Game variables" into A
 $E65B CALL $E619           ; Call #R$E619 (inside "Action record: RUN at
                            ; #R$E08F; RUN at #R$E46B;...") - Pre-check: does
                            ; the actor hold a purse? (#R$E619) No: refuse
 $E65E JP Z,$DC15           ; If the zero flag is set, go back to the routine
                            ; "Fail: A = 0, HL = 0, Z set" (#R$DC15)
 $E661 CALL $E39C           ; HL = its money (#R$E39C)
 $E664 BIT 7,H              ; Test bit 7 of H - Negative: refuse
 $E666 JP NZ,$DC15          ; If bit 7 of H is set, go back to the routine
                            ; "Fail: A = 0, HL = 0, Z set" (#R$DC15)
 $E669 LD A,H               ; Copy H into A - Nothing in it: refuse
 $E66A OR L                 ; Set in A the bits that are set in L
 $E66B JP Z,$DC15           ; If the result is zero, go back to the routine
                            ; "Fail: A = 0, HL = 0, Z set" (#R$DC15)
 $E66E RET                  ; Pass: it holds some money

; Action record: is the account settled? (RUN at $F309, $F321, $F33E)
;
; Addresses named in the title: #R$F309, #R$F321, #R$F33E.
; .
; No body; the pre-check passes when the cabbie has no purse or its balance is
; exactly zero. The cabbie's script at #R$F2B6 reads the balance of his purse
; (+9/+10 of the money he holds): negative while a fare is owed, positive when
; change is due, zero when settled.
; .
; The block also holds two routines that merely follow it in memory (#R$E686
; and #R$E691): a 50 percent roll used by Watson's after-turn code, and the
; remark in which Watson asks 'why do you think that ...?' about a statement
; chosen at random from the list of statements already made. Only the
; empty-list check and the final print of that remark (#R$E6A4-#R$E6B6) were
; never executed.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 1,836 times in 14 of them, run by cabbie,
; local police man. 30 of its 34 instructions were executed; the rest (#R$E6A4
; #R$E6B1 #R$E6B3 #R$E6B6) never ran in any stored route, and were therefore
; read from the code only.
;
; Output:F NZ if the cabbie has no purse or its balance is zero; otherwise
; .        $DC15
c$E66F DEFB $40,$00,$73,$E6 ; Action record header: flags $40; bit 6: pre-check
                            ; at #R$E673; byte 1 $00
 $E673 LD A,($A036)         ; Pre-check: A = the current actor (#R$A032($A036))
 $E676 CALL $E619           ; Is anything held by that actor (#R$E619)?
 $E679 JR Z,$E683           ; None: succeed (#R$E683)
 $E67B CALL $E39C           ; Otherwise check the result (#R$E39C)
 $E67E LD A,H               ; Copy H into A - HL non-zero: fail (#R$DC15)
 $E67F OR L                 ; Set in A the bits that are set in L
 $E680 JP NZ,$DC15          ; If the result is not zero, go back to the routine
                            ; "Fail: A = 0, HL = 0, Z set" (#R$DC15)
*$E683 OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller - Succeed, NZ
 $E685 RET                  ; Return to the caller
*$E686 CALL $D29D           ; Call the routine "A random number from 1 to 100"
                            ; (#R$D29D) - Roll 1-100 (#R$D29D)...
 $E689 CP $32               ; Compare A with $32
 $E68B JP C,$DC15           ; ...under 50: fail
 $E68E OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller - 50 or more: NZ
 $E690 RET                  ; Return to the caller
; This entry point is used by the routine at #R$9D13.
*$E691 CALL $E686           ; Watson's after-turn remark about something
                            ; already said: the 50% roll first
 $E694 RET Z                ; Failed the roll: nothing to say
 $E695 CALL $D29D           ; Call the routine "A random number from 1 to 100"
                            ; (#R$D29D) - Another roll 1-100 into B: how far
                            ; along the list of remembered statements to go
 $E698 LD B,A               ; Copy A into B
*$E699 LD IX,$9FF6          ; IX = the head of the list at #R$9FF2($9FF6)
*$E69D DJNZ $E6A6           ; Count B down (#R$E6A6 when done)
 $E69F CALL $A0F7           ; Call the routine "Move IX to the next node of a
                            ; list" (#R$A0F7) - Next node (#R$A0F7); at the end
                            ; of the list start again
 $E6A2 JR Z,$E699           ; If the zero flag is set, go back to #R$E699
 $E6A4 JR $E69D             ; Go back to #R$E69D
*$E6A6 PUSH IX              ; Save IX on the stack - Is it the head itself (an
                            ; empty list)?
 $E6A8 POP HL               ; Restore HL from the stack
 $E6A9 LD DE,$9FF6          ; Point DE at #R$9FF2($9FF6) in "Game variables"
 $E6AC AND A                ; Clear the carry flag, so that the subtraction
                            ; that follows is a plain one (a compare)
 $E6AD SBC HL,DE            ; Subtract DE from HL (a compare: carry = HL was
                            ; smaller, zero = equal)
 $E6AF JR Z,$E6B9           ; If the two values are equal, skip ahead to
                            ; #R$E6B9
 $E6B1 PUSH IX              ; No: print the question about that statement with
                            ; IX as its subject (#R$6F80)
 $E6B3 LD HL,$6F80          ; Point HL at the message "YOU SAY" WHY DO YOU
                            ; THINK THAT YOU AND YOU?"." (#R$6F80)
 $E6B6 CALL $A59F           ; Call the routine "Print the message at HL"
                            ; (#R$A59F)
*$E6B9 OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller - Return NZ
 $E6BB RET                  ; Return to the caller

; Action record: the cabbie names the fare (RUN at $F326)
;
; Addresses named in the title: #R$F326.
; .
; Prints '"Right guv'nor that will be Nd."' using the negative of the cabbie's
; purse balance. Seen 190 times with you as the passenger, 68 with Lestrade,
; and with Phipps, the Major and the German agent.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 329 times in 14 of them, run by cabbie.
; Every one of its 16 instructions was executed
; (tools/experiments/insn_coverage.py).
;
;  Input:$A035 The cabbie
; Output:F NZ; the fare named
c$E6BC DEFB $0D,$0C  ; Action record header: flags $0D; byte 1 $0C
 $E6BE LD A,($A035)  ; Read #R$A032($A035) in "Game variables" into A - The
                     ; indirect object (#R$A032($A035)): is anything held by it
                     ; (#R$E619)?
 $E6C1 CALL $E619    ; Call #R$E619 (inside "Action record: RUN at #R$E08F; RUN
                     ; at #R$E46B;...")
 $E6C4 JR Z,$E6E3    ; None: return NZ
 $E6C6 LD E,(IX+$09) ; Read byte +9 of the record at IX into E - DE = the word
                     ; at IX+9/+10
 $E6C9 LD D,(IX+$0A) ; Read byte +10 of the record at IX into D
 $E6CC LD HL,$6BB7   ; Point HL at the message "YOU SAY TO THE OIL LAMP" RIGHT
                     ; GUV'NOR THAT WILL... (#R$6BB7)
 $E6CF CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $E6D2 LD HL,$0000   ; Load HL with $0000
 $E6D5 AND A         ; Clear the carry flag, so that the subtraction that
                     ; follows is a plain one (a compare)
 $E6D6 SBC HL,DE     ; Subtract DE from HL (a compare: carry = HL was smaller,
                     ; zero = equal)
 $E6D8 CALL $A419    ; Call the routine "Print an amount of money" (#R$A419)
 $E6DB LD A,$22      ; Load A with $22
 $E6DD CALL $A9B7    ; Call the routine "Print character A, a word at a time
                     ; (word wrap)" (#R$A9B7)
 $E6E0 CALL $A2A2    ; Call the routine "Print a newline (A kept)" (#R$A2A2)
*$E6E3 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller
 $E6E5 RET           ; Return to the caller

; Action record: take the passenger in my cab as the one to deal with (RUN at
; $F2F7, $F35F, $F371)
;
; Addresses named in the title: #R$F2F7, #R$F35F, #R$F371.
; .
; The pre-check refuses unless the actor is not the direct object and the
; direct object's holder is one less than the actor's number - that is, the
; passenger is inside the cab that the cabbie (thing 31) drives (thing 30). The
; body then stores the direct object in +3 of the actor's table record
; (#R$CFB6) - the saved direct-object register of its plan - so the cabbie
; takes that person as the one he is dealing with. This body never ran in any
; stored route or test: its pre-check was reached 29 times in v12_clean_win and
; refused each time (the cabbie was its own direct object 19 times, and the
; passenger was out of the cab, holder $FF, 10 times). I could not build a
; situation in which the passenger is still in the cab when the script reaches
; it, so the body is read from the code only.
; .
; 8 of its 15 instructions were executed; the rest (#R$E6EA #R$E6ED #R$E6F0
; #R$E6F3 #R$E6F5 #R$E70B #R$E70D) never ran in any stored route, and were
; therefore read from the code only.
;
;  Input:$A034 The passenger
; Output:F NZ; the cab's step record's +3 is the passenger
;        IX That record
c$E6E6 DEFB $4D,$00,$F6,$E6 ; Action record header: flags $4D; bit 6: pre-check
                            ; at #R$E6F6; byte 1 $00
 $E6EA CALL $CFB6           ; IX = the record #R$CFB6 yields...
 $E6ED LD A,($A034)         ; Read #R$A032($A034) in "Game variables" into A -
                            ; ...its +3 becomes the direct object
                            ; (#R$A032($A034))
 $E6F0 LD (IX+$03),A        ; Store A in byte +3 of the record at IX
 $E6F3 OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller - Succeed
 $E6F5 RET                  ; Return to the caller
 $E6F6 LD A,($A036)         ; Read #R$A032($A036) in "Game variables" into A -
                            ; Pre-check: the actor must not be the direct
                            ; object itself
 $E6F9 LD HL,$A034          ; Point HL at #R$A032($A034) in "Game variables"
 $E6FC CP (HL)              ; Compare A with the byte at #R$A032($A034) in
                            ; "Game variables"
 $E6FD JP Z,$DC15           ; If A equals the byte at #R$A032($A034) in "Game
                            ; variables", go back to the routine "Fail: A = 0,
                            ; HL = 0, Z set" (#R$DC15)
 $E700 DEC A                ; Subtract one from A - And the direct object's
                            ; holder (+1) must be the actor's number less 1;
                            ; else refuse
 $E701 LD IX,($A013)        ; Read #R$A012($A013) in "Game variables" into IX
 $E705 CP (IX+$01)          ; Compare A with byte +1 of the record at IX
 $E708 JP NZ,$DC15          ; If A differs from byte +1 of the record at IX, go
                            ; back to the routine "Fail: A = 0, HL = 0, Z set"
                            ; (#R$DC15)
 $E70B OR $01               ; Make A non-zero, which clears the zero flag, and
                            ; hand that back to the caller
 $E70D RET                  ; Return to the caller

; Action record: the cabbie's parting shout (RUN at $F35C)
;
; Addresses named in the title: #R$F35C.
; .
; The cabbie's parting shout when a passenger has gone without paying: 'The
; cabbie shouts " You bloody snob, watch out if we ever meet again ... "'
; (#R$6C54). Seen in end4b, after Major Percival Ffoulkes climbed out of the
; cab unpaid ('What about me money guv'nor?' repeated first). The record reads
; +3 of the actor's table record (the saved direct-object register, #R$CFB6):
; if it is non-zero it prints the shout; if it is zero it sets the ROM variable
; #LINK(rom_symbols#a5C3C)($5C3C) to 1 first and then prints (what that does to
; the print was not tested; #R$E720 and #R$E722 never ran). When I climbed out
; unpaid myself in a test the cabbie only repeated 'What about me money
; guv'nor?' for the next seven hours, so the route to the shout is not simply
; 'leave without paying'.
; .
; Seen in the emulator (9 November, tools/experiments/record_coverage.py over
; the 15 stored routes): the body ran 46 times in 12 of them, run by cabbie. 12
; of its 14 instructions were executed; the rest (#R$E720 #R$E722) never ran in
; any stored route, and were therefore read from the code only.
;
; Output:F NZ; the cabbie's shout printed, if the player can see it
c$E70E DEFB $00,$00  ; Action record header: flags $00; byte 1 $00
 $E710 LD A,($5C3C)  ; Read the output-switch byte (TV_FLAG)
                     ; (#LINK(rom_symbols#a5C3C)($5C3C)) into A - Keep the
                     ; output switch #LINK(rom_symbols#a5C3C)($5C3C)
 $E713 PUSH AF       ; Save AF on the stack
 $E714 CALL $CFB6    ; (#R$CFB6)
 $E717 LD A,(IX+$03) ; Read byte +3 of the record at IX into A - The record's
                     ; flags (+3)
 $E71A AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $E71B LD HL,$6C54   ; Point HL at the message "YOU SHOUTS" YOU BLOODY SNOB,
                     ; WATCH OUT IF WE... (#R$6C54)
 $E71E JR NZ,$E725   ; If A is not zero, skip ahead to #R$E725
 $E720 LD A,$01      ; Load A with $01
 $E722 LD ($5C3C),A  ; Store A in the output-switch byte (TV_FLAG)
                     ; (#LINK(rom_symbols#a5C3C)($5C3C))
*$E725 CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $E728 POP AF        ; Restore AF from the stack
 $E729 LD ($5C3C),A  ; Store A in the output-switch byte (TV_FLAG)
                     ; (#LINK(rom_symbols#a5C3C)($5C3C))
 $E72C OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller
 $E72E RET           ; Return to the caller

; Plan script: watson (actor 3)
;
; Entry points: #R$E72F = watson (actor 3).
; .
; Decoded by tools/plan.py; see #R$CC78 for the language. Each sub-block is one
; instruction. Room and object numbers are as the game uses them (the reference
; pages list both). Labels for verbs 128-140 and for the common helper records
; (#R$E52F, #R$E57A, #R$E588, #R$E5A8, #R$DDBE, #R$F198) were read from those
; records' code, not tried one by one in the emulator.
; .
; In an instruction, 'plan dobj' and 'plan iobj' are not fixed objects: they
; mean the direct and indirect object currently held in the actor's plan
; registers (bytes +4 and +5 of its actor record), so the same step works on
; whatever the actor is dealing with - for the player, the objects of the
; command just typed. 'plan verb' is the verb register (+3), 'self' is the
; acting character, and '-' means none.
b$E72F DEFB $06,$EB,$6D                 ; PRINT message #R$6DEB: "WATSON LOOKS
                                        ; UP FROM THE PAPER AND SAYS' GOOD
                                        ; MORNING HOLMES.'"
