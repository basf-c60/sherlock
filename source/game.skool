; Routines run when a statement of the case is proven
;
; Short routines whose addresses appear in the records between the player's
; plan script (which ends at #R$994A($994C) - CORRECTED, it was once taken for
; a five-entry table at #R$9923($9927)) and here (#R$99A9($99AD) -> #R$99FC,
; #R$99E3($99E7) -> #R$9A05, #R$9997($999B) -> #R$9A13, #R$9965($9969) ->
; #R$9A3D, #R$9973($9977) -> #R$9A4B, #R$9981($9985) -> #R$9A59). Each marks
; the current record done (#R$9A74: IX+3 bit 1 set, bit 0 clear), sometimes
; sets a flag in another record, and prints a message. UPDATED 2026-11-07: the
; records are the case table at #R$9965 (statements and their evidence); each
; of these routines belongs to one statement.
; .
; CORRECTED: the automatic split had these as data ('b' and 't' blocks); found
; because message references were landing inside data (tools/check.py). Read
; from code, not traced.
; .
; Instruction coverage over the 15 stored routes (9 November,
; tools/experiments/insn_coverage.py): 41 of 45 instructions executed; #R$9A2F
; #R$9A33 #R$9A37 #R$9A3A never ran there and are read from the code only.
;
;  Input:IX The action record being run (each routine is entered at its own
; .         address)
; Output:F Prints a message, then returns through $A59F
c$99FC CALL $9A74      ; Mark this record done
 $99FF LD HL,$7079     ; "RIGHT THEN HOLMES WE MUST HURRY IF WE ARE TO CATCH
                       ; THEM."
 $9A02 JP $A59F        ; ...print it and return
 $9A05 LD HL,$99FA     ; Point HL at #R$99F7($99FA) in "The case: statements
                       ; about the crime, and..." - Set bit 1 of the record at
                       ; #R$99F7($99FA)
 $9A08 SET 1,(HL)      ; Set bit 1 of the byte at #R$99F7($99FA) in "The case:
                       ; statements about the crime, and..."
 $9A0A CALL $9A74      ; Call #R$9A74 (inside "Routines run when a statement of
                       ; the case...")
 $9A0D LD HL,$70E3     ; Point HL at the message "I DO NOT SEE THE IMPORTANCE
                       ; OF THAT HOLMES." (#R$70E3)
 $9A10 JP $A59F        ; Jump on to the routine "Print the message at HL"
                       ; (#R$A59F)
 $9A13 LD A,($9976)    ; Read #R$9973($9976) in "The case: statements about the
                       ; crime, and..." into A - Needs bit 1 of
                       ; #R$9973($9976)...
 $9A16 AND $02         ; Isolate bit 1 of A (mask $02)
 $9A18 JR Z,$9A2F      ; If bit 1 of A was clear, skip ahead to #R$9A2F
 $9A1A LD A,($9984)    ; Read #R$9981($9984) in "The case: statements about the
                       ; crime, and..." into A - ...and of #R$9981($9984)
 $9A1D AND $02         ; Isolate bit 1 of A (mask $02)
 $9A1F JR Z,$9A2F      ; If bit 1 of A was clear, skip ahead to #R$9A2F
 $9A21 CALL $9A74      ; Both: mark done
 $9A24 LD HL,$99B2     ; Point HL at #R$99AF($99B2) in "The case: statements
                       ; about the crime, and..." - Set bit 1 of #R$99AF($99B2)
 $9A27 SET 1,(HL)      ; Set bit 1 of the byte at #R$99AF($99B2) in "The case:
                       ; statements about the crime, and..."
 $9A29 LD HL,$7099     ; Point HL at the message "VERY GOOD HOLMES, BASIL WILL
                       ; LIKELY TRY TO SELL... (#R$7099)
 $9A2C JP $A59F        ; Jump on to the routine "Print the message at HL"
                       ; (#R$A59F)
*$9A2F RES 1,(IX+$03)  ; Clear bit 1 of byte +3 of the record at IX - Otherwise
                       ; clear both bits
 $9A33 RES 0,(IX+$03)  ; Clear bit 0 of byte +3 of the record at IX
 $9A37 LD HL,$7265     ; Point HL at the message "YOU SAY" THAT MAY WELL BE,
                       ; HOLMES, I WILL THINK... (#R$7265)
 $9A3A JP $A59F        ; Jump on to the routine "Print the message at HL"
                       ; (#R$A59F)
 $9A3D CALL $9A74      ; Call #R$9A74 (inside "Routines run when a statement of
                       ; the case...")
 $9A40 LD A,$01        ; Load A with $01 - Set #R$9E87($9E88)
 $9A42 LD ($9E88),A    ; Store A in #R$9E87($9E88) in "Game-over record: the
                       ; Major is arrested"
 $9A45 LD HL,$70F0     ; Point HL at the message "VERY GOOD HOLMES, I SHALL
                       ; RETURN TO LEATHER HEAD... (#R$70F0)
 $9A48 JP $A59F        ; Jump on to the routine "Print the message at HL"
                       ; (#R$A59F)
 $9A4B CALL $9A74      ; Call #R$9A74 (inside "Routines run when a statement of
                       ; the case...")
 $9A4E LD HL,$9976     ; Point HL at #R$9973($9976) in "The case: statements
                       ; about the crime, and..." - Set bit 1 of #R$9973($9976)
 $9A51 SET 1,(HL)      ; Set bit 1 of the byte at #R$9973($9976) in "The case:
                       ; statements about the crime, and..."
 $9A53 LD HL,$6FAB     ; Point HL at the message "SO MRS BROWN KILLED HERSELF,
                       ; EXCELLENT HOLMES,... (#R$6FAB)
 $9A56 JP $A59F        ; Jump on to the routine "Print the message at HL"
                       ; (#R$A59F)
 $9A59 CALL $9A74      ; Call #R$9A74 (inside "Routines run when a statement of
                       ; the case...")
 $9A5C LD A,$5F        ; Load A with $5F - Thing $5F (95)...
 $9A5E CALL $D237      ; Call the routine "Resolve an id (in A) to its full
                       ; entity record" (#R$D237)
 $9A61 LD (IX+$01),$FF ; ...is in nothing...
 $9A65 LD (IX+$0F),$00 ; ...and goes off stage (room 0)
 $9A69 LD HL,$9984     ; Point HL at #R$9981($9984) in "The case: statements
                       ; about the crime, and..." - Set bit 1 of #R$9981($9984)
 $9A6C SET 1,(HL)      ; Set bit 1 of the byte at #R$9981($9984) in "The case:
                       ; statements about the crime, and..."
 $9A6E LD HL,$6FCA     ; Point HL at the message "BRILLIANT HOLMES, I DO NOT
                       ; KNOW HOW YOU DO IT.".... (#R$6FCA)
 $9A71 JP $A59F        ; Jump on to the routine "Print the message at HL"
                       ; (#R$A59F)
*$9A74 SET 1,(IX+$03)  ; Mark the record at IX done: bit 1 set...
 $9A78 RES 0,(IX+$03)  ; Clear bit 0 of byte +3 of the record at IX - ...bit 0
                       ; clear
 $9A7C RET             ; Return to the caller

; Three bytes ($FF, 0, 0) referenced from $BD4D
;
; Addresses named in the title: #R$BD4B($BD4D).
b$9A7D DEFB $FF

; Action record: default for verb 32 (HELLO)
;
; The record is only its two header bytes: HELLO has no body of its own, and
; the code that follows at #R$9A80 is what runs. Played: HELLO by itself prints
; 'HI.' and takes no time; SAY TO WATSON "HELLO" makes Watson answer 'Watson
; says " Good morning "'. In the stored routes this body ran 11 times, all with
; Chief Constable Straker as the actor.
c$9A7E DEFB $00,$00  ; Action record header: flags $00; byte 1 $00

; Print one of two messages, depending on who is acting
;
; Referenced from #R$F725. If the actor (#R$A032($A036)) is you, prints #R$6915
; and stores 1 at #R$A022($A027); otherwise prints #R$6920 and stores 0.
; Returns NZ (success). Read from code.
;
; Output:F NZ (success)
;        $A027 1 if the actor is you, 0 if someone else
c$9A80 LD A,($A036)  ; The actor
 $9A83 CP $00        ; Compare A with $00 - You?
 $9A85 LD A,$01      ; Load A with $01
 $9A87 LD HL,$6915   ; Point HL at the message "HI." (#R$6915)
 $9A8A JR Z,$9A90    ; If A equals $00, skip ahead to #R$9A90
 $9A8C XOR A         ; Someone else
 $9A8D LD HL,$6920   ; Point HL at the message "YOU SAY" GOOD MORNING "."
                     ; (#R$6920)
*$9A90 LD ($A027),A  ; Store A in #R$A022($A027) in "Game variables"
 $9A93 CALL $A59F    ; Print it
 $9A96 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - Succeed
 $9A98 RET           ; Return to the caller

; Shared action 1: the police cab, GO TO (Leatherhead routes, $9AA3)
;
; Addresses named in the title: #R$9AA3.
; .
; Header $04 $00 then code. #R$9AA3 knows the police cab's only three routes,
; from the room it is in (#R$A00A) to the direct object: Old Mill Road to Main
; Street (L = 112), Main Street to Old Mill Road (114) and Main Street to Kings
; Cross Road (94); anything else refuses (#R$DC15). L becomes the journey's
; length (#R$A01A($A01F), at #R$9B04), the vehicle to move is the police cab
; (thing 109 = $6D, put in #R$E2C6), and the ride ends at #R$9B20 by handing
; back the vehicle sub-script #R$F3AD.
; .
; Confirmed in the emulator (tools/experiments/chase.py stage P): told SAY TO
; POLICE MAN "GO TO KINGS CROSS ROAD" in Leatherhead's Main Street at 5:07pm,
; the police cab - with Lestrade and Watson aboard - reached Kings Cross Road
; at 6:42, 95 minutes. Asked for Buckingham Palace Road it did nothing.
; CORRECTED: was data in the automatic split.
;
;  Input:IX The action record
; Output:F Z when the route is refused; otherwise continues at $9AD7
c$9A99 INC B         ; Add one to B - Header $04 $00
 $9A9A NOP           ; Do nothing (padding)
 $9A9B CALL $9AA3    ; Call #R$9AA3 (inside "Shared action 1: the police cab,
                     ; GO TO...") - Is this one of the police cab's routes? No:
                     ; refuse
 $9A9E JP Z,$DC15    ; If the zero flag is set, jump on to the routine "Fail: A
                     ; = 0, HL = 0, Z set" (#R$DC15)
 $9AA1 JR $9AD7      ; Jump on to #R$9AD7
; This entry point is used by the routine at #R$9ACB.
*$9AA3 LD A,($A00A)  ; Read the current actor's room (#R$A00A) into A - From
                     ; Old Mill Road (room 103)...
 $9AA6 CP $67        ; Compare A with $67
 $9AA8 JR NZ,$9AB5   ; If A differs from $67, skip ahead to #R$9AB5
 $9AAA LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - ...to
                     ; Main Street (50): 112 minutes
 $9AAD CP $32        ; Compare A with $32
 $9AAF LD L,$70      ; Load L with $70
 $9AB1 JR Z,$9AC8    ; If A equals $32, skip ahead to #R$9AC8
*$9AB3 XOR A         ; Set A to zero, which sets the zero flag for the caller
 $9AB4 RET           ; Return to the caller
*$9AB5 CP $32        ; Compare A with $32 - From Main Street (50)...
 $9AB7 JR NZ,$9AB3   ; If A differs from $32, go back to #R$9AB3
 $9AB9 LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - ...to
                     ; Old Mill Road (103): 114 minutes,
 $9ABC CP $67        ; Compare A with $67
 $9ABE LD L,$72      ; Load L with $72
 $9AC0 JR Z,$9AC8    ; If A equals $67, skip ahead to #R$9AC8
 $9AC2 CP $12        ; Compare A with $12 - or to Kings Cross Road (18): 94
                     ; minutes
 $9AC4 JR NZ,$9AB3   ; If A differs from $12, go back to #R$9AB3
 $9AC6 LD L,$5E      ; Load L with $5E
*$9AC8 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller - NZ: a route, L = its minutes
 $9ACA RET           ; Return to the caller

; Shared action 2: the police cab, GO FURIOUSLY TO - 20 minutes quicker
;
; Header $04 $00 then code: the same routes (#R$9AA3) with 20 minutes taken off
; - 94 out to Old Mill Road and 92 back. That matches Lestrade's own trips
; logged in the emulator (Main Street 1:39pm to Old Mill Road 3:13, and back
; 3:14 to 4:47). The local police man's action list (after its 00 entry) sends
; verb #R$9A99(29), GO TO, to shared action 1 and verb #R$9ACB(30), GO
; FURIOUSLY TO, here. Lestrade's orders use verb #R$9ACB(30) both ways in the
; chase, and SAY TO POLICE MAN "GO FURIOUSLY TO KINGS CROSS ROAD" took 75
; minutes against 95 for plain GO TO (tools/experiments/chase.py stages F2 and
; P). CORRECTED: was data in the automatic split.
;
;  Input:IX The action record
; Output:F Z when the route is refused; otherwise continues at $9B04
c$9ACB DEFB $04,$00  ; Action record header: flags $04; byte 1 $00
 $9ACD CALL $9AA3    ; Call #R$9AA3 (inside "Shared action 1: the police cab,
                     ; GO TO...") - Work out the route's time as GO TO does
                     ; (#R$9AA3); no route: refuse
 $9AD0 JP Z,$DC15    ; If the zero flag is set, jump on to the routine "Fail: A
                     ; = 0, HL = 0, Z set" (#R$DC15)
 $9AD3 LD A,L        ; Copy L into A - Twenty minutes less: L - $14
 $9AD4 SUB $14       ; Subtract $14 from A
 $9AD6 LD L,A        ; Copy A into L
; This entry point is used by the routine at #R$9A99.
*$9AD7 LD A,$6D      ; Load A with $6D - The thing named at #R$E2C6 is $6D
                     ; (109)...
 $9AD9 LD ($E2C6),A  ; Store A in "HAIL: the cab hailed, plus one" (#R$E2C6)
 $9ADC LD A,$69      ; Load A with $69 - ...and the shared-action code is $69;
                     ; carry on as #R$9B04 does
 $9ADE JP $9B04      ; Skip ahead to #R$9B04

; Shared action 15: GO FURIOUSLY TO in a hansom cab - dearer, two minutes
; quicker
;
; Header $04 $00 then code: the route check (#R$9B50), the fare at 6d a step
; (#R$9B25 with DE = 6), and the table's minutes less 2 as the ride's length;
; then on as #R$9AF4. A cabbie's own action list sends verb #R$9AE1(30) (GO
; FURIOUSLY TO) here. Read from the code.
;
;  Input:IX The action record (a cabbie's GO FURIOUSLY TO)
; Output:F From the ride routine at $9B02
c$9AE1 DEFB $04,$00  ; Action record header: flags $04; byte 1 $00
 $9AE3 CALL $9B50    ; (#R$9B50)
 $9AE6 LD DE,$0006   ; Load DE with $0006 - DE = 6 (#R$9B25)
 $9AE9 CALL $9B25    ; Call the routine "Price a cab ride from its journey
                     ; time" (#R$9B25)
 $9AEC LD A,(IX+$02) ; Read byte +2 of the record at IX into A - L = the byte
                     ; at IX+2 minus 2
 $9AEF SUB $02       ; Subtract $02 from A
 $9AF1 LD L,A        ; Copy A into L
 $9AF2 JR $9B02      ; Join the common ending at #R$9B02

; Shared action 14: GO TO in a hansom cab
;
; Header $04 $00 then code (a cabbie's action list sends verb #R$9AF4(29), GO
; TO, here): the route check (#R$9B50), the fare at 2d a step (#R$9B25 with DE
; = 2) and the table's minutes as the ride's length (#R$9B02 stores it at
; #R$A01A($A01F)); then the cab is moved (#R$DD0E) and the ride handed to the
; vehicle sub-script #R$F3AD. Confirmed in the emulator: 20 minutes and 10d
; from Baker Street to Parliament Street (tools/experiments/cab_test.py).
;
;  Input:IX The action record (a cabbie's GO TO)
; Output:HL $F3AD, the vehicle sub-script
;        F Carry set
c$9AF4 DEFB $04,$00   ; Action record header: flags $04; byte 1 $00
 $9AF6 CALL $9B50     ; Can the cab get there from here? (#R$9B50)
 $9AF9 LD DE,$0002    ; Load DE with $0002 - The fare at 2d a step (#R$9B25
                      ; with DE = 2)
 $9AFC CALL $9B25     ; Call the routine "Price a cab ride from its journey
                      ; time" (#R$9B25)
 $9AFF LD L,(IX+$02)  ; Read byte +2 of the record at IX into L - L = the
                      ; table's journey time, in minutes (IX+2)
; This entry point is used by the routine at #R$9AE1.
*$9B02 LD A,$01       ; Load A with $01
; This entry point is used by the routine at #R$9ACB.
*$9B04 PUSH AF        ; Save AF on the stack
 $9B05 LD H,$00       ; Load H with $00
 $9B07 LD ($A01F),HL  ; Which is the length of the action (#R$A01A($A01F))
 $9B0A LD A,($E2C6)   ; Read "HAIL: the cab hailed, plus one" (#R$E2C6) into A
                      ; - Clear the 'revealed' flag of the thing named at
                      ; #R$E2C6 (#R$9C60)
 $9B0D CALL $9C60     ; Call the routine "Clear an object's 'revealed' flag (+5
                      ; bit 7)" (#R$9C60)
 $9B10 POP BC         ; Restore BC from the stack
 $9B11 PUSH BC        ; Save BC on the stack
 $9B12 LD A,($E2C6)   ; Read "HAIL: the cab hailed, plus one" (#R$E2C6) into A
                      ; - Then #R$DD0E with the same thing and B = 1
 $9B15 CALL $DD0E     ; Call #R$DD0E (inside "Default action: move in a
                      ; direction (verbs...")
 $9B18 POP AF         ; Restore AF from the stack
 $9B19 CALL $D224     ; The destination's record (#R$D224)
 $9B1C RES 6,(IX+$00) ; Clear bit 6 of its +0
 $9B20 LD HL,$F3AD    ; Point HL at #R$F3AD in "Plan script: returned as a
                      ; sub-script by..." - Hand the ride to the vehicle
                      ; sub-script at #R$F3AD
 $9B23 SCF            ; Set the carry flag for the caller
 $9B24 RET            ; Return to the caller

; Price a cab ride from its journey time
;
; IX is the journey's entry in #R$9B7F. The fare is HL = DE x (minutes / 5,
; rounded down, + 1). The cabbie's 10d for the 20-minute ride from Baker Street
; to Parliament Street in the emulator fits a rate of 2d in DE (2 x 5). Unless
; #R$E619 says otherwise for the actor in #R$A032($A036), it is taken off the
; money (#R$E39C, SBC HL,DE, #R$E38F); then #R$CFB6, and #R$A032($A035) from
; the entry's +3. Read from the code; the fare confirmed
; (tools/experiments/cab_test.py).
;
;  Input:IX The journey entry (+2 holds the minutes)
;        DE The fare for each five minutes
; Output:DE The fare
;        IX Unchanged
c$9B25 LD A,(IX+$02) ; Read byte +2 of the record at IX into A - A = the
                     ; journey's minutes
 $9B28 PUSH IX       ; Save IX on the stack
 $9B2A LD HL,$0000   ; Load HL with $0000 - HL = DE x (minutes / 5 + 1): DE per
                     ; five minutes, started
*$9B2D ADD HL,DE     ; Add DE to HL
 $9B2E SUB $05       ; Subtract $05 from A
 $9B30 JR NC,$9B2D   ; If it did not go below zero, go back to #R$9B2D
 $9B32 EX DE,HL      ; DE = the fare
 $9B33 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - Does
                     ; the actor (#R$A032($A036)) pay? (#R$E619)
 $9B36 CALL $E619    ; Call #R$E619 (inside "Action record: RUN at #R$E08F; RUN
                     ; at #R$E46B;...")
 $9B39 JR Z,$9B44    ; If the zero flag is set, skip ahead to #R$9B44
 $9B3B CALL $E39C    ; Call the routine "HL = the money a thing holds (+9/+10)"
                     ; (#R$E39C) - Take the fare off the actor's money
 $9B3E AND A         ; Clear the carry flag, so that the subtraction that
                     ; follows is a plain one (a compare)
 $9B3F SBC HL,DE     ; Subtract DE from HL (a compare: carry = HL was smaller,
                     ; zero = equal)
 $9B41 CALL $E38F    ; Call the routine "Store HL as the money a thing holds
                     ; (+9/+10)" (#R$E38F)
*$9B44 CALL $CFB6    ; Narrate the action (#R$CFB6)
 $9B47 LD A,(IX+$03) ; Read byte +3 of the record at IX into A - #R$A032($A035)
                     ; = (IX+3), with IX as #R$CFB6 left it
 $9B4A LD ($A035),A  ; Store A in #R$A032($A035) in "Game variables"
 $9B4D POP IX        ; Restore IX from the stack
 $9B4F RET           ; Return to the caller

; A cabbie told where to go: can he get there from here?
;
; Sets up the cab (#R$A012($A017)) for the journey - its +1 from the actor in
; #R$A032($A036), its room (+15) and #R$A00A from the cabbie's - and looks for
; a journey from here to the destination in #R$A032($A034) (#R$9C07). If there
; is one, returns Z. If not, the cabbie replies 'SORRY GUV'NOR I CANNOT GET
; THERE FROM 'ERE' (#R$6C34) and this returns NZ to its caller's caller (it
; drops its own return address). Confirmed in the emulator: asked for Old Mill
; Road from Baker Street, 'The cabbie replies " Sorry guv'nor I cannot get
; there from'ere ".'
;
;  Input:IX The cabbie's record (found from $A036)
; Output:F Z when a journey exists; otherwise the caller is abandoned after the
; .        apology is printed
c$9B50 LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - The cab
                     ; is the cabbie's number less one (cabbie 31 drives cab
                     ; 30, 34 drives 33)
 $9B53 DEC A         ; Subtract one from A
 $9B54 LD IY,($A017) ; Read #R$A012($A017) in "Game variables" into IY - The
                     ; cabbie is in the cab; remember the cab at #R$E2C6
 $9B58 LD (IY+$01),A ; Store A in byte +1 of the record at IY
 $9B5B LD ($E2C6),A  ; Store A in "HAIL: the cab hailed, plus one" (#R$E2C6)
 $9B5E CALL $D237    ; Call the routine "Resolve an id (in A) to its full
                     ; entity record" (#R$D237) - The cabbie's room becomes the
                     ; cab's room, and the current room
 $9B61 LD A,(IX+$0F) ; Read byte +15 of the record at IX into A
 $9B64 LD (IY+$0F),A ; Store A in byte +15 of the record at IY
 $9B67 LD ($A00A),A  ; Store A in the current actor's room (#R$A00A)
 $9B6A LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - Is
                     ; there a journey from here to the destination
                     ; (#R$A032($A034))?
 $9B6D LD C,A        ; Copy A into C
 $9B6E LD A,($A00A)  ; Read the current actor's room (#R$A00A) into A
 $9B71 CALL $9C07    ; Call the routine "Find the cab journey between two
                     ; rooms" (#R$9C07)
 $9B74 RET Z         ; Yes: Z
 $9B75 POP HL        ; No: drop the return address, so the record stops here,
 $9B76 LD HL,$6C34   ; Point HL at the message "YOU REPLIES" SORRY GUV'NOR I
                     ; CANNOT GET THERE... (#R$6C34) - and say SORRY GUV'NOR I
                     ; CANNOT GET THERE FROM 'ERE
 $9B79 CALL $A59F    ; Call the routine "Print the message at HL" (#R$A59F)
 $9B7C OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller
 $9B7E RET           ; Return to the caller

; Cab journeys: which cab stands a hansom cab runs between, and how long it
; takes
;
; Three-byte entries (one stand, the other stand, a number), ended by $FF,
; searched either way round by #R$9C07. The ten stands are street rooms:
; Portman, Baker, Parliament, Slater, Aldergate and Sidmouth Streets, Kings
; Cross Road, Bishops Road, Buckingham Palace Road and Camden Street; every
; pair of them has an entry (45 entries). The third byte is the journey's
; length in minutes: the cab-ride action record at #R$9AE3 puts it, less 2, in
; #R$A01A($A01F), the number of minutes an action takes; and Parliament Street
; to Kings Cross Road, 12 here, matches Lestrade's cab ride logged in the
; emulator (7:10 to 7:20am). #R$9B25 also prices the ride from it. Leatherhead
; and Old Mill Road are not here: they are reached by train and the police cab.
; .
; Confirmed in the emulator (tools/experiments/cab_test.py): hailed in Baker
; Street, the cab took 19-20 minutes to Parliament Street (the table says 20),
; and the cabbie then said 'Right guv'nor that will be 10d.'; asked for Old
; Mill Road, which is not in the table, he replied 'Sorry guv'nor I cannot get
; there from'ere'.
b$9B7F DEFB $2D,$05,$03 ; Portman Street (room 45) - Baker Street (room 5): 3
 $9B82 DEFB $2D,$0A,$07 ; Portman Street (room 45) - Parliament Street (room
                        ; 10): 7
 $9B85 DEFB $2D,$0C,$14 ; Portman Street (room 45) - Slater Street (room 12):
                        ; 20
 $9B88 DEFB $2D,$0E,$13 ; Portman Street (room 45) - Aldergate Street (room
                        ; 14): 19
 $9B8B DEFB $2D,$12,$12 ; Portman Street (room 45) - Kings Cross Road (room
                        ; 18): 18
 $9B8E DEFB $2D,$18,$07 ; Portman Street (room 45) - Bishops Road (room 24): 7
 $9B91 DEFB $2D,$1C,$0C ; Portman Street (room 45) - Buckingham Palace Road
                        ; (room 28): 12
 $9B94 DEFB $2D,$20,$06 ; Portman Street (room 45) - Camden Street (room 32): 6
 $9B97 DEFB $2D,$28,$0D ; Portman Street (room 45) - Sidmouth Street (room 40):
                        ; 13
 $9B9A DEFB $05,$0A,$14 ; Baker Street (room 5) - Parliament Street (room 10):
                        ; 20
 $9B9D DEFB $05,$0C,$19 ; Baker Street (room 5) - Slater Street (room 12): 25
 $9BA0 DEFB $05,$0E,$1A ; Baker Street (room 5) - Aldergate Street (room 14):
                        ; 26
 $9BA3 DEFB $05,$12,$0C ; Baker Street (room 5) - Kings Cross Road (room 18):
                        ; 12
 $9BA6 DEFB $05,$18,$06 ; Baker Street (room 5) - Bishops Road (room 24): 6
 $9BA9 DEFB $05,$1C,$0F ; Baker Street (room 5) - Buckingham Palace Road (room
                        ; 28): 15
 $9BAC DEFB $05,$20,$18 ; Baker Street (room 5) - Camden Street (room 32): 24
 $9BAF DEFB $05,$28,$09 ; Baker Street (room 5) - Sidmouth Street (room 40): 9
 $9BB2 DEFB $0A,$0C,$12 ; Parliament Street (room 10) - Slater Street (room
                        ; 12): 18
 $9BB5 DEFB $0A,$0E,$12 ; Parliament Street (room 10) - Aldergate Street (room
                        ; 14): 18
 $9BB8 DEFB $0A,$12,$0C ; Parliament Street (room 10) - Kings Cross Road (room
                        ; 18): 12
 $9BBB DEFB $0A,$18,$13 ; Parliament Street (room 10) - Bishops Road (room 24):
                        ; 19
 $9BBE DEFB $0A,$1C,$02 ; Parliament Street (room 10) - Buckingham Palace Road
                        ; (room 28): 2
 $9BC1 DEFB $0A,$20,$04 ; Parliament Street (room 10) - Camden Street (room
                        ; 32): 4
 $9BC4 DEFB $0A,$28,$0F ; Parliament Street (room 10) - Sidmouth Street (room
                        ; 40): 15
 $9BC7 DEFB $0C,$0E,$03 ; Slater Street (room 12) - Aldergate Street (room 14):
                        ; 3
 $9BCA DEFB $0C,$12,$14 ; Slater Street (room 12) - Kings Cross Road (room 18):
                        ; 20
 $9BCD DEFB $0C,$18,$1E ; Slater Street (room 12) - Bishops Road (room 24): 30
 $9BD0 DEFB $0C,$1C,$14 ; Slater Street (room 12) - Buckingham Palace Road
                        ; (room 28): 20
 $9BD3 DEFB $0C,$20,$11 ; Slater Street (room 12) - Camden Street (room 32): 17
 $9BD6 DEFB $0C,$28,$19 ; Slater Street (room 12) - Sidmouth Street (room 40):
                        ; 25
 $9BD9 DEFB $0E,$12,$0D ; Aldergate Street (room 14) - Kings Cross Road (room
                        ; 18): 13
 $9BDC DEFB $0E,$18,$1C ; Aldergate Street (room 14) - Bishops Road (room 24):
                        ; 28
 $9BDF DEFB $0E,$1C,$11 ; Aldergate Street (room 14) - Buckingham Palace Road
                        ; (room 28): 17
 $9BE2 DEFB $0E,$20,$09 ; Aldergate Street (room 14) - Camden Street (room 32):
                        ; 9
 $9BE5 DEFB $0E,$28,$0B ; Aldergate Street (room 14) - Sidmouth Street (room
                        ; 40): 11
 $9BE8 DEFB $12,$18,$0B ; Kings Cross Road (room 18) - Bishops Road (room 24):
                        ; 11
 $9BEB DEFB $12,$1C,$10 ; Kings Cross Road (room 18) - Buckingham Palace Road
                        ; (room 28): 16
 $9BEE DEFB $12,$20,$12 ; Kings Cross Road (room 18) - Camden Street (room 32):
                        ; 18
 $9BF1 DEFB $12,$28,$03 ; Kings Cross Road (room 18) - Sidmouth Street (room
                        ; 40): 3
 $9BF4 DEFB $18,$1C,$0F ; Bishops Road (room 24) - Buckingham Palace Road (room
                        ; 28): 15
 $9BF7 DEFB $18,$20,$18 ; Bishops Road (room 24) - Camden Street (room 32): 24
 $9BFA DEFB $18,$28,$0D ; Bishops Road (room 24) - Sidmouth Street (room 40):
                        ; 13
 $9BFD DEFB $1C,$20,$0C ; Buckingham Palace Road (room 28) - Camden Street
                        ; (room 32): 12
 $9C00 DEFB $1C,$28,$13 ; Buckingham Palace Road (room 28) - Sidmouth Street
                        ; (room 40): 19
 $9C03 DEFB $20,$28,$16 ; Camden Street (room 32) - Sidmouth Street (room 40):
                        ; 22
 $9C06 DEFB $FF         ; End marker

; Find the cab journey between two rooms
;
; Searches #R$9B7F for an entry joining room A and room C, in either order; C =
; 0 matches any entry with A at either end. Returns Z with IX on the entry, or
; NZ if there is none. Read from the code.
;
;  Input:A one room
;        C the other (0 = any)
; Output:F Z if found
;        IX the entry
c$9C07 LD IX,$9B7F   ; Point IX at "Cab journeys: which cab stands a hansom cab
                     ; runs..." (#R$9B7F)
 $9C0B PUSH BC       ; Save BC on the stack
 $9C0C LD B,A        ; Copy A into B
*$9C0D LD A,(IX+$00) ; Read the first byte of the record at IX into A - End of
                     ; the table: NZ, not found
 $9C10 CP $FF        ; Compare A with $FF
 $9C12 JR Z,$9C3D    ; If A equals $FF, jump on to #R$9C3D
 $9C14 LD A,B        ; Copy B into A - Is A this entry's first stand?
 $9C15 CP (IX+$00)   ; Compare A with the first byte of the record at IX
 $9C18 JR Z,$9C2A    ; If A equals the first byte of the record at IX, skip
                     ; ahead to #R$9C2A
 $9C1A CP (IX+$01)   ; Compare A with byte +1 of the record at IX - or its
                     ; second?
 $9C1D JR NZ,$9C33   ; If A differs from byte +1 of the record at IX, skip
                     ; ahead to #R$9C33
 $9C1F LD A,C        ; Copy C into A - A is the second stand: C = 0 matches
                     ; anything,
 $9C20 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $9C21 JR Z,$9C3B    ; If A is zero, skip ahead to #R$9C3B
 $9C23 CP (IX+$00)   ; Compare A with the first byte of the record at IX -
                     ; otherwise C must be the first
 $9C26 JR NZ,$9C33   ; If A differs from the first byte of the record at IX,
                     ; skip ahead to #R$9C33
 $9C28 JR $9C3B      ; Skip ahead to #R$9C3B
*$9C2A LD A,C        ; Copy C into A - A is the first stand: C = 0 or C the
                     ; second
 $9C2B AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $9C2C JR Z,$9C3B    ; If A is zero, skip ahead to #R$9C3B
 $9C2E CP (IX+$01)   ; Compare A with byte +1 of the record at IX
 $9C31 JR Z,$9C3B    ; If A equals byte +1 of the record at IX, skip ahead to
                     ; #R$9C3B
*$9C33 INC IX        ; Step IX on to the next byte - Next entry
 $9C35 INC IX        ; Step IX on to the next byte
 $9C37 INC IX        ; Step IX on to the next byte
 $9C39 JR $9C0D      ; Go back to #R$9C0D
*$9C3B POP BC        ; Restore BC from the stack - Z: found, IX on the entry
 $9C3C RET           ; Return to the caller
*$9C3D OR $01        ; Set bit 0 of A
 $9C3F POP BC        ; Restore BC from the stack
 $9C40 RET           ; Return to the caller

; Action record: move the vehicle the actor is in to the direct object's room
;
; Header $04 $00, then: takes the actor's container (+1 of #R$A012($A017) - the
; cab or train it is riding in), sets that thing's bit 7 of +5 (#R$9C56), and
; moves it to the room in #R$A032($A034), with everything in it, by jumping
; into the move code of the direction action at #R$DD0E (which also updates
; #R$A00A, #R$DD01 and #R$DCFF when the mover is the actor). Run by the vehicle
; sub-script at #R$F3AD (#R$F3AD+4: RUN #R$9C41 with the plan's direct object),
; which #R$9B20 returns. CORRECTED: was untitled data. Read from the code.
;
;  Input:$A017 The actor's container, the vehicle
;        $A034 The destination room
; Output:F From the move at $DD0E
c$9C41 INC B         ; Add one to B - Header $04 $00
 $9C42 NOP           ; Do nothing (padding)
 $9C43 LD IX,($A017) ; Read #R$A012($A017) in "Game variables" into IX - A =
                     ; the actor's container: the vehicle it is in
 $9C47 LD A,(IX+$01) ; Read byte +1 of the record at IX into A
 $9C4A PUSH AF       ; Save AF on the stack
 $9C4B CALL $9C56    ; Set the vehicle's +5 bit 7
 $9C4E LD A,($A034)  ; Read #R$A032($A034) in "Game variables" into A - B = the
                     ; destination
 $9C51 LD B,A        ; Copy A into B
 $9C52 POP AF        ; Restore AF from the stack
 $9C53 JP $DD0E      ; Move the vehicle and all in it to room B

; Set an object's 'revealed' flag (+5 bit 7)
;
; Finds the object (#R$D237) and sets bit 7 of its +5 flags - the bit the
; flag-word tables at #R$C471 call revealed - then returns NZ. Read from the
; code.
;
;  Input:A The thing number
; Output:IX The thing's record
;        F NZ
c$9C56 CALL $D237     ; Thing A's record (#R$D237)
 $9C59 SET 7,(IX+$05) ; Set bit 7 of +5 (visible)
 $9C5D OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller - Return NZ
 $9C5F RET            ; Return to the caller

; Clear an object's 'revealed' flag (+5 bit 7)
;
; As #R$9C56, but clears the bit.
;
;  Input:A The thing number
; Output:IX The thing's record
;        F NZ
c$9C60 CALL $D237     ; (Next routine) thing A's record
 $9C63 RES 7,(IX+$05) ; Clear bit 7 of +5 (hidden)
 $9C67 OR $01         ; Make A non-zero, which clears the zero flag, and hand
                      ; that back to the caller - Return NZ
 $9C69 RET            ; Return to the caller

; Look up the actor's after-turn routine
;
; Searches the table at #R$9C85 (#R$D34E) for the actor in #R$A032($A036).
; Returns Z if there is none (the search's $FF end marker), NZ if found. Read
; from the code.
;
;  Input:$A036 The actor
; Output:F Z if the actor has no after-turn routine; NZ if it has
;        IX The actor's entry in the table at $9C85
c$9C6A LD A,($A036)  ; Read #R$A032($A036) in "Game variables" into A - The
                     ; actor (#R$A032($A036)) looked up in the list at #R$9C85
                     ; (#R$D34E)
 $9C6D LD IX,$9C85   ; Point IX at "After-turn routines for nine characters"
                     ; (#R$9C85)
 $9C71 CALL $D34E    ; Call the routine "Find a 3-byte record by id, in a
                     ; sentinel-terminated..." (#R$D34E)
 $9C74 CP $FF        ; Compare A with $FF - $FF = not there
 $9C76 RET           ; Return to the caller

; Run the current actor's own after-turn routine
;
; After every turn (from the main loop at #R$A0CC), looks the actor up in the
; table at #R$9C85 (#R$9C6A, through #R$D34E) and jumps to its routine. Nine
; characters have one. Read from the code; the routines are not traced.
; .
; Instruction coverage over the 15 stored routes (9 November,
; tools/experiments/insn_coverage.py): all 8 instructions were executed.
;
;  Input:$A036 The actor
; Output:F Unchanged from the actor's own routine, or the caller continues if
; .        there is none
c$9C77 CALL $9C6A    ; Has this actor a routine?
 $9C7A RET Z         ; No
 $9C7B LD L,(IX+$01) ; Read byte +1 of the record at IX into L - Its address...
 $9C7E LD H,(IX+$02) ; Read byte +2 of the record at IX into H
 $9C81 LD A,L        ; Copy L into A
 $9C82 OR H          ; Set in A the bits that are set in H
 $9C83 RET Z         ; If the result is zero, return
 $9C84 JP (HL)       ; ...jump to it

; After-turn routines for nine characters
;
; Three-byte entries (actor id, routine address), ended by $FF, searched by
; #R$9C6A.
b$9C85 DEFB $02,$FF,$9D ; Actor 2 inspector lestrade: #R$9DFF
 $9C88 DEFB $03,$13,$9D ; Actor 3 watson: #R$9D13
 $9C8B DEFB $04,$30,$9D ; Actor 4 chief constable straker: #R$9D30
 $9C8E DEFB $0B,$48,$9D ; Actor 11 local police man: #R$9D48
 $9C91 DEFB $0C,$73,$9D ; Actor 12 local police man: #R$9D73
 $9C94 DEFB $08,$D1,$9E ; Actor 8 gardener: #R$9ED1
 $9C97 DEFB $09,$CB,$9E ; Actor 9 cook: #R$9ECB
 $9C9A DEFB $05,$C1,$9E ; Actor 5 strachan: #R$9EC1
 $9C9D DEFB $06,$A2,$9C ; Actor 6 phipps: #R$9CA2
 $9CA0 DEFB $FF         ; End marker
 $9CA1 DEFB $0F

; Phipps's after-turn routine
;
; Once thing $55 (85, the burning note) has been revealed (+5 bit 7), counts
; down #R$9CA1; when it reaches 0, the note is described as BURNT (word $015B
; into its +9/+10), its +$0D/+$0E are cleared, and bit 1 of +3 of the case
; record at #R$99B7 is cleared. Read from the code.
; .
; Played, Wednesday morning: with the player waiting outside, the note is
; revealed at 10:05am, the countdown #R$9CA1 (15 at the start) falls once a
; minute and reaches 0 at 10:24am. A plain TAKE of the note runs the shared
; TAKE script at #R$DF7E, which sets the countdown to $FF (stopped) and renames
; the note SINGE, so it can be examined and used as evidence; TAKE NOTE FROM
; FIREPLACE does not run that script and the note still burns away.
;
; Output:F Z until the note has burnt; no registers are returned
c$9CA2 LD A,$55       ; Load A with $55 - Thing $55, the burning note
 $9CA4 CALL $D237     ; Call the routine "Resolve an id (in A) to its full
                      ; entity record" (#R$D237)
 $9CA7 BIT 7,(IX+$05) ; Test bit 7 of byte +5 of the record at IX - Not yet
                      ; revealed (+5 bit 7 clear): nothing
 $9CAB RET Z          ; If bit 7 of byte +5 of the record at IX is clear,
                      ; return
 $9CAC LD HL,$9CA1    ; Point HL at #R$9CA1 in "After-turn routines for nine
                      ; characters" - The countdown at #R$9CA1: $FF means it
                      ; has run out already
 $9CAF LD A,(HL)      ; Read the byte at #R$9CA1 in "After-turn routines for
                      ; nine characters" into A
 $9CB0 CP $FF         ; Compare A with $FF
 $9CB2 RET Z          ; If A equals $FF, return
 $9CB3 DEC (HL)       ; Subtract one from the byte HL points at - One turn
                      ; less; carry on only when it reaches 0
 $9CB4 RET NZ         ; If the byte HL points at is not zero, return
 $9CB5 LD HL,$015B    ; Load HL with $015B - Describe the note as BURNT (word
                      ; $015B in +9/+10)...
 $9CB8 LD (IX+$09),L  ; Store L in byte +9 of the record at IX
 $9CBB LD (IX+$0A),H  ; Store H in byte +10 of the record at IX
 $9CBE XOR A          ; Clear A to zero (and the carry flag) - ...and clear its
                      ; +13 and +14
 $9CBF LD (IX+$0D),A  ; Store A in byte +13 of the record at IX
 $9CC2 LD (IX+$0E),A  ; Store A in byte +14 of the record at IX
 $9CC5 LD IX,$99B7    ; Point IX at #R$99B7 in "The case: statements about the
                      ; crime, and..." - Case record #R$99B7: clear bit 1 of +3
 $9CC9 RES 1,(IX+$03) ; Clear bit 1 of byte +3 of the record at IX
 $9CCD RET            ; Return to the caller

; Is thing C in the same room as the current actor, and visible to the player?
;
; Z if C is in the actor's room (#R$A012($A017)'s +$0F) and the player can see
; it (#R$C821); NZ otherwise. Read from the code.
; .
; Checked 9 November over the first 120 commands of the winning route: 4172
; runs, every one met its stated postcondition (Z only when the thing's room
; equals the actor's room).
;
;  Input:C The thing number
; Output:F Z if the thing is in the actor's room and the player can see it; NZ
; .        if not
;        B The room of the actor ($A017)
;        IX The thing's record
c$9CCE LD IX,($A017) ; Read #R$A012($A017) in "Game variables" into IX - B =
                     ; the room of the actor's own record (#R$A012($A017))
 $9CD2 LD B,(IX+$0F) ; Read the rooms byte (+15) of the thing record at IX into
                     ; B
 $9CD5 LD A,C        ; Copy C into A
 $9CD6 CALL $D237    ; Call the routine "Resolve an id (in A) to its full
                     ; entity record" (#R$D237) - IX = thing C: is it in the
                     ; same room? If not, return NZ
 $9CD9 LD A,(IX+$0F) ; Read the rooms byte (+15) of the thing record at IX into
                     ; A
 $9CDC CP B          ; Compare A with B
 $9CDD RET NZ        ; If A differs from B, return
 $9CDE LD A,C        ; Copy C into A - Same room: can the player see it
                     ; (#R$C821 with A = C)?
 $9CDF CALL $C821    ; Call the routine "Can the current actor (#R$A032($A036))
                     ; see thing A?" (#R$C821)
 $9CE2 JR Z,$9CE6    ; Not visible: NZ
 $9CE4 XOR A         ; Set A to zero, which sets the zero flag for the caller -
                     ; Visible: Z
 $9CE5 RET           ; Return to the caller
*$9CE6 OR $01        ; Make A non-zero, which clears the zero flag, and hand
                     ; that back to the caller
 $9CE8 RET           ; Return to the caller

; Say good morning to C, if just met
;
; Used by after-turn routines: #R$9CF2 checks whether C is here and seen and
; whether the greeting countdown at HL has run out; if so the countdown is set
; to 30 to 45 minutes (30 plus a random number from 0 to 15) and #R$6929 is
; printed: '<actor> SAYS TO <C> "GOOD MORNING".' While C stays away the
; countdown runs down by one a turn, so characters greet each other again only
; after a while apart. Read from the code.
;
;  Input:HL The greeting countdown
;        C The thing to greet
; Output:F From $A59F when the greeting is printed
c$9CE9 CALL $9CF2    ; #R$9CF2 sets up who is being spoken to; if it returns,
                     ; print message #R$6929
; This entry point is used by the routine at #R$9DC6.
*$9CEC LD HL,$6929   ; Point HL at the message "YOU SAY TO THE OIL LAMP" GOOD
                     ; MORNING "." (#R$6929) - "... SAYS TO ... GOOD MORNING"
 $9CEF JP $A59F      ; Jump on to the routine "Print the message at HL"
                     ; (#R$A59F)
; This entry point is used by the routines at #R$9D48, #R$9DC6 and #R$9DD8.
*$9CF2 LD A,C        ; Copy C into A - The thing to talk to (C) becomes the
                     ; direct object (#R$A032($A034))
 $9CF3 LD ($A034),A  ; Store A in #R$A032($A034) in "Game variables"
 $9CF6 CALL $9CCE    ; Is it in the actor's room and visible to the player
                     ; (#R$9CCE)?
 $9CF9 JR Z,$9D02    ; Yes
 $9CFB DEC (HL)      ; Subtract one from the byte HL points at - Not so: one
                     ; less on its countdown (not below zero)
 $9CFC JP P,$9D00    ; If the last result was positive (sign flag clear), skip
                     ; ahead to #R$9D00
 $9CFF INC (HL)      ; Add one to the byte HL points at
*$9D00 POP DE        ; Restore DE from the stack - ...and skip the caller's
                     ; print (the stack is dropped)
 $9D01 RET           ; Return to the caller
*$9D02 LD A,(HL)     ; Read the byte HL points at into A - Visible: only when
                     ; the countdown is 0...
 $9D03 AND A         ; Test A for zero (this leaves A as it was and clears
                     ; carry)
 $9D04 JR NZ,$9D00   ; If A is not zero, go back to #R$9D00
 $9D06 LD A,$0F      ; Load A with $0F - ...then reset it to a random 30 to 44
                     ; (#R$D2A4 with range 15, plus 30)
 $9D08 CALL $D2A4    ; Call the routine "A random number from 0 to A" (#R$D2A4)
 $9D0B ADD A,$1E     ; Add $1E to A
 $9D0D LD (HL),A     ; Store A at the address HL points to
 $9D0E XOR A         ; Set A to zero, which sets the zero flag for the caller -
                     ; Greet
 $9D0F RET           ; Return to the caller

; Watson's greeting countdowns: the player, Lestrade, Straker
;
; Minutes to go before the next greeting or warning (see #R$9CE9).
b$9D10 DEFB $1E,$00,$00

; Watson's after-turn routine
;
; Greets the player, Inspector Lestrade and Chief Constable Straker when he
; meets them (countdowns at #R$9D10-#R$9D10($9D12), through #R$9CE9), then
; continues at #R$E691 (not traced).
