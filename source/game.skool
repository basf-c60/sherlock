*$BC31 LD ($BA1E),IX  ; Remember the record in #R$BA1B($BA1E)
 $BC35 CALL $BCC9     ; Try to prove it (#R$BCC9)
 $BC38 JR Z,$BC43     ; Proven: return NZ
 $BC3A LD A,$01       ; Load A with $01 - Not proven: #R$BA1B($BA1D) = 1...
 $BC3C LD ($BA1D),A   ; Store A in #R$BA1B($BA1D) in "Variables used by the
                      ; code at #R$BA20-#R$BF58"
