                     ; one of two word slots (NZ if both are full)
 $AC92 JR $AC97      ; Skip ahead to #R$AC97

; Put word BC in the first empty pair at $AAAE (NZ if both are taken)
;
; Addresses named in the title: #R$AAAB($AAAE).
;
;  Input:BC The word
; Output:F Z when stored in one of the two slots at $AAAE; NZ when both are
; .        taken
c$AC94 LD HL,$AAAE   ; The two word slots at #R$AAAB($AAAE) (2 bytes each)
; This entry point is used by the routine at #R$AC8F.
*$AC97 LD A,(HL)     ; Read the byte HL points at into A - First slot empty?
