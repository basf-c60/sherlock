>#R$6737(WAY)</td><td>$978</td><td>$DF</td><td></td></tr><tr><td>#R$673A(WE)</td><td>$97B</td><td>$DF</td><td></td></tr><tr><td>#R$673D(WEAPON)</td><td>$97E</td><td>$DF</td><td></td></tr><tr><td>#R$6742(WEAR)</td><td>$983</td><td>$3F</td><td></td></tr><tr><td>#R$6745(WELL)</td><td>$986</td><td>$DF</td><td></td></tr><tr><td>#R$6749(WENT)</td><td>$98A</td><td>$DF</td><td></td></tr><tr><td>#R$674D(WERE)</td><td>$98E</td><td>$DF</td><td></td></tr><tr><td>#R$6751(WEST)</td><td>$992</td><td>$2F</td><td></td></tr><tr><td>#R$6755(WHAT)</td><td>$996</td><td>$6F</td><td></td></tr><tr><td>#R$6759(WHEN)</td><td>$99A</td><td>$DF</td><td></td></tr><tr><td>#R$675D(WHERE)</td><td>$99E</td><td>$DF</td><td></td></tr><tr><td>#R$6761(WHILE)</td><td>$9A2</td><td>$DF</td><td></td></tr><tr><td>#R$6765(WHO)</td><td>$9A6</td><td>$DF</td><td></td></tr><tr><td>#R$6768(WIDE)</td><td>$9A9</td><td>$6F</td><td></td></tr><tr><td>#R$676C(WIFE)</td><td>$9AD</td><td>$DF</td><td></td></tr><tr><td>#R$6770(WILL)</td><td>$9B1</td><td>$8F</td><td></td></tr><tr><td>#R$6774(WINDING)</td><td>$9B5</td><td>$6F</td><td></td></tr><tr><td>#R$677A(WINDOWS)</td><td>$9BB</td><td>$50</td><td></td></tr><tr><td>#R$677E(WITH)</td><td>$9BF</td><td>$7F</td><td></td></tr><tr><td>#R$6782(WOKE)</td><td>$9C3</td><td>$DF</td><td></td></tr><tr><td>#R$6786(WOKEN)</td><td>$9C7</td><td>$DF</td><td></td></tr><tr><td>#R$6789(WOMAN)</td><td>$9CA</td><td>$DF</td><td></td></tr><tr><td>#R$678D(WOODEN)</td><td>$9CE</td><td>$6F</td><td></td></tr><tr><td>#R$6792(WORKING)</td><td>$9D3</td><td>$D5</td><td></td></tr><tr><td>#R$6796(WORLDS)</td><td>$9D7</td><td>$D0</td><td></td></tr><tr><td>#R$679A(WOULD)</td><td>$9DB</td><td>$D4</td><td></td></tr><tr><td>#R$679E(XLE)</td><td>$9DF</td><td>$DF</td><td></td></tr><tr><td>#R$67A2(YARD)</td><td>$9E3</td><td>$5F</td><td></td></tr><tr><td>#R$67A6(YEARS)</td><td>$9E7</td><td>$D0</td><td></td></tr><tr><td>#R$67AA(YET)</td><td>$9EB</td><td>$DF</td><td></td></tr><tr><td>#R$67AD(YOU)</td><td>$9EE</td><td>